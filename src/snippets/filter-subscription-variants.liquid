<div class="product-subscription__filter-variants pb-sm">
  <div class="p6 font-700 mb-xxxs">Select Filter</div>
  <div class="filter-subscription__variants flex flex-col gap-xxxs desktop:flex-row desktop:flex-wrap desktop:gap-xxs">
    {% for variant in variants %}
      {% if variant.selling_plan_allocations.size > 0 %}
        <button type="button" class="filter-subscription__variant py-xxs px-sm border border-gray rounded-[2px] flex justify-between items-center gap-sm desktop:block desktop:flex-1" data-selected="{% if selected_variant == variant %}true{% else %}false{% endif %}" data-variant="{{ variant.id }}" data-value="{{ variant.title | handle }}" data-available="{{ variant.available }}" js-fitler-subscription-variant>
          <div class="p4 font-500">{{ variant.title }}</div>
          <div class="flex justify-center gap-xxs p6">
            {% if variant.selling_plan_allocations[0].compare_at_price > variant.selling_plan_allocations[0].price %}
              <s>{{ variant.selling_plan_allocations[0].compare_at_price | money }}</s>
            {% endif %}
            <span class="font-700">{{ variant.selling_plan_allocations[0].price | money }}</span>
          </div>
        </button>
      {% endif %}
    {% endfor %}
  </div>
  {% for variant in variants %}
    {% if variant.metafields.seed.filter_subscription_description != blank and variant.selling_plan_allocations.size > 0 %}
      <div class="filter-subscription__description p4 mt-xxs {% if selected_variant != variant %}hidden{% endif %}" data-variant="{{ variant.id }}" data-value="{{ variant.title | handle }}" js-filter-subscription-description>
        {{ variant.metafields.seed.filter_subscription_description }}
      </div>
    {% endif %}

    {% if variant.selling_plan_allocations.size > 0 and subscription_type == 'airpurifier_and_filter' %}
      <div class="filter-subscription__selling-plans-group pb-xxs pt-sm {% if selected_variant != variant %}hidden{% endif %}" data-variant="{{ variant.id }}" js-filter-subscription-selling-plans-group>
        <div class="p6 font-700 mb-xxxs {% if variant.available == false %}text-gray{% endif %}">Choose Frequency</div>  
        <div class="filter-subscription__selling-plans flex flex-wrap gap-xxs">
          {% for selling_plan_allocation in variant.selling_plan_allocations %}
            <button type="button" data-selected="false" data-selling-plan-id="{{ selling_plan_allocation.selling_plan.id }}" data-variant="{{ variant.id }}" {% if variant.available == false %}disabled{% endif %} class="filter-subscription__selling-plan flex-1 rounded-[2px] border border-gray p-xxs p-3 font-500 text-blue" js-filter-subscription-selling-plan>
              {% if selling_plan_allocation.selling_plan.options[0].value == 'month' %}
                1 month
              {% else %}
                {{ selling_plan_allocation.selling_plan.options[0].value }}
              {% endif %}
            </button>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>