<s-drawer id="MobileNavDrawer" position='left' open="[js-open-mobile-nav]" close="[js-close-mobile-nav]">
  <div class="mobile-nav h-full flex flex-col relative">
    <div class="mobile-nav__header px-md py-xs flex justify-between items-center">
      <a href="{{ routes.root_url }}" class="mobile-nav__logo w-[140px]">{% render 'icon-blueair-logo' %}</a>
      <button class="mobile-nav__close w-40" js-close-mobile-nav>{% render 'icon-nav-close' %}</button>
    </div>
    <ul class="mobile-nav__main-nav p-md flex-1 max-h-full overflow-y-auto flex flex-col gap-xs text-18">
      {% assign nav_linklist = linklists[settings.header_nav] %}
      {% for link in nav_linklist.links %}
        {% if link.links != blank %}
          <li class="mobile-main-nav__item">
            <button class="mobile-main-nav__child-nav-trigger w-full flex justify-between items-center gap-md" data-target="MobileChildNav-{{ link.handle }}" js-mobile-subnav-trigger>
              <span>{{ link.title }}</span>
              <span class="w-40">{% render 'icon-active-right' %}</span>
            </button>
          </li>
        {% else %}
          <li class="mobile-main-nav__item">
            <a href="{{ link.url }}" class="mobile-main-nav__link link block w-full py-xxs leading-[24px]">
              {{ link.title }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
    <div class="mobile-nav__footer border-t border-gray px-md py-xs grid grid-cols-2 text-14">
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mobile-nav__account flex justify-start items-center gap-xxxs">
        <span class="w-36">{% render 'icon-account' %}</span>
        <span>{% if customer %}Account{% else %}Sign In / Join{% endif %}</span>
      </a>
      <div class="w-36">
        {% render 'icon-globe' %}
      </div>
    </div>

    {% for link in nav_linklist.links %}
      {% if link.links != blank %}
        <div id="MobileChildNav-{{ link.handle }}" class="mobile-nav__child-nav absolute top-0 bottom-[61px] left-0 right-0 z-[1] bg-white -translate-x-full transition-transform duration-300 ease-in-out pointer-events-none flex flex-col" data-active="false" js-mobile-subnav>
          <div class="mobile-child-nav__header border-b border-gray flex justify-between items-center px-md py-xs">
            <button class="w-32" js-mobile-subnav-close>{% render 'icon-active-left' %}</button>
            <span class="text-14 font-700">{{ link.title }}</span>
            <button class="mobile-nav__close w-40" js-close-mobile-nav>{% render 'icon-nav-close' %}</button>
          </div>
          <div class="mobile-child-nav__links-container flex-1 max-h-full overflow-y-auto">
            {% for child_link in link.links %}
              {% assign child_link_handle = child_link.title | handle %}
              {% if child_link_handle == 'image-links' %}
                <ul class="mobile-child-nav__image-links p-md flex flex-nowrap gap-xs overflow-x-auto">
                  {% for grandchild_link in child_link.links %}
                    <li class="mobile-child-nav__item">
                      <a href="{{ grandchild_link.url }}" class="mobile-child-nav__link block">
                        {% assign image_link_title = grandchild_link.title %}
                        <div class="w-[124px] min-w-[124px] h-[124px]">
                          {% if grandchild_link.title contains '|' %}
                            {% assign image_link_title = grandchild_link.title | split: '|' | first | strip %}
                            {% assign image_file = grandchild_link.title | split: '|' | last | strip %}
                            {% assign image_object = images[image_file] %}
                            {% render 'lazy-image', image: image_object, picture_classes: 'h-full', img_classes: 'h-full object-cover object-bottom' %}
                          {% elsif grandchild_link.object.metafields.seed.nav_link_image != blank %}
                            {% render 'lazy-image', image: grandchild_link.object.metafields.seed.nav_link_image, picture_classes: 'h-full', img_classes: 'h-full object-cover object-bottom' %}
                          {% endif %}
                        </div>
                        <div class="text-14 font-700 mt-xxs">
                          {{ image_link_title }}
                        </div>
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% elsif child_link_handle == 'quiz' %}
                <div class="mobile-child-nav__quiz p-md">
                  {% if settings.quiz_image != blank %}
                    <div class="mobile-child-nav__quiz-image mb-xs">
                      {% render 'lazy-image' image: settings.quiz_image %}
                    </div>
                  {% endif %}
                  <div class="mobile-child-nav__quiz-text text-16 font-700 mb-xs">{{ settings.quiz_text }}</div>
                  <a href="{{ settings.quiz_link_url }}" class="mobile-child-nav__quiz-link btn">
                    <span class="btn__text">{{ settings.quiz_link_text }}</span>
                    <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                  </a>
                </div>
              {% elsif child_link_handle == 'app' %}
                <div class="mobile-child-nav__app py-md mx-md border-t border-gray">
                  <div>Download the Blueair App</div>
                  <div class="mobile-child-nav__app-links flex justify-start gap-xs mt-xs">
                    <a href="{{ settings.app_store_url_mobile }}" class="mobile-child-nav__app-link mobile-child-nav__app-link--mobile desktop:hidden">
                      <img src="{{ 'app-store--black.png' | asset_url }}" class="block w-auto h-[38px]" />
                    </a>
                    <a href="{{ settings.google_play_url_mobile }}" class="mobile-child-nav__app-link mobile-child-nav__app-link--mobile desktop:hidden">
                      <img src="{{ 'google-play--black.png' | asset_url }}" class="block w-auto h-[38px]" />
                    </a>
                    <a href="{{ settings.app_store_url_desktop }}" class="mobile-child-nav__app-link mobile-child-nav__app-link--desktop hidden desktop:block">
                      <img src="{{ 'app-store--black.png' | asset_url }}" class="block w-auto h-[38px]" />
                    </a>
                    <a href="{{ settings.google_play_url_desktop }}" class="mobile-child-nav__app-link mobile-child-nav__app-link--desktop hidden desktop:block">
                      <img src="{{ 'google-play--black.png' | asset_url }}" class="block w-auto h-[38px]" />
                    </a>
                  </div>
                </div>
              {% else %}
                {% if child_link.links != blank %}
                  <div class="mobile-child-nav__links-wrapper mx-md py-md border-t border-gray">
                    <div class="text-14 font-700 mb-xs">{{ child_link.title }}</div>
                    <ul class="mobile-child-nav__links">
                      {% for grandchild_link in child_link.links %}
                        <li class="mobile-child-nav__item {% unless forloop.last %}mb-md{% endunless %}">
                          <a href="{{ grandchild_link.url }}" class="mobile-child-nav__link link text-18 w-full flex gap-xxs items-center">
                            {% if child_link_handle contains 'room-size' %}
                              {% if grandchild_link.title contains 'Small' %}
                                {% render 'room-icon', size: 'small' %}
                              {% elsif grandchild_link.title contains 'Medium' %}
                                {% render 'room-icon', size: 'medium' %}
                              {% elsif grandchild_link.title contains 'Large' %}
                                {% render 'room-icon', size: 'large' %}
                              {% elsif grandchild_link.title contains 'Extralarge' %}
                                {% render 'room-icon', size: 'extralarge' %}
                              {% endif %}
                            {% endif %}
                            <span>{{ grandchild_link.title }}</span>
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% else %}
                  <div class="mobile-child-nav__item mx-md border-t border-gray">
                    <a href="{{ child_link.url }}" class="mobile-child-nav__link link text-18 w-full block my-md">
                      {{ child_link.title }}
                    </a>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</s-drawer>