{% render 'region-check' %}
{% if is_transactional %}
  {% if product.metafields.seed.product_card_title != blank %}
    {% assign product_title = product.metafields.seed.product_card_title %}
  {% else %}
    {% assign product_title = product.title %}
  {% endif %}
{% else %}
  {% if product.metafields.seed.product_title_international != blank %}
    {% assign product_title = product.metafields.seed.product_title_international %}
  {% else %}
    {% assign product_title = product.title %}
  {% endif %}
{% endif %}

{{ product_title }}