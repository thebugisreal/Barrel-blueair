{% capture margins_paddings %}
    {{ margin_top_mobile }} {{ margin_bottom_mobile }} {{ padding_top_mobile }} {{ padding_bottom_mobile }} {{ margin_top_desktop }} {{ margin_bottom_desktop }} {{ padding_top_desktop }} {{ padding_bottom_desktop }}
{% endcapture %}
<div class="section__product-desc-image mx-md {{ margins_paddings }} tabletl:mx-auto tabletl:max-w-[var(--max-width-desktop)]" style="--max-width-desktop: {{ max_width_desktop }};">
    <div class="section__product-desc-image-content">
        {% if title != blank %}
            <h1 class="{{ title_style }} mb-xxs font-900">{{ title }}</h1>
        {% endif %}
        <div class="section__products flex flex-col gap-xs tabletl:gap-md">
            {% if product != blank %}
                <div class="grid grid-cols-3 gap-xxs pl-md {{ color }} tabletl:pl-lg tabletl:gap-md">
                    <div class="product__description flex flex-col justify-center py-md col-span-2">
                        <h1 class="product__title s1 mb-xxs tabletl:mb-xs"> {{ product.title }}</h1>
                        <p class="product__price s3 mb-sm tabletl:mb-md">{{ product.price |  money }}</p>
                        <a {{ product.url }} class="{{ btn_style }}">
                            <span class="btn__text">{{ btn_text }}</span>
                            <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                        </a>
                    </div>
                    <div class="product__image">
                        {% if image != blank %}
                            {% render 'lazy-image' image:image, image_desktop:image:image_desktop %}
                        {% else %}
                            {% render 'lazy-image' image:product.featured_image %}
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>

    </div>
</div>