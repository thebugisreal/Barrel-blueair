{% assign filter_subscriptions = subscription.filter_subscriptions.value %}
{% if subscription.pdp_type == 'Filter' %}
  {% assign pdp_type = 'filter' %}
{% else %}
  {% assign pdp_type = 'airpurifier_and_filter' %}
{% endif %}

<div class="product__subscription-container">
  <div class="product__subscription border border-blue rounded-[3px] relative mt-sm" data-type="{{ pdp_type }}" data-selected="true" js-subscription>
    <button type="button" class="product-subscription__toggle px-xs py-md desktop:px-md flex items-center gap-sm w-full" js-subscription-toggle>
      <div class="checkbox w-[22px] h-[22px] border border-gray rounded-full p-xxxs pt-[5px] flex justify-center items-center">
        {% render 'icon-check' %}
      </div>
      <div class="s3 font-700 flex-1 text-left">
        {% if pdp_type == 'filter' %}
          Filter Subscription
        {% else %}
          Air Purifier + Filter Subscription
        {% endif %}
      </div>
      {% if pdp_type == 'filter' %}
        <div class="product-subscription__price-wrapper s3 flex justify-end items-center gap-xs" js-subscription-price></div>
      {% else %}
        <div class="product-subscription__price-wrapper s3 flex justify-end items-center gap-xs" js-price js-full-price>
          {% if current_variant.compare_at_price > current_variant.price %}
            <s class="product__price product__price--compare">{{ current_variant.compare_at_price | money }}</s>
            <span class="product__price product__price--current font-700">{{ current_variant.price | money }}</span>
          {% else %}
            <span class="product__price product__price--current font-700">{{ current_variant.price | money }}</span>
          {% endif %}
        </div>
      {% endif %}
    </button>
    <div class="product-subscription__content px-xs desktop:px-md transition-[max-height] duration-500">
      {% if subscription.description_1_bullets != blank %}
        <div class="product-subscription__description-container border-t border-gray py-md flex gap-sm">
          {% for i in (1..2) %}
            {% assign description_title_handle = 'description_' | append: i | append: '_title' %}
            {% assign description_bullets_handle = 'description_' | append: i | append: '_bullets' %}
            {% if subscription[description_bullets_handle] != blank %}
              <div class="product-subscription__description flex-1">
                {% if subscription[description_title_handle] != blank %}
                  <div class="product-subscription-description__title font-500">
                    {{ subscription[description_title_handle] }}
                  </div>
                {% endif %}
                <ul class="product-subscription-description__bullets mt-xxxs">
                  {% for bullet in subscription[description_bullets_handle].value %}
                    <li class="product-subscription-description__bullet flex">{{ bullet }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
      <div class="product-subscription__filter-subscriptions py-md border-t border-gray">
        <input type="hidden" name="" disabled value="" js-filter-subscription-selected-variant-input>
        <input type="hidden" name="" disabled value="" js-filter-subscription-selected-variant-selling-plan-input>
        <div class="pb-sm p2 font-500">
          Customize Your Subscription
        </div>
        <div class="filter-subscriptions">
          <div class="p6 font-700 mb-xxxs">Select Filter</div>
          <div class="filter-subscriptions__filters flex flex-col gap-xxxs desktop:flex-row desktop:flex-wrap desktop:gap-xxs">
            {% assign filter_count = 0 %}
            {% for filter_product in filter_subscriptions %}
              {% assign filter_variant = filter_product.variants[0] %}
              {% if filter_variant.selling_plan_allocations.size > 0 %}
                {% assign filter_count = filter_count | plus: 1 %}
                {% if pdp_type == 'filter' %}
                  {% if filter_product == product %}
                    {% assign current_on_load = true %}
                  {% else %}
                    {% assign current_on_load = false %}
                  {% endif %}
                {% else %}
                  {% if filter_count == 1 %}
                    {% assign current_on_load = true %}
                  {% else %}
                    {% assign current_on_load = false %}
                  {% endif %}
                {% endif %}
                <button type="button" class="filter-subscription__variant p-xxs border border-gray rounded-[2px] flex justify-between items-center gap-sm desktop:block desktop:flex-1" {% if current_on_load %}current-on-load {% endif %} data-selected="false" data-variant="{{ filter_variant.id }}" data-available="{{ filter_variant.available }}" js-fitler-subscription-variant>
                  <div class="p4 font-500">
                    {% if filter_product.metafields.seed.filter_subscription_label != blank %}
                      {{ filter_product.metafields.seed.filter_subscription_label }}
                    {% else %}
                      {{ filter_variant.title }}
                    {% endif %}
                  </div>
                  <div class="flex justify-center gap-xxs p6" js-price-copy>
                    {% if filter_variant.selling_plan_allocations[0].compare_at_price > filter_variant.selling_plan_allocations[0].price %}
                      <s>{{ filter_variant.selling_plan_allocations[0].compare_at_price | money }}</s>
                    {% endif %}
                    <span class="font-700">{{ filter_variant.selling_plan_allocations[0].price | money }}</span>
                  </div>
                </button>
              {% endif %}
            {% endfor %}
          </div>
          {% for filter_product in filter_subscriptions %}
            {% assign filter_variant = filter_product.variants[0] %}
            {% if filter_variant.selling_plan_allocations.size > 0 %}
              <div class="filter-subscription__selling-plans-group hidden" data-variant="{{ filter_variant.id }}" js-filter-subscription-selling-plans-group>
                {% if filter_product.metafields.seed.filter_subscription_description != blank %}
                  <div class="filter-subscription__description p4 mt-xxs">
                    {{ filter_product.metafields.seed.filter_subscription_description }}
                  </div>
                {% endif %}
                <div class="p6 font-700 mt-sm mb-xxxs {% if filter_variant.available == false %}text-gray{% endif %}">Choose Frequency</div>  
                <div class="filter-subscription__selling-plans flex flex-wrap gap-xxs">
                  {% for selling_plan_allocation in filter_variant.selling_plan_allocations %}
                    <button type="button" data-selected="false" data-selling-plan-id="{{ selling_plan_allocation.selling_plan.id }}" data-variant="{{ filter_variant.id }}" {% if filter_variant.available == false %}disabled{% endif %} class="filter-subscription__selling-plan flex-1 rounded-[2px] border border-gray p-xxs p-3 font-500 text-blue" js-filter-subscription-selling-plan>
                      {% if selling_plan_allocation.selling_plan.options[0].value == 'month' %}
                        1 month
                      {% else %}
                        {{ selling_plan_allocation.selling_plan.options[0].value }}
                      {% endif %}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    {% if subscription.tags != blank %}
      <ul class="product-subscription__tags flex gap-xxs absolute left-md top-0 -translate-y-1/2">
        {% for tag in subscription.tags.value %}
          {% capture tag_cycle %}{% cycle 'odd', 'even' %}{% endcapture %}
          <li class="product-subscription__tag rounded-[20px] font-500 p6 py-xxxs px-xs {% if tag_cycle == 'odd' %}bg-blue text-white{% else %}bg-blue-darkSky{% endif %}">{{ tag }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  <button type="button" class="product__non-subscription border border-blue rounded-[3px] mt-sm px-xs py-md desktop:px-md flex items-center gap-sm w-full" data-selected="false" data-available="{{ current_variant.available }}" js-non-subscription-toggle>
    <div class="checkbox w-[22px] h-[22px] border border-gray rounded-full p-xxxs pt-[5px] flex justify-center items-center">
      {% render 'icon-check' %}
    </div>
    <div class="s3 font-700 flex-1 text-left">
      {% if pdp_type == 'filter' %}
        Replacement Filter
      {% else %}
        Air Purifier Only
      {% endif %}
    </div>
    <div class="product__price-wrapper s3 flex justify-end items-center gap-xs" js-price js-full-price js-price-copy>
      {% if current_variant.compare_at_price > current_variant.price %}
        <s class="product__price product__price--compare">{{ current_variant.compare_at_price | money }}</s>
        <span class="product__price product__price--current font-700">{{ current_variant.price | money }}</span>
      {% else %}
        <span class="product__price product__price--current font-700">{{ current_variant.price | money }}</span>
      {% endif %}
    </div>
  </button>
</div>