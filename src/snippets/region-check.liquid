{% comment %}
  Region Check Snippet
  This snippet checks the store URL and defines transactional regions based on country codes.
  Usage: {% include 'region-check' %}
{% endcomment %}

{% liquid
if shop.permanent_domain == '5ef43d-4a.myshopify.com'  
    assign transactional_countries = 'US,CA' | split: ',' 
    assign is_transactional = false 
    assign current_country = localization.country.iso_code | upcase 
    for country in transactional_countries 
        if country == current_country 
          assign is_transactional = true 
          break 
        endif 
      endfor 
elsif shop.permanent_domain == 'blueeudev.myshopify.com' 
    assign transactional_countries = 'DE' | split: ',' 
    assign is_transactional = false 
    assign current_country = localization.country.iso_code | upcase 
    for country in transactional_countries 
        if country == current_country 
          assign is_transactional = true 
          break 
        endif 
      endfor 
elsif shop.permanent_domain == 'uk-blueair.myshopify.com' 
    assign transactional_countries = 'GB' | split: ',' 
    assign is_transactional = false 
    assign current_country = localization.country.iso_code | upcase 
    for country in transactional_countries 
        if country == current_country 
          assign is_transactional = true 
          break 
        endif 
      endfor 
endif  
%}