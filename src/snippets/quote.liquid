{% capture margins_paddings %}
    {{ margin_top_mobile }} {{ margin_bottom_mobile }} {{ padding_top_mobile }} {{ padding_bottom_mobile }} {{ margin_top_desktop }} {{ margin_bottom_desktop }} {{ padding_top_desktop }} {{ padding_bottom_desktop }}
{% endcapture %}

<div class="section__quote mx-30 tabletl:mx-auto {{ margins_paddings }}" style="--max-width-desktop: {{ max_width_desktop }};">
    <div class="section__quote-content">
        <div class="flex flex-col tabletl:flex-row tabletl:gap-24">
            <div class="quote-container text-[#00B5E2] w-[30px] tabletl:w-[45px]">
                {%  render 'icon-quote' %}
            </div>
            <div class="text-container flex-1">
                {% if title != blank %}
                    <h1 class="{{ title_style }} font-500">{{ title }}</h1>
                {% endif %}
                {% if author != blank %}
                    <p class="s2 my-24 font-900"> {{ author }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>