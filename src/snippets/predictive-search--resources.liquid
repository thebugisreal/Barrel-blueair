{%- comment -%}
 * Snippet: predictive-search--resources.liquid
 * --------------------------------------------
 * Used to display predictive search resources, such as products, collections and articles.
 * @param title - required
 * @param resources - required
{%- endcomment -%}

{% assign results_count = 0 %}
{%- if resources.size > 0 -%}
  <ul id="predictive-search-results-list" class="predictive-search__results-list" role="listbox" aria-labelledby="predictive-search-products">
  {%- for resource in resources -%}
    {% if type == 'product' %}
      <li class="predictive-search__list-item mb-xs" role="option">
        <a href="{{ resource.url }}" class="predictive-search__item flex items-center gap-sm" tabindex="-1">
          <div class="predictive-search__item-image w-[65px] h-[65px]">
            {% if resource.featured_image != blank %}            
              {% render 'lazy-image', image: resource.featured_image, picture_classes: 'h-full', img_classes: 'h-full object-cover' %}
            {% endif %}
          </div>
          <div class="predictive-search__item-content flex-1">
            <div class="predictive-search__item-heading p1 font-500">{{ resource.title }}</div>
          </div>
        </a>
      </li>
      {% assign results_count = results_count | plus: 1 %}
    {% elsif type == 'article' %}
      {% unless resource.tags contains 'support' %}
        <li class="predictive-search__list-item mb-xs" role="option">
          <a href="{{ resource.url }}" class="predictive-search__item flex items-center gap-sm" tabindex="-1">
            <div class="predictive-search__item-image w-[65px] h-[65px]">
              {% if resource.image != blank %}
                {% render 'lazy-image', image: resource.image, picture_classes: 'h-full', img_classes: 'h-full object-cover' %}
              {% endif %}
            </div>
            <div class="predictive-search__item-content flex-1">
              <div class="predictive-search__item-heading p1 font-500">{{ resource.title }}</div>
              <div class="predictive-search__item-updated-date p6 mt-xxxs">Updated {{ resource.updated_at | date: "%b %d, %Y" }}</div>
            </div>
          </a>
        </li>
        {% assign results_count = results_count | plus: 1 %}
      {% endunless %}
    {% elsif type == 'support' %}
      {% if resource.tags contains 'support' %}
        <li class="predictive-search__list-item pb-md mb-md border-b border-gray-athans" role="option">
          <a href="{{ resource.url }}" class="predictive-search__item flex items-start gap-sm" tabindex="-1">
            <div class="predictive-search__item-image w-[32px]">
              {% render 'icon-article' %}
            </div>
            <div class="predictive-search__item-content flex-1">
              <div class="predictive-search__item-heading p1 font-500">{{ resource.title }}</div>
              <div class="predictive-search__item-excerpt p6 mt-xxxs">
                <span class="desktop:hidden">
                  {{ resource.content | strip_html | truncate: 100 }}
                </span>
                <span class="hidden desktop:inline">
                  {{ resource.content | strip_html | truncate: 200 }}
                </span>
              </div>
            </div>
          </a>
        </li>
        {% assign results_count = results_count | plus: 1 %}
      {% endif %}
    {% endif %}
  {%- endfor -%}
  </ul>
{%- endif -%}

{% if results_count == 0 %}
  <div class="predictive-search__no-results pt-xs pb-lg">
    <div class="h5 font-700">No Results for "{{ predictive_search.terms }}"</div>
    <div class="s3 mt-xxs">Try again using a different spelling or keywords.</div>
  </div>
  {% if popular_searches_linklist != blank %}
    <div class="predictive-search__popular-searches py-md border-t border-gray-athans">
      {% render 'predictive-search--popular-searches' popular_searches_linklist: popular_searches_linklist %}
    </div>
  {% endif %}
{% endif %}