{%- liquid 
  assign current_variant = product.selected_or_first_available_variant
  if product.variants[1].title contains 'subscription' or product.variants[1].title contains 'Subscription'
    assign current_variant = product.variants[0]
  endif
  assign atc_disabled = false
  assign atc_text = ''
  assign options_select_required = false
  if product.available
    if current_variant
      if current_variant.available 
        assign atc_text = 'products.product.add_to_cart' | t
      else 
        assign atc_disabled = true
        assign atc_text = 'products.product.sold_out' | t
      endif
    else 
      assign options_select_required = true
    endif
  else
    assign atc_disabled = true
    assign atc_text = 'products.product.sold_out' | t
  endif
-%}

<div class="product__sticky-bar hidden fixed top-[var(--header-height)] left-0 w-full z-[2] px-md py-xxs gap-md bg-white flex items-center justify-between tabletl:items-center desktop:px-xl" js-product-sticky-bar>
    <div class="flex flex-col flex-1">
        <div class="product-sticky-bar__title s1 text-16">
          {% if product.metafields.seed.product_card_title != blank %}
            {{ product.metafields.seed.product_card_title  }}
          {% else %}
            {{ product.title }}
          {% endif %}
        </div>
        <p class="p1 text-14 tabletl:hidden" js-sticky-price>{{ current_variant.price | money }}</p>
    </div>

    <div class="product-sticky-bar__atc-wrapper relative flex gap-md items-center">
        <p class="s1 hidden tabletl:block" js-sticky-price>{{ current_variant.price | money }}</p>
        <button class="product__atc btn btn--blue-rounded pr-sm" {% if atc_disabled %} disabled {% endif %} type="button" js-sticky-atc>
            <span class="product-sticky-bar__atc btn__text text-14" js-atc-text>{{ atc_text }}</span>
        </button>
        <loading-spinner js-sticky-loader style="--width: 24px; --height: 24px; --background: #F5F5F580; --color: #002955;"></loading-spinner>
    </div>  
</div>