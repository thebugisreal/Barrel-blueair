{%- liquid 
  assign current_variant = product.selected_or_first_available_variant
  assign atc_disabled = false
  assign atc_text = ''
  assign options_select_required = false
  if product.available
    if current_variant
      if current_variant.available 
        assign atc_text = 'Add To Cart '
      else 
        assign atc_disabled = true
        assign atc_text = 'Out Of Stock'
      endif
    else 
      assign options_select_required = true
    endif
  else
    assign atc_disabled = true
    assign atc_text = 'Out Of Stock'
  endif
-%}

<div class="product__sticky-bar hidden sticky top-[var(--header-height)] left-0 w-full z-[2] px-md py-sm gap-md bg-white flex items-center justify-between tabletl:items-center desktop:px-xl" js-product-sticky-bar>
    <div class="flex flex-col flex-1">
        <div class="product-sticky-bar__title s1">
            {{ product.title }}
        </div>
        <p class="p1 tabletl:hidden">{{ current_variant.price |  money }}</p>
    </div>

    <div class="product-sticky-bar__atc-wrapper relative flex gap-md items-center">
        <p class="s1 hidden tabletl:block" js-sticky-price>{{ current_variant.price |  money }}</p>
        <button class="product__atc btn btn--blue-rounded" {% if atc_disabled %} disabled {% endif %} type="button" js-sticky-atc>
            <span class="product-sticky-bar__atc btn__text" js-atc-text>{{ atc_text }}</span>
            <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
        </button>
        <loading-spinner js-sticky-loader style="--width: 24px; --height: 24px; --background: #F5F5F580; --color: #002955;"></loading-spinner>
    </div>  
</div>