<compare-banner class="compare-banner fixed bottom-0 right-0 left-0 bg-white z-[2] w-full px-md pt-md tabletl:px-xl">
    <s-accordion data-manual-collapse="false" js-accordion>
        <div class="accordion-item" js-accordion-item>
            <button class="accordion-header s1 pb-md w-full flex justify-between items-center gap-xs" aria-expanded="true" aria-controls="compareBannerContent" js-accordion-header>
                <div>
                    Compare up to <span class="tabletl:hidden">2</span> <span class="hidden tabletl:inline">3</span> models <span class="compare-products-selected font-900">(${porductsSelected})</span>
                </div>
                <div class="icon-container h-[33px] w-[33px] p-xxs">
                    {%  render 'icon-plus' %}
                    {%  render 'icon-minus' %}
                </div>
            </button>
            <div id="compareBannerContent" class="accordion-content" aria-hidden="false" js-accordion-content>
                <div class="pb-md flex justify-between gap-sm items-center">
                    <ul class="compare-banner__products flex gap-md items-center tabletl:gap-lg">
                        <li 
                            class="compare-banner__product flex justify-center items-center gap-xs border-r border-gray pr-md tabletl:pr-lg"
                            v-for="(product,index) in products"
                        >
                            <img 
                                class="h-[70px]"
                                :src="product.featured_image"
                                loading="lazy"
                                :alt="product.featured_image.alt"
                            />
                            <p class="p1">${ product.title }</p>
                            <button class="compare__product-remove border rounded-full flex p-[2px]"
                                :data-product-id="product.id"
                                @click="onRemove">
                                {%  render 'icon-plus' %}
                            </button>
                        </li>
                        <li v-if="porductsSelected < 3" class="compare-banner__product-more">
                            <p>Compare 1 more</p>
                        </li>
                    </ul>
                    <div v-if="porductsSelected > 1">
                        <a href="https://blueairdev.myshopify.com/pages/data-rights-request-form?view=product-compare" class="compare__btn btn btn--blue-rounded">
                            <span class="btn__text">Compare</span>
                            <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                        </a>
                    </div>
                    <div v-else>
                        <a href="https://blueairdev.myshopify.com/pages/data-rights-request-form?view=product-compare" class="compare__btn btn btn--blue-rounded disabled">
                            <span class="btn__text">Compare</span>
                            <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </s-accordion>
</compare-banner>