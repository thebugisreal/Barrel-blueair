{% liquid
    assign current_variant = product.selected_or_first_available_variant

%}

<div class="product-card__description p-md bg-white">
    <div class="product-card__tags min-h-[28px] mb-xxs flex justify-center gap-x-xs gap-y-xxs flex-wrap">
      <span class="product-card__tag product-card__tag--gray bg-gray {% if current_variant.available %}hidden{% endif %} text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]" >Out of Stock</span>
      {% for tag in product.metafields.seed.product_tags.value %}
        <span class="product-card__tag product.metafields.seed.product_card_tag_style-{{ product.metafields.seed.product_card_tag_style  }} {% if product.metafields.seed.product_card_tag_style == 'White fill' %}product-card__tag--white{% else %}product-card__tag--blue{% endif %} text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]">{{ tag }}</span>
      {% endfor %}
    </div>

    <a href="{{ product.url }}" class="product-card__title s1 block text-center !no-underline mb-md">
        {% if localization.country.iso_code == 'US' %}
            {% if product.metafields.seed.product_card_title != blank %}
                {% assign product_title = product.metafields.seed.product_card_title %}
              {% else %}
                {% assign product_title = product.title %}
              {% endif %}
          {% else %}
            {% if localization.country.iso_code == 'MY' %}
                {% if product.metafields.seed.product_title_my != blank %}
                    {% assign product_title = product.metafields.seed.product_title_my %}
                {% else %}
                    {% assign product_title = product.title %}
                {% endif %}
            {% elsif localization.country.iso_code == 'NP' %}
                {% if product.metafields.seed.product_title_my != blank %}
                    {% assign product_title = product.metafields.seed.product_title_np %}
