<ul class="product__spec-container">
    {% if product.metafields.seed.blair_filterSpecification_filterType != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Filter Type</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_filterSpecification_filterType}}</p>
        </li>
    {% endif %}
    {% if localization.country.iso_code == 'US' or localization.country.iso_code == 'CA' %}
      {% if product.metafields.seed.blair_dimensions != blank %}
          <li class="flex gap-md">
              <p class="p3 w-1/2">Dimensions(HxWxD)</p>
              <p class="p4 w-1/2">{{ product.metafields.seed.blair_dimensions}}</p>
          </li>
      {% endif %}
    {% else %}
      {% if product.metafields.seed.dimensions_hxwxd_international != blank %}
          <li class="flex gap-md">
              <p class="p3 w-1/2">Dimensions(HxWxD)</p>
              <p class="p4 w-1/2">{{ product.metafields.seed.dimensions_hxwxd_international}}</p>
          </li>
      {% else %}
        {% if product.metafields.seed.blair_dimensions != blank %}
            <li class="flex gap-md">
                <p class="p3 w-1/2">Dimensions(HxWxD)</p>
                <p class="p4 w-1/2">{{ product.metafields.seed.blair_dimensions}}</p>
            </li>
        {% endif %}
      {% endif %}
    {% endif %}
    {% if product.metafields.seed.blair_productSpecification_weight != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Product Weight</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_weight}} {{ product.metafields.seed.blair_productSpecification_weight_measurement}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_productSpecification_tankcapacity != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Tank Capacity</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_tankcapacity}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_energyConsumption != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Energy Consumption</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_energyConsumption}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.max_wattage_heat != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Max Wattage (Heat)</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.max_wattage_heat}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_productSpecification_soundlevel != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Sound level</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_soundlevel}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_airOutlet != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Air outlet</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_airOutlet}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_recommendedRoomSize != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Recommended room size</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_recommendedRoomSize}} {{ product.metafields.seed.blair_recommendedRoomSize_measurement }}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_productSpecification_airchanges != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Air changes per hour (ACH)</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_airchanges}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_productSpecification_run_time != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Humidification run time</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_run_time}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_CADR_pollen != blank or product.metafields.seed.blair_CADR_dust != blank or product.metafields.seed.blair_CADR_smoke != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Clean air delivery rate (CADR)</p>
            <p class="p4 w-1/2">
                {% if product.metafields.seed.blair_CADR_pollen != blank %}
                    Pollen {{ product.metafields.seed.blair_CADR_pollen}} <br>
                {% endif %}
                {% if product.metafields.seed.blair_CADR_dust != blank %}
                    Dust {{ product.metafields.seed.blair_CADR_dust}} <br>
                {% endif %}
                {% if product.metafields.seed.blair_CADR_smoke != blank %}
                    Smoke {{ product.metafields.seed.blair_CADR_smoke}} <br>
                {% endif %}
            </p>
        </li>
    {% endif %}
    {% if product.metafields.seed.operating_power != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Operating Power</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.operating_power}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.filter_frame_material != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Filter Frame Material</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.filter_frame_material}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.filter_recycling != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Filter Recycling</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.filter_recycling}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_filterSpecification_lifetime != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Recommended filter change</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_filterSpecification_lifetime}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_filterSpecification_filterNumber != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Number of filters</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_filterSpecification_filterNumber}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_repIndicator != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Filter replacement indicator</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_repIndicator}}</p>
        </li>
    {% endif %}
    {% if product.metafields.seed.blair_productSpecification_fanspeed != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">Speed control options</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_fanspeed}}</p>
        </li>
    {% endif %}
</ul>