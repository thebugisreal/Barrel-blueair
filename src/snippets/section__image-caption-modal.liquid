{% comment %}  
Params:

product: Product Object
{% endcomment %}

<image-caption-modal class="bg-white py-8 px-12 block">
    <header class="flex justify-end">
        <button class="modal-open btn transition-all duriation-1000" js-modal-open>
            <p class="btn__text p2">View Product </p>
            <div class="btn__arrow">{%  render 'icon-arrows-diag' %}</div>
        </button>
        <button class="close-icon btn w-[46px] h-[46px] hidden ml-auto" js-modal-close>
            <div class="btn__arrow border-0">{% render 'icon-close-no-border' %}</div>
        </button>
    </header>

    <div class="modal-body flex flex-col fadeOut" js-modal-body>
        <div class="flex gap-24 tabletl:gap-0 tabletl:h-auto tabletl:flex-col">
            <div class="product-body px-24 tabletl:text-center">
                <h4 class="h4">{{ product.title }}</h4>
                <p class="p1 my-12 font-400">{{ product.price | money}}</p>
                <a href="{{ product.url }}" class="btn w-fit mb-16 tabletl:mx-auto">
                    <p class="btn__text p2">Shop Now </p>
                    <div class="btn__arrow">{%  render 'icon-arrow-right' %}</div>
                </a>
            </div>
     
            {% if product.featured_image != blank %}
                <div class="w-1/3 tabletl:w-auto tabletl:max-w-[250px] tabletl:mx-auto">
                    {% if product_image_override != blank %}
                        {% render 'lazy-image' image:product_image_override  picture_classes:'h-fit', img_classes:'h-fit object-contain'%}
                    {% else %}
                        {% render 'lazy-image' image:product.featured_image  picture_classes:'h-fit', img_classes:'h-fit object-contain'%}
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</image-caption-modal>

