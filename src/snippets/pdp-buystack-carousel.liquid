{% comment %}
  PDP Buystack Carousel

  Renders a carousel of media (images/videos) with descriptions from product metafield

  @param {object} product - Product object
  @param {string} section_id - Unique section ID for carousel controls
  @param {string} carousel_classes - Additional CSS classes for carousel container
  @param {string} slide_classes - Additional CSS classes for slides
  @param {string} title - Optional title to display above carousel
{% endcomment %}

{% liquid
  assign carousel_items = product.metafields.seed.pdp_buystack_carousel.value
  assign carousel_id = 'pdp-buystack-carousel-' | append: section_id
%}

{% if carousel_items != blank %}
  <div class="pdp-buystack-carousel__header flex justify-between items-center mb-md tabletp:mb-[54px]">
    {% if title != blank %}
      <h2 class="pdp-buystack-carousel__title text-18 font-700 m-0 leading-tight tabletp:text-22">{{ title }}</h2>
    {% else %}
      <div></div>
    {% endif %}

    {% comment %} Desktop navigation arrows {% endcomment %}
    <div class="pdp-buystack-carousel__nav hidden tabletp:flex gap-xs">
      <button
        class="swiper-button-prev swiper-button-prev--{{ carousel_id }} w-[20px] h-[20px] rounded-full items-center justify-center text-blue hover:bg-gray-light transition-colors !block !static"
        style="--swiper-navigation-size: 20px;"
        type="button"
      ></button>
      <button
        class="swiper-button-next swiper-button-next--{{ carousel_id }} w-[20px] h-[20px] rounded-full items-center justify-center text-blue hover:bg-gray-light transition-colors !block !static"
        style="--swiper-navigation-size: 20px;"
        type="button"
      ></button>
    </div>
  </div>

  {%- capture carousel_options -%}
    {
      "slidesPerView": 2.5,
      "spaceBetween": 8,
      "loop": false,
      "autoHeight": true,
      "centeredSlides": false,
      "freeMode": false,
      "watchOverflow": true,
      "navigation": {
        "enabled": true,
        "nextEl": ".swiper-button-next--{{ carousel_id }}",
        "prevEl": ".swiper-button-prev--{{ carousel_id }}"
      },
      "breakpoints": {
        "1024": {
          "slidesPerView": 4,
          "spaceBetween": 8
        }
      }
    }
  {%- endcapture -%}

  <div class="pdp-buystack-carousel {{ carousel_classes }} tabletp:w-full tabletp:max-w-full">
    <s-carousel data-options="{{ carousel_options | escape }}" class="block">
      <div id="{{ carousel_id }}" class="swiper w-full overflow-hidden" js-carousel>
        <div class="swiper-wrapper w-full tabletp:w-auto">
          {% for item in carousel_items %}
            <div class="swiper-slide {{ slide_classes }}" js-carousel-slide>
              <div
                class="pdp-buystack-carousel__slide relative h-full cursor-pointer"
                js-buystack-slide
                data-slide-index="{{ forloop.index0 }}"
              >
                {% if item.media != blank %}
                  <div class="pdp-buystack-carousel__media relative">
                    {% case item.media.value.media_type %}
                      {% when 'image' %}
                        {% render 'lazy-image',
                          image: item.media.value,
                          loading: 'lazy',
                          picture_classes: 'w-full aspect-[9/16]',
                          img_classes: 'w-full h-full object-cover rounded-lg'
                        %}
                      {% when 'video' %}
                        <div class="video-container aspect-[9/16] rounded-lg overflow-hidden">
                          <video
                            class="w-full h-full object-cover"
                            no-controls
                            muted
                            playsinline
                            preload="metadata"
                            {% if forloop.first %}
                              autoplay
                            {% endif %}
                            poster="{% if item.media.value.preview_image %}{{ item.media.value.preview_image | image_url: width: 800 }}{% endif %}"
                            data-video-index="{{ forloop.index0 }}"
                          >
                            {% for source in item.media.value.sources %}
                              <source src="{{ source.url }}" type="{{ source.mime_type }}">
                            {% endfor %}
                            Your browser does not support the video tag.
                          </video>
                        </div>
                      {% else %}
                        {% comment %} Fallback for other media types {% endcomment %}
                        {% if item.media.value.preview_image %}
                          {% render 'lazy-image',
                            image: item.media.value.preview_image,
                            loading: 'lazy',
                            picture_classes: 'w-full aspect-[9/16]',
                            img_classes: 'w-full h-full object-cover rounded-lg'
                          %}
                        {% endif %}
                    {% endcase %}

                    {% if item.description != blank %}
                      <div class="pdp-buystack-carousel__description absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-xxxs rounded-b-lg">
                        <div class="rte text-14 text-white">
                          {{ item.description | metafield_tag }}
                        </div>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </s-carousel>
  </div>

  {% comment %} Buystack Modal {% endcomment %}
  <buystack-modal
    id="buystack-modal-{{ section_id }}"
    class="hidden fixed inset-0 z-50 opacity-0 transition-all duration-300 ease-in-out"
    open="[js-buystack-modal-open]"
    close="[js-buystack-modal-close]"
    data-carousel-id="{{ carousel_id }}"
  >
    <div class="buystack-modal__container absolute bg-black overflow-hidden transition-all duration-300 ease-out inset-0 rounded-none tabletp:bottom-8 tabletp:right-8 tabletp:top-auto tabletp:left-auto tabletp:rounded-3xl tabletp:shadow-2xl">
      <button
        class="buystack-modal__close absolute top-16 left-16 z-10 w-32 h-32 flex items-center justify-center bg-black bg-opacity-50 rounded-full text-white transition-all duration-200 hover:bg-opacity-70"
        js-buystack-modal-close
        aria-label="Close modal"
      >
        {% render 'icon-close' %}
      </button>

      <div class="buystack-modal__carousel-container relative w-full h-full">
        {%- capture modal_carousel_options -%}
          {
            "direction": "vertical",
            "slidesPerView": 1,
            "spaceBetween": 0,
            "loop": true,
            "grabCursor": true,
            "keyboard": {
              "enabled": true,
              "onlyInViewport": true
            },
            "mousewheel": {
              "enabled": true,
              "forceToAxis": true
            },
            "navigation": {
              "enabled": true,
              "nextEl": ".buystack-modal__nav--down",
              "prevEl": ".buystack-modal__nav--up"
            }
          }
        {%- endcapture -%}

        <s-carousel data-options="{{ modal_carousel_options | escape }}" class="buystack-modal__carousel w-full h-full">
          <div
            id="buystack-modal-carousel-{{ section_id }}"
            class="swiper w-full h-full"
            js-buystack-carousel
            js-carousel
          >
            <div class="swiper-wrapper w-full h-full">
              {% for item in carousel_items %}
                <div
                  class="swiper-slide buystack-modal__slide relative w-full h-full flex items-center justify-center"
                  data-slide-index="{{ forloop.index0 }}"
                >
                  <div class="buystack-modal__media-container relative w-full h-full">
                    {% if item.media != blank %}
                      {% case item.media.value.media_type %}
                        {% when 'video' %}
                          <div class="buystack-modal__video-container relative w-full h-full">
                            <video
                              class="buystack-modal__video w-full h-full object-cover"
                              muted
                              playsinline
                              preload="metadata"
                              autoplay
                              no-controls
                              poster="{% if item.media.value.preview_image %}{{ item.media.value.preview_image | image_url: width: 800 }}{% endif %}"
                            >
                              {% for source in item.media.value.sources %}
                                <source src="{{ source.url }}" type="{{ source.mime_type }}">
                              {% endfor %}
                              Your browser does not support the video tag.
                            </video>
                          </div>
                        {% when 'image' %}
                          <div class="buystack-modal__image-container relative w-full h-full">
                            {% render 'lazy-image',
                              image: item.media.value,
                              loading: 'lazy',
                              picture_classes: 'buystack-modal__image-wrapper w-full h-full',
                              img_classes: 'buystack-modal__image w-full h-full object-cover'
                            %}
                          </div>
                        {% else %}
                          {% if item.media.value.preview_image %}
                            <div class="buystack-modal__image-container relative w-full h-full">
                              {% render 'lazy-image',
                                image: item.media.value.preview_image,
                                loading: 'lazy',
                                picture_classes: 'buystack-modal__image-wrapper w-full h-full',
                                img_classes: 'buystack-modal__image w-full h-full object-cover'
                              %}
                            </div>
                          {% endif %}
                      {% endcase %}

                      {% if item.description != blank %}
                        <div class="buystack-modal__description absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black to-transparent p-sm text-sm leading-relaxed">
                          <div class="rte text-white">
                            {{ item.description | metafield_tag }}
                          </div>
                        </div>
                      {% endif %}
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>

            <!-- Navigation arrows -->
            <button
              class="buystack-modal__nav swiper-button-prev buystack-modal__nav--up absolute !left-auto !right-16 !w-32 !h-32 !rotate-90 flex items-center justify-center bg-black bg-opacity-50 rounded-full text-white transition-all duration-200 hover:bg-opacity-70 z-10 border-0 cursor-pointer focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-50"
              type="button"
              aria-label="Previous video"
              style="--swiper-navigation-size: 12px;"
            ></button>

            <button
              class="buystack-modal__nav swiper-button-next buystack-modal__nav--down absolute !left-auto !right-16 !w-32 !h-32 !rotate-90 flex items-center justify-center bg-black bg-opacity-50 rounded-full text-white transition-all duration-200 hover:bg-opacity-70 z-10 border-0 cursor-pointer focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-50"
              type="button"
              aria-label="Next video"
              style="--swiper-navigation-size: 12px;"
            ></button>
          </div>
        </s-carousel>
      </div>
    </div>
  </buystack-modal>
{% endif %}
