{% assign cart_variants = '' %}
{% for item in cart.items %}
  {% assign cart_variants = cart_variants | append: item.variant_id | append: ',' %}
{% endfor %}

<cart-drawer>
  <div id="cart" class="cart-drawer flex flex-col h-full" js-cart-drawer-contents>
    <h3 class="text-center mb-md px-md">Your Cart</h3>
    {% if cart == empty %}
      <p class="p4 text-center" js-empty-cart>
        Your cart is empty, <a href="/collections/all" js-cart-continue-link>continue shopping</a>.
      </p>
    {% endif %}

    {% comment %} Shipping Threshold {% endcomment %}
    {% if cart != empty and settings.shipping_threshold_enabled %}
      {% render 'cart--shipping-threshold' %}
    {% endif %}
    {% comment %} END Shipping Threshold {% endcomment %}

    <cart-drawer-items class="overflow-auto flex-1 px-md" data-gwp-threshold="{{ settings.gwp_threshold }}">
      <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart-drawer__form" method="post">
        <div id="CartDrawer-CartItems" class="drawer__contents">
          {%- if cart != empty -%}
            <p class="s1 mb-sm">Your Items</p>

            {% comment %} Cart Items  {% endcomment %}
            <div class="drawer__cart-items-wrapper flex flex-col gap-md mb-md">
              {%- for item in cart.items -%}
              <div id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="relative" js-cart-item>
                <loading-spinner style="--size: 3rem; --bg-opacity: 100%;"></loading-spinner>
                <div class="flex gap-md">
                  <a href="{{item.url}}" class="block w-1/2" js-cart-item-image>
                    <img class="cart-item__image" src="{{ item.image | image_url: width: 300 }}" alt="{{ item.image.alt | escape }}" loading="lazy">
                  </a>
                  <div class="item-text-container w-1/2">
                    <a href="{{item.url}}" class="p1 mb-xxxs">{{item.product.title}}</a>
                    {%- if item.product.has_only_default_variant == false -%}
                      {%- for option in item.options_with_values -%}
                        {% unless option.name == "Default Title" %}
                          <p class="my-4">{{ option.name }}: {{ option.value -}}</p>
                        {% endunless %}
                      {%- endfor -%}
                    {%- endif -%}
                    <div class="p1 hidden">
                      {% if item.original_price != item.final_price %}
                        <s>{{ item.original_price | money }}</s>
                        <span>{{ item.final_price | money }}</span>
                      {% else %}
                        <span>{{ item.original_price | money }}</span>
                      {% endif %}
                    </div>
                    {%- for property in item.properties -%}
                      {%- assign property_first_char = property.first | slice: 0 -%}
                      {%- if property.last != blank and property_first_char != '_' -%}
                        <p class="my-xxxs">{{ property.first }}: {{ property.last }}</p>
                      {%- endif -%}
                    {%- endfor -%}
                    {% if item.discounts != empty %}
                      <ul class="my-xxxs">
                        {%- for discount in item.discounts -%}
                          <li>{{ discount.title }}</li>
                        {%- endfor -%}
                      </ul>
                    {% endif %}
                    {%- if item.original_line_price != item.final_line_price -%}
                      <div class="cart-item__discounted-prices p1">
                        <span class="visually-hidden">
                          {{ 'products.product.price.regular_price' | t }}
                        </span>
                        <s class="cart-item__old-price price price--end">
                          {{ item.original_line_price | money }}
                        </s>
                        <span class="visually-hidden">
                          {{ 'products.product.price.sale_price' | t }}
                        </span>
                        <span class="price price--end">
                          {{ item.final_line_price | money }}
                        </span>
                      </div>
                    {%- else -%}
                      <span class="price price--end p1">
                        {{ item.original_line_price | money }}
                      </span>
                    {%- endif -%}

                    {% assign disable_quantity_selector = false %}
                    {% if item.product.metafields.seed.two_pack_filter_subscription_disable_quantity_selector_in_cart == true and item.selling_plan_allocation != blank and item.quantity > 1 %}
                      {% assign disable_quantity_selector = true %}
                    {% endif %}
                    <div class="cart-item__quantity-wrapper mt-xxs">
                      <quantity-input class="quantity cart-quantity p3 flex justify-center border border-blue p-xxs gap-md rounded-[2px]">
                        <button class="quantity__button no-js-hidden disabled:opacity-20 disabled:cursor-not-allowed" name="minus" type="button" {% if disable_quantity_selector %}disabled{% endif %}>
                          <span class="visually-hidden">
                            {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                          </span>
                          <div class="w-[16px]">{%  render 'icon-minus' %}</div>
                        </button>
                        <input
                          class="quantity__input flex-1 max-w-[16px] text-center"
                          type="number"
                          data-quantity-variant-id="{{ item.variant.id }}"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          {% # theme-check-disable %}
                          data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                          min="0"
                          {% if item.variant.quantity_rule.max != null %}
                            max="{{ item.variant.quantity_rule.max }}"
                          {% endif %}
                          step="{{ item.variant.quantity_rule.increment }}"
                          {% # theme-check-enable %}
                          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                          id="Drawer-quantity-{{ item.index | plus: 1 }}"
                          data-index="{{ item.index | plus: 1 }}"
                          {% if disable_quantity_selector %}readonly disabled{% endif %}
                        >
                        <button class="quantity__button no-js-hidden disabled:opacity-20 disabled:cursor-not-allowed" name="plus" type="button" {% if disable_quantity_selector %}disabled{% endif %}>
                          <span class="visually-hidden">
                            {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                          </span>
                          <div class="w-[16px]">{%  render 'icon-plus' %}</div>
                        </button>
                      </quantity-input>
    
                      <cart-remove-button
                        class="block mt-xxs"
                        id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                        data-index="{{ item.index | plus: 1 }}"
                      >
                        <button
                          type="button"
                          class="button button--tertiary cart-remove-button underline"
                          aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
                        >
                          Remove item
                        </button>
                      </cart-remove-button>
                      
    
                      <div id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}" class="cart-item__error" role="alert">
                      </div>
                    </div>
                  </div>
                </div>

                {% if item.product.metafields.seed.subscription != blank %}
                  {% liquid 
                    assign subscription_object = item.product.metafields.seed.subscription.value
                    assign is_subscribed = false
                    assign subscription_available = false
                    if item.selling_plan_allocation != blank
                      assign is_subscribed = true
                    else
                      if subscription_object.pdp_type == 'Air Purifier + Filter' and item.properties['subscriptionTempId'] != blank
                        for cart_item in cart.items
                          if cart_item.selling_plan_allocation != blank and item.properties['subscriptionTempId'] == cart_item.properties['subscriptionTempId'] and item != cart_item
                            assign is_subscribed = true
                            break
                          endif
                        endfor
                      endif
                      if is_subscribed == false
                        if subscription_object.pdp_type == 'Filter'
                          if item.variant.available and item.variant.selling_plan_allocations.size > 0
                            assign subscription_available = true
                            assign preselected_subscription = item.variant
                          endif
                        else
                          assign filter_subscriptions = subscription_object.filter_subscriptions.value
                          for filter_product in filter_subscriptions
                            assign filter_variant = filter_product.variants[0]
                            if filter_variant.available and filter_variant.selling_plan_allocations.size > 0
                              assign subscription_available = true
                              assign preselected_subscription = filter_variant
                              break
                            endif
                          endfor
                        endif
                      endif
                    endif
                  %}
                  {%- capture item_properties -%}
                    {
                    {% for property in item.properties %}
                      "{{ property.first }}": "{{ property.last }}"{% unless forloop.last %},{% endunless %}
                    {% endfor %}
                    }
                  {%- endcapture -%}
                  {% if subscription_object.pdp_type == 'Filter' and is_subscribed %}
                    <cart-subscription class="cart-item__subscription block border border-gray p-sm mt-sm" data-item-key="{{ item.key }}" data-item-quantity="{{ item.quantity }}" data-properties='{{ item_properties }}'>
                      <div class="flex justify-start items-start gap-xs">
                        <button type="button" class="cart-item-subscription__checkbox mt-xxxs" data-checked="true" js-cart-subscription-checkbox></button>
                        <div class="p3 flex-1">{{ item.title }} Subscription</div>
                      </div>
                      <p class="mt-xxxs">
                        {{ item.selling_plan_allocation.selling_plan.name }}&nbsp;
                        <a href="{{ item.url }}" class="link link--underline underline-offset-2" js-cart-subscription-edit>Edit</a>
                      </p>
                      <p class="text-12 mt-xxxs hidden" js-cart-subscription-error></p>
                    </cart-subscription>
                  {% elsif subscription_available %}
                    {% if preselected_subscription.product.metafields.seed.quantity_option.value contains '2 Pack | 2' %}
                      {% assign preselected_subscription_quantity = 2 %}
                    {% else %}
                      {% if subscription_object.pdp_type == 'Filter' %}
                        {% assign preselected_subscription_quantity = item.quantity %}
                      {% else %}
                        {% assign preselected_subscription_quantity = 1 %}
                      {% endif %}
                    {% endif %}
                    <cart-subscription class="cart-item__subscription block border border-gray p-sm mt-sm" data-type="{{ subscription_object.pdp_type | handle }}" data-item-key="{{ item.key }}" data-properties='{{ item_properties }}' data-preselected-subscription="{{ preselected_subscription.id }}:{{ preselected_subscription.selling_plan_allocations[0].selling_plan.id }}:{{ preselected_subscription_quantity }}">
                      <div class="flex justify-start items-center gap-xs">
                        <button type="button" class="cart-item-subscription__checkbox" data-checked="false" js-cart-subscription-checkbox></button>
                        <div class="p3 flex-1">Add a Filter Subscription</div>
                      </div>
                      <div class="border-t border-t-gray mt-sm pt-sm flex items-center gap-xxs">
                        <div class="flex-1">Pay when it's sent</div>
                        <div>
                          {% if preselected_subscription.selling_plan_allocations[0].compare_at_price > preselected_subscription.selling_plan_allocations[0].price %}
                            <s>{{ preselected_subscription.selling_plan_allocations[0].compare_at_price | money }}</s><br>
                          {% endif %}
                          <span class="font-700">{{ preselected_subscription.selling_plan_allocations[0].price | money }}</span>
                        </div>
                        <div class="py-xxs px-xs rounded-[24px] bg-blue text-white text-12 font-700">
                          Save 15%
                        </div>
                      </div>
                      <p class="text-12 mt-xxxs hidden" js-cart-subscription-error></p>
                    </cart-subscription>
                  {% endif %}
                {% endif %}
              </div>
              {%- endfor -%}
            </div>
            {% comment %} END Cart Items  {% endcomment %}

            {% comment %} Upsell Products {% endcomment %}
            {% if settings.upsell_1 != blank or settings.upsell_2 != blank %}
              {% assign upsell_1_variant = settings.upsell_1.variants[0] %}
              {% assign upsell_2_variant = settings.upsell_2.variants[0] %}

              {% unless cart_variants contains upsell_1_variant.id and cart_variants contains upsell_2_variant.id %}   
                {%- capture upsell_carousel_options -%}
                  {
                    "slidesPerView": 1,
                    "pagination": {
                      "el": ".swiper-upsell-pagination",
                      "type": "fraction"
                    },
                    "navigation": {
                      "nextEl": ".swiper-upsell-next",
                      "prevEl": ".swiper-upsell-prev"
                    }
                  }
                {%- endcapture -%}
                <div class="cart-drawer__upsell-container my-lg">
                  <s-carousel class="block relative" data-options='{{ upsell_carousel_options }}'>
                      <div id="CartUpsell-{{section.id}}" class="swiper" js-carousel>
                        <div class="flex justify-between items-center mb-md">
                          <h1 class="cart-drawer-upsell__title s1 font-900">Recommended</h1>
                          <div class="swiper-nav-container flex gap-xxs items-center">
                            <div class="swiper-upsell-prev w-[24px] p-xxs">{% render 'icon-caret-left' %}</div>
                            <div class="swiper-upsell-pagination w-fit p6"></div>
                            <div class="swiper-upsell-next w-[24px] p-xxs">{% render 'icon-caret-right' %}</div>
                          </div>
                        </div>

                        <div class="swiper-wrapper">
                          {% unless cart_variants contains upsell_1_variant.id %}
                            {% if settings.upsell_1 != blank %}
                              <div class="swiper-slide" js-carousel-slide>
                                {% render 'product-card__upsell' product:settings.upsell_1, section_id: section.id %}
                              </div>
                            {% endif %}
                          {% endunless %}

                          {% unless cart_variants contains upsell_2_variant.id %}
                            {% if settings.upsell_2 != blank %}
                              <div class="swiper-slide" js-carousel-slide>
                                {% render 'product-card__upsell' product:settings.upsell_2, section_id: section.id%}
                              </div>
                            {% endif %}
                          {% endunless %}
                        </div>
                      </div>
                  </s-carousel>
                </div>
              {% endunless %}
            {% endif %}
            {% comment %} END Upsell Products {% endcomment %}

            {% comment %} Gift with Purchases {% endcomment %}
            {% if settings.gwp1 != blank or settings.gwp2 != blank%}
              {% assign gwp_1_variant = settings.gwp1.variants[0] %}
              {% assign gwp_2_variant = settings.gwp2.variants[0] %}

              {% unless cart_variants contains gwp_1_variant.id and cart_variants contains gwp_2_variant.id %}
                {%- capture gwp_carousel_options -%}
                  {
                    "slidesPerView": 1,
                    "pagination": {
                      "el": ".swiper-gwp-pagination",
                      "type": "fraction"
                    },
                    "navigation": {
                      "nextEl": ".swiper-gwp-next",
                      "prevEl": ".swiper-gwp-prev"
                    }
                  }
                {%- endcapture -%}
                <div class="cart-drawer__gwp-container my-lg">
                  <s-carousel class="block relative {% if cart.total_price < settings.gwp_threshold %} gwp__limit-not-met {% endif %}" data-options='{{ gwp_carousel_options }}'>
                      <div id="CartGwp-{{section.id}}" class="swiper" js-carousel>
                        <div class="flex justify-between items-center mb-md">
                          <h1 class="cart-drawer-gwp__title s1 font-900">Select Your Free Gift</h1>
                          <div class="swiper-nav-container flex gap-xxs items-center">
                            <div class="swiper-gwp-prev w-[24px] p-xxs">{% render 'icon-caret-left' %}</div>
                            <div class="swiper-gwp-pagination w-fit p6"></div>
                            <div class="swiper-gwp-next w-[24px] p-xxs">{% render 'icon-caret-right' %}</div>
                          </div>
                        </div>

                        <div class="swiper-wrapper">
                          {% unless cart_variants contains gwp_1_variant.id %}
                            {% if settings.gwp1 != blank %}
                              <div class="swiper-slide" js-carousel-slide>
                                {% render 'product-card__upsell' product:settings.gwp1, section_id: section.id, gwp:true %}
                              </div>
                            {% endif %}
                          {% endunless %}

                          {% unless cart_variants contains gwp_2_variant.id %}
                            {% if settings.gwp2 != blank %}
                              <div class="swiper-slide" js-carousel-slide>
                                {% render 'product-card__upsell' product:settings.gwp2, section_id: section.id, gwp:true %}
                              </div>
                            {% endif %}
                          {% endunless %}
                        </div>
                      </div>
                  </s-carousel>
                </div>
              {% endunless %}
            {% endif %}
            {% comment %} END Gift with Purchases {% endcomment %}
          {% endif %}
        </div>
        <div id="CartDrawer-CartErrors" role="alert"></div>
      </form>
    </cart-drawer-items>
    
    {% comment %} Cart Footer {% endcomment %}
    {% if cart != empty %}
      <div class="cart-drawer__footer bg-blue-light p-md pb-lg">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {% render 'icon-caret' %}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}
        <div class="cart-drawer__totals">
          <div class="totals flex justify-between mb-xxs" role="status">
            <h2 class="totals__subtotal s2">Estimated Total:</h2>
            <p class="totals__subtotal-value s2">{{ cart.total_price | money }}</p>
          </div>
          <p class="p4 mb-xs">Taxes calculated at checkout</p>

          <div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="discounts__discount discounts__discount--end">
                    {%- render 'icon-discount' -%}
                    {{ discount.title }}
                    (-{{ discount.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>

        <!-- CTAs -->

        <div class="cart-drawer__ctas" {{ block.shopify_attributes }}>
          <button class="cart__checkout-button p2 btn btn--blue-rounded w-full justify-between mb-sm" type="submit" id="CartDrawer-Checkout" name="checkout" form="CartDrawer-Form">
            <span class="btn__text">Go to Checkout</span>
            <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
          </button>

          <a href="/cart" class="cart__checkout-button p2 btn w-fit mx-auto" type="submit" id="CartDrawer-Checkout" name="checkout" form="CartDrawer-Form">
            <span class="btn__text">View Cart Page</span>
            <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
          </a>
        </div>
      </div>
    {% endif %}
    {% comment %} END Cart Footer {% endcomment %}
  </div>
</cart-drawer>