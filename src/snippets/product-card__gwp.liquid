<product-card-upsell class="product-card__upsell flex gap-sm p-md">
    {% if product.featured_image != blank %}
        <div class="image-container w-1/2">
            <a href="{{ product.url }}">
                {% render 'lazy-image' image:product.featured_image %}
            </a>
        </div>
    {% endif %}
    <div class="content-container w-1/2 flex flex-col justify-center items-end">
        <div class="text-content w-full">
            <h1 class="p1 my-xxxs">{{ product.title }}</h1>
            <p class="p4 my-xxxs">{{ product.selected_or_first_available_variant.title }}</p>
            <p class="p1 font-700">{{ product.price | money }}</p>
        </div>

        <button class="product-card__atc underline mt-xs" data-variant-id="{{ product.selected_or_first_available_variant.id }}" {% unless product.selected_or_first_available_variant.available %} disabled {% endunless %} js-gwp-add  js-quick-add>
            {% if product.selected_or_first_available_variant.available %}
                Add to Cart
            {% else %}
                Sold Out
            {% endif %}
        </button>
    </div>
</product-card-upsell>