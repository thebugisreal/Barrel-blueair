<section class="section__product-desc-image mx-30 tabletl:mx-auto" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
    {% render 'spacing-divider' mobile_height:section.settings.spacing_top_mobile, desktop_height:section.settings.spacing_top_desktop %}

    <div class="section__product-desc-image-content " style="background-color: {{ section.settings.bg_color }};">
        {% if section.settings.title != blank %}
            <h1 class="{{ section.settings.title_style }} font-900">{{ section.settings.title }}</h1>
            <div class="spacing-divider h-[8px]"></div>
        {% endif %}

        {% if section.blocks.size > 0 %}
            <ul class="section__products">
                {% for block in section.blocks %}
                    <li class="grid grid-cols-3 gap-8 pl-16 tabletl:pl-32 tabletl:gap-24">
                        <div class="product__description flex flex-col justify-center py-16 col-span-2">
                            <h1 class="product__title text-sub1"> {{ block.settings.product.title }}</h1>
                            <div class="spacing-divider h-[8px] tabletl:h-[12px]"></div>
                            <p class="product__price text-sub3">{{ block.settings.product.price |  money }}</p>
                            <div class="spacing-divider h-[16px] tabletl:h-[24px]"></div>
                            <div class="flex">
                                <a href="{{ block.settings.product.url }}" class="flex gap-12 items-center"> 
                                  <p class="text-p1 font-400">Shop Now</p>
                                  <div class="h-[34px] w-[34px] p-4 rounded-full border border-blue">{%  render 'icon-arrow-right' %}</div>
                                </a>
                            </div>
                        </div>
                        <div class="product__image">
                            {% render 'lazy-image' image:block.settings.product.featured_image %}
                        </div>
                    </li>
                    {% unless forloop.last %} 
                        {% render 'spacing-divider' mobile_height: 12, desktop_height: 24 %}
                    {% endunless %}
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    {% render 'spacing-divider' mobile_height:section.settings.spacing_bottom_mobile, desktop_height:section.settings.spacing_bottom_desktop %}
</section>

{% schema %}
    {
      "name": "Product Desc + Image",
      "tag": "section",
      "settings": [
        {
            "type": "number",
            "id": "spacing_top_mobile",
            "label": "Spacing Top - Mobile",
            "default": 24
        },
        {
            "type": "number",
            "id": "spacing_bottom_mobile",
            "label": "Spacing Bottom - Mobile",
            "default": 24
        },
        {
            "type": "number",
            "id": "spacing_top_desktop",
            "label": "Spacing Top - Desktop",
            "default": 48
        },
        {
            "type": "number",
            "id": "spacing_bottom_desktop",
            "label": "Spacing Bottom - Desktop",
            "default": 48
        },
        {
            "type": "text",
            "id": "max_width_desktop",
            "label": "Max Width - Desktop",
            "info": "Make sure to include units",
            "default": "109ch"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#F0F3F6"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "select",
          "id": "title_style",
          "label": "Title Style",
          "options": [
            { "value": "h1", "label": "h1" },
            { "value": "h2", "label": "h2" },
            { "value": "h3", "label": "h3" },
            { "value": "h4", "label": "h4" },
            { "value": "text-p1", "label": "text-p1" },
            { "value": "text-p2", "label": "text-p2" },
            { "value": "text-p3", "label": "text-p3" },
            { "value": "text-p4", "label": "text-p4" }
          ],
          "default": "text-p1"
        }
      ],
      "blocks": [
        {
            "type": "Product",
            "name": "Product",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                }
            ]
        }
      ],
      "presets": [
        {
          "name": "Product Desc + Image"
        }
      ]
    }
{% endschema %}