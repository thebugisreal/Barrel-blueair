{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<section class="section__product-desc-image mx-30 {{ margins_paddings }} tabletl:mx-auto" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
    <div class="section__product-desc-image-content">
        {% if section.settings.title != blank %}
            <h1 class="{{ section.settings.title_style }} mb-8 font-900">{{ section.settings.title }}</h1>
        {% endif %}

        {% if section.blocks.size > 0 %}
            <ul class="section__products flex flex-col gap-12 tabletl:gap-24">
                {% for block in section.blocks %}
                    {% if block.settings.product != blank %}
                        <li class="grid grid-cols-3 gap-8 pl-16 {{ section.settings.color }} tabletl:pl-32 tabletl:gap-24">
                            <div class="product__description flex flex-col justify-center py-16 col-span-2">
                                <h1 class="product__title text-sub1 mb-8 tabletl:mb-12"> {{ block.settings.product.title }}</h1>
                                <p class="product__price text-sub3 mb-16 tabletl:mb-24">{{ block.settings.product.price |  money }}</p>
                                <a {{ block.settings.product.url }} class="btn">
                                    <span class="btn__text">Shop Now</span>
                                    <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                                </a>
                            </div>
                            <div class="product__image">
                                {% if block.settings.image != blank %}
                                    {% render 'lazy-image' image:block.settings.image, image_desktop:image:block.settings.image_desktop %}
                                {% else %}
                                    {% render 'lazy-image' image:block.settings.product.featured_image %}
                                {% endif %}
                            </div>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>

