<section class="section__product-desc-image mx-30 {{ section.settings.margin_top }} {{ section.settings.margin_bottom }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} tabletl:mx-auto" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
    <div class="section__product-desc-image-content">
        {% if section.settings.title != blank %}
            <h1 class="{{ section.settings.title_style }} mb-8 font-900">{{ section.settings.title }}</h1>
        {% endif %}

        {% if section.blocks.size > 0 %}
            <ul class="section__products flex flex-col gap-12 tabletl:gap-24">
                {% for block in section.blocks %}
                    {% if block.settings.product != blank %}
                        <li class="grid grid-cols-3 gap-8 pl-16 tabletl:pl-32 tabletl:gap-24" style="background-color: {{ section.settings.bg_color }};">
                            <div class="product__description flex flex-col justify-center py-16 col-span-2">
                                <h1 class="product__title text-sub1 mb-8 tabletl:mb-12"> {{ block.settings.product.title }}</h1>
                                <p class="product__price text-sub3 mb-16 tabletl:mb-24">{{ block.settings.product.price |  money }}</p>
                                <a {{ block.settings.product.url }} class="btn">
                                    <span class="btn__text">Shop Now</span>
                                    <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                                </a>
                            </div>
                            <div class="product__image">
                                {% if block.settings.image != blank %}
                                    {% render 'lazy-image' image:block.settings.image, image_desktop:image:block.settings.image_desktop %}
                                {% else %}
                                    {% render 'lazy-image' image:block.settings.product.featured_image %}
                                {% endif %}
                            </div>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>

{% schema %}
    {
      "name": "Product Desc + Image",
      "tag": "section",
      "settings": [
        {
            "type": "select",
            "id": "margin_top",
            "label": "Margin Top - Mobile",
            "options": [
                { "value": "mt-xxxs", "label": "xxxs" },
                { "value": "mt-xxs", "label": "xxs" },
                { "value": "mt-xs", "label": "xs" },
                { "value": "mt-sm", "label": "sm" },
                { "value": "mt-md", "label": "md" },
                { "value": "mt-lg", "label": "lg" },
                { "value": "mt-xl", "label": "xl" },
                { "value": "mt-xxl", "label": "xxl" },
                { "value": "mt-xxxl", "label": "xxxl" },
                { "value": "mt-xxxxl", "label": "xxxxl" }
            ],
            "default": "mt-md"
        },
        {
            "type": "select",
            "id": "margin_bottom",
            "label": "Margin Bottom - Mobile",
            "options": [
                { "value": "mb-xxxs", "label": "xxxs" },
                { "value": "mb-xxs", "label": "xxs" },
                { "value": "mb-xs", "label": "xs" },
                { "value": "mb-sm", "label": "sm" },
                { "value": "mb-md", "label": "md" },
                { "value": "mb-lg", "label": "lg" },
                { "value": "mb-xl", "label": "xl" },
                { "value": "mb-xxl", "label": "xxl" },
                { "value": "mb-xxxl", "label": "xxxl" },
                { "value": "mb-xxxxl", "label": "xxxxl" }
            ],
            "default": "mb-md"
        },
        {
            "type": "select",
            "id": "margin_top_desktop",
            "label": "Margin Top - Desktop",
            "options": [
                { "value": "tabletl:mt-xxxs", "label": "xxxs" },
                { "value": "tabletl:mt-xxs", "label": "xxs" },
                { "value": "tabletl:mt-xs", "label": "xs" },
                { "value": "tabletl:mt-sm", "label": "sm" },
                { "value": "tabletl:mt-md", "label": "md" },
                { "value": "tabletl:mt-lg", "label": "lg" },
                { "value": "tabletl:mt-xl", "label": "xl" },
                { "value": "tabletl:mt-xxl", "label": "xxl" },
                { "value": "tabletl:mt-xxxl", "label": "xxxl" },
                { "value": "tabletl:mt-xxxxl", "label": "xxxxl" }
            ],
            "default": "tabletl:mt-lg"
        },
        {
            "type": "select",
            "id": "margin_bottom_desktop",
            "label": "Margin Bottom - Desktop",
            "options": [
                { "value": "tabletl:mb-xxxs", "label": "xxxs" },
                { "value": "tabletl:mb-xxs", "label": "xxs" },
                { "value": "tabletl:mb-xs", "label": "xs" },
                { "value": "tabletl:mb-sm", "label": "sm" },
                { "value": "tabletl:mb-md", "label": "md" },
                { "value": "tabletl:mb-lg", "label": "lg" },
                { "value": "tabletl:mb-xl", "label": "xl" },
                { "value": "tabletl:mb-xxl", "label": "xxl" },
                { "value": "tabletl:mb-xxxl", "label": "xxxl" },
                { "value": "tabletl:mb-xxxxl", "label": "xxxxl" }
            ],
            "default": "tabletl:mb-lg"
        },
        {
            "type": "text",
            "id": "max_width_desktop",
            "label": "Max Width - Desktop",
            "info": "Make sure to include units",
            "default": "109ch"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#F0F3F6"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "select",
          "id": "title_style",
          "label": "Title Style",
          "options": [
            { "value": "h1", "label": "h1" },
            { "value": "h2", "label": "h2" },
            { "value": "h3", "label": "h3" },
            { "value": "h4", "label": "h4" },
            { "value": "text-p1", "label": "text-p1" },
            { "value": "text-p2", "label": "text-p2" },
            { "value": "text-p3", "label": "text-p3" },
            { "value": "text-p4", "label": "text-p4" }
          ],
          "default": "text-p1"
        }
      ],
      "blocks": [
        {
            "type": "Product",
            "name": "Product",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image - Mobile"
                },
                {
                    "type": "image_picker",
                    "id": "image_desktop",
                    "label": "Image - Desktop"
                }
            ]
        }
      ],
      "presets": [
        {
          "name": "Product Desc + Image"
        }
      ]
    }
{% endschema %}