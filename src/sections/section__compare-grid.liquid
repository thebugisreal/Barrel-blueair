{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
{%-liquid 
  assign hide_price = false
  if shop.permanent_domain contains 'eu' and localization.country.iso_code != 'DE'
    assign hide_price = true
  endif
-%}

<div class="compare__grid-container {{ margins_paddings }} px-lg {{ section.settings.color }} tabletl:px-xl max-w-[100vw] overflow-x-auto tabletl:overflow-x-visible" {% if shop.permanent_domain == 'blueeudev.myshopify.com' %}data-country="{{ localization.country.iso_code }}"{% endif %}>
    <compare-grid class="compare__grid grid grid-cols-3 relative min-w-[500px] tabletl:grid-cols-4 tabletl:min-w-0">
        {% comment %} Compare Grid Info Column {% endcomment %}
        <ul class="compare__grid-info-column border-r border-gray">
            <li class="compare-product__title whitespace-nowrap" js-compare-product-title>
              <a {% if section.settings.back_to_shop_url != blank %} href="{{ section.settings.back_to_shop_url }}" {% endif %} class="underline"> Back to shop </a>
            </li>
            <li class="compare__image-container invisible">
                <div class="compare__image">
                </div>
            </li>
            <li class="compare__atc py-lg w-fit mx-auto invisible">
                <a class="btn btn--blue-rounded" js-atc-btn>
                    <span class="btn__text">See Details</span>
                    <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                </a>
            </li>
            <li class="compare__title">
                <p class="s1">Overview</p>
            </li>
            <li class="compare__item compare__price">
                <p class="p1">Price</p>
            </li>
            <li class="compare__item">
              {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' %}
                <p class="p1">Recommended max room size (sq ft) </p>
              {% else %}
                <p class="p1">Recommended max room size (sq m)</p>
              {% endif %}
            </li>
            <li class="compare__item">
              {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' %}
                <p class="p1">Dimensions h x w x d (in)</p>
              {% else %}
                <p class="p1">Dimensions h x w x d (m)</p>
              {% endif %}
            </li>
            <li class="compare__item">
              {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' %}
                <p class="p1">Weight (lbs)</p>
              {% else %}
                <p class="p1">Weight (kg)</p>
              {% endif %}
            </li>
            <li class="compare__item">
                <p class="p1">Wi-Fi Enabled</p>
            </li>
            <li class="compare__title">
                <p class="s1">Specifications</p>
            </li>
            <li class="compare__item">
                <p class="p1">Energy Consumption (W)</p>
            </li>
            <li class="compare__item">
                <p class="p1">Sound Level (dB(A))</p>
            </li>
            <li class="compare__item">
                <p class="p1">Air Changes Per Hour</p>
            </li>
            <li class="compare__item">
                <p class="p1">Clean Air Delivery Rate</p>
            </li>
            <li class="compare__item">
                <p class="p1 indent-[24px]">Pollen</p>
            </li>
            <li class="compare__item">
                <p class="p1 indent-[24px]">Dust</p>
            </li>
            <li class="compare__item">
                <p class="p1 indent-[24px]">Smoke</p>
            </li>
            <li class="compare__title">
                <p class="s1">Features</p>
            </li>
            <li class="compare__item">
                <p class="p1">Air Quality Sensors</p>
            </li>
            <li class="compare__item">
                <p class="p1">Filter Replacement Indicator</p>
            </li>
            <li class="compare__item">
                <p class="p1">On/Off Timer</p>
            </li>
            <li class="compare__item">
                <p class="p1">Speed Control Options</p>
            </li>
            <li class="compare__item">
                <p class="p1">Wheels</p>
            </li>
            <li class="compare__item">
                <p class="p1">Max Room Size</p>
            </li>
        </ul>

        {% comment %} Compare Grid Additional Item Column {% endcomment %}
        <ul class="compare__grid-additional-column text-center order-[999] hidden tabletl:block" js-additional-column>
            <li class="compare-product__title invisible" js-compare-product-title>
              <a {% if section.settings.back_to_shop_url != blank %} href="{{ section.settings.back_to_shop_url }}" {% endif %} class="underline"> Back to shop </a>
            </li>
            <li class="compare__image-container p-xxs">
                <div class="w-full aspect-square flex justify-center items-center">
                  <p class="p1 font-300">Compare 1 more</p>
                </div>
            </li>
            <li class="compare__atc py-lg w-fit mx-auto">
                <a {% if section.settings.compare_more_url != blank %} href="{{ section.settings.compare_more_url }}" {% endif %} class="btn py-[9px]">
                    <span class="btn__text">Compare More</span>
                    <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                </a>
            </li>
            <li class="compare__title">
                <p class="s1">Overview</p>
            </li>
            <li class="compare__item compare__price">
                <p class="p1">N/A</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__title">
                <p class="s1"></p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1"></p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__title">
                <p class="s1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
            <li class="compare__item">
                <p class="p1">-</p>
            </li>
        </ul>

    </compare-grid>
</div>

