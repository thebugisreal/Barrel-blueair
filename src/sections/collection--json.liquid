{% comment %}
  Template to be used for getting grouped color/material swatches
  Usage: /collections/all/(product tag)?view=json
{% endcomment %}
<script type="text/javascript" js-collection-json>
[
{%- for product in collection.products -%}
  {%- assign size = blank -%}
  {%- for tag in product.tags -%}
    {%- if tag contains 'size:' -%}
      {%- assign size = tag | split: 'size:' | last | strip | capitalize -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign swatch_objects = product.metafields.seed.swatches.value | default: blank -%}
  {%- assign color_title = '' -%}
  {%- assign color_hex = '' -%}
  {%- assign swatch_image_url = '' -%}

  {%- if product.metafields.shopify.color-pattern != blank -%}
    {%- for color in product.metafields.shopify.color-pattern.value limit: 1 -%}
      {%- assign color_title = color.label -%}
      {%- assign color_hex = color.color -%}

      {%- if color.image != blank -%}
        {%- assign swatch_image_url = color.image | image_url: width: 100 -%}
      {%- elsif color.swatch != blank -%}
        {%- assign swatch_image_url = color.swatch | image_url: width: 100 -%}
      {%- endif -%}

      {%- if swatch_image_url == '' and swatch_objects != blank -%}
        {%- assign wanted = color.label | strip | downcase -%}
        {%- for swatch in swatch_objects -%}
          {%- assign swatch_name = swatch.name | strip | downcase -%}
          {%- if swatch_name == wanted and swatch.image != blank -%}
            {%- assign swatch_image_url = swatch.image | image_url: width: 100 -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "handle": {{ product.handle | json }},
    {%- if size != blank -%}
    "size": {{ size | json }},
    {%- endif -%}
    "color": {{ color_title | json }},
    "colorTitle": {{ color_title | json }},
    "colorHex": "{{ color_hex }}",
    "swatchImage": {{ swatch_image_url | json }},
    "available": {{ product.available | json }}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
</script>
