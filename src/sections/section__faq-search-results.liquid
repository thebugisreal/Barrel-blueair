{% paginate search.results by 500 %}
<faq-search-results class="section__faq-seearch-results block desktop:flex">
  <div class="faq-seearch-results__side p-md pb-0 desktop:pl-xl desktop:py-[56px] desktop:w-[300px] desktop:border-r desktop:border-gray">
    <div class="s1 hidden desktop:block mb-md">Search Results</div>
    <div class="faq-seearch-results__category py-xxs px-sm bg-blue-darkSky w-max relative desktop:w-full">Articles</div>
    <div class="border-t-2 border-gray desktop:border-t desktop:mt-md">
      <div class="s2 py-sm">Refine by</div>
      <div class="hidden">
        <label>Property Group</label>
        <select name="" id=""></select>
      </div>
    </div>
  </div>
  <div class="faq-seearch-results__main desktop:flex-1 desktop:pr-xl">
    {% if search.performed %}
      {% if search.results_count > 0 %}
        <div class="s1 p-md pt-48 border-b border-gray desktop:pt-[56px]">FAQ Articles</div>
        <ul class="faq-seearch-results__articles faq-seearch-results__articles--support">
          {% for article in search.results %}
            {% if article.tags contains 'support' %}
              <li class="faq-seearch-results__article border-b border-gray p-md hidden" data-blog="{{ article.handle |  split: '/' | first }}" js-support-tagged-article>
                <a href="{{ article.url }}" class="faq-seearch-results-article__title p3 link link--underline underline-offset-2">
                  {{ article.title }}
                </a>
                {% if article.content != blank %}
                  <div class="faq-seearch-results-article__content p4 mt-xxs">
                    {{ article.content | strip_html | truncatewords: 40 }}
                  </div>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <button class="faq-seearch-results__show-more-btn btn btn--blue-rounded mt-md mx-auto desktop:ml-md hidden" js-support-tagged-show-more-btn>
          <span class="btn__text">Show More</span>
          <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
        </button>

        <div class="s1 p-md pt-48 border-b border-gray desktop:pt-[56px]">Blog Articles</div>
        <ul class="faq-seearch-results__articles faq-seearch-results__articles--non-support">
          {% for article in search.results %}
            {% unless article.tags contains 'support' %}
              <li class="faq-seearch-results__article border-b border-gray p-md hidden" data-blog="{{ article.handle |  split: '/' | first }}" js-non-support-tagged-article>
                <a href="{{ article.url }}" class="faq-seearch-results-article__title p3 link link--underline underline-offset-2">
                  {{ article.title }}
                </a>
                {% if article.content != blank %}
                  <div class="faq-seearch-results-article__content p4 mt-xxs">
                    {{ article.content | strip_html | truncatewords: 40 }}
                  </div>
                {% endif %}
              </li>
            {% endunless %}
          {% endfor %}
        </ul>
        <button class="faq-seearch-results__show-more-btn btn btn--blue-rounded mt-md mx-auto desktop:ml-md hidden" js-non-support-tagged-show-more-btn>
          <span class="btn__text">Show More</span>
          <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
        </button>
      {% else %}
        <div class="faq-seearch-results__no-results px-md py-48 desktop:py-[56px]">
          No Search Results Found for "{{ search.terms }}"
        </div>
      {% endif %}
    {% endif %}
  </div>
</faq-search-results>
{% endpaginate %}

{% schema %}
{
  "name": "FAQ Search Results",
  "tag": "section"
}
{% endschema %}