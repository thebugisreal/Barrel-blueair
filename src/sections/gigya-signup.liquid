<div class="min-h-screen flex items-center justify-center bg-gray-light py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
      <h1 class="h3 text-center mb-md">Gigya Registration Form</h1>

    <form id="registrationForm" class="mt-8">
      <div>

        <div class="mb-4">
          <label for="email" class="sr-only">Email</label>
          <input type="email" id="email" name="email" required placeholder="Email" 
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>

        <div class="mb-4">
          <label for="password" class="sr-only">Password</label>
           <input type="email" id="email" name="email" required placeholder="Password" 
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
         </div>

        <div class="mb-4">
          <label for="firstName" class="sr-only">First Name</label>
          <input type="text" id="firstName" name="firstName" required placeholder="First Name"
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>

        <div class="mb-4">
          <label for="lastName" class="sr-only">Last Name</label>
          <input type="text" id="lastName" name="lastName" required placeholder="Last Name"
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>

        <div class="mb-4">
          <label for="address" class="sr-only">Address</label>
          <input type="text" id="address" name="address" required placeholder="Address"
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>

        <div class="grid grid-cols-3 gap-4 mb-4">
          <div>
            <label for="birthDay" class="sr-only">Birth Day</label>
            <input type="number" id="birthDay" name="birthDay" required min="1" max="31" placeholder="Birth Day"
                class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
          </div>
          <div>
            <label for="birthMonth" class="sr-only">Birth Month</label>
            <input type="number" id="birthMonth" name="birthMonth" required min="1" max="12" placeholder="Birth Month"
                class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
          </div>
          <div>
            <label for="birthYear" class="sr-only">Birth Year</label>
            <input type="number" id="birthYear" name="birthYear" required min="1900" max="2024" placeholder="Birth Year"
                class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
          </div>
        </div>
      </div>

      <div>
        <button type="submit" class="btn btn--blue-rounded mb-lg mx-auto">
          <span class="btn__text">Register</span>
          <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
        </button>

      </div>
    </form>
  </div>
</div>

<script>
  document.getElementById('registrationForm').addEventListener('submit', function (event) {
    event.preventDefault();

    const formData = new FormData(event.target);
    const data = {
      loginID: formData.get('email'),
      password: formData.get('password'),
      email: formData.get('email'),
      profile: {
        firstName: formData.get('firstName'),
        lastName: formData.get('lastName'),
        address: formData.get('address'),
        birthDay: parseInt(formData.get('birthDay'), 10),
        birthMonth: parseInt(formData.get('birthMonth'), 10),
        birthYear: parseInt(formData.get('birthYear'), 10),
      },
      preferences: {
        ageConsentGranted: { isConsentGranted: true },
        cookies: { isConsentGranted: true },
      },
    };

    gigya.accounts.initRegistration({
      callback: function (response) {
        if (response.errorCode === 0) {
          data.regToken = response.regToken;
          gigya.accounts.register({
            ...data,
            ignoreInterruptions: true,
            finalizeRegistration: true,
            callback: function (response) {
              if (response.errorCode === 0) {
                alert("User registered successfully")
                gigya.accounts.getJWT({
                  callback: function (response) {
                    if (response.errorCode === 0) {
                      const token = response.id_token
                      console.log("JWT Token:", token);
                      window.location.href = `https://store.xecurify.com/moas/broker/login/jwt/callback/34273/jwt_H1X/${token}?relay=https://store.xecurify.com/moas/broker/login/shopify/blueair-staging.myshopify.com/account`
                      console.log("Expiration Time:", response.expiration);
                    } else {
                      console.error("Error:", response.errorMessage);
                    }
                    console.log("the response is here")
                  },
                  fields: "email,profile",
                  expiration: 3600
                });
                console.log('User registered successfully');
              } else {
                console.error('Registration error:', response.errorMessage);
              }
            },
          });
        } else {
          console.error('Error initializing registration:', response.errorMessage);
        }
      },
    });
  });
</script>

