<div class="min-h-screen flex items-center justify-center bg-gray-light py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <h1 class="h3 text-center mb-md">Gigya Registration Form</h1>

    <form id="registrationForm" class="mt-8">
      <div>
        <div class="mb-4">
          <label for="email" class="sr-only">Email</label>
          <input type="email" id="email" name="email" required placeholder="Email" 
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>
        <div class="mb-4">
          <label for="firstName" class="sr-only">First Name</label>
          <input type="text" id="firstName" name="firstName" required placeholder="First Name"
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>
        <div class="mb-4">
          <label for="lastName" class="sr-only">Last Name</label>
          <input type="text" id="lastName" name="lastName" required placeholder="Last Name"
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>
        <div class="mb-4">
          <label for="reg_password" class="sr-only">Password</label>
          <input type="password" id="reg_password" name="password" required placeholder="Password" 
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>
        <div class="mb-4">
          <label for="reg_confirm_password" class="sr-only">Confirm Password</label>
          <input type="password" id="reg_confirm_password" name="confirm_password" required placeholder="Confirm Password" 
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>
        <!-- Consent checkboxes start -->
        <div class="mb-4 flex items-center">
          <input type="checkbox" id="over16" name="over16" required class="mr-xs w-6 h-6">
          <label for="over16" class="text-14">I confirm that I am over 16 years old <span class="text-red">*</span></label>
        </div>
        <div class="mb-4 flex items-center">
          <input type="checkbox" id="blueairUpdates" name="blueairUpdates" class="mr-xs w-6 h-6">
          <label for="blueairUpdates" class="text-14 ml-2">Sign up for updates on Blueair's newest products, services & exclusive offers</label>
        </div>
        <div class="mb-4 flex items-center">
          <input type="checkbox" id="unileverConsent" name="unileverConsent" class="mr-xs w-6 h-6">
          <label for="unileverConsent" class="text-14 ml-2">I consent to my data being shared with other Unilever brands to receive the latest news on other Unilever products & services</label>
        </div>
        <div class="my-xs">
          <p class="text-14">Please read our <a href="#" class="underline">notices</a> to understand how we use your personal data. By clicking the button below, you agree to our</p>
        </div>
      </div>
      <div>
        <button type="submit" class="btn btn--blue-rounded mb-lg mx-auto">
          <span class="btn__text">Register</span>
          <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.getElementById('registrationForm').addEventListener('submit', function (event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const password = formData.get('password');
    const confirmPassword = formData.get('confirm_password');
    if (password !== confirmPassword) {
      alert('Passwords do not match.');
      return;
    }
    if (!document.getElementById('over16').checked) {
      alert('You must confirm that you are over 16 years old.');
      return;
    }
    const data = {
      loginID: formData.get('email'),
      password: password,
      email: formData.get('email'),
      profile: {
        firstName: formData.get('firstName'),
        lastName: formData.get('lastName'),
        address: formData.get('address'),
      },
      preferences: {
        ageConsentGranted: { isConsentGranted: document.getElementById('over16').checked },
        blueairUpdates: { isConsentGranted: document.getElementById('blueairUpdates').checked },
        unileverConsent: { isConsentGranted: document.getElementById('unileverConsent').checked },
        cookies: { isConsentGranted: true },
      },
    };
    gigya.accounts.initRegistration({
      callback: function (response) {
        if (response.errorCode === 0) {
          data.regToken = response.regToken;
          gigya.accounts.register({
            ...data,
            ignoreInterruptions: true,
            finalizeRegistration: true,
            callback: function (response) {
              if (response.errorCode === 0) {
                alert("User registered successfully");
                gigya.accounts.getJWT({
                  callback: function (response) {
                    if (response.errorCode === 0) {
                      const token = response.id_token;
                      window.location.href = `https://store.xecurify.com/moas/broker/login/jwt/callback/34273/jwt_H1X/${token}?relay=https://store.xecurify.com/moas/broker/login/shopify/blueair-staging.myshopify.com/account`;
                    }
                  },
                  fields: "email,profile",
                  expiration: 3600
                });
              }
            },
          });
        }
      },
    });
  });
</script>

{% schema %}
{
  "name": "Gigya Signup",
  "settings": [],
  "presets": [
    {
      "name": "Gigya Signup",
      "category": "Authentication"
    }
  ]
}
{% endschema %}
