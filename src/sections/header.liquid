<s-header class="site-header fixed top-0 left-0 right-0 {% if template.name == 'index' %}transition-colors duration-300 bg-transparent{% elsif template.name == 'collection' %}bg-blue-light{% else %}bg-white{% endif %}" data-template="{{ template }}">
  {% if section.blocks.size > 0 %}
    <div class="section__announcement-bar hidden relative p-[5px] tabletl:p-[10px] {{ section.settings.bg_color }}" js-announcement-bar>
      {%- capture carousel_options -%}
          {
            "slidesPerView": 1,
            "cssMode": true,
            "loop": true,
            "autoHeight": false,
            "navigation": {
              "enabled": true,
              "nextEl": ".swiper-button-next--{{section.id}}",
              "prevEl": ".swiper-button-prev--{{section.id}}"
            }
          }
      {%- endcapture -%}
      {% if section.blocks.size < 2 %}
        {% assign hide_nav = 'hidden' %}
      {% endif %}
      <s-carousel data-options='{{ carousel_options }}' class="announcement-bar__carousel tabletl:px-30">
        <div id="AnnouncementBar-{{ section.id }}" class="swiper w-full max-w-full flex items-center" js-carousel>
          <div class="absolute right-[10px] w-[22px] z-[2] btn tabletl:right-[1%]" js-close-announcement><span class="btn__arrow items-center border-0">{% render 'icon-close' %}</span></div>
          <div class="swiper-button-prev--{{ section.id }} {{ hide_nav }} absolute z-[2] left-[20px] w-[24px] btn tabletl:left-[5%]"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--prev">{% render 'icon-arrow-left' %}</span></div>
          <div class="swiper-button-next--{{ section.id }} {{ hide_nav }} absolute z-[2] right-[40px] w-[24px] btn tabletl:right-[5%]"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--next">{% render 'icon-arrow-right' %}</span></div>
          <div class="swiper-wrapper min-h-[25px] items-center">
              {% for block in section.blocks %}
                  <div class="swiper-slide" js-carousel-slide>
                      {% if block.settings.url != blank %}
                          <a href="{{ block.settings.url }}" class="announcement p3 font-400 text-center block">{{ block.settings.announcement }}</a>
                      {% else %}
                          <div class="announcement p3 font-400 text-center">{{ block.settings.announcement }}</div>
                      {% endif %}
                  </div>
              {% endfor %} 
          </div>
        </div>
      </s-carousel>
    </div>
  {% endif %}

  <div class="site-header__warpper relative w-full px-md flex justify-between gap-md desktop:px-xl">
    <button class="site-header__mobile-nav w-24 self-center desktop:hidden" js-open-mobile-nav>{% render 'icon-nav' %}</button>
    <a href="{{ routes.root_url }}" class="site-header__logo w-[140px] self-center">{% render 'icon-blueair-logo' %}</a>
    <ul class="site-header__desktop-nav hidden flex-1 desktop:flex justify-start">
      {% assign nav_linklist = linklists[section.settings.header_nav_desktop] %}
      {% for link in nav_linklist.links %}
        {% if link.links != blank %}
          <li class="header-desktop-nav__item header-desktop-nav__item--mega-menu px-sm flex items-center cursor-default">
            <div class="header-desktop-nav__mega-menu-title text-16">{{ link.title }}</div>
            <div class="header-desktop-nav__mega-menu-wrapper absolute left-0 w-full bottom-0 z-[-1] bg-white opacity-0 pointer-events-none">
              {% render 'mega-menu' link: link %}
            </div>
          </li>
        {% else %}
          <li class="header-desktop-nav__item px-sm flex items-center">
            <a href="{{ link.url }}" class="header-desktop-nav__link text-16 underline-offset-[12px]">{{ link.title }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
    <div class="site-header__icon-links desktop:flex justify-end items-center gap-xs py-sm">
      <button class="site-header__icon-link site-header__icon-link--search w-36 hidden desktop:block" js-open-desktop-search>{% render 'icon-search' %}</button>
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="site-header__icon-link site-header__icon-link--account w-36 hidden desktop:block">{% render 'icon-account' %}</a>
      <button class="site-header__icon-link site-header__icon-link--cart w-36 relative" js-open-cart>
        {% render 'icon-cart' %}
        <span id="cart-count" class="absolute block top-0 right-0">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
      </button>
    </div>
  </div>  
</s-header>

{% render 'drawer--mobile-nav' %}

<style>
  :root{
    --header-height: 68px;
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "header_nav_desktop",
      "label": "Navigation"
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Color Set",
      "options": [
        {
          "value": "bg-white text-blue",
          "label": "None (white bg & blue text)"
        },
        {
          "value": "bg-blue-sky text-blue",
          "label": "Blue"
        },
        {
          "value": "bg-green-light text-green-dark",
          "label": "Green"
        },
        {
          "value": "bg-pink-light text-pink-dark",
          "label": "Pink"
        },
        {
          "value": "bg-yellow-light text-yellow-dark",
          "label": "Yellow"
        },
        {
          "value": "bg-brown-light text-brown-dark",
          "label": "Brown"
        },
        {
          "value": "bg-blue-light text-blue",
          "label": "Gray"
        }
      ],
      "default": "bg-white text-blue"
    }  
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "announcement",
          "label": "Announcement Text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ]
}
{% endschema %}