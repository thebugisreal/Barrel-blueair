<s-header class="site-header fixed top-0 left-0 right-0 {% if template.name == 'index' %}transition-colors duration-300 bg-white{% elsif template.name == 'collection' %}bg-white{% else %}bg-white{% endif %}" data-template="{{ template }}">
  {% if section.blocks.size > 0 %}
    <div class="section__announcement-bar hidden relative py-[5px] tabletl:py-[10px] {{ section.settings.bg_color }}" js-announcement-bar>
      {%- capture carousel_options -%}
          {
            "slidesPerView": 1,
            "cssMode": true,
            "loop": true,
            {% if section.settings.autoplay %}
              "autoplay": {
                "delay": {{ section.settings.autoplay_speed }}
              },
            {% endif %}
            "autoHeight": false,
            "navigation": {
              "enabled": true,
              "nextEl": ".swiper-button-next--{{section.id}}",
              "prevEl": ".swiper-button-prev--{{section.id}}"
            }
          }
      {%- endcapture -%}
      {% if section.blocks.size < 2 %}
        {% assign hide_nav = 'hidden' %}
      {% endif %}
      <s-carousel data-options='{{ carousel_options }}' class="announcement-bar__carousel">
        <div id="AnnouncementBar-{{ section.id }}" class="swiper w-full max-w-full flex items-center" js-carousel>
          <div class="absolute right-[8px] w-[22px] z-[2] btn tabletp:right-[2%]" js-close-announcement><span class="btn__arrow items-center border-0">{% render 'icon-close' %}</span></div>
          <div class="swiper-button-prev--{{ section.id }} {{ hide_nav }} absolute z-[2] left-[24px] w-[24px] btn tabletp:left-[7%]"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--prev leading-[0px]">{% render 'icon-arrow-left' %}</span></div>
          <div class="swiper-button-next--{{ section.id }} {{ hide_nav }} absolute z-[2] right-[32px] w-[24px] btn tabletp:right-[7%]"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--next leading-[0px]">{% render 'icon-arrow-right' %}</span></div>
          <div class="swiper-wrapper min-h-[25px] items-center">
              {% for block in section.blocks %}
                  <div class="swiper-slide" js-carousel-slide>
                      {% if block.settings.url != blank %}
                          <a href="{{ block.settings.url }}" class="announcement p3 font-400 text-center block px-[56px] leading-[18px] tabletp:px-[10%]" aria-label="Announcement > {{ block.settings.announcement }}">{{ block.settings.announcement }}</a>
                      {% else %}
                          <div class="announcement p3 font-400 text-center px-[56px] leading-[18px] tabletp:px-[10%]">{{ block.settings.announcement }}</div>
                      {% endif %}
                  </div>
              {% endfor %} 
          </div>
        </div>
      </s-carousel>
    </div>
  {% endif %}

  <div class="site-header__warpper relative w-full px-md flex justify-between gap-md desktop:px-xl">
    <button class="site-header__mobile-nav w-24 self-center desktop:hidden" js-open-mobile-nav>{% render 'icon-nav' %}</button>
    <a href="{{ routes.root_url }}" class="site-header__logo w-[140px] self-center">{% render 'icon-blueair-logo' %}</a>
    <ul class="site-header__desktop-nav hidden flex-1 desktop:flex justify-start">
      {% assign nav_linklist = linklists[section.settings.header_nav_desktop] %}
      {% for link in nav_linklist.links %}
        {% if link.links != blank %}
          <li class="header-desktop-nav__item header-desktop-nav__item--mega-menu px-sm flex items-center cursor-default" js-nav-item>
            <div class="header-desktop-nav__mega-menu-title text-16">{{ link.title }}</div>
            <div class="header-desktop-nav__mega-menu-wrapper absolute left-0 w-full bottom-[1px] translate-y-full z-[-1] bg-white pointer-events-none max-h-0 overflow-hidden transition-[max-height] duration-500" js-nav-menu>
              {% render 'mega-menu' link: link %}
            </div>
          </li>
        {% else %}
          <li class="header-desktop-nav__item px-sm flex items-center">
            <a href="{{ link.url }}" class="header-desktop-nav__link text-16 underline-offset-[12px]" aria-label="{{ link.title }}" js-nav-item>{{ link.title }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
    {% include 'region-check' %}
    <div class="site-header__icon-links desktop:flex justify-end items-center gap-xs py-sm">
      <button class="site-header__icon-link site-header__icon-link--search w-36 hidden desktop:block" js-open-desktop-search>{% render 'icon-search' %}</button>
      {% if shop.permanent_domain == 'blueeudev.myshopify.com' %}
      {% elsif shop.permanent_domain == 'uk-blueair.myshopify.com' %}
        <a href="{{ routes.account_url }}" class="site-header__icon-link site-header__icon-link--account w-36 hidden desktop:block">{% render 'icon-account' %}</a>
      {% else %}
