{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

{% if product.metafields.seed.pdp_perks != blank %}
    <div class="product__perks {{ margins_paddings }} bg-[#D6E4F3] px-lg tabletl:px-xl">
        <ul class="product__perks-container flex flex-col gap-lg tabletl:grid tabletl:grid-cols-3 tabletl:gap-xl tabletl:max-w-[var(--max-w-desktop)] tabletl:mx-auto"  style="--max-w-desktop:{{ section.settings.max_width_desktop }}">
          {% for filter in product.metafields.seed.pdp_perks.value %}
              <li class="product__filter text-center flex flex-col justify-center items-center gap-xxxs tabletl:gap-sm tabletl:flex-row">
                <div class="filter-icon w-[34px] mb-xs">
                    {% render 'lazy-image' image:filter.icon %}
                </div>
                <p class="s3 mb-xs">{{ filter.title }}</p>
              </li>
          {% endfor %}
        </ul>
    </div>
{% endif %}

