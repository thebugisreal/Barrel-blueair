<div class="template-404 flex justify-center mt-lg px-md tabletl:px-lg tabletl:mt-xl">
  <div class="layout-container">
    <h1 class="h2 font-500 mb-md">
      {{ 'templates.404.subtext' | t }}
    </h1>
    <h1 class="title mb-md">Oops!</h1>
    <p class="p1 mb-md font-300">We can't seem to find the page you're looking for.</p>
  
    <a href="/" class="btn btn--white-rounded">
      <span class="btn__text">Go to Homepage</span>
      <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
    </a>
  </div>
</div>
