{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<div class="section__icons {{ margins_paddings }} {{ section.settings.color }} px-md desktop:px-xl">
  <div class="icons__wrapper mx-auto desktop:max-w-[var(--max-w-desktop)] {{ section.settings.text_align_mobile }} {{ section.settings.text_align_desktop }}" style="--max-w-desktop: {% if section.settings.max_width_desktop != blank %}{{ section.settings.max_width_desktop }}{% else %}unset{% endif %};">
    {% if section.settings.title != blank %}
      <h1 class="icons__title {{ section.settings.title_style }} mb-lg desktop:mb-xl">{{ section.settings.title }}</h1>
    {% endif %}
    <div class="icons__grid grid gap-md" style="--cols-mobile: {{ section.settings.num_cols_mobile }}; --cols-desktop: {{ section.settings.num_cols_desktop }};">
      {% for block in section.blocks %}
        <div class="icons__block">
          {% if block.settings.icon != blank %}
            <div class="icon__image inline-block" style="{% if block.settings.icon_fixed_width != blank %}width: {{ block.settings.icon_fixed_width }}px{% else %}width: 100%{% endif %};">
              {% render 'lazy-image' image: block.settings.icon %}
            </div>
          {% endif %}
          {% if block.settings.title != blank %}
            <div class="icon__title {{ block.settings.title_style }} mt-sm">{{ block.settings.title }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

