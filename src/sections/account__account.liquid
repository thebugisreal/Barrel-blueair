{% assign sections = "My Profile,Filter Subscriptions,Order History,Devices & Warranty" | split: ',' %}

{% comment %} 
  My Profile Content 
{% endcomment %}
{% capture my_profile_content %}
  <div class="account__section">
    <h4 class="mt-md text-center min-h-[50px] flex justify-center items-center desktop:mt-0 desktop:text-left desktop:justify-start">My Profile</h4>
    <div class="mt-md grid gap-md desktop:grid-cols-2">
      <div class="account-content bg-white min-h-[225px] flex flex-col">
        <div class="px-md py-sm flex justify-between items-center border-b border-[#F0F3F6]">
          <p class="s1">Contact</p>
        </div>
        <div class="account__rte h-full p-md p2">
          <p>{{ customer.first_name }} {{ customer.last_name }}</p>
          <p>{{ customer.email }}</p>
        </div>
      </div>
  
      <div class="account-content bg-white min-h-[225px] flex flex-col hidden" js-account-subscribed>
        <div class="px-md py-sm flex justify-between items-center border-b border-[#F0F3F6]">
          <p class="s1">{{ settings.newsletter_heading | default: 'Already Subscribed' }}</p>
        </div>
        <div class="account__rte h-full p-md p2">
          <p>{{ settings.newsletter_text | default: 'You are already subscribed' }}</p>
          <a href="{{ settings.newsletter_cta_url | default: '/' }}" target="_blank" rel="noopener noreferrer" class="btn btn--blue-rounded mt-sm flex justify-center items-center gap-xxs">
            {{ settings.newsletter_cta_text | default: 'Unsubscribe' }}<span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
          </a>
        </div>
      </div>

      <div class="account-content bg-white min-h-[225px] flex flex-col hidden" js-account-not-subscribed>
        <div class="px-md py-sm flex justify-between items-center border-b border-[#F0F3F6]">
          <p class="s1">Join Our Newsletter</p>
        </div>
        <div class="account__rte h-full p-md p2">
          <p>Hit subscribe, if you would like to receive marketing communications about Blueair via email.</p>
          <button class="klaviyo_form_trigger btn btn--blue-rounded mt-sm flex justify-center items-center gap-xxs" data-form-id="{{ section.settings.form_id }}">
            Sign Up<span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
          </button>
        </div>
      </div>
    </div>            
  </div>

  <div class="account__section">
    <h4 class="mt-md mb-xxs text-center min-h-[50px] flex justify-center items-center desktop:mt-0 desktop:mb-0 desktop:text-left desktop:justify-start">Address Book</h4>
    <p class="p2 mt-xss text-black text-center px-sm desktop:mt-sm desktop:text-left desktop:px-0">
      Please note: To update your address for filter subscriptions, go to your "Filter Subscription" settings, edit my plan, and update the address details.
    </p>
    <div class="mt-md grid gap-md desktop:grid-cols-2">
      {% for address in customer.addresses %}
        {% if address == customer.default_address %}
          <div class="account-content bg-white min-h-[225px] flex flex-col" data-address-id="{{address.id}}">
            <div class="px-md py-sm flex justify-between items-center border-b border-[#F0F3F6]">
              <p class="s1">Primary Billing</p>
              <button class="p1 link" data-form="{{address.id}}" js-edit-address>Edit</button>
            </div>
            <div class="account__rte h-full p-md p2">
              <p>{{ address.first_name }} {{ address.last_name }}</p>
              {%- if address.company != blank -%}
                <p>{{ address.company }}</p>
              {%- endif -%}
              <p>{{ address.address1 }}</p>
              {%- if address.address2 != blank -%}
                <p>{{ address.address2 }}</p>
              {%- endif -%}
              <p>{{ address.city }}, {{ address.province_code }} {{ address.zip }}</p>
              <p>{{ address.country }}</p>
              {%- if address.phone != blank -%}
                <p>Phone: {{ address.phone }}</p>
              {%- endif -%}
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {% for address in customer.addresses %}
        {% unless address == customer.default_address %}
          <div class="account-content bg-white min-h-[225px] flex flex-col" data-address-id="{{address.id}}">
            <div class="px-md py-sm flex justify-between items-center border-b border-[#F0F3F6]">
              <p class="s1">Billing</p>
              <button class="p1 link" data-form="{{address.id}}" js-edit-address>Edit</button>
            </div>
            <div class="account__rte h-full p-md p2">
              <p>{{ address.first_name }} {{ address.last_name }}</p>
              {%- if address.company != blank -%}
                <p>{{ address.company }}</p>
              {%- endif -%}
              <p>{{ address.address1 }}</p>
              {%- if address.address2 != blank -%}
                <p>{{ address.address2 }}</p>
              {%- endif -%}
              <p>{{ address.city }}, {{ address.province_code }} {{ address.zip }}</p>
              <p>{{ address.country }}</p>
              {%- if address.phone != blank -%}
                <p>Phone: {{ address.phone }}</p>
              {%- endif -%}
            </div>
          </div>
        {% endunless %}
      {% endfor %}

      <button class="account-content__add account-conent--bordered text-center text-blue bg-tranparent p-md flex justify-center items-center gap-xxs row-start-1 desktop:row-auto desktop:min-h-[225px]" js-open-add-address>
        <p>New Address</p>
        <span class="account-content__icon p-xxs w-[33px] leading-[0] rounded-full bg-blue text-white">{% render 'icon-plus' %}</span>
      </button>
    </div>
  </div>
{% endcapture %}

{% comment %} 
  Filter Subscriptions Content 
{% endcomment %}
{% capture filter_subscriptions %}
  <div class="account__section">
    <div class="flex flex-col gap-md pb-xs justify-between items-center desktop:flex-row desktop:pb-0">
      <h4 class="mt-md text-center min-h-[50px] flex justify-center items-center desktop:mt-0 desktop:text-left desktop:justify-start">Active Filter Subscriptions</h4>
      <a href="{{ settings.add_subscription_url }}" target="_blank" rel="noopener noreferrer" class="account-content__add account-conent--bordered !no-underline flex justify-center items-center gap-xxs whitespace-nowrap w-full p-md desktop:w-auto desktop:p-0 desktop:bg-none">
        Add a Subscription
        <span class="account-content__icon p-xxs w-[33px] leading-[0] rounded-full bg-blue text-white">{% render 'icon-plus' %}</span>
      </a>
    </div>
    <div class="grid gap-md">
      <div class="account-content">
        <div id="og-msi" ng-jq></div>
        <script type="text/javascript" src="https://static.ordergroove.com/3488d6a745bd4989b67ebc6b0ad38ad6/msi.js"></script>
      </div>
    </div>
  </div>
{% endcapture %}

{% comment %} 
  Order History Content 
{% endcomment %}
{% capture order_history_content %}
  <div class="account__section">
    <div class="flex flex-col gap-md pb-xs justify-between items-center desktop:flex-row desktop:pb-0">
      <h4 class="mt-md text-center min-h-[50px] flex justify-center items-center desktop:mt-0 desktop:text-left desktop:justify-start">Order History</h4>
      <a href="{{ settings.start_return_url }}" target="_blank" rel="noopener noreferrer" class="btn btn--blue-rounded flex justify-center items-center gap-xxs whitespace-nowrap">
        Start a Return<span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
      </a>
    </div>
    <div class="mt-md grid gap-md">
      <div class="w-full flex justify-center items-center bg-[#D6E4F3] p-xxs p2">
        Please allow a few minutes for new orders to populate below.
      </div>
      <div class="account-content block">
        {% if customer.orders.size > 0 %}
          {% paginate customer.orders by 10 %}
            <table class="hidden desktop:w-full desktop:bg-white desktop:table" js-orders-desktop>
              <tr class="account__order w-full border-b border-[#F0F3F6]">
                <th class="p1 px-md py-sm text-left">Date of Purchase</th> 
                <th class="p1 px-md py-sm text-left">Status</th> 
                <th class="p1 px-md py-sm text-left">Total</th> 
                <th class="p1 px-md py-sm text-left">Order Number</th>
                <th class="p1 px-md py-sm text-right"></th>
              </tr>
              {% for order in customer.orders %}
                <tr class="account__order w-full border-b border-[#F0F3F6]" js-order-desktop>
                  <td class="p2 px-md py-sm text-left">{{ order.created_at | date: "%B %d, %y" }}</td> 
                  <td class="p2 px-md py-sm text-left">
                    <div class="px-sm py-xs flex justify-start items-center gap-xxs">
                      {% case order.fulfillment_status %}
                        {% when 'complete' %}
                          <span class="w-[12px] h-[12px] bg-[#40C1AC] border border-[#40C1AC] rounded-full"></span>
                        {% when 'fulfilled' %}
                          <span class="w-[12px] h-[12px] bg-[#40C1AC] border border-[#40C1AC] rounded-full"></span>
                        {% when 'partial' %}
                          <span class="w-[12px] h-[12px] bg-yellow-light border border-yellow-light rounded-full"></span>
                        {% when 'restocked' %}
                          <span class="w-[12px] h-[12px] bg-yellow-light border border-yellow-light rounded-full"></span>
                        {% when 'unfulfilled' %}
                          <span class="w-[12px] h-[12px] bg-[#D6E4F3] border border-[#D6E4F3] rounded-full"></span>
                        {% else %}
                      {% endcase %}
                      <p class="p2">{{ order.fulfillment_status_label }}</p>
                    </div>
                  </td> 
                  <td class="p2 px-md py-sm text-left">{{ order.total_price | money }}</td> 
                  <td class="p2 px-md py-sm text-left">{{ order.id }}</td>
                  <td class="p2 px-md py-sm text-right">
                    <button id="{{ order.id }}-tab" class="tab__trigger link link--underline" aria-controls="{{ order.id }}-content-panel" role="tab" aria-selected="true" js-tab>
                      View Details
                    </button>
                  </td>
                </tr>
              {% endfor %}
            </table>
            <div class="grid gap-sm desktop:hidden" js-orders-mobile>
              {% for order in customer.orders %}
                <div class="account__order bg-white" js-order-mobile>
                  <div class="flex justify-between items-center">
                    <p class="p2 px-sm py-xs">{{ order.created_at | date: "%B %d, %y" }}</p>
                    <button id="{{ order.id }}-tab" class="tab__trigger link link--underline p2 px-sm py-xs" aria-controls="{{ order.id }}-content-panel" role="tab" aria-selected="true" js-tab>
                      View Details
                    </button>
                  </div>
                  <div class="px-sm py-xs flex justify-start items-center gap-xxs">
                    {% case order.fulfillment_status %}
                      {% when 'complete' %}
                        <span class="w-[12px] h-[12px] bg-[#40C1AC] border border-[#40C1AC] rounded-full"></span>
                      {% when 'fulfilled' %}
                        <span class="w-[12px] h-[12px] bg-[#40C1AC] border border-[#40C1AC] rounded-full"></span>
                      {% when 'partial' %}
                        <span class="w-[12px] h-[12px] bg-yellow-light border border-yellow-light rounded-full"></span>
                      {% when 'restocked' %}
                        <span class="w-[12px] h-[12px] bg-yellow-light border border-yellow-light rounded-full"></span>
                      {% when 'unfulfilled' %}
                        <span class="w-[12px] h-[12px] bg-[#D6E4F3] border border-[#D6E4F3] rounded-full"></span>
                      {% else %}
                    {% endcase %}
                    <p class="p2">{{ order.fulfillment_status_label }}</p>
                  </div>
                  <div class="flex justify-between items-center">
                    <p class="p2 px-sm py-xs">{{ order.total_price | money }}</p>
                    <p class="p2 px-sm py-xs">{{ order.id }}</p>
                  </div>
                </div>
              {% endfor %}
            </div>
            {% if paginate.next %}
              <button class="p2 w-full px-md py-sm bg-white mt-sm text-left link link--underline text-center desktop:mt-0 desktop:text-left" 
                data-url="{{ paginate.next.url }}" 
                js-next-page>
                Load More
              </button>
            {% endif %}
          {% endpaginate %}
        {% else %}
          <div class="account__rte h-full p2">
            <p>You haven't placed any orders yet.</p>
          </div>
        {% endif %}
      </div>
    </div>            
  </div>
{% endcapture %}

{% comment %} 
  Device & Warranty Content
{% endcomment %}
{% capture devices_and_warranty %}
  <div class="account__section">
    <h4 class="mt-md text-center min-h-[50px] flex justify-center items-center desktop:mt-0 desktop:text-left desktop:justify-start">Devices & Warranty</h4>
    <div class="mt-md grid gap-md">
      <div class="account-content">
        <iframe class="iframe-container w-full h-[1020px] border-0" src="https://acct66616.extforms.netsuite.com/app/site/hosting/scriptlet.nl?script=2087&deploy=1&compid=ACCT66616&ns-at=AAEJ7tMQd5YN4YljuCQ07j1ZLwmp8-Wa5uPu4ol4DeKznw8De9w&uid={{ customer.metafields.blueair.gigya_uid }}&country={{ localization.country.iso_code }}&locale={{ localization.language.iso_code  }}_{{ localization.country.iso_code }}"></iframe>
			</div>
      </div>
    </div>            
  </div>
{% endcapture %}

<s-account class="account block w-full min-h-[90vh] bg-gray-athans pb-md" data-customer-email="{{ customer.email }}">
  <div class="tabletl:max-w-[var(--max-width-desktop)] tabletl:mx-auto" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
    <s-tabs class="account__container block w-full min-h-[90vh] p-md pb-xxl desktop:grid desktop:grid-cols-12 desktop:gap-x-md desktop:px-xl desktop:py-xxl" js-account-tabs-container>
      <div class="account__header flex flex-col desktop:col-span-3 desktop:bg-white desktop:h-full">
        <div class="bg-blue text-white text-center p-sm">
          <p class="account__title s1">Hello {{customer.first_name}}</p>
        </div>

        <!-- Mobile Navigation -->
        <div class="flex justify-start relative h-[56px] desktop:hidden">
          <s-accordion data-manual-collapse="false" class="w-full block absolute left-0 top-0" js-accordion>
            <div class="accordion-item" js-accordion-item>
              <button class="accordion-header p1 p-xs flex items-center justify-between gap-xs w-full bg-white h-[56px]" aria-expanded="false" aria-controls="AccountSectionsAccordion" js-accordion-header js-account-trigger-accoridon-header>
                <span js-account-label>{{ sections[0] }}</span>
                <span class="accordion-icon--caret-down w-[24px] leading-[0px]">{% render 'icon-active-down' %}</span>
              </button>
              <div id="AccountSectionsAccordion" class="accordion-content bg-white shadow-md" role="tablist" aria-hidden="true" aria-orientation="horizontal" js-accordion-content js-tablist>
                {% for section in sections %}
                  <button id="{{ section | handleize }}-tab" class="tab__trigger block w-full p2 px-xs pb-xs link text-left" 
                    role="tab" 
                    aria-controls="{{ section | handleize }}-content-panel" 
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" 
                    data-label="{{ section }}"
                    js-tab
                    js-account-tab>
                    {{ section | escape }}
                  </button>
                {% endfor %}
                <a href="https://5ef43d-4a.myshopify.com/apps/sso/moas/broker/login/shopify/slo/logout" class="block w-full p2 px-xs pb-xs link text-left">Sign Out</a>
              </div>
            </div>
          </s-accordion>
        </div>

        <!-- Desktop Navigation -->
        <ul class="hidden desktop:block" role="list">
          {% for section in sections %}
            {% capture value_id %}AccountSection-{{ section | handleize }}{% endcapture %}
            <li class="border-b border-[#F0F3F6]">
              <input type="radio"
                name="AccountSections"
                value="{{ section | handleize }}"
                id="{{ value_id }}"
                class="account-section__input visually-hidden"
                {% if forloop.first %}checked{% endif %}>
              <label 
                for="{{ value_id }}" 
                class="account-section__label flex justify-start items-center gap-xs p-sm"
                role="tab" 
                aria-controls="{{ section | handleize }}-content-panel" 
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" 
                data-label="{{ section }}"
                js-tab
                js-account-tab>
                <span class="account-section-label__checkbox w-[24px] min-w-[24px] h-[24px] border border-gray rounded-full relative"></span>
                <span class="account-section-label__text p1 leading-none">
                  {{ section | escape }}
                </span>
              </label>
            </li>                          
          {%- endfor -%}
          <li class="border-b border-[#F0F3F6]">
            <input type="radio"
              name="AccountSections"
              id="AccountLogOut"
              onclick="window.location='https://5ef43d-4a.myshopify.com/apps/sso/moas/broker/login/shopify/slo/logout';"
              class="account-section__input visually-hidden">
            <label 
              for="AccountLogOut" 
              class="account-section__label flex justify-start items-center gap-xs p-sm">
              <span class="account-section-label__checkbox w-[24px] min-w-[24px] h-[24px] border border-gray rounded-full relative"></span>
              <span class="account-section-label__text p1 leading-none">
                Sign Out
              </span>
            </label>
          </li>
        </ul>
      </div>

      <div class="account__sections desktop:col-span-9">
        <!-- Account Sections -->
        {% for section in sections %}
          <div id="{{ section | handleize }}-content-panel" class="tab__panel pt-md grid gap-y-md desktop:pt-0 desktop:gap-y-lg" 
            role="tabpanel" 
            aria-labelledby="{{ section | handleize }}-tab" 
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
            {% case section %}
            {% when 'My Profile' %}
              {{ my_profile_content }}
            {% when 'Filter Subscriptions' %}
              {{ filter_subscriptions }}
            {% when 'Order History' %}
              {{ order_history_content }}
            {% when 'Devices & Warranty' %}
              {{ devices_and_warranty }}
            {% endcase %}
          </div>
        {% endfor %}

        <!-- Account Orders -->
        <div js-orders-tabs>
          {% paginate customer.orders by 10 %}
            {% for order in customer.orders %}
              <div id="{{ order.id }}-content-panel" class="tab__panel" 
                role="tabpanel" 
                aria-labelledby="{{ order.id }}-tab" 
                aria-hidden="true">
                <div class="flex flex-col gap-md pb-xs justify-between items-center desktop:flex-row desktop:pb-0">
                  <h4 class="mt-md text-center min-h-[50px] flex justify-center items-center desktop:mt-0 desktop:text-left desktop:justify-start">Order History</h4>
                  <div class="flex flex-col-reverse gap-md items-center desktop:flex-row">
                    <button class="btn flex justify-center items-center gap-xxs" js-return-button>
                      <span class="btn__arrow">{% render 'icon-arrow-left' %}</span>Go Back
                    </button>
                    <a href="{{ settings.start_return_url }}" target="_blank" rel="noopener noreferrer" class="btn btn--blue-rounded flex justify-center items-center gap-xxs whitespace-nowrap">
                      Start a Return<span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                    </a>
                  </div>
                </div>
                <div class="account__section">
                  <div class="mt-md grid gap-md">
                    <div class="account-order__details bg-white">
                      <div class="px-md py-sm grid justify-between items-center border-b border-[#F0F3F6] gap-xxs desktop:flex">
                        <p class="s1 text-blue">Order Details</p>
                        <p class="p1 text-blue">Order No. {{ order.id }}</p>
                      </div>
                      <div class="px-md py-sm">
                        <table class="w-full">
                          <tr>
                            <td class="p1">Subtotal</td>
                            <td class="text-right">{{ order.subtotal_price | money }}</td>
                          </tr>
                          {% if order.discounts.size > 0 %}
                            {% for discount in order.discounts %}
                              <tr>
                                <td>Promo ({{ discount.code }})</td>
                                <td class="text-right">{{ discount.savings | money }}</td>
                              </tr>
                            {% endfor %}
                          {% else %}
                            <tr>
                              <td class="p1">Promo</td>
                              <td class="text-right">{{ 0 | money }}</td>
                            </tr>
                          {% endif %}
                          <tr>
                            <td class="p1">Shipping</td>
                            <td class="text-right">{{ order.shipping_price | money }}</td>
                          </tr>
                          {% if order.tax_lines.size > 0 %}
                            {% for tax_line in order.tax_lines %}
                              <tr>
                                <td class="p1">{{ tax_line.title }}</td>
                                <td class="text-right">{{ tax_line.price | money }}</td>
                              </tr>
                            {% endfor %}
                          {% else %}
                            <tr>
                              <td class="p1">Tax</td>
                              <td class="text-right">{{ 0 | money }}</td>
                            </tr>          
                          {% endif %}
                          <tr>
                            <td class="p1">Total</td>
                            <td class="text-right">{{ order.total_price | money }}</td>
                          </tr>
                        </table>
                      </div>
                    </div>

                    <div class="account-order__shipments bg-white">
                      <div class="px-md py-sm flex justify-between items-center border-b border-[#F0F3F6]">
                        <p class="s1 text-blue">Future Shipments</p>
                      </div>
                      <div class="px-md py-sm">
                        <table class="block desktop:hidden">
                          <tr>
                            {% for item in order.line_items %}
                              <td class="account-order-item__title">
                                <p class="p1 mb-xxs">Product</p>
                                <p class="p2">{{ item.title }}</p>
                              </td>
                              <td class="account-order-item__title">
                                <p class="p1 mb-xxs">Filter Plan Subscription</p>
                                <p class="p2">{{ item.selling_plan_allocation.selling_plan.name | default: "-" }}</p>
                              </td>
                            {% endfor %}
                          </tr>
                        </table>
                        <table class="hidden desktop:block">
                          <tr>
                            <td class="p1">Product</td>
                            <td class="p1">Filter Plan Subscription</td>
                          </tr>
                          <tr>
                            {% for item in order.line_items %}
                              <td class="account-order-item__title">
                                <p class="p2">{{ item.title }}</p>
                              </td>
                              <td class="account-order-item__title">{{ item.selling_plan_allocation.selling_plan.name | default: "-" }}</td>
                            {% endfor %}
                          </tr>
                        </table>
                      </div>
                    </div>

                    <div class="account-order__contact bg-white">
                      <div class="px-md py-sm flex justify-between items-center border-b border-[#F0F3F6]">
                        <p class="s1 text-blue">Contact</p>
                      </div>
                      <div class="px-md py-sm">
                        <table>
                          <tr>
                            <td class="p1">Email</td>
                          </tr>
                          <tr>
                            <td class="p2">{{ order.customer.email }}</td>
                          </tr>
                        </table>
                      </div>
                    </div>

                    <div class="account-order__shipping bg-white">
                      <div class="px-md py-sm flex justify-between items-center border-b border-[#F0F3F6]">
                        <p class="s1 text-blue">Shipping</p>
                      </div>
                      <div class="px-md py-sm">
                        <table class="block desktop:hidden">
                          <tr>
                            <td>
                              <p class="p1 mb-xxs">Primary Address</p>
                              <div class="p2">
                                <p>{{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}</p>
                                {%- if order.shipping_address.company != blank -%}
                                  <p>{{ order.shipping_address.company }}</p>
                                {%- endif -%}
                                <p>{{ order.shipping_address.address1 }}</p>
                                {%- if order.shipping_address.address2 != blank -%}
                                  <p>{{ order.shipping_address.address2 }}</p>
                                {%- endif -%}
                                <p>{{ order.shipping_address.city }}, {{ order.shipping_address.province_code }} {{ order.shipping_address.zip }}</p>
                                <p>{{ order.shipping_address.country }}</p>
                              </div>
                            </td>
                            <td>
                              <p class="p1 mb-xxs">Shipping Method</p>
                              <div class="p2">
                                {% if order.shipping_methods.length > 0 %}
                                  {% for shipping_method in order.shipping_methods limit: 1 %}
                                    <p>{{ shipping_method.title }}</p>
                                  {% endfor %}
                                {% else %}
                                -
                                {% endif %}
                              </div>
                            </td>
                          </tr>
                        </table>
                        <table class="hidden desktop:block">
                          <tr>
                            <td class="p1">Primary Address</td>
                            <td class="p1">Shipping Method</td>
                          </tr>
                          <tr>
                            <td class="p2">
                              <p>{{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}</p>
                              {%- if order.shipping_address.company != blank -%}
                                <p>{{ order.shipping_address.company }}</p>
                              {%- endif -%}
                              <p>{{ order.shipping_address.address1 }}</p>
                              {%- if order.shipping_address.address2 != blank -%}
                                <p>{{ order.shipping_address.address2 }}</p>
                              {%- endif -%}
                              <p>{{ order.shipping_address.city }}, {{ order.shipping_address.province_code }} {{ order.shipping_address.zip }}</p>
                              <p>{{ order.shipping_address.country }}</p>
                            </td>
                            <td class="p2">
                              {% if order.shipping_methods.length > 0 %}
                                {% for shipping_method in order.shipping_methods limit: 1 %}
                                  <p>{{ shipping_method.title }}</p>
                                {% endfor %}
                              {% else %}
                              -
                              {% endif %}
                            </td>
                          </tr>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% endpaginate %}
        </div>
      </div>
    </s-tabs>
  </div>

  <!-- Add Address Modal -->
  <s-modal id="addAddressModal" class="w-11/12 max-w-[550px] desktop:w-full" open="[js-open-add-address]" close="[js-close-add-address]">
    <div class="account-address__modal">
      <header class="account-address-modal__header px-md py-sm flex justify-between items-center">
        <p class="account__subtitle h6 font-400 text-blue">New Address</p>
        <button class="account__close btn p-0 text-blue border-0" js-close-add-address>
          <span class="w-[33px]">{% render 'icon-close-no-border' %}</span>
        </button>
      </header>
      {%- form 'customer_address', customer.new_address -%}
        <div class="px-md py-sm">
          {%- if form.errors -%}
            <ul class="form__errors">
              {% for field in form.errors %}
                <li>
                  {% if field == 'form' %}
                    {{ form.errors.messages[field] }}
                  {% else %}
                    {{ form.errors.translated_fields[field] }} - {{ form.errors.messages[field] }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {%- endif -%}
          <div class="grid grid-cols-2 gap-md mb-sm">
            <div class="relative">
              <label for="AddressFirstNameNew" class="form__label p1">First Name</label>
              <input type="text" id="AddressFirstNameNew" class="form__element" name="address[first_name]" value="{{ customer.first_name }}" autocomplete="given-name" placeholder="First Name">
            </div>
            <div class="relative">
              <label for="AddressLastNameNew" class="form__label p1">Last Name</label>
              <input type="text" id="AddressLastNameNew" class="form__element" name="address[last_name]" value="{{ customer.last_name }}" autocomplete="family-name" placeholder="Last Name">
            </div>
          </div>
          <div class="relative mb-sm">
            <label for="AddressCompanyNew" class="form__label p1">Company</label>
            <input type="text" id="AddressCompanyNew" class="form__element" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder="Company">
          </div>
          <div class="relative mb-sm">
            <label for="AddressAddress1New" class="form__label p1">Address 1</label>
            <input type="text" id="AddressAddress1New" class="form__element" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="Address 1">
          </div>
          <div class="relative mb-sm">
            <label for="AddressAddress2New" class="form__label p1">Address 2</label>
            <input type="text" id="AddressAddress2New" class="form__element" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="Address 2">
          </div>
          <div class="grid grid-cols-2 gap-md mb-sm">
            <div class="relative">
              <label for="AddressCountryNew" class="form__label p1">Country</label>
              <select id="AddressCountryNew" class="form__element" name="address[country]" data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select>
            </div>
            <div id="AddressProvinceContainerNew" class="relative">
              <label for="AddressProvinceNew" class="form__label p1">State/Province</label>
              <select id="AddressProvinceNew" class="form__element" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-md mb-sm">
            <div class="relative">     
              <label for="AddressCityNew" class="form__label p1">City</label>     
              <input type="text" id="AddressCityNew" class="form__element" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="City">
            </div>
            <div class="relative">
              <label for="AddressZipNew" class="form__label p1">Postal/Zip Code</label>
              <input type="text" id="AddressZipNew" class="form__element" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="Postal/Zip Code">
            </div>
          </div>
          <div class="relative mb-md">
            <label for="AddressPhoneNew" class="form__label p1">Phone Number</label>
            <input type="tel" id="AddressPhoneNew" class="form__element" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="Phone Number">
          </div>
          <div class="relative flex items-center justify-start gap-xxs mb-xs">
            <input type="checkbox" id="address_default_address_new" name="address[default]" value="1" class="account-address__input visually-hidden">
            <label for="address_default_address_new" class="account-address__label flex justify-start items-center gap-xxs">
              <span class="account-address-label__checkbox w-[22px] min-w-[22px] h-[22px] rounded[2px] border border-[#121A2230] relative"></span>
              <span class="account-address-label__text p2 flex-1">
                Set as default
              </span>
            </label>
          </div>
          <div class="flex justify-end items-center">
            <button class="btn btn--blue-rounded flex justify-center items-center gap-xxs">
              Save Address<span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
            </button>
          </div>
        </div>
      {%- endform -%}
    </div>
  </s-modal>

  <!-- Edit Address Modal -->
  <s-modal id="editAddressModal" class="w-11/12 max-w-[550px] desktop:w-full" open="[js-open-edit-address]" close="[js-close-edit-address]" js-edit-address-modal>
    <div class="account-address__modal">
      <header class="account-address-modal__header px-md py-sm flex justify-between items-center">
        <p class="account__subtitle h6 font-400 text-blue">Edit Address</p>
        <button class="account__close btn p-0 text-blue border-0" js-close-edit-address>
          <span class="w-[33px]">{% render 'icon-close-no-border' %}</span>
        </button>
      </header>
      {% for address in customer.addresses %}
        {% form 'customer_address', address, class: 'hidden', js-edit-address-form: '' %}
          <div class="px-md py-sm">
            <div class="grid grid-cols-2 gap-md mb-sm">
              <div class="relative">
                <label for="AddressFirstName_{{ form.id }}" class="form__label p1">First Name</label>
                <input type="text" id="AddressFirstName_{{ form.id }}" class="form__element" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder="First Name">
              </div>
              <div class="relative">
                <label for="AddressLastName_{{ form.id }}" class="form__label p1">Last Name</label>
                <input type="text" id="AddressLastName_{{ form.id }}" class="form__element" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder="Last Name">
              </div>
            </div>
            <div class="relative mb-sm">
              <label for="AddressCompany_{{ form.id }}" class="form__label p1">Company</label>
              <input type="text" id="AddressCompany_{{ form.id }}" class="form__element" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder="Company">
            </div>
            <div class="relative mb-sm">
              <label for="AddressAddress1_{{ form.id }}" class="form__label p1">Address 1</label>
              <input type="text" id="AddressAddress1_{{ form.id }}" class="form__element" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="Address 1">
            </div>
            <div class="relative mb-sm">
              <label for="AddressAddress2_{{ form.id }}" class="form__label p1">Address 2</label>
              <input type="text" id="AddressAddress2_{{ form.id }}" class="form__element" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="Address 2">
            </div>
            <div class="grid grid-cols-2 gap-md mb-sm">
              <div class="relative">
                <label for="AddressCountry_{{ form.id }}" class="form__label p1">Country</label>
                <select id="AddressCountry_{{ form.id }}" class="form__element" name="address[country]" data-default="{{ form.country }}" autocomplete="country" data-form-id="{{ form.id }}" js-country-select>{{ all_country_option_tags }}</select>
              </div>
              <div id="AddressProvinceContainer_{{ form.id }}" class="relative">
                <label for="AddressProvince_{{ form.id }}" class="form__label p1">State/Province</label>
                <select id="AddressProvince_{{ form.id }}" class="form__element" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-md mb-sm">
              <div class="relative">     
                <label for="AddressCity_{{ form.id }}" class="form__label p1">City</label>
                <input type="text" id="AddressCity_{{ form.id }}" class="form__element" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="City">
              </div>
              <div class="relative">
                <label for="AddressZip_{{ form.id }}" class="form__label p1">Postal/Zip Code</label>
                <input type="text" id="AddressZip_{{ form.id }}" class="form__element" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="Postal/Zip Code">
              </div>
            </div>
            <div class="relative mb-md">
              <label for="AddressPhone_{{ form.id }}" class="form__label p1">Phone Number</label>
              <input type="tel" id="AddressPhone_{{form.id}}" class="form__element" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="Phone Number">
            </div>
            <div class="relative flex items-center justify-start gap-xxs mb-xs">
              {{ form.set_as_default_checkbox }}
              <label for="address_default_address_{{form.id}}" class="account-address__label flex justify-start items-center gap-xxs">
                <span class="account-address-label__checkbox w-[22px] min-w-[22px] h-[22px] rounded[2px] border border-[#121A2230] relative"></span>
                <span class="account-address-label__text p2 flex-1">
                  Make this my default shipping address
                </span>
              </label>
            </div>
            <div class="flex justify-end items-center gap-md">
              <button type="button" class="account-address__edit-delete link text-pink-fuschia" data-target="{{address.url}}" js-delete-address>Delete Address</button>
              <button type="submit" class="btn btn--blue-rounded flex justify-center items-center gap-xxs">
                Save changes<span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
              </button>
            </div>
          </div>
        {% endform %}
      {% endfor %}
  </s-modal>
</s-account>

{% schema %}
{
  "name": "Account",
  "settings": [
  ]
}
{% endschema %}
