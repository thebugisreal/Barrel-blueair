<section class="account self-center justify-self-center w-full max-w-[475px]">
  <div class="account__container border">
    <div class="account__links w-full grid grid-cols-2">
      <div class="w-full flex items-center justify-center text-center">Sign In</div>
      <a href="/account/register" class="btn">Create Account</a>
    </div>
    
    {%- form 'recover_customer_password', id: 'recover', class: 'account-login__forgot hidden' -%}
      {% assign recover_success = form.posted_successfully? %}
      <h1 class="account__title">Reset Password</h1>
      <p class="">We will send you an email to reset your password.</p>

      {%- if form.errors -%}
        <ul class="form__errors">
          {% for field in form.errors %}
            <li>
              {% if field == 'form' %}
                {{ form.errors.messages[field] }}
              {% else %}
                {{ form.errors.translated_fields[field] }} - {{ form.errors.messages[field] }}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {%- endif -%}

      <div class="relative">
        <label for="RecoverEmail" class="form__label">
          Email Address
        </label>
        <input type="email"
          value=""
          name="email"
          id="RecoverEmail"
          class="form__element"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="RecoverEmail-email-error"
            autofocus
          {% endif %}
          placeholder="Email Address"
        >
      </div>

      
      <button class="btn w-full">Submit</button>
      <a href="#login">Cancel</a>
    {%- endform -%}

    {%- form 'customer_login', id: 'login', class: 'account-login__login', novalidate: 'novalidate' -%}
      <h1 class="account__title">My Account</h1>
      {%- if recover_success == true -%}
        <p class="">We've sent you an email with a link to update your password.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <ul class="form__errors">
          {% for field in form.errors %}
            <li>
              {% if field == 'form' %}
                {{ form.errors.messages[field] }}
              {% else %}
                {{ form.errors.translated_fields[field] }} - {{ form.errors.messages[field] }}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {%- endif -%}

      <div class="relative">
        <label for="CustomerEmail" class="form__label">
          Email Address
        </label>        
        <input
          type="email"
          name="customer[email]"
          id="CustomerEmail"
          class="form__element"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          {% if form.errors contains 'form' %}
            aria-invalid="true"
          {% endif %}
          placeholder="Email Address"
        >
      </div>

      <div class="relative">
        <label for="CustomerPassword" class="form__label">
          Password
        </label>          
        <input
          type="password"
          value=""
          name="customer[password]"
          id="CustomerPassword"
          class="form__element"
          autocomplete="current-password"
          {% if form.errors contains 'form' %}
            aria-invalid="true"
          {% endif %}
          placeholder="Password"
        >
      </div>

      <input type="submit" class="btn" value="Sign In">
      <a href="#recover">Forgot Password?</a>
    {%- endform -%}
  </div>
</section>