<s-login>
  <div class="gigya-screen-set" id="simple-screen-set" style="display:none" data-on-pending-registration-screen="complete-registration-screen">
    <!-- Account Login -->
    <div class="gigya-screen" id="login-screen" data-caption="Login">
      <div class="account__login w-full min-h-[100vh] flex flex-col bg-gray-athans text-center p-md desktop:p-xl">
        <div class="py-lg mt-[var(--header-height)]">
          <form class="gigya-login-form" onsubmit="return false;" method="post" data-screenset-element-id="gigya-login-form" data-screenset-element-id-publish="true" data-screenset-roles="instance" id="gigya-login-form" data-on-success-screen="complete-registration-screen">
            <h2 class="mb-lg">Sign into your Blueair account</h2>
            <div class="max-w-[400px] mx-auto pb-xxl flex flex-col justify-center items-center">
              <div class="relative w-full mb-md">
                <label for="GigyaCustomerEmail" class="form__label p2 text-left block w-full">
                  Email Address
                </label>        
                <input
                  type="email"
                  name="loginID"
                  id="GigyaCustomerEmail"
                  class="form__element w-full h-[60px] border px-xs py-xxs"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder="Email Address"
                >
                <div class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="loginID"></div>
              </div>

              <div class="relative w-full mb-md">
                <label for="GigyaCustomerPassword" class="form__label p2 text-left block w-full">
                  Password
                </label>
                <input
                  type="password"
                  value=""
                  name="password"
                  id="GigyaCustomerPassword"
                  class="form__element w-full h-[60px] border px-xs py-xxs"
                  autocomplete="current-password"
                  placeholder="Password"
                >
                <div class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="password"></div>
              </div>

              <div class="w-full mb-lg text-right">
                <a tabindex="0" href="javascript:void(0)" data-switch-screen="forgot-password-screen" class="link--underline p2">Forgot Password?</a>
              </div>

              <input id="AccountLogin" class="gigya-input-submit visually-hidden" tabindex="0" type="submit" data-gigya-type="submit" data-screenset-element-id-publish="false" data-screenset-roles="instance" gigya-default-value="null" value="Sign In">
              <label for="AccountLogin" class="btn btn--blue-rounded">
                <span class="btn__text">Sign In</span>
                <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
              </label>

              <div class="w-full flex justify-center items-center mt-md">
                <a href="/account/register" data-switch-screen="registration-screen" class="btn btn--white-rounded">
                  <span class="btn__text">Create an Account</span>
                  <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                </a>
              </div>
            </div>
          </form>

          {% comment %}
          {%- form 'customer_login', id: 'login', class: 'account-login__login', novalidate: 'novalidate' -%}
            {%- if recover_success == true -%}
              <p class="">We've sent you an email with a link to update your password.</p>
            {%- endif -%}
            {%- if form.errors -%}
              <ul class="form__errors">
                {% for field in form.errors %}
                  <li>
                    {% if field == 'form' %}
                      {{ form.errors.messages[field] }}
                    {% else %}
                      {{ form.errors.translated_fields[field] }} - {{ form.errors.messages[field] }}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            {%- endif -%}

            <div class="relative">
              <label for="CustomerEmail" class="form__label">
                Email Address
              </label>        
              <input
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                class="form__element"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors contains 'form' %}
                  aria-invalid="false"
                {% endif %}
                placeholder="Email Address"
              >
            </div>

            <div class="relative">
              <label for="CustomerPassword" class="form__label">
                Password
              </label>          
              <input
                type="password"
                value=""
                name="customer[password]"
                id="CustomerPassword"
                class="form__element"
                autocomplete="current-password"
                {% if form.errors contains 'form' %}
                  aria-invalid="false"
                {% endif %}
                placeholder="Password"
              >
            </div>

            <input id="AccountSubmit" type="submit" class="btn" value="Sign In">
            <a href="#recover">Forgot Password?</a>
          {%- endform -%}
          {% endcomment %}
        </div>
      </div>
    </div>

    <!-- Account Registration -->
    <div class="gigya-screen" id="registration-screen" data-caption="Register">
      <div class="account__login w-full min-h-[100vh] flex flex-col bg-gray-athans text-center p-md desktop:p-xl">
        <div class="py-lg mt-[var(--header-height)]">
          <h2 class="mb-lg">Create an Account</h2>
          <div class="max-w-[624px] mx-auto pb-xxl">
            <form class="gigya-register-form" onsubmit="return false;" method="post" data-screenset-element-id="gigya-register-form" data-screenset-element-id-publish="true" data-screenset-roles="instance" id="gigya-register-form" data-on-success-screen="complete-registration-screen">
              <div class="grid grid-cols-2 gap-md mb-md">
                <div class="gigya-composite-control gigya-composite-control-textbox account__input w-full">
                  <label class="gigya-label w-full block" data-binding="true" data-screenset-element-id-publish="false" data-screenset-roles="instance">
                    <span class="gigya-label-text p2 text-left w-full block" data-screenset-element-id-publish="false" data-screenset-roles="instance,template">First Name</span>
                  </label>
                  <input aria-label="First name" class="gigya-input-text w-full h-[60px] border px-xs py-xxs" name="profile.firstName" show-valid-checkmark="true" formnovalidate="formnovalidate" tabindex="0" type="text" data-gigya-type="text" data-screenset-element-id-publish="true" data-screenset-roles="instance" data-gigya-name="profile.firstName" data-original-value="" maxlength="32" aria-required="true" aria-invalid="false" autocomplete="off">
                  <span class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="profile.firstName"></span>
                </div>
                <div class="gigya-composite-control gigya-composite-control-textbox account__input w-full">
                  <label class="gigya-label w-full block" data-binding="true" data-screenset-element-id-publish="false" data-screenset-roles="instance">
                    <span class="gigya-label-text p2 text-left w-full block" data-screenset-element-id-publish="false" data-screenset-roles="instance,template">Last Name</span>
                  </label>
                  <input aria-label="Last name" class="gigya-input-text w-full h-[60px] border px-xs py-xxs" name="profile.lastName" show-valid-checkmark="true" formnovalidate="formnovalidate" tabindex="0" type="text" data-gigya-type="text" data-screenset-element-id-publish="true" data-screenset-roles="instance" data-gigya-name="profile.lastName" data-original-value="" maxlength="32" aria-required="true" aria-invalid="false" autocomplete="off">
                  <span class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="profile.lastName"></span>
                </div>
              </div>

              <div class="gigya-composite-control gigya-composite-control-textbox account__input w-full mb-md">
                <label class="gigya-label w-full block" data-binding="true" data-screenset-element-id-publish="false" data-screenset-roles="instance">
                  <span class="gigya-label-text p2 text-left w-full block" data-screenset-element-id-publish="false" data-screenset-roles="instance,template">Email address</span>
                </label>
                <input class="gigya-input-text w-full h-[60px] border px-xs py-xxs" name="email" autocomplete="new-password" show-valid-checkmark="true" data-display-name="" aria-label="Email" formnovalidate="formnovalidate" tabindex="0" type="text" data-screenset-element-id-publish="true" data-screenset-roles="instance" data-gigya-name="email" data-original-value="" maxlength="254" aria-required="true" aria-invalid="false">
                <span class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="email"></span>
              </div>

              <div class="gigya-composite-control gigya-composite-control-textbox account__input w-full mb-md">
                <label class="gigya-label w-full block" data-binding="true" data-screenset-element-id-publish="false" data-screenset-roles="instance">
                  <span class="gigya-label-text p2 text-left w-full block" data-screenset-element-id-publish="false" data-screenset-roles="instance,template">Password</span>
                </label>
                <input aria-label="Password" name="password" class="gigya-input-password w-full h-[60px] border px-xs py-xxs" show-valid-checkmark="true" tabindex="0" show-password-strength="left" gigya-conditional:show-password-strength="viewport.width < 920?up" type="password" autocomplete="new-password" data-screenset-element-id-publish="true" data-screenset-roles="instance" gigya-default-show-password-strength="left" data-gigya-name="password" data-original-value="" aria-required="true" aria-invalid="false">
                <div class="gigya-password-strength" data-bound-to="password" data-on-focus-bubble="true"></div>
                <span class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="password"></span>
                <p class="gigya-composite-control gigya-composite-control-label gigya-info-text p2 text-left mt-sm" data-binding="true" data-screenset-element-id-publish="false" data-screenset-roles="template,instance,instance">Your password must be at least 10 characters long and include at least one lowercase letter, one uppercase letter, one number and one special character.</p>
              </div>

              <div class="gigya-composite-control gigya-composite-control-textbox account__input w-full mb-md">
                <label class="gigya-label w-full block" data-binding="true" data-screenset-element-id-publish="false" data-screenset-roles="instance">
                  <span class="gigya-label-text p2 text-left w-full block" data-screenset-element-id-publish="false" data-screenset-roles="instance,template">Confirm Password</span>
                </label>
                <input aria-label="Confirm password" class="gigya-input-password w-full h-[60px] border px-xs py-xxs" name="passwordRetype" tabindex="0" show-valid-checkmark="true" data-required="true" type="password" autocomplete="off" data-screenset-element-id-publish="true" data-screenset-roles="instance" data-gigya-name="passwordRetype" data-original-value="" aria-required="true" aria-invalid="false">
                <span class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="passwordRetype"></span>
              </div>

              <div class="gigya-composite-control gigya-composite-control-checkbox gigya-age-consent flex mb-md" aria-invalid="false">
                <input class="gigya-input-checkbox" name="preferences.ageConsentGranted.isConsentGranted" type="checkbox" data-screenset-element-id="gigya-checkbox-age" data-screenset-element-id-publish="true" data-screenset-roles="instance" data-gigya-name="preferences.ageConsentGranted.isConsentGranted" data-original-value="false" id="gigya-checkbox-age" aria-required="true">
                <label class="gigya-label text-left" data-binding="true" data-screenset-element-id-publish="false" data-screenset-roles="instance" for="gigya-checkbox-age">
                  <span class="gigya-label-text gigya-checkbox-text p2 text-left" data-screenset-element-id-publish="false" data-screenset-roles="instance,template">Yes - I confirm that I am over 16 years old</span>
                </label>
              </div>

              <div class="gigya-composite-control gigya-composite-control-checkbox gigya-register-addtolist flex mb-md" aria-invalid="false">
                <input class="gigya-input-checkbox" name="subscriptions.optInOptOut.BRAND_XX_BH8488_EML.email.isSubscribed" type="checkbox" checked="checked" data-screenset-element-id="gigya-checkbox-promo" data-screenset-element-id-publish="true" data-screenset-roles="instance" data-gigya-name="subscriptions.optInOptOut.BRAND_XX_BH8488_EML.email.isSubscribed" data-original-value="true" id="gigya-checkbox-promo" aria-required="false">
                <label class="gigya-label text-left" data-binding="true"  data-screenset-element-id-publish="false" data-screenset-roles="instance" for="gigya-checkbox-promo">
                  <span class="gigya-label-text gigya-checkbox-text p2 text-left" data-screenset-element-id-publish="false" data-screenset-roles="instance,template">Yes, I would like to receive promotional offers, communications, and updates from Blueair and its affiliates via email and online advertising tailored to my interests and preferences.</span>
                </label>
              </div>

              <p class="p2 text-left">Please read our <a href="{{ section.settings.privacy_notice_url }}" class="link--underline">Privacy Notice</a> to understand how we collect, use, transfer and store your data.</p>

              <div class="flex justify-center items-center w-full flex justify-center items-center mt-lg pt-md">
                <input id="AccountRegister" class="visually-hidden" type="submit" value="Register">
                <label for="AccountRegister" class="btn btn--blue-rounded">
                  <span class="btn__text">Create Account</span>
                  <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                </label>
              </div>
            </form>

            <div class="flex flex-col justify-center items-center w-full flex justify-center items-center mt-lg pt-md">
              <p class="h6">Already have an Account?</p>
              <a href="/account" data-switch-screen="login-screen" class="btn btn--blue-rounded mt-md">
                <span class="btn__text">Sign In</span>
                <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Forgot Password -->
    <div class="gigya-screen" id="forgot-password-screen" data-caption="Forgot Password">
      <div class="account__login w-full min-h-[100vh] flex flex-col bg-gray-athans text-center p-md desktop:p-xl">
        <div class="py-lg mt-[var(--header-height)]">
          <form class="gigya-reset-password-form" data-on-success-screen="forgot-password-success-screen" onsubmit="return false;" method="post" data-screenset-element-id="gigya-reset-password-form" data-screenset-element-id-publish="true" data-screenset-roles="instance" id="gigya-reset-password-form">
            <h2 class="mb-sm">Reset Password</h2>
            <div class="max-w-[400px] mx-auto pb-xxl flex flex-col justify-center items-center">
              <label class="gigya-composite-control gigya-composite-control-label p2 mb-lg text-center" data-screenset-element-id-publish="false" data-screenset-roles="instance">
                Enter your email and we'll send you a link to reset your password
              </label>
       
              <div class="gigya-layout-row relative w-full mb-lg">
                <div class="gigya-composite-control gigya-composite-control-textbox email-wrapper" style="display: block;">
                  <label class="gigya-label form__label p2 text-left block w-full" for="gigya-textbox-loginID">
                    <span class="gigya-label-text" data-screenset-element-id-publish="false" data-screenset-roles="instance">Email Address</span>
                  </label>
                  <input type="text" name="username" class="gigya-input-text form__element w-full h-[60px] border px-xs py-xxs" formnovalidate="formnovalidate" tabindex="0" data-screenset-element-id="gigya-textbox-loginID" data-screenset-element-id-publish="true" data-screenset-roles="instance" data-gigya-name="loginID" data-original-value="" id="gigya-textbox-loginID" aria-required="true">
                  <span class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="loginID" data-screenset-element-id-publish="false" data-screenset-roles="instance" aria-atomic="true"></span>
                </div>
              </div>

              <div class="gigya-layout-row">
                <div class="gigya-composite-control gigya-composite-control-submit submit-wrapper">
                  <input id="forgotPasswordSubmit" type="submit" class="gigya-input-submit hidden" tabindex="0" data-screenset-element-id-publish="false" data-screenset-roles="instance" gigya-default-value="null" value="Submit">
                  <label for="forgotPasswordSubmit" class="btn btn--blue-rounded">
                    <span class="btn__text">Submit</span>
                    <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                  </label>
                </div>
                <div class="gigya-error-display gigya-composite-control gigya-composite-control-form-error" data-bound-to="gigya-reset-password-form" data-screenset-element-id-publish="false" data-screenset-roles="instance" aria-atomic="true">
                  <div class="gigya-error-msg text-left pt-xxs pb-xxxs gigya-form-error-msg" data-bound-to="gigya-reset-password-form" data-screenset-element-id-publish="false" data-screenset-roles="instance" aria-atomic="true">
                  </div>
                </div>
              </div>

              <div class="gigya-layout-row mt-md">
                <a class="gigya-composite-control gigya-composite-control-link link--underline" data-switch-screen="login-screen" tabindex="0" href="javascript:void(0)" role="button" title="Back to Login">
                  Back to Login
                </a>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Forgot Password Success-->
    <div class="gigya-screen" id="forgot-password-success-screen" data-caption="Forgot Password Success">
      <div class="account__login w-full min-h-[100vh] flex flex-col bg-gray-athans text-center p-md desktop:p-xl">
        <div class="py-lg mt-[var(--header-height)]">
          <form class="gigya-login-form-forgot" onsubmit="return false;" method="post" data-screenset-element-id="gigya-login-form-forgot" data-screenset-element-id-publish="true" data-screenset-roles="instance" data-gtm-form-interact-id="2" id="gigya-login-form-forgot">
            <h2 class="mb-lg">Sign into your Blueair account</h2>
            <div class="max-w-[400px] mx-auto pb-xxl flex flex-col justify-center items-center">
              <p class="p2 text-center mb-md">We've sent you an email with a link to update your password.</p>

              <div class="relative w-full mb-md">
                <label for="GiguaCustomerEmailFogot" class="form__label p2 text-left block w-full">
                  Email Address
                </label>        
                <input
                  type="email"
                  name="loginID"
                  id="GiguaCustomerEmailFogot"
                  class="form__element w-full h-[60px] border px-xs py-xxs"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  {% if form.errors contains 'form' %}
                    aria-invalid="false"
                  {% endif %}
                  placeholder="Email Address"
                >
                <div class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="loginID"></div>
              </div>

              <div class="relative w-full mb-md">
                <label for="GigyaCustomerPasswordForgot" class="form__label p2 text-left block w-full">
                  Password
                </label>          
                <input
                  type="password"
                  value=""
                  name="password"
                  id="GigyaCustomerPasswordForgot"
                  class="form__element w-full h-[60px] border px-xs py-xxs"
                  autocomplete="current-password"
                  {% if form.errors contains 'form' %}
                    aria-invalid="false"
                  {% endif %}
                  placeholder="Password"
                >
                <div class="gigya-error-msg text-left pt-xxs pb-xxxs" data-bound-to="password"></div>
              </div>

              <div class="w-full mb-lg text-right">
                <a tabindex="0" href="javascript:void(0)" data-switch-screen="forgot-password-screen" class="link--underline p2">Forgot Password?</a>
              </div>

              <input id="AccountLogin" type="submit" class="visually-hidden" value="Sign In">
              <label for="AccountLogin" class="btn btn--blue-rounded">
                <span class="btn__text">Sign In</span>
                <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
              </label>

              <div class="w-full flex justify-center items-center mt-md">
                <a href="/account/register" data-switch-screen="registration-screen" class="btn btn--white-rounded">
                  <span class="btn__text">Create an Account</span>
                  <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                </a>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="gigya-screen" id="complete-registration-screen" data-caption="Complete Register">
      <div class="account__login w-full min-h-[100vh] flex flex-col bg-gray-athans text-center p-md desktop:p-xl">
        <div class="py-lg mt-[var(--header-height)]">
          Testing
        </div>
      </div>
    </div>
  </div>

  <div class="hidden">
    <a href="#" onclick="gigya.accounts.showScreenSet({screenSet:'simple-screen-set', startScreen:'login-screen'});" js-login>Login</a>
    <a href="#" onclick="gigya.accounts.showScreenSet({screenSet:'simple-screen-set', startScreen:'registration-screen'});">Register</a>
    <a href="#" onclick="gigya.accounts.logout({callback:onLogout});">Logout</a>
  </div>
</s-login>

{% schema %}
{
  "name": "Account",
  "settings": [
    {
      "type": "header",
      "content": "Privacy Notice"
    },
    {
      "type": "url",
      "id": "privacy_notice_url",
      "label": "Page URL"
    }
  ]
}
{% endschema %}
