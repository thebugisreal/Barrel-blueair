<section class="section__image-caption tabletl:mx-auto {{ section.settings.margin_top }} {{ section.settings.margin_bottom }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }}" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
    <div class="section__image-caption-content mx-30 tabletl:mx-0">
        {% if section.settings.image != blank %}
            <div class="image-container relative mb-12">
                {% render 'lazy-image' image:section.settings.image, image_desktop:section.settings.image_desktop %}

                {% if section.settings.url != blank %}
                    <a href="{{ section.settings.url }}" class="image-url-link absolute top-12 left-12 tabletl:top-24 tabletl:left-24">
                        {% if section.settings.url_text != blank %}
                            <div class="flex items-center gap-[10px] bg-white py-8 px-12 w-fit">
                                <p class="text-p2">{{ section.settings.url_text }} </p>
                                <div class="w-[32px] border border-blue rounded-full">{%  render 'icon-arrows-diag' %}</div>
                            </div>
                        {% endif %}
                    </a>
                {% endif %}
            </div>
        {% endif %}
        {% if section.settings.caption != blank %}
            <p class="text-p6">{{ section.settings.caption }}</p>
        {% endif %}
    </div>
    
</section>

{% schema %}
    {
      "name": "Image + Caption",
      "tag": "section",
      "settings": [
        {
            "type": "select",
            "id": "margin_top",
            "label": "Margin Top - Mobile",
            "options": [
                { "value": "mt-xxxs", "label": "xxxs" },
                { "value": "mt-xxs", "label": "xxs" },
                { "value": "mt-xs", "label": "xs" },
                { "value": "mt-sm", "label": "sm" },
                { "value": "mt-md", "label": "md" },
                { "value": "mt-lg", "label": "lg" },
                { "value": "mt-xl", "label": "xl" },
                { "value": "mt-xxl", "label": "xxl" },
                { "value": "mt-xxxl", "label": "xxxl" },
                { "value": "mt-xxxxl", "label": "xxxxl" }
            ],
            "default": "mt-md"
        },
        {
            "type": "select",
            "id": "margin_bottom",
            "label": "Margin Bottom - Mobile",
            "options": [
                { "value": "mb-xxxs", "label": "xxxs" },
                { "value": "mb-xxs", "label": "xxs" },
                { "value": "mb-xs", "label": "xs" },
                { "value": "mb-sm", "label": "sm" },
                { "value": "mb-md", "label": "md" },
                { "value": "mb-lg", "label": "lg" },
                { "value": "mb-xl", "label": "xl" },
                { "value": "mb-xxl", "label": "xxl" },
                { "value": "mb-xxxl", "label": "xxxl" },
                { "value": "mb-xxxxl", "label": "xxxxl" }
            ],
            "default": "mb-md"
        },
        {
            "type": "select",
            "id": "margin_top_desktop",
            "label": "Margin Top - Desktop",
            "options": [
                { "value": "tabletl:mt-xxxs", "label": "xxxs" },
                { "value": "tabletl:mt-xxs", "label": "xxs" },
                { "value": "tabletl:mt-xs", "label": "xs" },
                { "value": "tabletl:mt-sm", "label": "sm" },
                { "value": "tabletl:mt-md", "label": "md" },
                { "value": "tabletl:mt-lg", "label": "lg" },
                { "value": "tabletl:mt-xl", "label": "xl" },
                { "value": "tabletl:mt-xxl", "label": "xxl" },
                { "value": "tabletl:mt-xxxl", "label": "xxxl" },
                { "value": "tabletl:mt-xxxxl", "label": "xxxxl" }
            ],
            "default": "tabletl:mt-lg"
        },
        {
            "type": "select",
            "id": "margin_bottom_desktop",
            "label": "Margin Bottom - Desktop",
            "options": [
                { "value": "tabletl:mb-xxxs", "label": "xxxs" },
                { "value": "tabletl:mb-xxs", "label": "xxs" },
                { "value": "tabletl:mb-xs", "label": "xs" },
                { "value": "tabletl:mb-sm", "label": "sm" },
                { "value": "tabletl:mb-md", "label": "md" },
                { "value": "tabletl:mb-lg", "label": "lg" },
                { "value": "tabletl:mb-xl", "label": "xl" },
                { "value": "tabletl:mb-xxl", "label": "xxl" },
                { "value": "tabletl:mb-xxxl", "label": "xxxl" },
                { "value": "tabletl:mb-xxxxl", "label": "xxxxl" }
            ],
            "default": "tabletl:mb-lg"
        },
        {
            "type": "text",
            "id": "max_width_desktop",
            "label": "Max Width - Desktop",
            "info": "Make sure to include units",
            "default": "1096px"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image - Mobile"
        },
        {
            "type": "image_picker",
            "id": "image_desktop",
            "label": "Image - Desktop"
        },
        {
            "type": "text",
            "id": "caption",
            "label": "Caption"
        },
        {
            "type": "url",
            "id": "url",
            "label": "URL"
        },
        {
            "type": "text",
            "id": "url_text",
            "label": "URL Text"
        }
      ],
      "presets": [
        {
          "name": "Image + Caption"
        }
      ]
    }
{% endschema %}