{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
  {% endcapture %}

<section class="section__image-caption tabletl:mx-auto {{ margins_paddings }}" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
    <div class="section__image-caption-content mx-0">
        {% if section.settings.image != blank %}
            <div class="image-container relative mb-12">
                {% render 'lazy-image' image:section.settings.image, image_desktop:section.settings.image_desktop %}

                {% if section.settings.product != blank %}
                    <div class="absolute bg-gray-athans top-12 left-12 overflow-hidden tabletl:top-24 tabletl:left-24">
                        {%  render 'section__image-caption-modal' product:section.settings.product, product_image_override:section.settings.product_image_override%}
                    </div>
                {% endif %}
            </div>
        {% endif %}
        {% if section.settings.caption != blank %}
            <div class="text-p6 rte">{{ section.settings.caption }}</div>
        {% endif %}
    </div>
    
</section>

