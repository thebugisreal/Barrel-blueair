            "options": [
                { "value": "h1", "label": "h1" },
                { "value": "h2", "label": "h2" },
                { "value": "h3", "label": "h3" },
                { "value": "h4", "label": "h4" },
                { "value": "text-p1", "label": "text-p1" },
                { "value": "text-p2", "label": "text-p2" },
                { "value": "text-p3", "label": "text-p3" },
                { "value": "text-p4", "label": "text-p4" }
            ],
            "default": "h2"
        },
        {
            "type": "url",
            "id": "url",
            "label": "URL"
        },
        {
            "type": "text",
            "id": "url_text",
            "label": "URL Text"
        }
      ],
      "blocks": [
        {
            "name": "Image + Caption",
            "type": "image_caption",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image_mobile",
                    "label": "Image - Mobile"
                },
                {
                    "type": "image_picker",
                    "id": "image_desktop",
                    "label": "Image - Desktop"
                },
                {
                    "type": "richtext",
                    "id": "caption",
                    "label": "Caption"
                },
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                }
            ]
        },
        {
            "name": "Product",
            "type": "product",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                }
            ]
        },
        {
            "name": "Collection",
            "type": "collection",
            "settings": [
                {
                    "type": "collection",
                    "id": "collection",
                    "label": "Collection"
                }
            ]
        },
        {
            "name": "Article",
            "type": "article",
            "settings": [
                {
                    "type": "article",
                    "id": "article",
                    "label": "Article"
                }
            ]
        },
        {
            "name": "Blog",
            "type": "blog",
            "settings": [
                {
                    "type": "blog",
                    "id": "blog",
                    "label": "Blog"
                },
                {
                    "type": "number",
                    "id": "article_pulled",
                    "label": "Article Pulled",
                    "default": 3
                }
            ]
        }
      ],
      "presets": [
        {
          "name": "Carousel"
        }
      ]
    }
{% endschema %}