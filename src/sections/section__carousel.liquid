{%- capture carousel_options -%}
    {
      "spaceBetween": 12,
      "runCallbacksOnInit": true,
      "slidesPerView": {{section.settings.slides_per_view}},
      "cssMode": true,
      "loop": false,
      "scrollbar": {
        "el": "[js-scrollbar-{{section.id}}]",
        "hide": false,
        "draggable": true
      },
      "navigation": {
        "enabled": true,
        "nextEl": ".swiper-button-next--{{section.id}}",
        "prevEl": ".swiper-button-prev--{{section.id}}"
      },
      "pagination": {
        "el": ".swiper-pagination",
        "type": "fraction"
      },
      "breakpoints": {
        "1024": {
          "slidesPerView": {{section.settings.slides_per_view_desktop}},
          "spaceBetween": 24,
          "navigation": {
            "enabled": true,
            "nextEl": ".swiper-button-next--{{section.id}}",
            "prevEl": ".swiper-button-prev--{{section.id}}"
          }
        },
        "1440": {
            "slidesPerView": {{section.settings.slides_per_view_extrawide}}
        }
      }
    }
  {%- endcapture -%}

{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

<div class="section__carousel {{ margins_paddings }}" style="--max-width-desktop: {{ section.settings.max_width_desktop }}; background-color: {{ section.settings.bg_color }}">
    <header class="section__carousel-header {% if section.settings.enable_title_link_same_link %} enable-title-link-same-line tabletl:pt-64 tabletl:mb-40 tabletl:flex tabletl:justify-between tabletl:mx-[60px] tabletl:items-center {% endif %}">
        {% if section.settings.title != blank %}
            {% liquid
                assign title_tag = 'p'
                assign title_options = 'h1,h2,h3,h4,h5,h6'

                if title_options contains section.settings.title_style
                    assign title_tag = section.settings.title_style
                endif
            %}
            <{{ title_tag }} class="section__carousel-title mx-30 mb-24 text-center">{{ section.settings.title }}</{{ title_tag }}>
        {% endif %}
        {% if section.settings.url != blank %}
            <a href="{{ section.settings.url }}" class="section__carousel-button {{ section.settings.cta_style }} mx-auto mb-40 tabletl:mb-48"> 
                <p class="p2 btn__text">{{ section.settings.url_text }}</p>
                <div class="btn__arrow">{%  render 'icon-arrow-right' %}</div>
            </a>
        {% endif %}
    </header>

    <div class="section__carousel-content grid grid-cols-1 ml-30 {% if section.settings.enable_centered_carousel %} tabletl:px-[60px] tabletl:mx-auto {% else %} tabletl:ml-auto {% endif %}">
        <s-carousel class="block" data-options='{{carousel_options}}'>
            <div id="{{section.id}}" class="swiper" js-carousel>
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        {% case block.type %}
                            {% when 'image_caption' %}
                                {% if block.settings.image_mobile != blank %}
                                    <div class="swiper-slide h-auto" js-carousel-slide>
                                        <div class="section__image-caption image-container flex flex-col relative h-full mb-12">
                                            {% render 'lazy-image' image:block.settings.image_mobile, image_desktop:block.settings.image_desktop, picture_classes:'h-full', img_classes:'h-full' %}
                                            {% if block.settings.product != blank %}
                                                <div class="absolute bg-gray-athans top-12 left-12 overflow-hidden tabletl:top-24 tabletl:left-24">
                                                    {%  render 'section__image-caption-modal' product:block.settings.product, product_image_override:block.settings.product_image_override%}
                                                </div>
                                            {% endif %}
                                            {% if block.settings.caption != blank %}
                                                <div class="{{ block.settings.caption_style }} rte">{{ block.settings.caption }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}
                            {% when 'product' %}
                                {% if block.settings.product != blank %}
                                    <div class="swiper-slide h-auto" js-carousel-slide>
                                        {% render 'product-card__carousel' product:block.settings.product %}
                                    </div>
                                {% endif %}
                            {% when 'collection' %}
                                {% if block.settings.collection != blank %}
                                    {% for product in block.settings.collection %}
                                        <div class="swiper-slide h-auto" js-carousel-slide>
                                            {% render 'product-card__carousel' product:product %}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            {% when 'article' %}
                                {% if block.settings.article != blank %}
                                    <div class="swiper-slide h-auto" js-carousel-slide>
                                        {% render 'article-card' article:block.settings.article %}
                                    </div>
                                {% endif %}
                            {% when 'blog' %}
                                {% if block.settings.blog != blank %}
                                    {% for article in block.settings.blog.articles limit:block.settings.article_pulled%}
                                        <div class="swiper-slide h-auto" js-carousel-slide>
                                            {% render 'article-card' article:article %}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                        {% endcase %}
                    {% endfor %}
                </div>

                {% comment %} Swiper Nav {% endcomment %}
                {% case section.settings.carousel_nav %}
                    {% when 'pagination'%}
                        <div class="swiper-nav-container py-8 flex justify-between items-center">
                            <div class="swiper-pagination w-fit !relative !left-0 !bottom-0" js-scrollbar-{{section.id}}></div>
                            <div class="nav-button-container flex gap-24">
                                <div class="swiper-button-prev--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--prev">{% render 'icon-arrow-left' %}</span></div>
                                <div class="swiper-button-next--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--next">{% render 'icon-arrow-right' %}</span></div>
                            </div>
                        </div>
                    {% when 'scrollbar'%}
                        <div class="swiper-nav-container py-8 flex gap-24 items-center">
                            <div class="swiper-button-prev--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--prev">{% render 'icon-arrow-left' %}</span></div>
                            <div class="swiper-scrollbar !relative !left-0 !bottom-0" js-scrollbar-{{section.id}}></div>
                            <div class="swiper-button-next--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--next">{% render 'icon-arrow-right' %}</span></div>
                        </div>
                {% endcase %}
                {% comment %} END Swiper Nav {% endcomment %}
            </div>
        </s-carousel>
    </div>
</div>

