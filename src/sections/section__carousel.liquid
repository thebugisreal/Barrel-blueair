{%- capture carousel_options -%}
    {
      "spaceBetween": 12,
      "runCallbacksOnInit": true,
      "slidesPerView": {{section.settings.slides_per_view}},
      "cssMode": true,
      "loop": false,
      "scrollbar": {
        "el": "[js-scrollbar-{{section.id}}]",
        "hide": false,
        "draggable": true
      },
      "navigation": {
        "enabled": true,
        "nextEl": ".swiper-button-next--{{section.id}}",
        "prevEl": ".swiper-button-prev--{{section.id}}"
      },
      "pagination": {
        "el": ".swiper-pagination",
        "type": "fraction"
      },
      "breakpoints": {
        "1024": {
          "slidesPerView": {{section.settings.slides_per_view_desktop}},
          "spaceBetween": 24,
          "navigation": {
            "enabled": true,
            "nextEl": ".swiper-button-next--{{section.id}}",
            "prevEl": ".swiper-button-prev--{{section.id}}"
          }
        },
        "1440": {
            "slidesPerView": {{section.settings.slides_per_view_extrawide}}
        }
      }
    }
  {%- endcapture -%}

<section class="section__carousel {{ section.settings.margin_top }} {{ section.settings.margin_bottom }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }}" style="--max-width-desktop: {{ section.settings.max_width_desktop }}; background-color: {{ section.settings.bg_color }}">
    <header class="section__carousel-header {% if section.settings.enable_title_link_same_link %} enable-title-link-same-line tabletl:pt-64 tabletl:mb-40 tabletl:flex tabletl:justify-between tabletl:mx-[60px] tabletl:items-center {% endif %}">
        {% if section.settings.title != blank %}
            {% liquid
                assign title_tag = 'p'
                assign title_options = 'h1,h2,h3,h4'

                if title_options contains section.settings.title_style
                    assign title_tag = section.settings.title_style
                endif
            %}
            <{{ title_tag }} class="section__carousel-title mx-30 mb-24 text-center">{{ section.settings.title }}</{{ title_tag }}>
        {% endif %}
        {% if section.settings.url != blank %}
            <a href="{{ section.settings.url }}" class="section__carousel-button btn btn--blue-rounded mx-auto mb-40 tabletl:mb-48"> 
                <p class="text-p2 btn__text">{{ section.settings.url_text }}</p>
                <div class="btn__arrow">{%  render 'icon-arrow-right' %}</div>
            </a>
        {% endif %}
    </header>

    <div class="section__carousel-content grid grid-cols-1 ml-30 {% if section.settings.enable_centered_carousel %} tabletl:mx-[60px] {% else %} tabletl:ml-auto {% endif %}">
        <s-carousel class="block" data-options='{{carousel_options}}'>
            <div id="{{section.id}}" class="swiper" js-carousel>
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        {% case block.type %}
                            {% when 'image_caption' %}
                                {% if block.settings.image_mobile != blank %}
                                    <div class="swiper-slide h-auto" js-carousel-slide>
                                        <div class="image-container flex flex-col relative h-full mb-12">
                                            {% render 'lazy-image' image:block.settings.image_mobile, image_desktop:block.settings.image_desktop, picture_classes:'h-full', img_classes:'h-full' %}
  
                                            {% if block.settings.product != blank %}
                                                <div class="absolute bg-gray-athans top-12 left-12 overflow-hidden tabletl:top-24 tabletl:left-24">
                                                    {%  render 'section__image-caption-modal' product:block.settings.product%}
                                                </div>
                                            {% endif %}

                                            {% if block.settings.caption != blank %}
                                                <p class="text-p6 mt-12">{{ block.settings.caption }}</p>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}
                            {% when 'product' %}
                                {% if block.settings.product != blank %}
                                    <div class="swiper-slide h-auto" js-carousel-slide>
                                        {% render 'product-card__carousel' product:block.settings.product %}
                                    </div>
                                {% endif %}
                            {% when 'collection' %}
                                {% if block.settings.collection != blank %}
                                    {% for product in block.settings.collection %}
                                        <div class="swiper-slide h-auto" js-carousel-slide>
                                            {% render 'product-card__carousel' product:product %}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            {% when 'article' %}
                                {% if block.settings.article != blank %}
                                    <div class="swiper-slide h-auto" js-carousel-slide>
                                        {% render 'article-card' article:block.settings.article %}
                                    </div>
                                {% endif %}
                            {% when 'blog' %}
                                {% if block.settings.blog != blank %}
                                    {% for article in block.settings.blog.articles limit:block.settings.article_pulled%}
                                        <div class="swiper-slide h-auto" js-carousel-slide>
                                            {% render 'article-card' article:article %}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                        {% endcase %}
                    {% endfor %}
                </div>

                {% comment %} Swiper Nav {% endcomment %}
                {% case section.settings.carousel_nav %}
                    {% when 'pagination'%}
                        <div class="swiper-nav-container py-8 flex justify-between items-center">
                            <div class="swiper-pagination w-fit !relative !left-0 !bottom-0" js-scrollbar-{{section.id}}></div>
                            <div class="nav-button-container flex gap-24">
                                <div class="swiper-button-prev--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--prev">{% render 'icon-arrow-left' %}</span></div>
                                <div class="swiper-button-next--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--next">{% render 'icon-arrow-right' %}</span></div>
                            </div>
                        </div>
                    {% when 'scrollbar'%}
                        <div class="swiper-nav-container py-8 flex gap-24 items-center">
                            <div class="swiper-button-prev--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--prev">{% render 'icon-arrow-left' %}</span></div>
                            <div class="swiper-scrollbar !relative !left-0 !bottom-0" js-scrollbar-{{section.id}}></div>
                            <div class="swiper-button-next--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--next">{% render 'icon-arrow-right' %}</span></div>
                        </div>
                {% endcase %}
                {% comment %} END Swiper Nav {% endcomment %}
            </div>
        </s-carousel>
    </div>
</section>

{% schema %}
    {
      "name": "Carousel",
      "tag": "section",
      "settings": [
        {
            "type": "select",
            "id": "margin_top",
            "label": "Margin Top - Mobile",
            "options": [
                { "value": "mt-xxxs", "label": "xxxs" },
                { "value": "mt-xxs", "label": "xxs" },
                { "value": "mt-xs", "label": "xs" },
                { "value": "mt-sm", "label": "sm" },
                { "value": "mt-md", "label": "md" },
                { "value": "mt-lg", "label": "lg" },
                { "value": "mt-xl", "label": "xl" },
                { "value": "mt-xxl", "label": "xxl" },
                { "value": "mt-xxxl", "label": "xxxl" },
                { "value": "mt-xxxxl", "label": "xxxxl" }
            ],
            "default": "mt-xs"
        },
        {
            "type": "select",
            "id": "margin_bottom",
            "label": "Margin Bottom - Mobile",
            "options": [
                { "value": "mb-xxxs", "label": "xxxs" },
                { "value": "mb-xxs", "label": "xxs" },
                { "value": "mb-xs", "label": "xs" },
                { "value": "mb-sm", "label": "sm" },
                { "value": "mb-md", "label": "md" },
                { "value": "mb-lg", "label": "lg" },
                { "value": "mb-xl", "label": "xl" },
                { "value": "mb-xxl", "label": "xxl" },
                { "value": "mb-xxxl", "label": "xxxl" },
                { "value": "mb-xxxxl", "label": "xxxxl" }
            ],
            "default": "mb-xs"
        },
        {
            "type": "select",
            "id": "margin_top_desktop",
            "label": "Margin Top - Desktop",
            "options": [
                { "value": "tabletl:mt-xxxs", "label": "xxxs" },
                { "value": "tabletl:mt-xxs", "label": "xxs" },
                { "value": "tabletl:mt-xs", "label": "xs" },
                { "value": "tabletl:mt-sm", "label": "sm" },
                { "value": "tabletl:mt-md", "label": "md" },
                { "value": "tabletl:mt-lg", "label": "lg" },
                { "value": "tabletl:mt-xl", "label": "xl" },
                { "value": "tabletl:mt-xxl", "label": "xxl" },
                { "value": "tabletl:mt-xxxl", "label": "xxxl" },
                { "value": "tabletl:mt-xxxxl", "label": "xxxxl" }
            ],
            "default": "tabletl:mt-md"
        },
        {
            "type": "select",
            "id": "margin_bottom_desktop",
            "label": "Margin Bottom - Desktop",
            "options": [
                { "value": "tabletl:mb-xxxs", "label": "xxxs" },
                { "value": "tabletl:mb-xxs", "label": "xxs" },
                { "value": "tabletl:mb-xs", "label": "xs" },
                { "value": "tabletl:mb-sm", "label": "sm" },
                { "value": "tabletl:mb-md", "label": "md" },
                { "value": "tabletl:mb-lg", "label": "lg" },
                { "value": "tabletl:mb-xl", "label": "xl" },
                { "value": "tabletl:mb-xxl", "label": "xxl" },
                { "value": "tabletl:mb-xxxl", "label": "xxxl" },
                { "value": "tabletl:mb-xxxxl", "label": "xxxxl" }
            ],
            "default": "tabletl:mb-md"
        },
        {
            "type": "text",
            "id": "max_width_desktop",
            "label": "Max Width - Desktop",
            "info": "Make sure to include units",
            "default": "109ch"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        {
            "type": "text",
            "label": "Slides per view",
            "id": "slides_per_view",
            "default": "1.2"
        },
        {
            "type": "text",
            "label": "Slides per view - Desktop",
            "id": "slides_per_view_desktop",
            "default": "1.8"
        },
        {
            "type": "text",
            "label": "Slides per view - Extrawide",
            "id": "slides_per_view_extrawide",
            "default": "3"
        },
        {
            "type": "select",
            "id": "carousel_nav",
            "label": "Carousel Nav",
            "options": [
                { "value":"scrollbar", "label":"Scrollbar" },
                { "value":"pagination", "label":"Pagination" },
                { "value":"none", "label":"None"}
            ],
            "default": "scrollbar"
        },
        {
            "type": "checkbox",
            "id": "enable_centered_carousel",
