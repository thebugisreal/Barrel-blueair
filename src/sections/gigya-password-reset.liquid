<div class="min-h-screen flex items-center justify-center bg-gray-light py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <h1 class="h3 text-center mb-md">Reset Your Password</h1>

    <form id="passwordResetForm" class="mt-8">
      <div>
        <div class="mb-4">
          <label for="email" class="sr-only">Email</label>
          <input type="email" id="email" name="email" required placeholder="Email" 
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>
      </div>

      <div>
        <button type="submit" class="btn btn--blue-rounded mb-lg mx-auto">
          <span class="btn__text">Send Reset Email</span>
          <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.getElementById('passwordResetForm').addEventListener('submit', function(event) {
    event.preventDefault();
    const email = document.getElementById('email').value;

    gigya.accounts.resetPassword({
      loginID: email,
      lang: "en",
      callback: function(response) {
        if (response.errorCode === 0) {
          alert("Password reset email sent successfully.");
        } else {
          alert("Error sending password reset email: " + response.errorMessage);
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Gigya Password Reset",
  "settings": [],
  "presets": [
    {
      "name": "Gigya Password Reset",
      "category": "Authentication"
    }
  ]
}
{% endschema %}