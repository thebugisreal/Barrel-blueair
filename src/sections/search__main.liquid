<div class="template-search {% unless search.performed and search.results.size > 0 %} template-search--empty{% endunless %}">
  {% paginate search.results by 1000 %}
    <div class="template-search__layout">
      {%- if search.performed -%}
        {% liquid
          assign article_results = search.results | where: "object_type", "article"
          assign product_results = search.results | where: "object_type", "product"
          assign product_results_count = product_results.size
          assign article_results_count = article_results.size

          assign no_results = true
          if product_results_count > 0 or article_results_count > 0
            assign no_results = false
          endif

          assign popular_searches_linklist = linklists[settings.popular_searches]
          assign article_count = 0
          assign support_count = 0

          assign regular_articles = "" | split: ""
          assign resource_articles = "" | split: ""

          for article in article_results
            if article.tags contains 'support'
              assign support_count = support_count | plus: 1
              assign resource_articles = article_results | slice: forloop.index0 | concat: resource_articles
            else 
              assign article_count = article_count | plus: 1
              assign regular_articles = article_results | slice: forloop.index0 | concat: regular_articles
            endif
          endfor

          assign regular_articles = regular_articles | reverse
          assign resource_articles = resource_articles | reverse
        %}
      {%- endif -%}

      <div class="search-grid__header bg-blue-light px-md py-lg desktop:px-xl desktop:pt-[48px] desktop:pb-xxl">
        <div class="search-grid__title-container flex justify-start items-center gap-sm">
          <p class="template-search__status h3" role="status">
            {% if no_results %}
              No Search Results Found for "{{ search.terms }}"
            {% else %}
              Search Results for "{{ search.terms }}"
            {% endif %}
          </p>
          <div class="search-grid__count whitespace-nowrap text-18 leading-[24px] bg-white rounded-[124px] px-xs py-xxs">{{ search.results.size }} results</div>
        </div>
      </div>

      {%- if search.performed and search.results.size > 0 -%}
        <div class="template-search__results mt-md px-lg tabletl:px-xl">
          <s-tabs class="search-results__tabs h-full flex flex-col">
            <div class="tab__triggers flex justify-center gap-xxs border-b border-gray-athans tabletl:justify-start" role="tablist" aria-orientation="horizontal" js-tablist>
              <button id="search-product-tab" class="tab__trigger s2 font-500 pb-xxs px-xxxs relative" aria-controls="search-product-content-panel" role="tab" aria-selected="true" js-tab>
                Products ({{product_results_count}})
              </button>
              <button id="search-article-tab" class="tab__trigger s2 font-500 pb-xxs px-xxxs relative" aria-controls="search-article-content-panel" role="tab" aria-selected="false" js-tab>
                Blogs ({{ article_count }})
              </button>
              <button id="search-support-tab" class="tab__trigger s2 font-500 pb-xxs px-xxxs relative" aria-controls="search-support-content-panel" role="tab" aria-selected="false" js-tab>
                Support ({{ support_count }})
              </button>
            </div>
            <div id="search-product-content-panel" class="tab__panel py-md flex-1 max-h-full desktop:py-lg" role="tabpanel" aria-labelledby="search-product-tab" aria-hidden="false">
              {% render 'search__main-results' search_result: product_results, type: 'product' %}
            </div>
            <div id="search-article-content-panel" class="tab__panel py-md flex-1 max-h-full desktop:py-lg" role="tabpanel" aria-labelledby="search-article-tab" aria-hidden="true">
              {% render 'search__main-results' search_result: article_results, type: 'article' %}
            </div>
            <div id="search-support-content-panel" class="tab__panel py-md flex-1 max-h-full desktop:py-lg" role="tabpanel" aria-labelledby="search-support-tab" aria-hidden="true">
              {% render 'search__main-results' search_result: article_results, type: 'support' %}
            </div>
          </s-tabs>
        </div>
      {%- endif -%}
    </div>
  {% endpaginate %}
</div>

<div id="fetchSearch" class="hidden">
  <s-tabs class="predictive-search-results__tabs h-full flex flex-col">
    <div class="tab__triggers flex justify-start gap-xxs border-b border-gray-athans" role="tablist" aria-orientation="horizontal" js-tablist>
      <button id="predictive-search-product-tab" class="tab__trigger p3 font-500 pb-xxs px-xxxs relative" aria-controls="predictive-search-product-content-panel" role="tab" aria-selected="true" js-tab>
        Products ({{ product_results.size }})
      </button>
      <button id="predictive-search-article-tab" class="tab__trigger p3 font-500 pb-xxs px-xxxs relative" aria-controls="predictive-search-article-content-panel" role="tab" aria-selected="false" js-tab>
        Blogs ({{ article_count }})
      </button>
      <button id="predictive-search-support-tab" class="tab__trigger p3 font-500 pb-xxs px-xxxs relative" aria-controls="predictive-search-support-content-panel" role="tab" aria-selected="false" js-tab>
        Support ({{ support_count }})
      </button>
    </div>
    <div id="predictive-search-product-content-panel" class="tab__panel py-md flex-1 max-h-full overflow-y-auto desktop:py-lg desktop:max-h-[calc(100vh-133px)]" role="tabpanel" aria-labelledby="predictive-search-product-tab" aria-hidden="false">
      {% render 'predictive-search--resources' resources: product_results, type: 'product', popular_searches_linklist: popular_searches_linklist %}
    </div>
    <div id="predictive-search-article-content-panel" class="tab__panel py-md flex-1 max-h-full overflow-y-auto desktop:py-lg desktop:max-h-[calc(100vh-133px)]" role="tabpanel" aria-labelledby="predictive-search-article-tab" aria-hidden="true">
      {% render 'predictive-search--resources' resources: regular_articles, type: 'article', popular_searches_linklist: popular_searches_linklist %}
    </div>
    <div id="predictive-search-support-content-panel" class="tab__panel py-md flex-1 max-h-full overflow-y-auto desktop:py-lg desktop:max-h-[calc(100vh-133px)]" role="tabpanel" aria-labelledby="predictive-search-support-tab" aria-hidden="true">
      {% render 'predictive-search--resources' resources: resource_articles, type: 'support', popular_searches_linklist: popular_searches_linklist %}
    </div>
  </s-tabs>
</div>

{% schema %}
{
  "name": "Search Results",
  "tag": "section"
}
{% endschema %}
