{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<div class="section__text-banner {{ margins_paddings }} {{ section.settings.color }} px-md desktop:px-xl">
  <div class="text-banner__wrapper mx-auto desktop:max-w-[var(--max-w-desktop)] {{ section.settings.text_align_mobile }} {{ section.settings.text_align_desktop }} {% if section.settings.image != blank %}desktop:flex desktop:justify-center desktop:items-center desktop:gap-[225px]{% endif %}" style="--max-w-desktop: {% if section.settings.max_width_desktop != blank %}{{ section.settings.max_width_desktop }}{% else %}unset{% endif %};">
    {% if section.settings.image != blank %}
      <div class="text-banner__image w-[111px] min-w-[111px] inline-block mb-lg desktop:mb-0">
        {% render 'lazy-image' image: section.settings.image %}
      </div>
    {% endif %}
    <div class="text-banner__text-content">
      {% if section.settings.title != blank %}
        <h1 class="text-banner__title {{ section.settings.title_style }} mb-xs">{{ section.settings.title }}</h1>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <p class="text-banner__subtext {{ section.settings.subtext_style }}">{{ section.settings.subtext }}</p>
      {% endif %}
      {% if section.settings.cta_url != blank and section.settings.cta_text != blank%}
        {% case section.settings.text_align_mobile %}
          {% when 'text-left' %}
            {% assign btn_alignment_mobile = 'mr-auto' %}
          {% when 'text-center' %}
            {% assign btn_alignment_mobile = 'mx-auto' %}
          {% when 'text-right' %}
            {% assign btn_alignment_mobile = 'ml-auto' %}
        {% endcase %}
        {% case section.settings.text_align_desktop %}
          {% when 'desktop:text-left' %}
            {% assign btn_alignment_desktop = 'desktop:mr-auto desktop:ml-0' %}
          {% when 'desktop:text-center' %}
            {% assign btn_alignment_desktop = 'desktop:mx-auto' %}
          {% when 'desktop:text-right' %}
            {% assign btn_alignment_desktop = 'desktop:ml-auto desktop:mr-0' %}
        {% endcase %}
        <a href="{{ section.settings.cta_url }}" class="text-banner__cta {{ section.settings.cta_style }} {{ btn_alignment_mobile }} {{ btn_alignment_desktop }} mt-md">
          <span class="btn__text">{{ section.settings.cta_text }}</span>
          <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

