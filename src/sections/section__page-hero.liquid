{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

<div class="section__page-hero {{ margins_paddings }} px-md {{ section.settings.color }} {% if section.settings.section_max_width_desktop != blank %} desktop:px-0 {% else %} desktop:px-xl{% endif %}">
  <div class="tabletl:flex tabletl:gap-xxxl tabletl:justify-between tabletl:mx-auto tabletl:max-w-[var(--max-width-section-desktop)]" style="--max-width-section-desktop: {{ section.settings.max_width_section_desktop }};">
    <div class="hero__content-container flex-1 tabletl:max-w-[var(--max-width-desktop)]" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
        {% if section.settings.title != blank %}
            <h1 class="hero__title {{ section.settings.title_style }} mb-md">{{ section.settings.title }}</h1>
        {% endif %}
        {% if section.settings.subtext != blank %}
            <p class="hero__subtext {{ section.settings.subtext_style }}">{{ section.settings.subtext }}</p>
        {% endif %}

        {% comment %} App Store - Mobile {% endcomment %}
        {% if settings.app_store_url_mobile != blank or settings.google_play_url_mobile != blank %}
            <div class="hero__app-mobile mt-lg tabletl:hidden">
            <div class="hero__app-mobile-links flex flex-col gap-md">
                {% if settings.app_store_url_mobile != blank %}
                <a href="{{ settings.app_store_url_mobile }}" target="_blank" rel="noopener noreferrer" class="hero__app-mobile-link">
                    <img src="{{ 'app-store--white.png' | asset_url }}" class="block w-[195px] h-full" />
                </a>
                {% endif %}
                {% if settings.google_play_url_mobile != blank %}
                <a href="{{ settings.google_play_url_mobile }}" target="_blank" rel="noopener noreferrer" class="hero__app-mobile-link">
                    <img src="{{ 'google-play--white.png' | asset_url }}" class="block w-[195px] h-full" />
                </a>
                {% endif %}
            </div>
            </div>
        {% endif %}
        {% comment %} END App Store - Mobile {% endcomment %}

        {% comment %} App Store - Desktop {% endcomment %}
        {% if settings.app_store_url_desktop != blank or settings.google_play_url_desktop != blank %}
            <div class="hero__app-desktop border-blue-light mt-lg hidden tabletl:block">
            <div class="hero__app-desktop-links flex gap-md">
                {% if settings.app_store_url_desktop != blank %}
                <a href="{{ settings.app_store_url_desktop }}" target="_blank" rel="noopener noreferrer" class="hero__app-desktop-link">
                    <img src="{{ 'app-store--white.png' | asset_url }}" class="block w-[170px] h-full" />
                </a>
                {% endif %}
                {% if settings.google_play_url_desktop != blank %}
                <a href="{{ settings.google_play_url_desktop }}" target="_blank" rel="noopener noreferrer" class="hero__app-desktop-link">
                    <img src="{{ 'google-play--white.png' | asset_url }}" class="block w-[195px] h-full" />
                </a>
                {% endif %}
            </div>
            </div>
        {% endif %}
        {% comment %} END App Store - Desktop {% endcomment %}
    </div>

    {% if section.settings.image_desktop != blank %}
        <div class="hero__image hidden tabletl:block min-w-[300px] tabletl:max-w-[400px]">
          {% render 'lazy-image', image: section.settings.image_desktop %}

          {% if section.settings.caption != blank %}
              <p class="hero__image-caption mt-md text-center {{ section.settings.caption_style }}">{{ section.settings.caption }}</p>
          {% endif %}
        </div>
    {% endif %}
  </div>
</div>

