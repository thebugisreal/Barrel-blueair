{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
{% if section.settings.enable_bg_clickabe_url and section.settings.cta_url != blank %}
  <a href="{{section.settings.cta_url}}" class="section__hero {{ margins_paddings }} {{ section.settings.color }} tabletl:px-xl" style="{% if section.settings.content_max_height_mobile != blank  %}--max-h-mobile: {{ section.settings.content_max_height_mobile }};{% endif %} {% if section.settings.content_max_height_desktop != blank  %}--max-h-desktop: {{ section.settings.content_max_height_desktop }};{% endif %}">
{% else %}
  <div class="section__hero {{ margins_paddings }} {{ section.settings.color }} tabletl:px-xl" style="{% if section.settings.content_max_height_mobile != blank  %}--max-h-mobile: {{ section.settings.content_max_height_mobile }};{% endif %} {% if section.settings.content_max_height_desktop != blank  %}--max-h-desktop: {{ section.settings.content_max_height_desktop }};{% endif %}">
{% endif %}
  <div class="hero__wrapper relative">
    {% if section.settings.image_mobile != blank %}
      <div class="hero__image">
        {% render 'lazy-image', image: section.settings.image_mobile, image_desktop: section.settings.image_desktop, img_classes:'object-cover'%}
      </div>
    {% endif %}

    {% capture alignments %}
      {{ section.settings.text_align_mobile }} {{ section.settings.hor_align_mobile }} {{ section.settings.ver_align_mobile }} {{ section.settings.text_align_desktop }} {{ section.settings.hor_align_desktop }} {{ section.settings.ver_align_desktop }}
    {% endcapture %}  
    <div class="hero__content-wrapper tabletl:mx-auto tabletl:max-w-[var(--section-max-width-desktop)] {% if section.settings.image_mobile != blank %}absolute inset-0{% else %}no-image{% endif %} flex px-md py-lg {% if section.settings.image_mobile != blank %} tabletl:p-xl {% else %} tabletl:p-0 {% endif %} {{ alignments }}" style="{% if section.settings.content_height_mobile != blank %}--height-mobile: {{ section.settings.content_height_mobile }};{% endif %} {% if section.settings.content_height_desktop != blank %}--height-desktop: {{ section.settings.content_height_desktop }};{% endif %}--section-max-width-desktop: {{ section.settings.section_max_width_desktop}};">
      <div class="hero__content" style="{% if section.settings.content_max_width_mobile != blank  %}--max-w-mobile: {{ section.settings.content_max_width_mobile }};{% endif %} {% if section.settings.content_max_width_desktop != blank %}--max-w-desktop: {{ section.settings.content_max_width_desktop }};{% endif %}">
        {% if section.settings.title != blank %}
          <h1 class="hero__title {{ section.settings.title_style }} mb-sm">{{ section.settings.title }}</h1>
        {% endif %}
        {% if section.settings.subtext != blank %}
          <p class="hero__subtext {{ section.settings.subtext_style }}">{{ section.settings.subtext }}</p>
        {% endif %}
        {% if section.settings.cta_url != blank and section.settings.cta_text != blank%}
          {% case section.settings.text_align_mobile %}
            {% when 'text-left' %}
              {% assign btn_alignment_mobile = 'mr-auto' %}
            {% when 'text-center' %}
              {% assign btn_alignment_mobile = 'mx-auto' %}
            {% when 'text-right' %}
              {% assign btn_alignment_mobile = 'ml-auto' %}
          {% endcase %}
          {% case section.settings.text_align_desktop %}
            {% when 'desktop:text-left' %}
              {% assign btn_alignment_desktop = 'desktop:mr-auto desktop:ml-0' %}
            {% when 'desktop:text-center' %}
              {% assign btn_alignment_desktop = 'desktop:mx-auto' %}
            {% when 'desktop:text-right' %}
              {% assign btn_alignment_desktop = 'desktop:ml-auto desktop:mr-0' %}
          {% endcase %}
          {% if section.settings.enable_bg_clickabe_url %}
            <button href="{{ section.settings.cta_url }}" class="hero__cta {{ section.settings.cta_style }} {{ btn_alignment_mobile }} {{ btn_alignment_desktop }} mt-md">
              <span class="btn__text">{{ section.settings.cta_text }}</span>
              <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
            </button>
          {% else %}
            <a href="{{ section.settings.cta_url }}" class="hero__cta {{ section.settings.cta_style }} {{ btn_alignment_mobile }} {{ btn_alignment_desktop }} mt-md">
              <span class="btn__text">{{ section.settings.cta_text }}</span>
              <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
{% if section.settings.enable_bg_clickabe_url and section.settings.cta_url != blank %}
  </a>
{% else %}
  </div>
{% endif %}

