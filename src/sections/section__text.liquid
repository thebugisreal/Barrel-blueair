<section class="section__product-text tabletl:mx-auto" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
    {% render 'spacing-divider' mobile_height:section.settings.spacing_top_mobile, desktop_height:section.settings.spacing_top_desktop %}
    <s-accordion data-manual-collapse="false" js-accordion>
        <ul class="section__product-text-content mx-30 tabletl:mx-auto">
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'title' %}
                        {% if block.settings.title != blank %}
                            <li class="list-none">
                                {% render 'spacing-divider' mobile_height:block.settings.spacing_top_mobile, desktop_height:block.settings.spacing_top_desktop %}
                                <h1 class="{{ block.settings.title_style }} font-900" style="background-color: {{ block.settings.bg_color }};">{{ block.settings.title }}</h1>
                                {% render 'spacing-divider' mobile_height:block.settings.spacing_bottom_mobile, desktop_height:block.settings.spacing_bottom_desktop %}
                            </li>
                        {% endif %}
                    {% when 'richtext' %}
                        {% if block.settings.richtext != blank %}
                            <li class="list-none">
                                {% render 'spacing-divider' mobile_height:block.settings.spacing_top_mobile, desktop_height:block.settings.spacing_top_desktop %}
                                <div class="rte {{ block.settings.richtext_style }}" style="background-color: {{ block.settings.bg_color }};">
                                    {{ block.settings.richtext }}
                                </div>
                                {% render 'spacing-divider' mobile_height:block.settings.spacing_bottom_mobile, desktop_height:block.settings.spacing_bottom_desktop %}
                            </li>
                        {% endif %}
                    {% when 'bullet' %}
                        {% if block.settings.text != blank %}
                            <li class="list-none">
                                {% render 'spacing-divider' mobile_height:block.settings.spacing_top_mobile, desktop_height:block.settings.spacing_top_desktop %}
                                <div class="flex gap-20" style="background-color: {{ block.settings.bg_color }};">
                                    <div class="bullet">&#9679;</div> 
                                    <p class="{{ block.settings.text_style }}">{{ block.settings.text }} </p>
                                </div>
                                {% render 'spacing-divider' mobile_height:block.settings.spacing_bottom_mobile, desktop_height:block.settings.spacing_bottom_desktop %}
                            </li>
                        {% endif %}
                    {% when 'accordion_item' %}
                        <div class="accordion-item" js-accordion-item>
                            <button class="accordion-header {{ block.settings.title_style }}" aria-expanded="true" aria-controls="accordionID-{{ section.id }}-{{ forloop.index }}" js-accordion-header>{{ block.settings.title }}</button>
                            <div id="accordionID-{{ section.id }}-{{ forloop.index }}" class="accordion-content rte text-p2" aria-hidden="false" js-accordion-content>
                                {{ block.settings.accordion_content }}
                            </div>
                        </div>
                {% endcase %}
            {% endfor %}
        </ul>
    </s-accordion>
    {% render 'spacing-divider' mobile_height:section.settings.spacing_bottom_mobile, desktop_height:section.settings.spacing_bottom_desktop %}
</section>

