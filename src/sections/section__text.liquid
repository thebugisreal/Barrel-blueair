<section class="section__product-text {{ section.settings.margin_top }} {{ section.settings.margin_bottom }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} tabletl:mx-auto" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
    <ul class="section__product-text-content mx-30 tabletl:mx-auto">
        {% for block in section.blocks %}
            {% case block.type %}
                {% when 'title' %}
                    {% if block.settings.title != blank %}
                        <li class="list-none">
                            {% liquid
                                assign title_tag = 'p'
                                assign title_options = 'h1,h2,h3,h4'

                                if title_options contains block.settings.title_style
                                    assign title_tag = block.settings.title_style
                                endif
                            %}
                            <{{title_tag}} class="{{ block.settings.title_style }} font-900 my-24">{{ block.settings.title }}</{{title_tag}}>
                        </li>
                    {% endif %}
                {% when 'richtext' %}
                    {% if block.settings.richtext != blank %}
                        <li class="list-none">
                            <div class="rte {{ block.settings.richtext_style }}">
                                {{ block.settings.richtext }}
                            </div>
                        </li>
                    {% endif %}
                {% when 'bullet' %}
                    {% if block.settings.text != blank %}
                        <li class="list-none">
                            <div class="flex gap-20 my-8">
                                <div class="bullet">&#9679;</div> 
                                <p class="{{ block.settings.text_style }}">{{ block.settings.text }} </p>
                            </div>
                        </li>
                    {% endif %}
            {% endcase %}
        {% endfor %}
    </ul>
</section>

