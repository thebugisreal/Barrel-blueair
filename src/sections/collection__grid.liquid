{% comment %}
{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
{% render 'filter-sort', results: collection, scope: 'global' %}
{% render 'active-filters', results: collection %}
{% endcomment %}
{% paginate collection.products by 24 %}
<s-collection-grid role="section" class="collection-grid block" data-id="{{ section.id }}">
  <div class="collection-grid__layout">
    <div class="collection-grid__header bg-blue-light px-md py-lg desktop:px-xl desktop:pt-[48px] desktop:pb-xxl">
      {% if collection.handle != 'shop-all' %}
        {% assign shop_all_collection = collections['shop-all'] %}
        <a href="{{ shop_all_collection.url }}" class="collection-grid__shop-all-link link link--underline inline-block mb-md">Shop</a>
      {% endif %}
      <div class="collection-grid__title-containe flex justify-start items-center gap-sm">
        <h1 class="collection-grid__title h3">{{ collection.title }}</h1>
        <div class="collection-grid__count text-18 leading-[24px] bg-white rounded-[124px] px-xs py-xxs" js-collection-count>{{ collection.products_count }} results</div>
      </div>
    </div>

    {% if collection.products.size > 0 %}
      <div class="collection-grid__body px-md pt-lg pb-xxl desktop:px-xl">
        {% if collection.metafields.seed.collection_links != blank %}
          {% assign linklist = linklists[collection.metafields.seed.collection_links] %}
          {% if linklist != blank %}
            <div class="collection-grid__collection-links-container mb-lg">
              <p>Choose Your Product Type</p>
              <div class="collection-grid__collection-links mt-xs grid grid-cols-2 gap-xs desktop:flex desktop:flex-wrap desktop:gap-md">
                {% for link in linklist.links %}
                  {% unless link.active %}
                    <a href="{{ link.url }}" class="collection-grid__collection-link !no-underline border border-gray desktop:flex desktop:justify-start desktop:items-center desktop:w-[300px] desktop:min-w-[300px]">
                      {% if link.object.metafields.seed.collection_link_image != blank %}
                        <div class="w-[100px] hidden desktop:block">
                          {% render 'lazy-image' image: link.object.metafields.seed.collection_link_image %}
                        </div>
                      {% endif %}
                      <div class="p-sm desktop:p-md desktop:flex-1 desktop:text-16">{{ link.title }}</div>
                    </a>
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endif %}
  
        <div class="collection-grid__filter-sort-triggers mb-md grid grid-cols-2 gap-sm desktop:flex desktop:justify-between desktop:items-center">
          <button class="collection-grid__filter-trigger collection-grid__filter-trigger--mobile desktop:hidden" js-open-mobile-filter>
            <span>Filters</span>
          </button>
          <button class="collection-grid__filter-trigger collection-grid__filter-trigger--desktop hidden desktop:block" js-desktop-filter-trigger>
            <span js-desktop-filter-trigger-label>Show Filters</span>
          </button>
          <div class="collection-grid__sort-trigger-container">
            <span>Sort by</span>
          </div>
        </div>
  
        <div class="collection-grid__grid-container desktop:flex">
          <div class="collection-grid__desktop-fitlers hidden w-[300px]" js-desktop-filters data-opened="false">
            {% render 'filter-sort', results: collection, scope: 'desktop' %}
          </div>
          <div class="collection-grid__grid-wrapper desktop:flex-1">
            <ul class="collection-grid__products grid grid-cols-1 gap-md desktop:grid-cols-3 desktop:gap-y-lg" js-products-grid>
              {% for product in collection.products %}
                <li class="collection-grid__product">
                  {% render 'product-card' product: product %}
                </li>
              {% endfor %}

              {% comment %}callouts here - if first page and no filters{% endcomment %}
            </ul>
            
            <div class="collection-grid__pagination" js-pagination>
              {% if paginate.next.url %}
                <button class="collection-grid__show-more-btn block w-max mx-auto my-xxl text-18 border border-blue py-sm px-xl" data-url="{{ paginate.next.url }}" js-show-more-btn>Show More</button>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
      
      <loading-spinner class="collection-grid__loading-spinner fixed z-[5]" style="--background: #00000060; --color: #002955; --width: 32px; --height: 32px;"></loading-spinner>
    {% else %}
      <p class="collection-grid__no-results h6 px-md py-lg desktop:px-xl">No Products Found</p>
    {% endif %}
  </div>
</s-collection-grid>
{% endpaginate %}



{% schema %}
{
  "name": "Product Grid",
  "settings": [
  ]
}
{% endschema %}
