{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

{% if section.settings.enable_clickable_url and section.settings.cta_url != blank %}
  <a href="{{ section.settings.cta_url }}" class="section__promo-banner {{ margins_paddings }}" style="background-color: {{ section.settings.background_color }}; max-width: {{ section.settings.section_max_width }};">
{% else %}
  <div class="section__promo-banner {{ margins_paddings }}" style="background-color: {{ section.settings.background_color }}; max-width: {{ section.settings.section_max_width }};">
{% endif %}
  
  <div class="promo-banner__wrapper">
    <div class="promo-banner__content">
      
      {% if section.settings.tag_text != blank %}
        <div class="promo-banner__tag">
          <span class="tag__text">{{ section.settings.tag_text }}</span>
        </div>
      {% endif %}
      
      {% if section.settings.main_text != blank %}
        <div class="promo-banner__main-text">
          <h2 class="main-text">{{ section.settings.main_text }}</h2>
        </div>
      {% endif %}
      
      {% if section.settings.sub_text != blank %}
        <div class="promo-banner__sub-text">
          <p class="sub-text">{{ section.settings.sub_text }}</p>
        </div>
      {% endif %}
      
      {% if section.settings.cta_text != blank and section.settings.cta_url != blank %}
        <div class="promo-banner__cta">
          <a href="{{ section.settings.cta_url }}" class="cta-button">
            {{ section.settings.cta_text }}
          </a>
        </div>
      {% endif %}
      
    </div>
  </div>

{% if section.settings.enable_clickable_url and section.settings.cta_url != blank %}
  </a>
{% else %}
  </div>
{% endif %}

<style>
  .section__promo-banner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .promo-banner__wrapper {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }
  
  .promo-banner__content {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem;
  }
  
  .promo-banner__tag {
    display: flex;
    align-items: center;
  }
  
  .tag__text {
    background-color: {{ section.settings.tag_background_color | default: '#BAE6FF' }};
    color: {{ section.settings.tag_text_color | default: '#002955' }};
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .promo-banner__main-text {
    display: flex;
    align-items: center;
  }
  
  .main-text {
    color: {{ section.settings.main_text_color | default: '#FFFFFF' }};
    font-size: 1.25rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }
  
  .promo-banner__sub-text {
    display: flex;
    align-items: center;
  }
  
  .sub-text {
    color: {{ section.settings.sub_text_color | default: '#FFFFFF' }};
    font-size: 0.875rem;
    margin: 0;
  }
  
  .promo-banner__cta {
    display: flex;
    align-items: center;
  }
  
  .cta-button {
    background-color: {{ section.settings.cta_background_color | default: '#BAE6FF' }};
    color: {{ section.settings.cta_text_color | default: '#002955' }};
    padding: 0.5rem 1.5rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
    display: inline-block;
  }
  
  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
  }
  
  /* Mobile responsive */
  @media (max-width: 768px) {
    .promo-banner__content {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .main-text {
      font-size: 1rem;
    }
    
    .sub-text {
      font-size: 0.75rem;
    }
    
    .cta-button {
      padding: 0.375rem 1rem;
      font-size: 0.875rem;
    }
  }
  
  /* Desktop responsive */
  @media (min-width: 769px) {
    .promo-banner__content {
      flex-direction: row;
      gap: 1.5rem;
    }
    
    .main-text {
      font-size: 1.5rem;
    }
  }
</style>

