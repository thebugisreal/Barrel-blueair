<section class="section__accordion mx-30 tabletl:mx-auto {{ section.settings.margin_top }} {{ section.settings.margin_bottom }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }}" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
  
    {% if section.settings.title != blank %}
        {% liquid
            assign title_tag = 'p'
            assign title_options = 'h1,h2,h3,h4'

            if title_options contains section.settings.title_style
                assign title_tag = section.settings.title_style
            endif
        %}
        <{{ title_tag }} class="section__accordion-title mb-24 tabletl:mb-48">{{ section.settings.title }}</{{ title_tag }}>
    {% endif %}
    <s-accordion class="section__accordion-content" data-manual-collapse="true" js-accordion>
        {% for block in section.blocks %}
            <div class="accordion-item my-16" js-accordion-item>

                <button class="accordion-header w-full flex justify-between items-center gap-12" {% if forloop.first %} aria-expanded="true" {% else %}  aria-expanded="false" {% endif %} aria-controls="accordionID-{{ section.id }}-{{ forloop.index }}" js-accordion-header>
                    <p class="{{ block.settings.title_style }} text-left flex-1">{{ block.settings.title }}</p>
                    <div class="icon-container h-[33px] w-[33px] p-8">
                        {%  render 'icon-plus' %}
                        {%  render 'icon-minus' %}
                    </div>
                </button>

                <div id="accordionID-{{ section.id }}-{{ forloop.index }}" class="accordion-content rte text-p2" {% if forloop.first %} aria-hidden="false" {% else %} aria-hidden="true" {% endif %} js-accordion-content>
                    {{ block.settings.richtext }}
                </div>
            </div>
        {% endfor %}
    </s-accordion>
</section>

{% schema %}
