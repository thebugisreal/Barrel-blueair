{% include 'region-check' %}
{%- liquid 
  assign current_variant = product.selected_or_first_available_variant
  if product.variants[1].title contains 'subscription' or product.variants[1].title contains 'Subscription'
    assign current_variant = product.variants[0]
  endif
  assign product_form_id = 'ProductForm-' | append: section.id | append: product.id
  assign master_select_id = 'MasterSelect-' | append: section.id
  assign current_swatch = ''
  if product.options_by_name['color'] != blank
    assign swatch_option = product.options_by_name['color'].position | minus: 1
    assign current_swatch = current_variant.options[swatch_option]
  elsif product.options_by_name['filter type'] != blank
    assign swatch_option = product.options_by_name['filter type'].position | minus: 1
    assign current_swatch = current_variant.options[swatch_option]
  endif
  assign enable_subscription = false
  if product.metafields.seed.subscription != blank
    assign subscription = product.metafields.seed.subscription.value
    for filter_subscription in subscription.filter_subscriptions.value
      if filter_subscription.variants[0].selling_plan_allocations.size > 0
        assign enable_subscription = true
        break
      endif
    endfor
  endif
  for tag in product.tags
    if tag contains 'product-family-size:'
      assign related_tag_size = tag
    endif
    if tag contains 'product-family-color:'
      assign related_tag_color = tag
    endif
    if tag contains 'size:'
      assign size_tag = tag | split: 'size:' | last | capitalize
    endif
  endfor

  if product.metafields.seed.filter_subscription_discount != blank
    assign filter_subscription_discount = product.metafields.seed.filter_subscription_discount.value
    assign filter_subscription_discount_percentage = filter_subscription_discount | times: 1
    assign filter_subscription_discount_decimal = filter_subscription_discount_percentage | divided_by: 100.0
    assign filter_subscription_price = current_variant.price | times: filter_subscription_discount_decimal
    assign filter_subscription_discounted_price = current_variant.price | minus: filter_subscription_price
  endif

  assign user_country = localization.country.iso_code | downcase
-%}

<s-product role="section" class="product" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" {% if current_swatch != blank %}data-swatch-option="{{ swatch_option }}" data-current-swatch="{{ current_swatch }}"{% endif %} data-current-price="{{ current_variant.price }}" data-current-price-compare-at="{{ current_variant.compare_at_price }}">
  <a class="skip-to-content-link sr-only" href="#ProductInfo-{{ section.id }}">Skip to product information</a>
  <div class="product__layout desktop:grid desktop:grid-cols-2 desktop:items-start">
    <div class="product__images flex flex-col-reverse desktop:sticky desktop:top-[var(--header-height)] extrawide:max-w-[675px] extrawide:ml-auto">
      {%- capture thumb_carousel_options -%}
        {
          "loop": false,
          "autoHeight": false,
          "spaceBetween": 8,
          "watchSlidesProgress": true,
          "navigation": {
            "enabled": true,
            "prevEl": "[js-pdp-thumb-prev]",
            "nextEl": "[js-pdp-thumb-next]"
          }
        }
      {%- endcapture -%}
      <s-carousel data-options='{{ thumb_carousel_options }}' class="product__thumb-carousel grid p-sm desktop:p-md w-fit mx-auto">
        <div id="ProductThumbCarousel-{{ product.id }}" class="swiper w-full max-w-[350px] px-[40px]" js-carousel js-pdp-carousel is-thumb-carousel>
          <div class="swiper-wrapper">
            {% assign first_render_quantity_options_images = true %}
            {% assign current_slides_count = 0 %}
            {% assign active_thumb_taken = false %}
            {% for media in product.media %}
              {% assign media_swatch = '' %}
              {% assign country_tag = '' %}
              {% assign hide_media = false %}
              {% assign alt_text = media.alt | downcase | strip %}
              {% if alt_text contains 'country:' %}
                {% assign show_country = alt_text | split: 'country:' | last | split: ' ' | first | strip %}
                {% if show_country != user_country %}
                  {% assign hide_media = true %}
                {% endif %}
              {% endif %}
              {% if alt_text contains 'country-hide:' %}
                {% assign hide_country = alt_text | split: 'country-hide:' | last | split: ' ' | first | strip %}
                {% if hide_country == user_country %}
                  {% assign hide_media = true %}
                {% endif %}
              {% endif %}
              {% assign active_thumb = false %}
              {% if current_swatch != blank %}
                {% assign media_swatch = media.alt | strip %}
                {% if media_swatch != current_swatch and media_swatch != 'All' %}
                  {% assign hide_media = true %}
                {% endif %}
              {% endif %}
              {% if hide_media == false and active_thumb_taken == false %}
                {% assign active_thumb_taken = true %}
                {% assign active_thumb = true %}
              {% endif %}
              {% unless hide_media %}
                {% assign current_slides_count = current_slides_count | plus: 1 %}
              {% endunless %}
              {% case media.media_type %}
                {% when 'image' %}
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide swiper-slide-thumb{% endif %} {% if active_thumb %}swiper-slide-thumb-active{% endif %} w-[48px] min-w-[48px] p-xxxs border border-gray" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-thumb-carousel-slide>
                    {% render 'lazy-image' image: media alt: media.alt picture_classes: 'h-full' img_classes: 'w-full h-full object-cover object-center' %}
                    
                    {% comment %} Used for replacing first image with Quanity Image Metafield {% endcomment %}
                    {% if first_render_quantity_options_images and product.metafields.seed.quantity_options_images != blank %}
                      {% for media in product.metafields.seed.quantity_options_images.value %}
                        <span class="absolute top-0 bottom-0 right-0 left-0" data-quanity="{{ product.metafields.seed.quantity_option.value[forloop.index] | split: '|' | last | strip }}" js-quanity-option-image>
                          {% render 'lazy-image' image: media alt: media.alt picture_classes: 'h-full' img_classes: 'w-full h-full object-cover object-center' %}
                        </span>
                      {% endfor %}
                      {% assign first_render_quantity_options_images = false %}
                    {% endif %}
                    {% comment %} END Used for replacing first image with Quanity Image Metafield {% endcomment %}

                  </div>
                {% when 'video' %}
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide swiper-slide-thumb{% endif %} {% if active_thumb %}swiper-slide-thumb-active{% endif %} w-[48px] min-w-[48px] p-xxxs border border-gray" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-thumb-carousel-slide>
                    {{ media | video_tag: controls: true, autoplay: false, loop: true, mute: false }}
                  </div>
                {% when 'external_video' %}              
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide swiper-slide-thumb{% endif %} {% if active_thumb %}swiper-slide-thumb-active{% endif %} w-[48px] min-w-[48px] p-xxxs border border-gray" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-thumb-carousel-slide>
                    {{ media | external_video_tag }}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
          <div class="swiper-button-prev left-0 top-1/2 -translate-y-1/2 w-[40px] text-blue after:content-none" js-pdp-thumb-prev>{% render 'icon-active-left' %}</div>
          <div class="swiper-button-next right-0 top-1/2 -translate-y-1/2 w-[40px] text-blue after:content-none {% if current_slides_count < 2 %}hide-thumb-carousel{% endif %}" js-pdp-thumb-next>{% render 'icon-active-right' %}</div>
          <div class="absolute h-full w-[40px] left-0 top-0 z-[5]" style="background: linear-gradient(to right, rgba(255,255,255), rgba(255,255,255, 0.5));"></div>
          <div class="absolute h-full w-[40px] right-0 top-0 z-[5]" style="background: linear-gradient(to left, rgba(255,255,255), rgba(255,255,255, 0.5));"></div>
        </div>
      </s-carousel>
      {%- capture main_carousel_options -%}
        {
          "slidesPerView": 1,
          "loop": false,
          "autoHeight": false,
          "navigation": {
            "enabled": true,
            "prevEl": "[js-pdp-main-prev]",
            "nextEl": "[js-pdp-main-next]"
          }
        }
      {%- endcapture -%}
      <s-carousel data-options='{{ main_carousel_options }}' data-controller="ProductThumbCarousel-{{ product.id }}" class="product__main-carousel grid">
        <div id="ProductMainCarousel-{{ product.id }}" class="swiper w-full max-w-full" js-carousel js-pdp-carousel>
          <div class="swiper-wrapper">
            {% assign first_render_quantity_options_images = true %}
            {% for media in product.media %}
              {% assign media_swatch = '' %}
              {% assign hide_media = false %}
              {% assign alt_text = media.alt | downcase | strip %}
              {% if alt_text contains 'country:' %}
                {% assign show_country = alt_text | split: 'country:' | last | split: ' ' | first | strip %}
                {% if show_country != user_country %}
                  {% assign hide_media = true %}
                {% endif %}
              {% endif %}
              {% if alt_text contains 'country-hide:' %}
                {% assign hide_country = alt_text | split: 'country-hide:' | last | split: ' ' | first | strip %}
                {% if hide_country == user_country %}
                  {% assign hide_media = true %}
                {% endif %}
              {% endif %}
              {% if current_swatch != blank %}
                {% assign media_swatch = media.alt | strip %}
                {% if media_swatch != current_swatch and media_swatch != 'All' %}
                  {% assign hide_media = true %}
                {% endif %}
              {% endif %}
              {% case media.media_type %}
                {% when 'image' %}
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide{% endif %}" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-main-carousel-slide>
                    {% render 'lazy-image' image: media %}

                    {% comment %} Used for replacing first image with Quanity Image Metafield {% endcomment %}
                    {% if first_render_quantity_options_images and product.metafields.seed.quantity_options_images != blank %}
                      {% for media in product.metafields.seed.quantity_options_images.value %}
                        <span class="absolute top-0 bottom-0 right-0 left-0" data-quanity="{{ product.metafields.seed.quantity_option.value[forloop.index] | split: '|' | last | strip }}" js-quanity-option-image>
                          {% render 'lazy-image' image: media alt: media.alt picture_classes: 'h-full' img_classes: 'w-full h-full object-cover object-center' %}
                        </span>
                      {% endfor %}
                      {% assign first_render_quantity_options_images = false %}
                    {% endif %}
                    {% comment %} END Used for replacing first image with Quanity Image Metafield {% endcomment %}
                  </div>
                {% when 'video' %}
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide{% endif %}" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-main-carousel-slide>
                    {{ media | video_tag: controls: true, autoplay: false, loop: true, mute: false }}
                  </div>
                {% when 'external_video' %}              
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide{% endif %}" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-main-carousel-slide>
                    {{ media | external_video_tag }}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
          <div class="swiper-button-prev swiper-nav-btn left-sm text-blue w-[40px] h-[40px] bg-white rounded-full after:content-none" js-pdp-main-prev>{% render 'icon-arrow-left' %}</div>
          <div class="swiper-button-next swiper-nav-btn right-sm text-blue w-[40px] h-[40px] bg-white rounded-full after:content-none" js-pdp-main-next>{% render 'icon-arrow-right' %}</div>
        </div>
      </s-carousel>
    </div><!-- .product__images-container -->

    <div class="product__information p-md desktop:px-xl" id="ProductInfo-{{ section.id }}" js-product-info>
      <div class="desktop:max-w-[var(--max-w-desktop)] desktop:mx-auto" style="--max-w-desktop: {% if section.settings.buybox_max_width != blank %}{{ section.settings.buybox_max_width }}{% else %}unset{% endif %};">
        {%- comment -%}
          * Product Form
        {%- endcomment -%}
        {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', js-product-form: true -%}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'room_tag' %}
                {% capture spacing %}
                  {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                {% endcapture %}
                {% if is_transactional %}
                  {% if product.metafields.seed.applicableFor != blank %}
                    <div class="product__room-tag tag-small w-fit px-xs py-xxs border border-gray rounded-[60px] mb-xs {{ spacing }}">{{ product.metafields.seed.applicableFor }}</div>
                  {% endif %}
                {% else %}
                  {% if product.metafields.seed.applicableFor_international != blank %}
                    <div class="product__room-tag tag-small w-fit px-xs py-xxs border border-gray rounded-[60px] mb-xs {{ spacing }}">{{ product.metafields.seed.applicableFor_international }}</div>
                  {% elsif product.metafields.seed.applicableFor != blank %}
                    <div class="product__room-tag tag-small w-fit px-xs py-xxs border border-gray rounded-[60px] mb-xs {{ spacing }}">{{ product.metafields.seed.applicableFor }}</div>
                  {% endif %}
                {% endif %}
              {% when 'title' %}
                {% capture spacing %}
                  {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                {% endcapture %}
                <h1 class="product__title h3 {{ spacing }}">
                  {% render 'product-title-intl', product: product %}
                </h1>
                {% if current_variant.title != 'Default Title' and product.options contains 'Filter'%}
                  <p class="product__short-description h5 desktop:my-xxs">{{ current_variant.title }} </p>
                {% endif %}
              {% when 'text' %}
                {% capture spacing %}
                  {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                {% endcapture %}
                <div class="{{ spacing }} rte">
                  {{block.settings.text}}
                </div>
              {% when 'short_description' %}
                {% capture spacing %}
                  {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                {% endcapture %}
                <div class="{{ spacing }}">
                  {% if product.metafields.seed.blair_plpShortDescription != blank %}
                    <p class="product__short-description p2 desktop:mt-xxs">{{ product.metafields.seed.blair_plpShortDescription }}</p>
                  {% endif %}
                  {% if product.metafields.seed.blair_filterSupportModels != blank %}
                    <p class="product__short-description p2 desktop:mt-xxs">Compatible with {{ product.metafields.seed.blair_filterSupportModels }}</p>
                  {% endif %}
                </div>
                {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' %}
                  {% if localization.country.iso_code == 'DE' %}
                    <div class="product__intl-pricing mb-md">
                      <span class="text-16" js-price>
                        {{ current_variant.price | money }}
                      </span>
                    </div>
                  {% endif %}
                {% endif %}
              {% when 'star_rating' %}
                {% capture spacing %}
                  {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                {% endcapture %}
                <div class="product__star-rating mt-sm {{ spacing }}">
                  <div data-bv-show="rating_summary" data-bv-product-id="{{product.id}}"></div>
                  <style>
                    .product__star-rating [data-bv-show="rating_summary"] .bv_main_container_row_flex {
                      display: none !important;
                    }
                    .product__star-rating [data-bv-show="rating_summary"] .bv_main_container_row_flex.bv_ratings_summary {
                      display: inline-flex !important;
                      align-items: end !important
                    }
                  </style>
                </div>
              {% when 'product_badge' %}
                {% if is_transactional %}
                  {% if localization.country.iso_code == 'CA' %}
                    {% if product.metafields.seed.product_tags_canada != blank %}
                      {% capture spacing %}
                        {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                      {% endcapture %}
                      <div class="product__badges {{ spacing }} flex justify-start gap-x-xs gap-y-xxs flex-wrap">
                        {% for tag in product.metafields.seed.product_tags_canada.value %}
                          <span class="product__badge bg-blue-darkSky text-12 leading-[1] font-500 py-xxs px-xs rounded-[60px]">{{ tag }}</span>
                        {% endfor %}
                      </div>
                    {% endif %}
                  {% else %}
                      {% if product.metafields.seed.product_tags != blank %}
                        {% capture spacing %}
                          {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                        {% endcapture %}
                        <div class="product__badges {{ spacing }} flex justify-start gap-x-xs gap-y-xxs flex-wrap">
                          {% for tag in product.metafields.seed.product_tags.value %}
                            <span class="product__badge bg-blue-darkSky text-12 leading-[1] font-500 py-xxs px-xs rounded-[60px]">{{ tag }}</span>
                          {% endfor %}
                        </div>
                      {% endif %}
                  {% endif %}
                {% endif %}
              {% when 'filter_options' %}
                {% if enable_subscription == false and product.metafields.seed.product_card_filter_products != blank %}
                  <div class="product__filter-options my-sm">
                    <p class="s1 mb-sm">Customize your filter</p>
                    <div class="product__filters flex gap-xs mb-xs">
                      {% for swatch_product in product.metafields.seed.product_card_filter_products.value %}
                        <a href="{{swatch_product.url}}" class="product__filter-link block h-xl w-xl border {% if swatch_product.variants[0].title == product.variants[0].title %} border-black {% else %} border-gray {% endif %} tabletl:h-xxl tabletl:w-xxl">
                          {% assign image = swatch_product.metafields.seed.product_card_image | default: swatch_product.featured_image %}
                          {% render 'lazy-image' image: image %}
                        </a>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}
              {% when 'product_options' %}
                {% if is_transactional %}
                {% capture spacing %}
                  {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                {% endcapture %}
                <div class="{{ spacing }}">
                  {%- comment -%} Product Variant Master Select {%- endcomment -%}
                  {% render 'master-variant-select',
                  variants: product.variants,
                  id: master_select_id,
                  current_variant: current_variant
                  %}

                  {% unless product.has_only_default_variant %}
                  <product-options class="no-js-hidden" data-product='ProductJSON' data-master-select-id="{{ master_select_id }}" data-enable-history-state {% if product.options_with_values.size != 2 %}data-disable-option-binding{% endif %}>
                    {% for option in product.options_with_values %}
                      {% render 'product-option-selector' 
                        option: option
                        type: 'swatch'
                        section_id: section.id
                        product_id: product.id
                        current_variant: current_variant
                      %}
                    {% endfor %}
                  </product-options>
                  {% endunless %}

                  {% if size_tag != blank and related_tag_size != blank %}
                    <div class="product__realated-sizes-container mt-sm mb-sm">
                      <span class="product__related-size-label block font-700 text-12 text-blue mb-xxs">Size: {{size_tag}}</span>
                      <div class="product__related-sizes flex flex-row-reverse justify-end flex-wrap gap-xs"
                        data-handle="{{product.handle}}"
                        data-collection="{{related_tag_size}}"
                        data-option="size"
                        js-product-option-swatches-container>
                      </div>
                    </div>
                  {% endif %}

                  {% if product.metafields.shopify.color-pattern != blank and related_tag_color != blank %}
                    <div class="product__realted-colors-container mt-sm mb-sm">
                      {% for color in product.metafields.shopify.color-pattern.value %}
                        <div class="product__related-color">
                          <span class="product__related-color-label block font-700 text-12 text-blue mb-xxs">Color: {{color.label}}</span>
                          <div class="product__related-colors flex flex-wrap gap-xs"
                            data-handle="{{product.handle}}"
                            data-collection="{{related_tag_color}}"
                            data-option="color"
                            js-product-option-swatches-container>
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  {% endif %}

                  {% if product.metafields.seed.promo_callout != blank %}
                    <div class="product__promo-callout mb-32 font-700 text-12 text-center bg-blue-darkSky text-blue py-xxs px-xs w-full rounded-[60px]">
                      {{ product.metafields.seed.promo_callout }}
                    </div>
                  {% endif %}

                  {% if enable_subscription %}
                    {% render 'product-subscription' product: product current_variant: current_variant subscription: subscription filter_subscription_discounted_price: filter_subscription_discounted_price %}
                  {% endif %}

                  {% if product.metafields.seed.quantity_option != blank %}
                    <div class="product__quantity-option border-t border-gray py-sm px-xs flex justify-start flex-wrap gap-x-md gap-y-xs {% if enable_subscription or product.variants.size > 1 %}mt-md{% endif %}" js-quantity-option>
                      {% for quantity_variant in product.metafields.seed.quantity_option.value %}
                        {% assign quantity_variant_value = quantity_variant | split: '|' | last | strip %}
                        {% assign quantity_variant_label = quantity_variant | split: '|' | first | strip %}
                        <div class="product__quantity-variant">
                          <input 
                            id="Product{{ product.id }}-QuantityVariant-{{ quantity_variant | handle }}" 
                            class="product-quantity-variant__input visually-hidden"
                            type="radio" 
                            name="quantity" 
                            value="{{ quantity_variant_value }}"
                            data-pack="{% if quantity_variant_label contains 'Pack' %}true{% else %}false{% endif %}"
                            autocomplete="off"
                            js-quantity-variant>
                          <label
                            for="Product{{ product.id }}-QuantityVariant-{{ quantity_variant | handle }}"
                            class="product-quantity-variant__label text-18 flex justify-start items-center gap-xs">
                              <span class="product-quantity-variant__checkbox w-[22px] h-[22px] rounded-full border border-blue relative"></span>
                              <span class="flex-1">{{ quantity_variant_label }}</span>
                          </label>
                        </div>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
              {% when 'atc' %}
                {% if is_transactional %}
                {% capture spacing %}
                  {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                {% endcapture %}
                <div class=" flex flex-col gap-md {{ spacing }} tabletl:items-center tabletl:justify-between tabletl:flex-col-reverse">          
                  <button 
                    class="product__atc btn btn--blue-rounded relative mx-auto w-full justify-center"
                    type="submit" 
                    {% unless current_variant.available %} disabled {% endunless %}
                    js-add-to-cart>
                    <div class="btn__text whitespace-nowrap h-[32px] flex items-center">
                      <span js-price>
                        {{ current_variant.price | money }}
                      </span>
                      <span>&nbsp;-&nbsp;</span>
                      <span js-atc-text data-add-to-cart-text="{{ 'products.product.add_to_cart' | t }}" data-out-of-stock-text="{{'products.product.sold_out' | t }}">
                        {% if current_variant.available %}
                          {{ 'products.product.add_to_cart' | t }}
                        {% else %}
                          {{'products.product.sold_out' | t }}
                        {% endif %}
                      </span>
                    </div>
                    <loading-spinner style="--color: #F0F3F6; --width: 24px; --height: 24px;"></loading-spinner>
                  </button>
                  <p class="affirm-as-low-as mx-auto tabletl:order-first" data-page-type="product" data-amount="{{current_variant.price}}"></p>
                </div>
                <p class="hidden p2 font-700" js-error-message></p>
              {% endif %}
              {% when 'experience' %}
                {% capture spacing %}
                  {{ block.settings.margin_top_mobile }} {{ block.settings.margin_bottom_mobile }} {{ block.settings.margin_top_desktop }} {{ block.settings.margin_bottom_desktop }}
                {% endcapture %}
                {% if product.metafields.seed.experience_icons != blank or product.metafields.seed.experience_description != blank %}
                  <s-accordion class="block {{ spacing }}" data-manual-collapse="true" js-accordion>
                    <div class="accordion-item accordion-item product__experience border-t border-gray" js-accordion-item>
                      <button class="accordion-header py-md w-full flex justify-between items-center" type="button" aria-expanded="true" aria-controls="accordionID" js-accordion-header>
                        {% if product.metafields.seed.experience_heading != blank %}
                          <span class="s2">{{ product.metafields.seed.experience_heading }}</span>
                        {% endif %}
                        <span class="accordion-icon--plus p-xxs w-[33px] leading-[0]">{% render 'icon-plus' %}</span>
