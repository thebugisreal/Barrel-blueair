  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.addEventListener('click', function(e) {
        const bisButton = e.target.closest('[js-klaviyo-bis-modal-trigger]');
        if (!bisButton) return;
        
        e.preventDefault();
        e.stopPropagation();
        
        const variantId = bisButton.getAttribute('data-variant-id');
        if (!variantId) {
          console.error('No variant ID found for BIS modal');
          return;
        }
        
        console.log('Opening Klaviyo BIS modal for variant:', variantId);
        
        // Function to try opening the modal with retry logic
        function openBISModal() {
          if (window.Klaviyo && window.Klaviyo.BIS && window.Klaviyo.BIS.showModal) {
            window.Klaviyo.BIS.showModal({ variant: variantId });
            return true;
          } else if (window.klaviyo && window.klaviyo.backinstock && window.klaviyo.backinstock.showModal) {
            window.klaviyo.backinstock.showModal({ variant: variantId });
            return true;
          } else if (window.klaviyo && window.klaviyo.BIS && window.klaviyo.BIS.showModal) {
            window.klaviyo.BIS.showModal({ variant: variantId });
            return true;
          } else if (window.klaviyo && typeof window.klaviyo.push === 'function') {
            window.klaviyo.push(['backinstock', 'showModal', { variant: variantId }]);
            return true;
          } else {
            const bisModal = document.querySelector('[js-klaviyo-bis-modal]');
            if (bisModal && typeof bisModal.open === 'function') {
              const productTitle = bisModal.querySelector('[js-bis-product-title]');
              if (productTitle) {
                productTitle.textContent = bisButton.closest('.product-upsell__item').querySelector('.product-upsell__title')?.textContent || 'Product';
              }
              
              const form = bisModal.querySelector('[js-bis-form]');
              if (form) {
                let variantInput = form.querySelector('input[name="variant"]');
                if (!variantInput) {
                  variantInput = document.createElement('input');
                  variantInput.type = 'hidden';
                  variantInput.name = 'variant';
                  form.appendChild(variantInput);
                }
                variantInput.value = variantId;
              }
              
              bisModal.open();
              return true;
            }
            
            if (!window._klaviyoBISLogged) {
              console.log('Klaviyo BIS not ready, retrying...');
              console.log('Available Klaviyo objects:', {
                'window.Klaviyo': typeof window.Klaviyo,
                'window.klaviyo': typeof window.klaviyo,
                'klaviyo.backinstock': window.klaviyo ? typeof window.klaviyo.backinstock : 'undefined',
                'klaviyo.BIS': window.klaviyo ? typeof window.klaviyo.BIS : 'undefined',
                'klaviyo.push': window.klaviyo ? typeof window.klaviyo.push : 'undefined'
              });
              window._klaviyoBISLogged = true;
            }
            return false;
          }
        }
        
        if (!openBISModal()) {
          const retryInterval = setInterval(() => {
            if (openBISModal()) {
              clearInterval(retryInterval);
              window._klaviyoBISLogged = false;
            }
          }, 2000);
          
          setTimeout(() => {
            clearInterval(retryInterval);
            console.error('Klaviyo BIS failed to load within 10 seconds');
            window._klaviyoBISLogged = false;
          }, 10000);
        }
      });
    });
  </script>

</s-product>

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "@id" : {{ shop.url | append: product.url | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {%- if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

