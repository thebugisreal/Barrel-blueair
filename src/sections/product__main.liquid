{%- liquid 
  if product.variants.size > 1
    assign current_variant = product.selected_variant 
  else
    assign current_variant = product.variants[0]
  endif
  assign product_form_id = 'ProductForm-' | append: section.id | append: product.id
  assign master_select_id = 'MasterSelect-' | append: section.id
  assign current_swatch = ''
  if product.options_by_name['color'] != blank
    assign swatch_option = product.options_by_name['color'].position | minus: 1
    assign current_swatch = current_variant.options[swatch_option]
  elsif product.options_by_name['filter type'] != blank
    assign swatch_option = product.options_by_name['filter type'].position | minus: 1
    assign current_swatch = current_variant.options[swatch_option]
  endif
-%}

<s-product role="section" class="product" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" {% if current_swatch != blank %}data-swatch-option="{{ swatch_option }}" data-current-swatch="{{ current_swatch }}"{% endif %}>
  <a class="skip-to-content-link sr-only" href="#ProductInfo-{{ section.id }}">Skip to product information</a>
  <div class="product__layout desktop:grid desktop:grid-cols-2 desktop:items-start">
    <div class="product__images flex flex-col-reverse desktop:sticky desktop:top-[var(--header-height)]">
      {%- capture thumb_carousel_options -%}
        {
          "loop": false,
          "autoHeight": false,
          "spaceBetween": 8,
          "watchSlidesProgress": true,
          "navigation": {
            "enabled": true,
            "prevEl": "[js-pdp-thumb-prev]",
            "nextEl": "[js-pdp-thumb-next]"
          }
        }
      {%- endcapture -%}
      <s-carousel data-options='{{ thumb_carousel_options }}' class="product__thumb-carousel grid p-sm desktop:p-md w-fit mx-auto">
        <div id="ProductThumbCarousel-{{ product.id }}" class="swiper w-full max-w-full px-[40px]" js-carousel js-pdp-carousel is-thumb-carousel>
          <div class="swiper-wrapper">
            {% assign current_slides_count = 0 %}
            {% assign active_thumb_taken = false %}
            {% for media in product.media %}
              {% assign media_swatch = '' %}
              {% assign hide_media = false %}
              {% assign active_thumb = false %}
              {% assign media_swatch = media.alt | strip %}
              {% if current_swatch != blank %}
                {% if media_swatch != current_swatch %}
                  {% assign hide_media = true %}
                {% endif %}
              {% endif %}
              {% if hide_media == false and active_thumb_taken == false %}
                {% assign active_thumb_taken = true %}
                {% assign active_thumb = true %}
              {% endif %}
              {% unless hide_media %}
                {% assign current_slides_count = current_slides_count | plus: 1 %}
              {% endunless %}
              {% case media.media_type %}
                {% when 'image' %}
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide swiper-slide-thumb{% endif %} {% if active_thumb %}swiper-slide-thumb-active{% endif %} w-[48px] min-w-[48px] h-[48px] p-xxxs border border-gray" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-thumb-carousel-slide>
                    {% render 'lazy-image' image: media alt: media.alt picture_classes: 'h-full' img_classes: 'w-full h-full object-cover object-center' %}
                  </div>
                {% when 'video' %}
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide swiper-slide-thumb{% endif %} {% if active_thumb %}swiper-slide-thumb-active{% endif %} w-[48px] min-w-[48px] h-[48px] p-xxxs border border-gray" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-thumb-carousel-slide>
                    {{ media | video_tag: controls: true, autoplay: false, loop: true, mute: false }}
                  </div>
                {% when 'external_video' %}              
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide swiper-slide-thumb{% endif %} {% if active_thumb %}swiper-slide-thumb-active{% endif %} w-[48px] min-w-[48px] h-[48px] p-xxxs border border-gray" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-thumb-carousel-slide>
                    {{ media | external_video_tag }}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
          <div class="swiper-button-prev left-0 top-1/2 -translate-y-1/2 w-[40px] text-blue after:content-none" js-pdp-thumb-prev>{% render 'icon-active-left' %}</div>
          <div class="swiper-button-next right-0 top-1/2 -translate-y-1/2 w-[40px] text-blue after:content-none {% if current_slides_count < 2 %}hide-thumb-carousel{% endif %}" js-pdp-thumb-next>{% render 'icon-active-right' %}</div>
          <div class="absolute h-full w-[40px] left-0 top-0 z-[5]" style="background: linear-gradient(to right, rgba(255,255,255), rgba(255,255,255, 0.5));"></div>
          <div class="absolute h-full w-[40px] right-0 top-0 z-[5]" style="background: linear-gradient(to left, rgba(255,255,255), rgba(255,255,255, 0.5));"></div>
        </div>
      </s-carousel>
      {%- capture main_carousel_options -%}
        {
          "slidesPerView": 1,
          "loop": false,
          "autoHeight": false,
          "navigation": {
            "enabled": true,
            "prevEl": "[js-pdp-main-prev]",
            "nextEl": "[js-pdp-main-next]"
          }
        }
      {%- endcapture -%}
      <s-carousel data-options='{{ main_carousel_options }}' data-controller="ProductThumbCarousel-{{ product.id }}" class="product__main-carousel grid">
        <div id="ProductMainCarousel-{{ product.id }}" class="swiper w-full max-w-full" js-carousel js-pdp-carousel>
          <div class="swiper-wrapper">
            {% for media in product.media %}
              {% assign media_swatch = '' %}
              {% assign hide_media = false %}
              {% assign media_swatch = media.alt | strip %}
              {% if current_swatch != blank %}
                {% if media_swatch != current_swatch %}
                  {% assign hide_media = true %}
                {% endif %}    
              {% endif %}
              {% case media.media_type %}
                {% when 'image' %}
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide{% endif %}" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-main-carousel-slide>
                    {% render 'lazy-image' image: media %}
                  </div>
                {% when 'video' %}
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide{% endif %}" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-main-carousel-slide>
                    {{ media | video_tag: controls: true, autoplay: false, loop: true, mute: false }}
                  </div>
                {% when 'external_video' %}              
                  <div class="{% if hide_media %}hidden{% else %}swiper-slide{% endif %}" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-main-carousel-slide>
                    {{ media | external_video_tag }}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
          <div class="swiper-button-prev swiper-nav-btn left-sm text-blue w-[40px] h-[40px] bg-white rounded-full after:content-none" js-pdp-main-prev>{% render 'icon-arrow-left' %}</div>
          <div class="swiper-button-next swiper-nav-btn right-sm text-blue w-[40px] h-[40px] bg-white rounded-full after:content-none" js-pdp-main-next>{% render 'icon-arrow-right' %}</div>
        </div>
      </s-carousel>
    </div><!-- .product__images-container -->

    <div class="product__information p-md desktop:px-xl" id="ProductInfo-{{ section.id }}" js-product-info>
      <div class="desktop:max-w-[var(--max-w-desktop)] desktop:mx-auto" style="--max-w-desktop: {% if section.settings.buybox_max_width != blank %}{{ section.settings.buybox_max_width }}{% else %}unset{% endif %};">
        {%- comment -%}
          * Product Form
        {%- endcomment -%}
        {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', js-product-form: true -%}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'room_tag' %}
                {% if product.metafields.seed.applicableFor != blank %}
                  <div class="product__room-tag tag-small w-fit px-xs py-xxs border border-gray rounded-[60px] mb-xs">{{ product.metafields.seed.applicableFor }}</div>
                {% endif %}
              {% when 'title' %}
                <h1 class="product__title h3">{{ product.title }}</h1>
                {% if product.variants[0] != blank and product.variants[0].title != 'Default Title' %}
                  <p class="product__short-description h5 desktop:my-xxs">{{ product.variants[0].title}} </p>
                {% endif %}
              {% when 'short_description' %}
                {% if product.metafields.seed.productHeadline1 != blank %}
                  <p class="product__short-description p2 desktop:mt-xxs">{{ product.metafields.seed.productHeadline1 }}</p>
                {% endif %}
                {% if product.metafields.seed.blair_filterSupportModels != blank %}
                  <p class="product__short-description p2 desktop:mt-xxs">Compatible with {{ product.metafields.seed.blair_filterSupportModels }}</p>
                {% endif %}
              {% when 'star_rating' %}
                <div class="product__star-rating mt-sm">reviews</div>
              {% when 'filter_options' %}
                {% if product.metafields.seed.product_card_filter_products != blank %}
                  <div class="product__filter-options my-sm">
                    <p class="s1 mb-sm">Customize your filter</p>
                    <div class="product__filters flex gap-xs mb-xs">
                      {% for swatch_product in product.metafields.seed.product_card_filter_products.value %}
                        <a href="{{swatch_product.url}}" class="product__filter-link block h-xl w-xl border {% if swatch_product.variants[0].title == product.variants[0].title %} border-black {% else %} border-gray {% endif %} tabletl:h-xxl tabletl:w-xxl">
                          {% assign image = swatch_product.featured_image | default: product.featured_image %}
                          {% render 'lazy-image' image: image %}
                        </a>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}
              {% when 'product_options' %}
                {%- comment -%} Product Variant Master Select {%- endcomment -%}
                {% render 'master-variant-select',
                variants: product.variants,
                id: master_select_id,
                current_variant: current_variant
                %}

                {% unless product.has_only_default_variant %}
                <product-options class="no-js-hidden" data-product='ProductJSON' data-master-select-id="{{ master_select_id }}" data-enable-history-state {% if product.options_with_values.size != 2 %}data-disable-option-binding{% endif %}>
                  {% for option in product.options_with_values %}
                    {% render 'product-option-selector' 
                      option: option
                      type: 'swatch'
                      section_id: section.id
                      product_id: product.id
                      current_variant: current_variant
                    %}
                  {% endfor %}
                </product-options>
                {% endunless %}

                {% liquid 
                  assign enable_subscription = false
                  if product.metafields.seed.subscription != blank
                    assign subscription = product.metafields.seed.subscription.value
                    for filter_subscription in subscription.filter_subscriptions.value
                      if filter_subscription.variants[0].selling_plan_allocations.size > 0
                        assign enable_subscription = true
                        break
                      endif
                    endfor
                  endif
                %}
                {% if enable_subscription %}
                  {% render 'product-subscription' product: product current_variant: current_variant subscription: subscription %}
                {% endif %}
              {% when 'atc' %}
                <button 
                  class="product__atc btn btn--blue-rounded relative"
                  type="submit" 
                  {% unless current_variant.available %} disabled {% endunless %}
                  js-add-to-cart>
                  <div class="btn__text">
                    <span js-price>{{ current_variant.price | money }}</span><span>&nbsp;-&nbsp;</span>
                    <span js-atc-text>
                      {% if current_variant.available %}
                        Add to Cart
                      {% else %}
                        Out of Stock
                      {% endif %}
                    </span>
                  </div>
                  <div class="btn__arrow">{% render 'icon-arrow-right' %}</div>
                  <loading-spinner style="--color: #F0F3F6; --width: 24px; --height: 24px;"></loading-spinner>
                </button>
                <p class="hidden p2" js-error-message></p>
              {% when 'experience' %}
                {% if product.metafields.seed.experience_icons != blank or product.metafields.seed.experience_description != blank %}
                  <div class="product__experience py-md border-t border-gray">
                    {% if product.metafields.seed.experience_heading != blank %}
                      <div class="product-experience__heading s2 mb-sm desktop:mb-md">
                        {{ product.metafields.seed.experience_heading }}
                      </div>
                    {% endif %}
                    {% if product.metafields.seed.experience_description != blank %}
                      <div class="product-experience__description rte p4">
                        {{ product.metafields.seed.experience_description | metafield_tag }}
                      </div>
                    {% endif %}
                    {% if product.metafields.seed.experience_icons != blank %}
                      <ul class="product-experience__icons grid grid-cols-4 mt-md gap-x-xxs gap-y-md desktop:gap-x-sm">
                        {% for icon_object in product.metafields.seed.experience_icons.value %}
                          <li class="product-experience__icon flex flex-col items-center gap-xs">
                            <div class="w-[36px]">{% render 'lazy-image' image: icon_object.icon %}</div>
                            <div class="p4 text-center">{{ icon_object.text }}</div>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                {% endif %}
              {% when 'additional_features' %}
                {% if product.metafields.seed.blair_airSensor != blank  or product.metafields.seed.blair_productSpecification_fanspeed != blank or product.metafields.seed.blair_productSpecification_timer != blank or product.metafields.seed.blair_wifiConnectivity != blank %}
                  <s-accordion data-manual-collapse="true" js-accordion>
                    <div class="accordion-item product__additional-features border-t border-gray" js-accordion-item>
                      <button type="button" class="accordion-header py-md w-full flex justify-between items-center" aria-expanded="true" aria-controls="ProductAdditionalFeatures" js-accordion-header>
                        <span class="s2">Additional Features</span>
                        <span class="accordion-icon--plus p-xxs w-[33px] leading-[0]">{% render 'icon-plus' %}</span>
                        <span class="accordion-icon--minus p-xxs w-[33px] leading-[0]">{% render 'icon-minus' %}</span>
                      </button>
                      <div id="ProductAdditionalFeatures" class="accordion-content" aria-hidden="false" js-accordion-content>
                        <ul class="product-additional-features__list pb-md">
                          {% if product.metafields.seed.blair_wifiConnectivity != blank %}
                            <li class="product-additional-features__list-item py-xs grid grid-cols-1 gap-xxxs desktop:grid-cols-2 desktop:gap-md">
                              <span class="p3">Wi-Fi connectivity for remote control</span>
                              <span class="p4">{% if product.metafields.seed.blair_wifiConnectivity == '1' or product.metafields.seed.blair_wifiConnectivity == 'Yes' or product.metafields.seed.blair_wifiConnectivity == 'yes' %}Yes{% else %}No{% endif %}</span>
                            </li>
                          {% endif %}
                          {% if product.metafields.seed.blair_productSpecification_timer != blank %}
                            <li class="product-additional-features__list-item py-xs grid grid-cols-1 gap-xxxs desktop:grid-cols-2 desktop:gap-md">
                              <span class="p3">On/ off timer</span>
                              <span class="p4">
                                {% if product.metafields.seed.blair_productSpecification_timer == 'true_app' %}
                                  Yes, <a href="/pages/subscribe" class="link link--underline underline-offset-1">via Blueair App</a>
                                {% else %}
                                  No
                                {% endif %}
                            </span>
                            </li>
                          {% endif %}
                          {% if product.metafields.seed.blair_productSpecification_fanspeed != blank %}
                            <li class="product-additional-features__list-item py-xs grid grid-cols-1 gap-xxxs desktop:grid-cols-2 desktop:gap-md">
                              <span class="p3">Speed control options</span>
                              <span class="p4">{{ product.metafields.seed.blair_productSpecification_fanspeed }}</span>
                            </li>
                          {% endif %}
                          {% if product.metafields.seed.blair_airSensor != blank %}
                            <li class="product-additional-features__list-item py-xs grid grid-cols-1 gap-xxxs desktop:grid-cols-2 desktop:gap-md">
                              <span class="p3">Integrated air sensors</span>
                              <span class="p4">{% if product.metafields.seed.blair_airSensor == '1' or product.metafields.seed.blair_airSensor == 'Yes' or product.metafields.seed.blair_airSensor == 'yes' %}Yes{% else %}No{% endif %}</span>
                            </li>
                          {% endif %}
                        </ul>
                      </div>
                    </div>
                  </s-accordion>
                {% endif %}
              {% when 'shipping_warranty' %}
                {% if block.settings.icon_1_image != blank %}
                  <s-accordion data-manual-collapse="true" js-accordion>
                    <div class="accordion-item product__shipping-warranty border-t border-gray" js-accordion-item>
                      <button type="button" class="accordion-header py-md w-full flex justify-between items-center" aria-expanded="true" aria-controls="ProductShippingWarranty" js-accordion-header>
                        <span class="s2">Shipping & Warranty</span>
                        <span class="accordion-icon--plus p-xxs w-[33px] leading-[0]">{% render 'icon-plus' %}</span>
                        <span class="accordion-icon--minus p-xxs w-[33px] leading-[0]">{% render 'icon-minus' %}</span>
                      </button>
                      <div id="ProductShippingWarranty" class="accordion-content" aria-hidden="false" js-accordion-content>
                        <ul class="product-shipping-warranty__icons grid grid-cols-1 gap-sm desktop:grid-cols-3 desktop:gap-md pb-md">
                          {% for i in (1..3) %}
                            {% assign icon_image_handle = 'icon_' | append: i | append: '_image' %}
                            {% assign icon_text_handle = 'icon_' | append: i | append: '_text' %}
                            <li class="product-shipping-warranty__icon flex justify-start items-center gap-xxs desktop:flex-col desktop:gap-xs">
                              <div class="w-[36px]">{% render 'lazy-image' image: block.settings[icon_image_handle] %}</div>
                              <div class="p4 text-center">{{ block.settings[icon_text_handle] }}</div>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  </s-accordion>
                {% endif %}
              {% when 'upsells' %}
                {% if product.metafields.seed.upsells != blank %}
                  <div class="product__upsells py-md border-t border-gray">
                    {% if product.metafields.seed.upsells_heading != blank %}
                      <div class="product-upsells__heading s2 mb-md">{{ product.metafields.seed.upsells_heading }}</div>
                    {% endif %}
                    <div class="product-upsells__items grid grid-cols-1 gap-md desktop:grid-cols-2 desktop:gap-sm">
                      {% for upsell_object in product.metafields.seed.upsells.value %}
                        <product-upsell class="product-upsell__item border border-gray p-sm desktop:py-md flex flex-col">
                          {% if upsell_object.heading != blank %}
                            <div class="product-upsell__title s2 mb-xxs">{{ upsell_object.heading }}</div>
                          {% endif %}
                          {% if upsell_object.short_description != blank %}
                            <div class="product-upsell__description p4">{{ upsell_object.short_description }}</div>
                          {% endif %}
                          <div class="product-upsell__buybox mt-md flex-1 flex flex-col justify-between gap-md">
                            {% assign upsell_product = upsell_object.product.value %}
                            {% assign upsell_current_variant = upsell_product.selected_or_variants[0] %}
                            {% if upsell_product.variants.size > 1 %}
                              {% liquid
                                assign color_option = false
                                assign filter_type_option = false
                                if upsell_product.options_by_name['color'] != blank
                                  assign color_option = upsell_product.options_by_name['color'].position | minus: 1
                                elsif upsell_product.options_by_name['filter type'] != blank
                                  assign filter_type_option = upsell_product.options_by_name['filter type'].position | minus: 1
                                endif
                              %}
                              {% if color_option != false %}
                                <div class="product-upsell__variants-container">
                                  <div class="product-upsell__current-color-label p3 mb-xxxs" js-product-upsell-current-color-label>{{ upsell_current_variant.options[color_option] }}</div>
                                  <div class="product-upsell__variants flex justify-start flex-wrap gap-xs">
                                    {% assign upsell_product_swatch_objects = upsell_product.metafields.seed.swatches.value | reverse | reverse %}
                                    {% for upsell_variant in upsell_product.variants %}
                                      <button type="button" 
                                        class="product-upsell__variant product-upsell__variant--color w-[40px] h-[40px] rounded-full" 
                                        data-variant-id="{{ upsell_variant.id }}"
                                        data-available="{{ upsell_variant.available }}"
                                        data-price="{{ upsell_variant.price | money }}"
                                        data-selected="{% if upsell_variant.options[color_option] == upsell_current_variant.options[color_option] %}true{% else %}false{% endif %}"
                                        title="{{ upsell_variant.options[color_option] }}"
                                        js-product-upsell-variant>
                                        <div class="block w-full h-full rounded-full overflow-hidden" style="background-color: {{ upsell_product_swatch_objects[forloop.index0].color }};">
                                          {% if upsell_product_swatch_objects[forloop.index0].image != blank %}
                                            <img src="{{ upsell_product_swatch_objects[forloop.index0].image.value | img_url: '40x'}}" alt="{{ upsell_variant.options[color_option] }}" class="block h-full w-full">
                                          {% endif %}
                                        </div>
                                      </button>
                                    {% endfor %}
                                  </div>
                                </div>
                              {% elsif filter_type_option != false %}
                                <div class="product-upsell__variants grid grid-cols-1 gap-xxs">
                                  {% for upsell_variant in upsell_product.variants %}
                                    <button type="button" 
                                      class="product-upsell__variant product-upsell__variant--filter-type p3 border border-gray p-xxs text-center rounded-[2px]" 
                                      data-variant-id="{{ upsell_variant.id }}"
                                      data-available="{{ upsell_variant.available }}"
                                      data-price="{{ upsell_variant.price | money }}"
                                      data-selected="{% if upsell_variant.options[filter_type_option] == upsell_current_variant.options[filter_type_option] %}true{% else %}false{% endif %}"
                                      js-product-upsell-variant>
                                      {{ upsell_variant.options[filter_type_option] }}
                                    </button>
                                  {% endfor %}
                                </div>
                              {% endif %}
                            {% endif %}
                            <div class="product-upsell__atc-container flex justify-between items-center flex-wrap gap-xxs">
                              <div class="product-upsell__price p1" js-product-upsell-price>{{ upsell_current_variant.price | money }}</div>
                              <button type="button" class="product-upsell__atc btn btn--blue-rounded" {% unless upsell_current_variant.available %}disabled{% endunless %} data-variant-id="{{ upsell_current_variant.id }}" js-product-upsell-atc>
                                <span class="btn__text">
                                  {% if upsell_current_variant.available %}
                                    Add to Cart
                                  {% else %}
                                    Out of Stock
                                  {% endif %}
                                </span>
                                <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                              </button>
                              <p class="p6 hidden text-right w-full leading-[1.1]" js-product-upsell-error></p>
                            </div>
                          </div>
                        </product-upsell>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}
              {% when 'spacing' %}
                <div class="product__spacing w-full h-[var(--spacing-mobile)] desktop:h-[var(--spacing-desktop)]" style="--spacing-mobile: {{ block.settings.spacing_mobile | default: 0 }}px; --spacing-desktop: {{ block.settings.spacing_desktop | default: 0 }}px;"></div>
            {% endcase %}
          {% endfor %}
        {%- endform -%}
        {% comment %}
        <div class="hidden">
          addOnFilters - {{ product.metafields.seed.addOnFilters }}<br>
          applicableFor - {{ product.metafields.seed.applicableFor }}<br>
          availableInCountries - {{ product.metafields.seed.availableInCountries }}<br>
          blair_airInlet - {{ product.metafields.seed.blair_airInlet }}<br>
          blair_airOutlet - {{ product.metafields.seed.blair_airOutlet }}<br>
          blair_airSensor - {{ product.metafields.seed.blair_airSensor }}<br>
          blair_blue_allocated_unit - {{ product.metafields.seed.applicableFor }}<br>
          blair_CADR_dust - {{ product.metafields.seed.blair_CADR_dust }}<br>
          blair_CADR_pollen - {{ product.metafields.seed.blair_CADR_pollen }}<br>
          blair_CADR_smoke - {{ product.metafields.seed.blair_CADR_smoke }}<br>
          blair_casters - {{ product.metafields.seed.blair_casters }}<br>
          blair_classic_allocated_unit - {{ product.metafields.seed.blair_classic_allocated_unit }}<br>
          blair_clean_air_delivery_rate - {{ product.metafields.seed.blair_clean_air_delivery_rate }}<br>
          blair_defaultFilter - {{ product.metafields.seed.blair_defaultFilter }}<br>
          blair_defaultSpareID - {{ product.metafields.seed.blair_defaultSpareID }}<br>
