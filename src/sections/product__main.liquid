{%- liquid 
  assign current_variant = product.selected_or_first_available_variant 
  assign product_form_id = 'ProductForm-' | append: section.id | append: product.id
  assign master_select_id = 'MasterSelect-' | append: section.id
  assign current_swatch = ''
  if product.options_by_name['color'] != blank
    assign swatch_option = product.options_by_name['color'].position | minus: 1
    assign current_swatch = current_variant.options[swatch_option]
  elsif product.options_by_name['filter type'] != blank
    assign swatch_option = product.options_by_name['filter type'].position | minus: 1
    assign current_swatch = current_variant.options[swatch_option]
  endif
-%}

<s-product role="section" class="product" data-section-id="{{ section.id }}" {% if current_swatch != blank %}data-swatch-option="{{ swatch_option }}" data-current-swatch="{{ current_swatch }}"{% endif %}>
  <a class="skip-to-content-link sr-only" href="#ProductInfo-{{ section.id }}">Skip to product information</a>
  <div class="product__layout desktop:grid desktop:grid-cols-2 desktop:items-start">
    <div class="product__images flex flex-col-reverse desktop:sticky desktop:top-[var(--header-height)]">
      {%- capture thumb_carousel_options -%}
        {
          "loop": false,
          "autoHeight": false,
          "spaceBetween": 8,
          "watchSlidesProgress": true,
          "navigation": {
            "enabled": true,
            "prevEl": "[js-pdp-thumb-prev]",
            "nextEl": "[js-pdp-thumb-next]"
          }
        }
      {%- endcapture -%}
      <s-carousel data-options='{{ thumb_carousel_options }}' class="product__thumb-carousel grid p-sm desktop:p-md">
        <div id="ProductThumbCarousel-{{ product.id }}" class="swiper w-full max-w-full px-[40px]" js-carousel js-pdp-carousel>
          <div class="swiper-wrapper">
            {% assign active_thumb_taken = false %}
            {% for media in product.media %}
              {% assign media_swatch = '' %}
              {% assign hide_media = false %}
              {% assign active_thumb = false %}
              {% if current_swatch != blank %}
                {% assign media_swatch = media.alt | strip %}
                {% if media_swatch != current_swatch %}
                  {% assign hide_media = true %}
                {% endif %}
              {% endif %}
              {% if hide_media == false and active_thumb_taken == false %}
                {% assign active_thumb_taken = true %}
                {% assign active_thumb = true %}
              {% endif %}
              {% case media.media_type %}
                {% when 'image' %}
                  <button class="{% if hide_media %}hidden{% else %}swiper-slide swiper-slide-thumb{% endif %} {% if active_thumb %}swiper-slide-thumb-active{% endif %} w-[48px] min-w-[48px] h-[48px] p-xxxs border border-gray" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-thumb-carousel-slide>
                    {% render 'lazy-image' image: media alt: media.alt picture_classes: 'h-full' img_classes: 'w-full h-full object-cover object-center' %}
                  </button>
                {% when 'video' %}
                  <button class="{% if hide_media %}hidden{% else %}swiper-slide swiper-slide-thumb{% endif %} {% if active_thumb %}swiper-slide-thumb-active{% endif %} w-[48px] min-w-[48px] h-[48px] p-xxxs border border-gray" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-thumb-carousel-slide>
                    {{ media | video_tag: controls: true, autoplay: false, loop: true, mute: false }}
                  </button>
                {% when 'external_video' %}              
                  <button class="{% if hide_media %}hidden{% else %}swiper-slide swiper-slide-thumb{% endif %} {% if active_thumb %}swiper-slide-thumb-active{% endif %} w-[48px] min-w-[48px] h-[48px] p-xxxs border border-gray" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-thumb-carousel-slide>
                    {{ media | external_video_tag }}
                  </button>
                {% endcase %}
            {% endfor %}
          </div>
          <div class="swiper-button-prev left-0 top-1/2 -translate-y-1/2 w-[40px] text-blue after:content-none" js-pdp-thumb-prev>{% render 'icon-active-left' %}</div>
          <div class="swiper-button-next right-0 top-1/2 -translate-y-1/2 w-[40px] text-blue after:content-none" js-pdp-thumb-next>{% render 'icon-active-right' %}</div>
          <div class="absolute h-full w-[40px] left-0 top-0 z-[5]" style="background: linear-gradient(to right, rgba(255,255,255), rgba(255,255,255, 0.5));"></div>
          <div class="absolute h-full w-[40px] right-0 top-0 z-[5]" style="background: linear-gradient(to left, rgba(255,255,255), rgba(255,255,255, 0.5));"></div>
        </div>
      </s-carousel>
      {%- capture main_carousel_options -%}
        {
          "slidesPerView": 1,
          "loop": false,
          "autoHeight": false,
          "navigation": {
            "enabled": true,
            "prevEl": "[js-pdp-main-prev]",
            "nextEl": "[js-pdp-main-next]"
          }
        }
      {%- endcapture -%}
      <s-carousel data-options='{{ main_carousel_options }}' data-controller="ProductThumbCarousel-{{ product.id }}" class="product__main-carousel grid">
        <div id="ProductMainCarousel-{{ product.id }}" class="swiper w-full max-w-full" js-carousel js-pdp-carousel>
          <div class="swiper-wrapper">
            {% for media in product.media %}
              {% assign media_swatch = '' %}
              {% assign hide_media = false %}
              {% if current_swatch != blank %}
                {% assign media_swatch = media.alt | strip %}
                {% if media_swatch != current_swatch %}
                  {% assign hide_media = true %}
                {% endif %}
              {% endif %}
              {% case media.media_type %}
                {% when 'image' %}
                  <button class="{% if hide_media %}hidden{% else %}swiper-slide{% endif %}" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-main-carousel-slide>
                    {% render 'lazy-image' image: media %}
                  </button>
                {% when 'video' %}
                  <button class="{% if hide_media %}hidden{% else %}swiper-slide{% endif %}" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-main-carousel-slide>
                    {{ media | video_tag: controls: true, autoplay: false, loop: true, mute: false }}
                  </button>
                {% when 'external_video' %}              
                  <button class="{% if hide_media %}hidden{% else %}swiper-slide{% endif %}" {% if media_swatch != blank %}data-swatch="{{ media_swatch }}"{% endif %} js-carousel-slide js-main-carousel-slide>
                    {{ media | external_video_tag }}
                  </button>
                {% endcase %}
            {% endfor %}
          </div>
          <div class="swiper-button-prev swiper-nav-btn left-sm text-blue w-[40px] h-[40px] bg-white rounded-full after:content-none" js-pdp-main-prev>{% render 'icon-arrow-left' %}</div>
          <div class="swiper-button-next swiper-nav-btn right-sm text-blue w-[40px] h-[40px] bg-white rounded-full after:content-none" js-pdp-main-next>{% render 'icon-arrow-right' %}</div>
        </div>
      </s-carousel>
    </div><!-- .product__images-container -->

    <div class="product__information p-md desktop:px-xl" id="ProductInfo-{{ section.id }}">
      {%- comment -%}
        * Product Form
      {%- endcomment -%}
      {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', js-product-form: true -%}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'room_tag' %}
              {% if product.metafields.seed.recommended_room_size != blank %}
                <div class="product__room-tag tag-small w-fit px-xs py-xxs border border-gray rounded-[60px] mb-xs">{{ product.metafields.seed.recommended_room_size }}</div>
              {% endif %}
            {% when 'title' %}
              <h1 class="product__title h3">{{ product.title }}</h1>
            {% when 'star_rating' %}
              <div class="product__star-rating mt-sm">reviews</div>
            {% when 'option_selector' %}
              {%- comment -%} Product Variant Master Select {%- endcomment -%}
              {% render 'master-variant-select',
              variants: product.variants,
              id: master_select_id,
              current_variant: current_variant
              %}

              {% unless product.has_only_default_variant %}
              <product-options class="no-js-hidden" data-product='ProductJSON' data-master-select-id="{{ master_select_id }}" data-enable-history-state {% if product.options_with_values.size != 2 %}data-disable-option-binding{% endif %}>
                {% for option in product.options_with_values %}
                  {% render 'product-option-selector' 
                    option: option
                    type: 'swatch'
                    section_id: section.id
                    product_id: product.id
                    current_variant: current_variant
                  %}
                {% endfor %}
              </product-options>
              {% endunless %}
            {% when 'subscription' %}

            {% when 'atc' %}
              <button 
                class="product__atc btn btn--blue-rounded relative"
                type="submit" 
                {% unless current_variant.available %} disabled {% endunless %}
                js-add-to-cart>
                <div class="btn__text">
                  <span js-price>{{ current_variant.price | money }}</span><span>&nbsp;-&nbsp;</span>
                  <span js-atc-text>
                    {% if current_variant.available %}
                      Add to Cart
                    {% else %}
                      Out of Stock
                    {% endif %}
                  </span>
                </div>
                <div class="btn__arrow">{% render 'icon-arrow-right' %}</div>
                <loading-spinner style="--color: #F0F3F6; --width: 24px; --height: 24px;"></loading-spinner>
              </button>
              <p class="hidden p2" js-error-message></p>
            {% when 'spacing' %}
              <div class="product__spacing w-full h-[var(--spacing-mobile)] desktop:h-[var(--spacing-desktop)]" style="--spacing-mobile: {{ block.settings.spacing_mobile | default: 0 }}px; --spacing-desktop: {{ block.settings.spacing_desktop | default: 0 }}px;"></div>
          {% endcase %}
        {% endfor %}
      
      
      {% if product.metafields.seed.short_description != blank %}
        <p class="product__short-description p2 desktop:mt-xxs">{{ product.metafields.seed.short_description }}</p>
      {% endif %}
      {%- endform -%}
    </div><!-- .product__images-container -->
  </div><!-- .product__layout -->

  <script type="application/json" id="ProductJSON">{{ product | json }}</script>

</s-product>

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {%- if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "blocks": [
    {
      "name": "Room Size Tag",
      "type": "room_tag"
    },
    {
      "name": "Title",
      "type": "title"
    },
    {
      "name": "Star Rating",
      "type": "star_rating"
    },
    {
      "name": "Option Selector",
      "type": "option_selector"
    },
    {
      "name": "Subscription",
      "type": "subscription"
    },
    {
      "name": "ATC Button",
      "type": "atc"
    },
    {
      "name": "Spacing",
      "type": "spacing",
      "settings": [
        {
          "type": "number",
          "id": "spacing_mobile",
          "label": "Spacing (px) - Mobile"
        },
        {
          "type": "number",
          "id": "spacing_desktop",
          "label": "Spacing (px) - Desktop"
        }
      ]
    }
  ]
}
{% endschema %}