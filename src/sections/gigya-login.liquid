<script type="text/javascript" lang="javascript" src="https://cdns.gigya.com/js/gigya.js?apikey={{ settings.gigya_api_key }}"></script>

<div class="min-h-screen mx-auto text-blue bg-gray-light px-xl {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}">
  <div class="flex flex-col items-center justify-center">
    <div class="flex justify-center">
        <h1 class="flex items-center h3 mb-sm text-blue">
            Account
        </h1>
    </div>
    <div class="flex justify-center gap-lg">
      <button id="toggleLogin" class="mr-8 font-bold border-b-2 border-blue text-18">Login</button>
      <button id="toggleRegister" class="font-bold text-18 text-blue hover:underline">Create an account</button>
    </div>
    <div id="loginForm" class="py-md max-w-[400px] w-full">
      <div id="loginFormErrors" class="mb-4 text-red text-14"></div>
      <form id="customer_login" accept-charset="UTF-8" data-login-with-shop-sign-in="true" novalidate="novalidate" class="space-y-4">
        <input type="hidden" name="form_type" value="customer_login">
        <input type="hidden" name="utf8" value="✓">
        <div class="">
          <label for="CustomerEmail" class="sr-only">
              Email
          </label>
          <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="none" placeholder="Email" class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>
        <div class="">
        <label for="CustomerPassword" class="sr-only">
            Password
        </label>
        <input type="password" value="" name="customer[password]" id="CustomerPassword" autocomplete="current-password" placeholder="Password" class="w-full mb-md border-b px-sm py-xxxs pr-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
        </div>

        <div class="flex pt-4 justify-center">
          <button type="submit" class="btn btn--blue-rounded mb-lg">
            <span class="btn__text">Sign in</span>
            <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
          </button>
        </div>
      </form>
      <div class="flex justify-center mt-4">
        <a href="{{ section.settings.reset_password_link }}" class="text-blue underline hover:text-blue-dark text-16">Forgot Password?</a>
      </div>
    </div>
    <div id="registerForm" class="py-md max-w-[400px] w-full" style="display:none;">
      <div id="formErrors" class="mb-4 text-red text-14"></div>
      <form id="registrationForm" class="mt-8">
        <div>
          <div class="mb-4">
            <label for="reg_email" class="sr-only">Email</label>
            <input type="email" id="reg_email" name="email" required placeholder="Email" 
              class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
          </div>
          <div class="mb-4">
            <label for="firstName" class="sr-only">First Name</label>
            <input type="text" id="firstName" name="firstName" required placeholder="First Name"
              class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
          </div>
          <div class="mb-4">
            <label for="lastName" class="sr-only">Last Name</label>
            <input type="text" id="lastName" name="lastName" required placeholder="Last Name"
              class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
          </div>
           <div class="mb-4">
            <label for="reg_password" class="sr-only">Password</label>
            <input type="password" id="reg_password" name="password" required placeholder="Password" 
              class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
          </div>
          <div class="mb-4">
            <label for="reg_confirm_password" class="sr-only">Confirm Password</label>
            <input type="password" id="reg_confirm_password" name="confirm_password" required placeholder="Confirm Password" 
              class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
          </div>
          <!-- Consent checkboxes start -->
          <div class="mb-4 flex items-center">
            <input type="checkbox" id="over16" name="over16" required class="mr-xs w-6 h-6">
            <label for="over16" class="text-14">I confirm that I am over 16 years old <span class="text-red">*</span></label>
          </div>
          <div class="mb-4 flex items-center">
            <input type="checkbox" id="blueairUpdates" name="blueairUpdates" class="mr-xs w-6 h-6">
            <label for="blueairUpdates" class="text-14 ml-2">Sign up for updates on Blueair's newest products, services & exclusive offers</label>
          </div>
          <div class="mb-4 flex items-center">
            <input type="checkbox" id="unileverConsent" name="unileverConsent" class="mr-xs w-6 h-6">
            <label for="unileverConsent" class="text-14 ml-2">I consent to my data being shared with other Unilever brands to receive the latest news on other Unilever products & services</label>
          </div>
          <div class="my-xs">
            <p class="text-14">Please read our <a href="#" class="underline">notices</a> to understand how we use your personal data. By clicking the button below, you agree to our</p>
          </div>
        </div>
        <div>
          <button type="submit" class="btn btn--blue-rounded mb-lg mx-auto">
            <span class="btn__text">Register</span>
            <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const loginForm = document.getElementById('loginForm');
    const registerForm = document.getElementById('registerForm');
    const toggleLogin = document.getElementById('toggleLogin');
    const toggleRegister = document.getElementById('toggleRegister');

    toggleLogin.onclick = function () {
      loginForm.style.display = 'block';
      registerForm.style.display = 'none';
      toggleLogin.classList.add('border-b-2', 'border-blue', 'font-bold');
      toggleRegister.classList.remove('border-b-2', 'border-blue', 'font-bold');
    };

    toggleRegister.onclick = function () {
      loginForm.style.display = 'none';
      registerForm.style.display = 'block';
      toggleRegister.classList.add('border-b-2', 'border-blue', 'font-bold');
      toggleLogin.classList.remove('border-b-2', 'border-blue', 'font-bold');
    };

    // Login form submission
    document.getElementById('customer_login').addEventListener('submit', function (event) {
      event.preventDefault();
      const email = document.getElementById('CustomerEmail').value;
      const password = document.getElementById('CustomerPassword').value;
      gigya.accounts.login({
        loginID: email,
        password: password,
        callback: function (response) {
          if (response.errorCode === 0) {
            gigya.accounts.getJWT({
              callback: function (response) {
                if (response.errorCode === 0) {
                  const token = response.id_token;
                  const xecurifyId = {{ settings.xecurify_id | json }};
                  window.location.href = `https://store.xecurify.com/moas/broker/login/jwt/callback/${xecurifyId}/jwt_H1X/${token}?relay=https://store.xecurify.com/moas/broker/login/shopify/${window.Shopify.shop}/account`;
                }
              },
              fields: "email,profile",
              expiration: 3600
            });
          } else {
            var loginErrorDiv = document.getElementById('loginFormErrors');
            if (loginErrorDiv) {
              loginErrorDiv.textContent = 'Invalid email or password';
            } else {
              alert('Invalid email or password');
            }
          }
        }
      });
    });

    // Registration form submission
    document.getElementById('registrationForm').addEventListener('submit', function (event) {
      event.preventDefault();
      document.getElementById('formErrors').innerHTML = "";

      const formData = new FormData(event.target);
      const password = formData.get('password');
      const confirmPassword = formData.get('confirm_password');

      if (password !== confirmPassword) {
        document.getElementById('formErrors').textContent = 'Passwords do not match.';
        return;
      }

      if (!document.getElementById('over16').checked) {
        document.getElementById('formErrors').textContent = 'You must confirm that you are over 16 years old.';
        return;
      }

      const data = {
        loginID: formData.get('email'),
        password: password,
        email: formData.get('email'),
        profile: {
          firstName: formData.get('firstName'),
          lastName: formData.get('lastName')
        },
        preferences: {
          ageConsentGranted: { isConsentGranted: true },
          cookies: { isConsentGranted: true }
        }
      };

      gigya.accounts.register(data);
    });
  });
</script>

