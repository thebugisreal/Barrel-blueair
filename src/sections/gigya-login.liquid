<script type="text/javascript" lang="javascript" src="https://cdns.gigya.com/js/gigya.js?apikey=3_ySPsrsHSXFGBAm5bIySMyifZ29wt6LFIsiaU4QLEVlaz5MOEhi5cEJrKaWn_Glcv"></script>

<div class="mx-auto text-blue bg-gray-light px-xl {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}">
  
<div class="flex gap-xl">
    <div class="flex justify-center">
        <h1 class="flex items-center h3 mb-sm text-blue">
            Login With GIGYA Credentials
        </h1>
    </div>

    <div class="py-md max-w-[400px] w-full">
        <form method="post" action="/account/login" id="customer_login" accept-charset="UTF-8" data-login-with-shop-sign-in="true" novalidate="novalidate" class="space-y-4">
            <input type="hidden" name="form_type" value="customer_login">
            <input type="hidden" name="utf8" value="✓">
            <div class="">
            <label for="CustomerEmail" class="sr-only">
                Email
            </label>
            <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="none" placeholder="Email" class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
            </div>
            <div class="">
            <label for="CustomerPassword" class="sr-only">
                Password
            </label>
            <input type="password" value="" name="customer[password]" id="CustomerPassword" autocomplete="current-password" placeholder="Password" class="w-full mb-md border-b px-sm py-xxxs pr-xxxs text-16 text-blue bg-transparent placeholder:text-blue">
            </div>

            <div class="flex pt-4">
            <button class="gap-xs bg-blue rounded-full p-xxs flex items-center text-white text-16">
                Sign in
            <span class="btn__arrow bg-white">
                {% render 'icon-arrow-right' %}
            </span>
            </button>
            </div>
        </form>
    </div>
</div>

<script>
  document.getElementById('customer_login').addEventListener('submit', function (event) {
    event.preventDefault();

    const email = document.getElementById('CustomerEmail').value;
    const password = document.getElementById('CustomerPassword').value;

    gigya.accounts.login({
      loginID: email,
      password: password,
      callback: function (response) {
        if (response.errorCode === 0) {
          console.log('Login successful');
          gigya.accounts.getJWT({
            callback: function (response) {
              if (response.errorCode === 0) {
                const token = response.id_token;
                console.log("JWT Token:", token);
                window.location.href = `https://store.xecurify.com/moas/broker/login/jwt/callback/34273/jwt_H1X/${token}?relay=https://store.xecurify.com/moas/broker/login/shopify/blueair-staging.myshopify.com/account`;
                console.log("Expiration Time:", response.expiration);
              } else {
                console.error("Error:", response.errorMessage);
              }
              console.log("the response is here");
            },
            fields: "email,profile",
            expiration: 3600
          });
        } else {
          console.error('Login failed:', response.errorMessage);
        }
      }
    });
  });
</script>

