{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<div class="section__content-panels {{ margins_paddings }} {{ section.settings.color }}" style="--cols-mobile: {{ section.settings.num_cols_mobile }}; --cols-desktop: {{ section.settings.num_cols_desktop }};">
  <div class="content-panels__title-container flex flex-col items-center gap-md px-md desktop:px-xl {% if section.settings.title != blank and section.settings.cta_url != blank and section.settings.cta_text != blank %}desktop:flex-row desktop:justify-between mb-lg{% endif %}">
    {% if section.settings.title != blank %}
      <h1 class="content-panels__title {{ section.settings.title_style }} text-center {% unless section.settings.cta_url != blank and section.settings.cta_text != blank %}mb-lg desktop:mb-xl{% endunless %}">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.cta_url != blank and section.settings.cta_text != blank %}
      <a href="{{ section.settings.cta_url }}" class="content-panels__cta {{ section.settings.cta_style }} {% if section.settings.title == blank %}mb-lg{% endif %}">
        <span class="btn__text">{{ section.settings.cta_text }}</span>
        <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
      </a>
    {% endif %}
  </div>

  {% if section.settings.carousel_mobile %}
    {%- capture carousel_options -%}
      {
        "cssMode": true,
        "loop": false,
        "autoHeight": false
      }
    {%- endcapture -%}
    <s-carousel data-options='{{ carousel_options }}' data-init="belowDesktop" class="content-panels__carousel grid desktop:px-xl">
      <div id="ContentPanels-{{ section.id }}" class="swiper w-full max-w-full" js-carousel>
        <div class="swiper-wrapper content-panels__blocks desktop:!grid desktop:gap-md">
          {% for block in section.blocks %}
            {% if block.type == 'customization' %}
              <div class="swiper-slide content-panels__block content-panels__block--customization flex flex-col justify-between {% if block.settings.enable_padding %} p-xs pb-0 {% endif %} {{ block.settings.content_position }} w-[80%] tabletp:w-[70%] box-content {{ block.settings.color }} {% if forloop.first %}pl-md pr-xxs{%  elsif forloop.last %}pl-xxs pr-md{% else %}px-xxs{% endif %} desktop:px-0 desktop:w-full desktop:box-border" js-carousel-slide>
                {% if block.settings.image_mobile != blank %}
                  <div class="content-panel__image w-full {{ block.settings.image_position }}">
                    {% render 'lazy-image' breakpoint: 'desktop' image: block.settings.image_mobile image_desktop: block.settings.image_desktop %}
                  </div>
                {% endif %}
                {% if block.settings.title != blank %}
                  <div class="content-panel__title {{ block.settings.title_style }} mt-sm">{{ block.settings.title }}</div>
                {% endif %}
                {% if block.settings.subtext != blank %}
                  <div class="content-panel__subtext {{ block.settings.subtext_style }} mt-sm">{{ block.settings.subtext }}</div>
                {% endif %}
                {% if block.settings.cta_url != blank and block.settings.cta_text != blank %}
                  <a href="{{ block.settings.cta_url }}" class="content-panel__cta pb-sm {{ block.settings.cta_style }} mt-xxs">
                    <span class="btn__text">{{ block.settings.cta_text }}</span>
                    <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                  </a>
                {% endif %}
              </div>
            {% elsif block.type == 'article' %}
              <div class="swiper-slide content-panels__block content-panels__block--article w-[80%] p-xs tabletp:w-[70%] box-content {% if forloop.first %}pl-md pr-xxs{%  elsif forloop.last %}pl-xxs pr-md{% else %}px-xxs{% endif %} desktop:px-0 desktop:w-full desktop:box-border" js-carousel-slide>
                {% render 'article-card' article: block.settings.article %}
              </div>
            {% elsif block.type == 'media-content-overlay' %}
              <div class="swiper-slide content-panels__block content-panels__block--media-overlay w-[80%] tabletp:w-[70%] box-content {{ block.settings.color }} {% if forloop.first %}pl-md pr-xxs{%  elsif forloop.last %}pl-xxs pr-md{% else %}px-xxs{% endif %} desktop:px-0 desktop:w-full desktop:box-border" js-carousel-slide>
                <div class="relative h-full w-full">
                  <div class="content-container-layout flex {{ block.settings.horizontal_position }} {{ block.settings.vertical_position }} p-xs absolute top-xs bottom-xs right-xs left-xs z-[1]">
                    <div class="content-container {{ block.settings.text_alignment }}">
                      {% if block.settings.title != blank %}
                        <div class="content-panel__title {{ block.settings.title_style }} mt-sm">{{ block.settings.title }}</div>
                      {% endif %}
                      {% if block.settings.subtext != blank %}
                        <div class="content-panel__subtext {{ block.settings.subtext_style }} mt-sm">{{ block.settings.subtext }}</div>
                      {% endif %}
                      {% if block.settings.cta_url != blank and block.settings.cta_text != blank %}
                        <a href="{{ block.settings.cta_url }}" class="content-panel__cta {{ block.settings.cta_style }} mt-xxs">
                          <span class="btn__text">{{ block.settings.cta_text }}</span>
                          <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                        </a>
                      {% endif %}
                    </div>
                  </div>
                  {% if block.settings.image_mobile != blank %}
                    <div class="background-image">
                      {% render 'lazy-image' breakpoint: 'desktop' image: block.settings.image_mobile image_desktop: block.settings.image_desktop %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </s-carousel>
  {% else %}
    <div class="content-panels__grid grid gap-x-sm gap-y-md px-md desktop:px-xl desktop:gap-md">
      {% for block in section.blocks %}
        {% if block.type == 'customization' %}
          <div class="content-panels__block content-panels__block--customization flex flex-col justify-between {% if block.settings.enable_padding %} p-xs pb-0 {% endif %} {{ block.settings.content_position }} {{ block.settings.color }}">
            {% if block.settings.image_mobile != blank %}
              <div class="content-panel__image w-full {{ block.settings.image_position }}">
                {% render 'lazy-image' breakpoint: 'desktop' image: block.settings.image_mobile image_desktop: block.settings.image_desktop %}
              </div>
            {% endif %}
            {% if block.settings.title != blank %}
              <div class="content-panel__title {{ block.settings.title_style }} mt-sm">{{ block.settings.title }}</div>
            {% endif %}
            {% if block.settings.subtext != blank %}
              <div class="content-panel__subtext {{ block.settings.subtext_style }} mt-sm">{{ block.settings.subtext }}</div>
            {% endif %}
            {% if block.settings.cta_url != blank and block.settings.cta_text != blank %}
              <a href="{{ block.settings.cta_url }}" class="content-panel__cta pb-sm {{ block.settings.cta_style }} mt-xxs">
                <span class="btn__text">{{ block.settings.cta_text }}</span>
                <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
              </a>
            {% endif %}
          </div>
        {% elsif block.type == 'article' %}
          <div class="content-panels__block content-panels__block--article">
            {% render 'article-card' article: block.settings.article %}
          </div>
        {% elsif block.type == 'media-content-overlay' %}
          <div class="swiper-slide content-panels__block content-panels__block--media-overlay box-content {{ block.settings.color }} desktop:px-0 desktop:w-full desktop:box-border">
            <div class="relative h-full w-full">
              <div class="content-container-layout flex {{ block.settings.horizontal_position }} {{ block.settings.vertical_position }} p-xs absolute top-xs bottom-xs right-xs left-xs z-[1]">
                <div class="content-container {{ block.settings.text_alignment }}">
                  {% if block.settings.title != blank %}
                    <div class="content-panel__title {{ block.settings.title_style }} mt-sm">{{ block.settings.title }}</div>
                  {% endif %}
                  {% if block.settings.subtext != blank %}
                    <div class="content-panel__subtext {{ block.settings.subtext_style }} mt-sm">{{ block.settings.subtext }}</div>
                  {% endif %}
                  {% if block.settings.cta_url != blank and block.settings.cta_text != blank %}
                    <a href="{{ block.settings.cta_url }}" class="content-panel__cta {{ block.settings.cta_style }} mt-xxs">
                      <span class="btn__text">{{ block.settings.cta_text }}</span>
                      <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
                    </a>
                  {% endif %}
                </div>
              </div>
              {% if block.settings.image_mobile != blank %}
                <div class="background-image h-full">
                  {% render 'lazy-image' breakpoint: 'desktop' image: block.settings.image_mobile image_desktop: block.settings.image_desktop, picture_classes: 'h-full', img_classes:"h-full object-cover"%}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>

