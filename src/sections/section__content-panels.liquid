{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<div class="section__content-panels {{ margins_paddings }} {{ section.settings.color }} px-md desktop:px-xl">
  <div class="content-panels__title-container flex flex-col items-center gap-md {% if section.settings.title != blank and section.settings.cta_url != blank and section.settings.cta_text != blank %}desktop:flex-row desktop:justify-between mb-lg{% endif %}">
    {% if section.settings.title != blank %}
      <h1 class="content-panels__title {{ section.settings.title_style }} text-center {% unless section.settings.cta_url != blank and section.settings.cta_text != blank %}mb-lg desktop:mb-xl{% endunless %}">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.cta_url != blank and section.settings.cta_text != blank %}
      <a href="{{ section.settings.cta_url }}" class="content-panels__cta {{ section.settings.cta_style }} {% if section.settings.title == blank %}mb-lg{% endif %}">
        <span class="btn__text">{{ section.settings.cta_text }}</span>
        <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
      </a>
    {% endif %}
  </div>
  <div class="content-panels__grid grid gap-md" style="--cols-mobile: {{ section.settings.num_cols_mobile }}; --cols-desktop: {{ section.settings.num_cols_desktop }};">
    {% for block in section.blocks %}
      <div class="content-panels__block">
        {% if block.settings.image_mobile != blank %}
          <div class="content-panel__image">
            {% render 'lazy-image' image: block.settings.image_mobile image_desktop: block.settings.image_desktop %}
          </div>
        {% endif %}
        {% if block.settings.title != blank %}
          <div class="content-panel__title {{ block.settings.title_style }} mt-sm">{{ block.settings.title }}</div>
        {% endif %}
        {% if block.settings.cta_url != blank and block.settings.cta_text != blank %}
          <a href="{{ block.settings.cta_url }}" class="content-panel__cta {{ block.settings.cta_style }} mt-xxs">
            <span class="btn__text">{{ block.settings.cta_text }}</span>
            <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

