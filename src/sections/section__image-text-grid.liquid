{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<div class="section__image-text-grid {{ margins_paddings }} {{ section.settings.color }} desktop:px-xl">
  <div class="flex flex-col gap-lg desktop:flex-row desktop:items-center desktop:gap-[136px] desktop:mx-auto desktop:max-w-[var(--section-max-width-desktop)]"  style="--section-max-width-desktop: {{ section.settings.section_max_width_desktop}}">
    <div class="image-text-grid__grid-container px-md desktop:px-0 desktop:flex-1">
      <div class="image-text-grid__grid-wrapper {% if section.settings.image_position_desktop == 'left' %}desktop:mr-auto{% else %}desktop:ml-auto{% endif %} desktop:max-w-[var(--desktop-text-max-width)]" style="--desktop-text-max-width: {% if section.settings.text_max_width != blank  %}{{ section.settings.text_max_width }}{% else %}unset{% endif %};">
        {% if section.settings.title != blank %}
          <h2 class="image-text-grid__title {{ section.settings.title_style }} mb-lg desktop:pb-xs">{{ section.settings.title }}</h2>
        {% endif %}
        <div class="image-text-grid__grid grid grid-cols-2 gap-x-md gap-y-lg">
          {% for block in section.blocks %}
            <div class="image-text-grid__block">
              {% if block.settings.title != blank %}
                <h3 class="image-text-grid-block__title {{ block.settings.title_style }} mb-xxs">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.subtext != blank %}
                <p class="image-text-grid-block__subtext {{ block.settings.subtext_style }}">{{ block.settings.subtext }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
    <div class="image-text-grid__image {% unless section.settings.image_inset_mobile %}px-md desktop:px-0{% endunless %} {{ section.settings.image_position_mobile }} {% if section.settings.image_position_desktop == 'left' %}desktop:order-first{% else %}desktop:order-last{% endif %} desktop:w-[var(--desktop-image-width)]" style="--desktop-image-width: {{ section.settings.image_width }}%;" >
      {% render 'lazy-image' image: section.settings.image_mobile image_desktop: section.settings.image_desktop %}
    </div>
  </div>
</div>

