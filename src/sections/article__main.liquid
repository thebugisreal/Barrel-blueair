<article class="article" itemscope itemtype="http://schema.org/BlogPosting">
  <div class="spacing-divider h-[48px] tabletl:hidden"></div>

  <div class="article__header-container bg-gray-athans tabletl:flex tabletl:items-center">
    <header class="article__header mx-[30px] tabletl:mx-[40px] tabletl:w-1/2">
      <a href="{{ blog.url }}" class="flex gap-12 items-center py-[10px]"> 
        <div class="h-[34px] w-[34px] p-4 rounded-full border border-blue">{%  render 'icon-arrow-left' %}</div>
        <p>Back to {{ blog.title }}</p>
      </a>
      <div class="spacing-divider h-[24px] tabletl:h-[48px]"></div>
      <h1 class="article__title font-900">{{ article.title }}</h1>
      <div class="spacing-divider h-[24px] tabletl:h-[48px]"></div>
      <div class="article__author tabletl:flex tabletl:gap-16">
        <p class="text-p4">Reviewed by <span class="text-p3 underline">{{ article.author }}</span></p>
        <div class="spacing-divider h-[16px] tabletl:hidden"></div>
        <p class="hidden text-[#121A224D] tabletl:block">&bull;</p>
        <p class="text-p4">Updated {{ article.created_at | date: "%b %d, %Y"}}</p>
      </div>
      <div class="spacing-divider hidden tabletl:h-[24px] tabletl:block"></div>
    </header>
    <div class="spacing-divider h-[48px] tabletl:hidden"></div>
  
    {% if article.image != blank %}
      <div class="article__image tabletl:w-1/2">{% render 'lazy-image' image: article.image %}</div>
      <div class="spacing-divider h-[48px] tabletl:hidden"></div>
    {% endif %}
  </div>


  <div class="article__content bg-gray-athans px-[30px] tabletl:px-0 tabletl:mx-auto tabletl:max-w-[109ch]">
    <div class="spacing-divider h-[48px] tabletl:h-[96px]"></div>
    {{ article.content }}
    <div class="spacing-divider h-[48px] tabletl:h-[96px]"></div>
  </div>


  {% comment %} Blog Comments {% endcomment %}
  {%- if blog.comments_enabled? and article.comments.size > 0-%}
    {%- assign anchorId = '#Comments-' | append: article.id -%}
    {% paginate article.comments by 5 %} 
      <div class="article__comments"> 
        <h2 class="article__comments-title">{{ article.comments_count }} Comments</h2>
        {% for comment in article.comments %}
          {% render 'article-comment' comment: comment %}
        {% endfor %}
        {% render 'pagination', paginate: paginate, anchor: anchorId %}
      </div>
    {% endpaginate %}

    <div class="article__new-comment-form">
      {% render 'new-comment-form', blog: blog %}
    </div>
  {%- endif -%}
  {% comment %} END Blog Comments {% endcomment %}

</article>


{% schema %}
{
  "name": "Blog Post",
  "tag": "section"
}
{% endschema %}
