<article class="article" itemscope itemtype="http://schema.org/BlogPosting" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">

  <div class="article__header-container pt-48 bg-gray-athans tabletl:pt-0 tabletl:flex">
    <header class="article__header mx-[30px] flex items-center tabletl:mx-[40px] tabletl:w-1/2">
      <div class="article__header-content mx-auto">
        <a href="{{ blog.url }}" class="btn pt-[10px]">
          <span class="btn__arrow">{% render 'icon-arrow-left' %}</span>
          <span class="btn__text">Back to {{ blog.title }}</span>
        </a>
        
        <h1 class="article__title font-900 my-24 tabletl:my-48">{{ article.title }}</h1>
        <div class="article__author tabletl:flex tabletl:mb-24 tabletl:gap-16">
          <p class="p4 mb-16 tabletl:mb-0">Reviewed by <span class="p3 underline">{{ article.author }}</span></p>
          <p class="hidden text-[#121A224D] tabletl:block">&bull;</p>
          <p class="p4">Updated {{ article.created_at | date: "%b %d, %Y"}}</p>
        </div>
      </div>

    </header>
  
    {% if article.image != blank %}
      <div class="article__image mt-48 tabletl:mt-0 tabletl:w-1/2">{% render 'lazy-image' image: article.image img_classes:'h-full', picture_classes:' h-full object-cover' %}</div>
    {% endif %}
  </div>

  {% if article.content != blank %}
    <div class="article__content rte px-[30px] py-48 tabletl:py-[96px] tabletl:px-0 tabletl:mx-auto tabletl:max-w-[109ch]">
      {{ article.content }}
    </div>
  {% endif %}


  {% comment %} Blog Comments {% endcomment %}
  {%- if blog.comments_enabled? and article.comments.size > 0-%}
    {%- assign anchorId = '#Comments-' | append: article.id -%}
    {% paginate article.comments by 5 %} 
      <div class="article__comments"> 
        <h2 class="article__comments-title">{{ article.comments_count }} Comments</h2>
        {% for comment in article.comments %}
          {% render 'article-comment' comment: comment %}
        {% endfor %}
        {% render 'pagination', paginate: paginate, anchor: anchorId %}
      </div>
    {% endpaginate %}

    <div class="article__new-comment-form">
      {% render 'new-comment-form', blog: blog %}
    </div>
  {%- endif -%}
  {% comment %} END Blog Comments {% endcomment %}

</article>


{% schema %}
{
  "name": "Article Header",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "max_width_desktop",
      "label": "Max Width of Text Content - Desktop",
      "info": "Make sure to include units",
      "default": "109ch"
    }
  ]
}
{% endschema %}
