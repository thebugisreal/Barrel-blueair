{% assign footer_linklist = linklists[settings.footer_nav] %}
{% assign subfooter_linklist = linklists[settings.subfooter_nav] %}

<footer class="site-footer bg-blue text-white px-md pt-xl pb-lg desktop:px-xl desktop:pt-xxl">
  <div class="site-footer__main desktop:flex desktop:justify-between desktop:gap-lg">
    <div class="site-footer__nav-conatiner desktop:flex-1">
      {% if section.settings.footer_heading_text != blank %}
        <h1 class="site-footer__heading {{ section.settings.footer_heading_style }} leading-[1.3]">
          {{ section.settings.footer_heading_text }}
        </h1>
      {% endif %}
    
      <div class="site-footer__social-media-links flex gap-md pt-lg mt-xs">
        {% if settings.social_instagram != blank %}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{% render 'icon-social-ig' %}</a>
        {% endif %}
        {% if settings.social_facebook != blank %}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{% render 'icon-social-fb' %}</a>
        {% endif %}
        {% if settings.social_tiktok != blank %}
          <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{% render 'icon-social-tt' %}</a>
        {% endif %}
        {% if settings.social_linkedin != blank %}
          <a href="{{ settings.social_linkedin }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{% render 'icon-social-in' %}</a>
        {% endif %}
      </div>

      {% if settings.app_store_url_mobile != blank or settings.google_play_url_mobile != blank %}
        <div class="site-footer__divider py-lg">
          <hr class="block my-xs text-blue-medium">
        </div>

        <div class="site-footer__app site-footer__app--mobile">
          <h2 class="text-18">Get the Blueair app</h2>
          <div class="site-footer__app-links flex flex-col gap-sm mt-sm">
            {% if settings.app_store_url_mobile != blank %}
              <a href="{{ settings.app_store_url_mobile }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--mobile">
                <img src="{{ 'app-store--white.png' | asset_url }}" class="block w-auto h-[67px]" />
              </a>
            {% endif %}
            {% if settings.google_play_url_mobile != blank %}
              <a href="{{ settings.google_play_url_mobile }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--mobile">
                <img src="{{ 'google-play--white.png' | asset_url }}" class="block w-auto h-[67px]" />
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if settings.bcorp_link_url != blank %}
        <div class="site-footer__divider py-lg">
          <hr class="block my-xs text-blue-medium">
        </div>

        <div class="site-footer__bcorp">
          <a href="{{ settings.bcorp_link_url }}" target="_blank" rel="noopener noreferrer" class="site-footer__bcorp-link block w-[270px]">
            {% render 'icon-b-default' %}
          </a>
        </div>
      {% endif %}

      <div class="site-footer__divider py-lg">
        <hr class="block my-xs text-blue-medium">
      </div>

      <div class="site-footer__nav site-footer__nav--mobile desktop:hidden">

      </div>
    </div>
    
    <div class="site-footer__nav-conatiner hidden desktop:block desktop:w-1/2">
      <div class="site-footer__nav site-footer__nav--desktop">

      </div>

      {% if settings.app_store_url_desktop != blank or settings.google_play_url_desktop != blank %}
        <div class="site-footer__app site-footer__app--desktop">
          <h2 class="text-18">Get the Blueair app</h2>
          <div class="site-footer__app-links flex gap-md mt-sm">
            {% if settings.app_store_url_desktop != blank %}
              <a href="{{ settings.app_store_url_desktop }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--desktop">
                <img src="{{ 'app-store--white.png' | asset_url }}" class="block w-auto h-[57px]" />
              </a>
            {% endif %}
            {% if settings.google_play_url_desktop != blank %}
              <a href="{{ settings.google_play_url_desktop }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--desktop">
                <img src="{{ 'google-play--white.png' | asset_url }}" class="block w-auto h-[57px]" />
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
  
  <div class="site-footer__subfooter pt-lg border-t border-blue-medium flex flex-col gap-lg desktop:flex-row-reverse desktop:justify-between desktop:items-center">
    <div class="w-36">
      {% render 'icon-globe' %}
    </div>
    <ul class="site-footer__subfooter-nav flex flex-wrap gap-x-md gap-y-xs font-300">
      {% for link in subfooter_linklist.links %}
        <li class="site-footer__item">
          <a href="{{ link.url }}" class="site-footer__link !no-underline">{{ link.title }}</a>
        </li>
      {% endfor %}
      <li class="site-footer__item w-full mt-sm desktop:w-auto desktop:mt-0 desktop:order-first">&copy; Blueair 2023-2024</li>
    </ul>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "footer_heading_text",
      "label": "Heading Text"
    },
    {
      "type": "select",
      "id": "footer_heading_style",
      "label": "Heading Style",
      "options": [
        {
          "value": "h1",
          "label": "h1"
        },
        {
          "value": "h2",
          "label": "h2"
        },
        {
          "value": "h3",
          "label": "h3"
        },
        {
          "value": "h4",
          "label": "h4"
        },
        {
          "value": "h5",
          "label": "h5"
        },
        {
          "value": "h6",
          "label": "h6"
        }
      ],
      "default": "h3"
    }
  ]
}
{% endschema %}
