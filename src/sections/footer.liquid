{% assign footer_linklist = linklists[section.settings.footer_nav] %}
{% assign subfooter_linklist = linklists[section.settings.subfooter_nav] %}

<footer class="site-footer bg-blue text-white px-md pt-xl pb-lg desktop:px-xl desktop:pt-xxl">
  <div class="site-footer__main desktop:flex desktop:justify-between desktop:gap-lg">
    <div class="site-footer__nav-conatiner desktop:flex-1 desktop:max-w-[420px]">
      {% if section.settings.footer_heading_text != blank %}
        <h1 class="site-footer__heading {{ section.settings.footer_heading_style }} leading-[1.3]">
          {{ section.settings.footer_heading_text }}
        </h1>
      {% endif %}
    
      <div class="site-footer__social-media-links flex gap-md pt-lg mt-xs desktop:mt-0">
        {% if settings.social_instagram != blank %}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{% render 'icon-social-ig' %}</a>
        {% endif %}
        {% if settings.social_facebook != blank %}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{% render 'icon-social-fb' %}</a>
        {% endif %}
        {% if settings.social_tiktok != blank %}
          <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{% render 'icon-social-tt' %}</a>
        {% endif %}
        {% if settings.social_linkedin != blank %}
          <a href="{{ settings.social_linkedin }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{% render 'icon-social-in' %}</a>
        {% endif %}
      </div>

      {% if settings.app_store_url_mobile != blank or settings.google_play_url_mobile != blank %}
        <div class="site-footer__divider py-lg desktop:hidden">
          <hr class="block my-xs text-blue-medium">
        </div>

        <div class="site-footer__app site-footer__app--mobile desktop:hidden">
          <h2 class="text-18">Get the Blueair app</h2>
          <div class="site-footer__app-links flex flex-col gap-sm mt-sm">
            {% if settings.app_store_url_mobile != blank %}
              <a href="{{ settings.app_store_url_mobile }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--mobile">
                <img src="{{ 'app-store--white.png' | asset_url }}" class="block w-auto h-[67px]" />
              </a>
            {% endif %}
            {% if settings.google_play_url_mobile != blank %}
              <a href="{{ settings.google_play_url_mobile }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--mobile">
                <img src="{{ 'google-play--white.png' | asset_url }}" class="block w-auto h-[67px]" />
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if settings.bcorp_link_url != blank %}
        <div class="site-footer__divider py-lg">
          <hr class="block my-xs text-blue-medium desktop:my-sm">
        </div>

        <div class="site-footer__bcorp">
          <a href="{{ settings.bcorp_link_url }}" target="_blank" rel="noopener noreferrer" class="site-footer__bcorp-link block w-[270px] desktop:w-[200px]">
            {% render 'icon-b-footer' %}
          </a>
        </div>
      {% endif %}

      <div class="site-footer__divider py-lg desktop:hidden">
        <hr class="block my-xs text-blue-medium">
      </div>

      <div class="site-footer__nav site-footer__nav--mobile desktop:hidden">
        <s-accordion data-manual-collapse="false" js-accordion>
          {% for link in footer_linklist.links %}
            <div class="accordion-item {% unless forloop.last %}mb-md{% endunless %}" js-accordion-item>
              <button class="accordion-header w-full flex justify-between items-center" aria-expanded="false" aria-controls="FooterNavLink{{ forloop.index }}" js-accordion-header>
                <span class="h4 text-20">{{ link.title }}</span>
                <span class="accordion-icon accordion-icon--caret-down w-24">{% render 'icon-active-down' %}</span>
              </button>
              <div id="FooterNavLink{{ forloop.index }}" class="accordion-content" aria-hidden="true" js-accordion-content>
                <ul class="site-footer__links mt-md">
                  {% for child_link in link.links %}
                    <li class="site-footer__item {% unless forloop.last %}mb-xs{% endunless %}">
                      <a href="{{ child_link.url }}" class="site-footer__link text-18 font-300">{{ child_link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endfor %}
        </s-accordion>
      </div>
    </div>
    
    <div class="site-footer__nav-conatiner hidden desktop:block desktop:w-1/2">
      <div class="site-footer__nav site-footer__nav--desktop flex gap-md">
        {% for link in footer_linklist.links %}
          <div class="site-footer__links-wrapper flex-1">
            <div class="h4 text-20 mb-md">{{ link.title }}</div>
            <ul class="site-footer__links">
              {% for child_link in link.links %}
                <li class="site-footer__item mt-sm">
                  <a href="{{ child_link.url }}" class="site-footer__link text-18 font-300">{{ child_link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>

      {% if settings.app_store_url_desktop != blank or settings.google_play_url_desktop != blank %}
        <div class="site-footer__app site-footer__app--desktop pt-xs mt-lg">
          <h2 class="text-18">Get the Blueair app</h2>
          <div class="site-footer__app-links flex gap-md mt-sm">
            {% if settings.app_store_url_desktop != blank %}
              <a href="{{ settings.app_store_url_desktop }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--desktop">
                <img src="{{ 'app-store--white.png' | asset_url }}" class="block w-auto h-[57px]" />
              </a>
            {% endif %}
            {% if settings.google_play_url_desktop != blank %}
              <a href="{{ settings.google_play_url_desktop }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--desktop">
                <img src="{{ 'google-play--white.png' | asset_url }}" class="block w-auto h-[57px]" />
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="site-footer__divider pt-lg pb-sm desktop:pb-lg desktop:pt-xxl">
    <hr class="block mt-xs mb-sm text-blue-medium desktop:my-0">
  </div>
  
  <div class="site-footer__subfooter flex flex-col gap-lg desktop:flex-row-reverse desktop:justify-between desktop:items-center">
    {% if settings.enable_modal_popup %}
      <div class="site-footer__county-select border border-white rounded-[24px] overflow-hidden text-white max-w-max cursor-pointer" js-open-country-market-selector-modal>
        <div class="country-select__label flex gap-xxxs justify-start items-center py-xxs px-xs pr-md">
          <div class="icon-globe w-32">{% render 'icon-globe' %}</div>
          <div class="country-name text-12 flex-1">{{ localization.country.name }}</div>
        </div>  
      </div>
    {% else %}
      <div class="site-footer__county-select border border-white rounded-[24px] overflow-hidden text-white max-w-max">
        {% render 'country-select' scope: 'Footer' %}
      </div>
    {% endif %}
    <ul class="site-footer__links flex flex-wrap gap-x-md gap-y-xs font-300">
      {% for link in subfooter_linklist.links %}
        <li class="site-footer__item">
          <a href="{{ link.url }}" class="site-footer__link !no-underline">{{ link.title }}</a>
        </li>
      {% endfor %}
      {% if localization.country.iso_code == 'US' %}
        <li class="site-footer__item">
          <span class=evidon-notice-link></span>
        </li>
      {% endif %}
      {% if localization.country.iso_code == 'CA' or localization.country.iso_code == 'GB' %}
        <li class="site-footer__item">
          <button id="ot-sdk-btn" class="ot-sdk-show-settings site-footer__link !no-underline">Cookie Settings</button>
        </li>
      {% endif %}
      <li class="site-footer__item w-full mt-sm desktop:w-auto desktop:mt-0 desktop:order-first">&copy; Blueair {{  "now" | date: '%Y' }} </li>
    </ul>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "footer_nav",
      "label": "Footer Navigation"
    },
    {
      "type": "link_list",
      "id": "subfooter_nav",
      "label": "Subfooter Navigation"
    },
    {
      "type": "text",
      "id": "footer_heading_text",
      "label": "Heading Text"
    },
    {
      "type": "select",
      "id": "footer_heading_style",
      "label": "Heading Style",
      "options": [
        {
          "value": "h1",
          "label": "h1"
        },
        {
          "value": "h2",
          "label": "h2"
        },
        {
          "value": "h3",
          "label": "h3"
        },
        {
          "value": "h4",
          "label": "h4"
        },
        {
          "value": "h5",
          "label": "h5"
        },
        {
          "value": "h6",
          "label": "h6"
        }
      ],
      "default": "h3"
    }
  ]
}
{% endschema %}
