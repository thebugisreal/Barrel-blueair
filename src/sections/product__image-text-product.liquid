{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

{% if product.metafields.seed.pdp_image_text_prod != blank %}
    {% comment %} Mobile {% endcomment %}
    <div class="product__image-text-product relative tabletl:hidden {{ margins_paddings }} {{ section.settings.color }}">
        <div class="mx-auto h-full">
            <div class="text-content px-lg tabletl:px-0 tabletl:max-w-[30%] tabletl:mr-auto tabletl:flex tabletl:flex-col tabletl:justify-center">
                {% if product.metafields.seed.pdp_image_text_prod.value.display_name != blank %}
                    <h3 class="mb-md tabletl:mb-lg">{{ product.metafields.seed.pdp_image_text_prod.value.display_name }}</h3>
                {% endif %}
                {% if product.metafields.seed.pdp_image_text_prod.value.text != blank %}
                    <div class="rte h5">
                        {{ product.metafields.seed.pdp_image_text_prod.value.text | metafield_tag}}
                    </div>
                {% endif %}
                {% if product.metafields.seed.pdp_image_text_prod.value.logo != blank %}
                    <div class="logo-container max-w-[60%]">
                        {%  render 'lazy-image' image: product.metafields.seed.pdp_image_text_prod.value.logo%}
                    </div>
                {% endif %}
            </div>
            <div class="image-container relative">
                <div class="flex h-full flex-col gap-xl mt-[30vh]">
                    {% if product.metafields.seed.pdp_image_text_prod.value.video != blank %}
                      <div class="video-container h-[70vh]">
                        {{ product.metafields.seed.pdp_image_text_prod.value.video.value | video_tag: class: 'block w-full h-full object-cover object-center desktop:pointer-events-none h-full object-cover', image_size: '1280x', autoplay: true, loop: true, muted: true, controls: false }}
                      </div>
                    {% elsif product.metafields.seed.pdp_image_text_prod.value.image != blank%}
                      <div class="image-container h-[70vh]">
                          {% render 'lazy-image' image: product.metafields.seed.pdp_image_text_prod.value.image, image_desktop: product.metafields.seed.pdp_image_text_prod.value.image_desktop, picture_classes: 'h-full', img_classes: 'h-full object-cover', breakpoint:'tabletl' %}
                      </div>
                    {% endif %}
                </div>
                {% comment %} Assoicated Product {% endcomment %}
                {% if product.metafields.seed.pdp_image_text_prod.value.product != blank %}
                    {% assign associated_prod = all_products[product.metafields.seed.pdp_image_text_prod.value.product] %}
                    <div class="absolute top-[-20vh] right-lg left-lg flex justify-center">
                        <div class="product__image-text-associated_prod-container bg-blue-light max-h-[512px] max-w-[312px]">
                            {% if associated_prod.featured_image != blank %}
                               {%  render 'lazy-image' image:associated_prod.featured_image, picture_classes: 'h-fit', img_classes: 'h-full'%}
                            {% endif %}
                            <div class="text-container px-sm pt-sm pb-lg bg-blue-light">
                               <div class="product-card__tags min-h-[28px] mb-md flex justify-start gap-x-xs gap-y-xxs flex-wrap">
                                   <span class="product-card__tag product-card__tag--gray bg-gray {% if associated_prod.selected_or_first_available_variant.available %}hidden{% endif %} text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]">Out of Stock</span>
                                   {% for tag in associated_prod.metafields.seed.product_tags.value %}
                                   <span class="product-card__tag {% if associated_prod.metafields.seed.product_card_tag_style == 'White fill' %}product-card__tag--white{% else %}product-card__tag--blue{% endif %} text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]">{{ tag }}</span>
                                   {% endfor %}
                               </div>
                               <p class="s1 font-900"> {{ associated_prod.title }}</p>
                               <p class="p2 mt-md">{{ associated_prod.price | money }}</p>
                            </div>
                       </div>
                    </div>
                {% endif %}
            </div>
        </div>

    </div>

    {% comment %} Desktop {% endcomment %}
    <div class="product__image-text-product relative hidden tabletl:h-[100vh] tabletl:block {{ margins_paddings }} {{ section.settings.color }}">
        <div class="mx-auto h-full tabletl:max-w-[var(--max-width-desktop)]"  style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
            <div class="flex h-full flex-col gap-xl tabletl:gap-[136px] tabletl:flex-row tabletl:pl-xl">
                <div class="text-content px-lg tabletl:px-0 tabletl:max-w-[30%] tabletl:mr-auto tabletl:flex tabletl:flex-col tabletl:justify-center">
                    {% if product.metafields.seed.pdp_image_text_prod.value.display_name != blank %}
                        <h3 class="mb-md tabletl:mb-lg">{{ product.metafields.seed.pdp_image_text_prod.value.display_name }}</h3>
                    {% endif %}
                    {% if product.metafields.seed.pdp_image_text_prod.value.text != blank %}
                        <div class="rte h5">
                            {{ product.metafields.seed.pdp_image_text_prod.value.text | metafield_tag}}
                        </div>
                    {% endif %}
                    {% if product.metafields.seed.pdp_image_text_prod.value.logo != blank %}
                        <div class="logo-container max-w-[60%]">
                            {%  render 'lazy-image' image: product.metafields.seed.pdp_image_text_prod.value.logo%}
                        </div>
                    {% endif %}
                </div>
                {% if product.metafields.seed.pdp_image_text_prod.value.video != blank %}
                  <div class="video-container tabletl:w-1/2">
                    {{ product.metafields.seed.pdp_image_text_prod.value.video.value | video_tag: class: 'block w-full h-full object-cover object-center desktop:pointer-events-none object-cover', image_size: '1280x', autoplay: true, loop: true, muted: true, controls: false }}
                  </div>
                {% elsif product.metafields.seed.pdp_image_text_prod.value.image != blank%}
                  <div class="image-container tabletl:w-1/2">
                      {%  render 'lazy-image' image: product.metafields.seed.pdp_image_text_prod.value.image, image_desktop: product.metafields.seed.pdp_image_text_prod.value.image_desktop, picture_classes: 'h-full', img_classes: 'h-full object-cover', breakpoint:'tabletl'%}
                  </div>
                {% endif %}
            </div>
        </div>
        {% comment %} Assoicated Product {% endcomment %}
        {% if product.metafields.seed.pdp_image_text_prod.value.product != blank %}
            {% assign associated_prod = all_products[product.metafields.seed.pdp_image_text_prod.value.product] %}
            <div class="absolute top-0 bottom-0 right-0 left-0 flex justify-center items-center">
                <div class="product__image-text-associated_prod-container bg-blue-light max-h-[512px] max-w-[312px]">
                    {% if associated_prod.featured_image != blank %}
                       {%  render 'lazy-image' image:associated_prod.featured_image, picture_classes: 'h-full', img_classes: 'h-full'%}
                    {% endif %}
                    <div class="text-container px-sm pt-sm pb-lg bg-blue-light">
                       <div class="product-card__tags min-h-[28px] mb-md flex justify-start gap-x-xs gap-y-xxs flex-wrap">
                           <span class="product-card__tag product-card__tag--gray bg-gray {% if associated_prod.selected_or_first_available_variant.available %}hidden{% endif %} text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]">Out of Stock</span>
                           {% for tag in associated_prod.metafields.seed.product_tags.value %}
                           <span class="product-card__tag {% if associated_prod.metafields.seed.product_card_tag_style == 'White fill' %}product-card__tag--white{% else %}product-card__tag--blue{% endif %} text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]">{{ tag }}</span>
                           {% endfor %}
                       </div>
                       <p class="s1 font-900"> {{ associated_prod.title }}</p>
                       <p class="p2 mt-md">{{ associated_prod.price | money }}</p>
                    </div>
               </div>
            </div>
        {% endif %}
    </div>
{% endif %}

