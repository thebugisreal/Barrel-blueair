{%- paginate blog.articles by 9 -%}
  {% assign first_article = articles[blog.metafields.seed.featured_article] %}

  <div class="blog tabletl:px-[60px]">
    <h1 class="blog__title text-center mt-xl tabletl:mt-xxl">{{ blog.title | escape }}</h1>
    {% if first_article != blank %}
      <div class="blog__first-article my-[48px] tabletl:my-[80px]">
        <p class="text-sub1 hidden tabletl:block tabletl:mb-16">Featured</p>
        <div class="tabletl:flex tabletl:gap-64 tabletl:items-center">
          {% if first_article.image != blank %}
            <div class="blog__first-article-image tabletl:w-1/2">{% render 'lazy-image' image: first_article.image %}</div>
          {% endif %}
          <div class="blog__first-article-text-container px-[30px] tabletl:pl-0 tabletl:pr-[40px] tabletl:w-1/2 tabletl:mx-auto tabletl:max-w-[var(--max-width-desktop)]" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
            <header class="blog__first-article-header py-16 tabletl:pt-0 tabletl:pb-24">
              <div class="blog__first-article-tag-container flex items-center gap-12 tabletl:gap-16">
                <ul class="blog__first-article-tags flex">
                  {% for tag in first_article.tags %}
                    <li class="blog__first-article-tag tag-small py-[6px] px-[10px] border border-gray rounded-[60px]"> {{ tag }} </li>
                  {% endfor %}
                </ul>
                <p class="blog__first-article-date text-p4">Updated {{ first_article.created_at | date: "%b %d, %Y"}}</p>
              </div>
              <h3 class="blog__first-article-title mt-16 tabletl:mt-24">{{ first_article.title }}</h3>
            </header>
            {%- if first_article.excerpt.size > 0 or first_article.content.size > 0 -%}
              <p class="blog__first-article-excerpt text-p2 mb-16 tabletl:mb-24">
                {%- if first_article.excerpt.size > 0 -%}
                  {{ first_article.excerpt | strip_html | truncatewords: 50 }}
                {%- else -%}
                  {{ first_article.content | strip_html | truncatewords: 50 }}
                {%- endif -%}
              </p>
            {%- endif -%}
            <a href="{{ first_article.url }}" class="btn py-[10px]"> 
              <p class="btn__text">Read More</p>
              <div class="btn__arrow">{%  render 'icon-arrow-right' %}</div>
            </a>
           
          </div>
        </div>
      </div>
    {% endif %}

    <h3 class="px-30 font-900 mt-40 mb-16 tabletl:mt-64 tabletl:mb-24 tabletl:px-0">Latest Entries</h3>

    <ul class="blog-tags flex flex-wrap gap-8 mx-30 tabletl:mx-0 tabletl:gap-16">
      <li class="blog__article-tag text-sub3 border border-gray rounded-[60px] {% if current_tags == blank %} active {% endif %} tabletl:py-[8px]">
        <a href="{{ blog.url }}" class="py-[10px] px-[20px]">All</a>
      </li>
      {% for tag in blog.all_tags %}
        {% unless first_article.tags contains tag %}
        <li class="blog__article-tag text-sub3 border border-gray rounded-[60px] {% if current_tags contains tag %} active {% endif %} tabletl:py-[8px]">
          <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="py-[10px] px-[20px]">{{ tag }}</a>
        </li>
        {% endunless %}
      {% endfor %}
    </ul>

    <ul class="blog-articles mt-24 grid grid-cols-1 gap-x-48 mx-30 gap-y-64 tabletl:mt-40 tabletl:mx-0 tabletl:grid-cols-3" role="list">
      {%- for article in blog.articles -%}
        {% unless first_article == article  %}
        <li class="blog-articles__article h-auto">
          {%- render 'article-card', article: article -%}
        </li>
        {% endunless %}
      {%- endfor -%}
      </ul>

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog Posts",
  "settings": [
    {
      "type": "text",
      "id": "max_width_desktop",
      "label": "Max Width - Desktop",
      "info": "Make sure to include units",
      "default": "109ch"
    }
  ]
}
{% endschema %}
