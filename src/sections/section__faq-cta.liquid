{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<div class="section__faq-cta mx-md desktop:mx-xl">
  <div class="faq-cta__wrapper {{ margins_paddings }} {{ section.settings.color }} px-md desktop:px-xl mx-auto max-w-[var(--max-width)]" style="--max-width: {% if section.settings.max_width != blank %}{{ section.settings.max_width }}{% else %}unset{% endif %};">
    {% if section.settings.title != blank %}
      <h2 class="faq-cta__title {{ section.settings.title_style }} mb-32 text-center">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.cta_url != blank and section.settings.cta_text != blank%}
      <a href="{{ section.settings.cta_url }}" class="faq-cta__cta-button mx-auto {{ section.settings.cta_style }}">
        <span class="btn__text">{{ section.settings.cta_text }}</span>
        <span class="btn__arrow">{% render 'icon-arrow-right' %}</span>
      </a>
    {% endif %}
  </div>  
</div>

