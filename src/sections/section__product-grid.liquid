{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<div class="section__product-grid {{ margins_paddings }} {{ section.settings.color }}" style="--cols-mobile: {{ section.settings.num_cols_mobile }}; --cols-desktop: {{ section.settings.num_cols_desktop }};">
  {% if section.settings.title != blank %}
    <h1 class="product-grid__title {{ section.settings.title_style }} text-center mb-md desktop:mb-xl px-md desktop:px-xl">{{ section.settings.title }}</h1>
  {% endif %}
  
  {% if section.settings.carousel_mobile %}
    {%- capture carousel_options -%}
      {
        "cssMode": true,
        "loop": false,
        "autoHeight": false
      }
    {%- endcapture -%}
    <s-carousel data-options='{{ carousel_options }}' data-init="belowDesktop" class="product-grid__carousel grid desktop:px-xl">
      <div id="ProductGrid-{{ section.id }}" class="swiper w-full max-w-full" js-carousel>
        <div class="swiper-wrapper product-grid__products desktop:!grid desktop:gap-md">
          {% if section.settings.collection != blank %}
            {% for product in section.settings.collection.products limit: section.settings.num_products %}
              <div class="swiper-slide product-grid__product w-[80%] tabletp:w-[70%] box-content {% if forloop.first %}pl-md pr-xs{%  elsif forloop.last %}pl-xs pr-md{% else %}px-xs{% endif %} desktop:px-0 desktop:w-full desktop:box-border" js-carousel-slide>
                {% render 'product-card' product: product %}
              </div>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              <div class="swiper-slide product-grid__product w-[80%] tabletp:w-[70%] box-content {% if forloop.first %}pl-md pr-xs{%  elsif forloop.last %}pl-xs pr-md{% else %}px-xs{% endif %} desktop:px-0 desktop:w-full desktop:box-border" js-carousel-slide>
                {% render 'product-card' product: block.settings.product %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </s-carousel>
  {% else %}
    <div class="product-grid__grid grid gap-sm desktop:gap-md px-md desktop:px-xl">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.num_products %}
          <div class="product-grid__product">
            {% render 'product-card' product: product %}
          </div>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          <div class="product-grid__product">
            {% render 'product-card' product: block.settings.product %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  {% endif %}
</div>

