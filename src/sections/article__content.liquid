<div class="article__content tabletl:px-xl">
    {% for block in section.blocks %}
        {% case block.type %}
          {% when 'divider_line' %}
            {%  render 'divider-line' 
                margin_top_mobile: block.settings.margin_top_mobile,
                margin_bottom_mobile: block.settings.margin_bottom_mobile,
                padding_top_mobile: block.settings.padding_top_mobile,
                padding_bottom_mobile: block.settings.padding_bottom_mobile,
                margin_top_desktop: block.settings.margin_top_desktop,
                margin_bottom_desktop: block.settings.margin_bottom_desktop,
                padding_top_desktop: block.settings.padding_top_desktop,
                padding_bottom_desktop: block.settings.padding_bottom_desktop,
                max_width_desktop: block.settings.max_width_desktop
            %}
          {% when 'image_caption' %}
            {%  render 'image-caption' 
                margin_top_mobile: block.settings.margin_top_mobile,
                margin_bottom_mobile: block.settings.margin_bottom_mobile,
                padding_top_mobile: block.settings.padding_top_mobile,
                padding_bottom_mobile: block.settings.padding_bottom_mobile,
                margin_top_desktop: block.settings.margin_top_desktop,
                margin_bottom_desktop: block.settings.margin_bottom_desktop,
                padding_top_desktop: block.settings.padding_top_desktop,
                padding_bottom_desktop: block.settings.padding_bottom_desktop,
                max_width_desktop: block.settings.max_width_desktop,
                image: block.settings.image,
                image_desktop: block.settings.image_desktop,
                product: block.settings.product,
                product_image_override: block.settings.product_image_override,
                caption: block.settings.caption,
                caption_style: block.settings.caption_style
            %}
          {% when 'text' %}
            {% render 'text'
                margin_top_mobile: block.settings.margin_top_mobile,
                margin_bottom_mobile: block.settings.margin_bottom_mobile,
                padding_top_mobile: block.settings.padding_top_mobile,
                padding_bottom_mobile: block.settings.padding_bottom_mobile,
                margin_top_desktop: block.settings.margin_top_desktop,
                margin_bottom_desktop: block.settings.margin_bottom_desktop,
                padding_top_desktop: block.settings.padding_top_desktop,
                padding_bottom_desktop: block.settings.padding_bottom_desktop,
                max_width_desktop: block.settings.max_width_desktop,
                richtext: block.settings.richtext,
                richtext_style: block.settings.richtext_style,
                richtext_alignment: block.settings.richtext_alignment
            %}
          {% when 'quote' %}
            {% render 'quote'
                margin_top_mobile: block.settings.margin_top_mobile,
                margin_bottom_mobile: block.settings.margin_bottom_mobile,
                padding_top_mobile: block.settings.padding_top_mobile,
                padding_bottom_mobile: block.settings.padding_bottom_mobile,
                margin_top_desktop: block.settings.margin_top_desktop,
                margin_bottom_desktop: block.settings.margin_bottom_desktop,
                padding_top_desktop: block.settings.padding_top_desktop,
                padding_bottom_desktop: block.settings.padding_bottom_desktop,
                max_width_desktop: block.settings.max_width_desktop,
                title: block.settings.title,
                title_style: block.settings.title_style,
                author: block.settings.author
            %}
          {% when 'image_text' %}
            {% render 'image-text' 
                margin_top_mobile: block.settings.margin_top_mobile,
                margin_bottom_mobile: block.settings.margin_bottom_mobile,
                padding_top_mobile: block.settings.padding_top_mobile,
                padding_bottom_mobile: block.settings.padding_bottom_mobile,
                margin_top_desktop: block.settings.margin_top_desktop,
                margin_bottom_desktop: block.settings.margin_bottom_desktop,
                padding_top_desktop: block.settings.padding_top_desktop,
                padding_bottom_desktop: block.settings.padding_bottom_desktop,
                max_width_desktop: block.settings.max_width_desktop,
                title: block.settings.title,
                title_style: block.settings.title_style,
                richtext: block.settings.richtext,
                image_mobile: block.settings.image_mobile,
                image_desktop: block.settings.image_desktop,
                image_placement_desktop: block.settings.image_placement_desktop,
                image_placement_mobile: block.settings.image_placement_mobile,
                color: block.settings.color,
                text_padding_right_desktop: block.settings.text_padding_right_desktop,
                text_padding_left_desktop: block.settings.text_padding_left_desktop
                cta_url: block.settings.cta_url,
                cta_text: block.settings.cta_text,
                cta_style: block.settings.cta_style
            %}
          {% when 'image_text_review' %}
            {%  render 'image-text-review' 
                margin_top_mobile: block.settings.margin_top_mobile,
                margin_bottom_mobile: block.settings.margin_bottom_mobile,
                padding_top_mobile: block.settings.padding_top_mobile,
                padding_bottom_mobile: block.settings.padding_bottom_mobile,
                margin_top_desktop: block.settings.margin_top_desktop,
                margin_bottom_desktop: block.settings.margin_bottom_desktop,
                padding_top_desktop: block.settings.padding_top_desktop,
                padding_bottom_desktop: block.settings.padding_bottom_desktop,
                max_width_desktop: block.settings.max_width_desktop,
                section_title: block.settings.section_title,
                section_title_style: block.settings.section_title_style,
                color: block.settings.color,
                image_mobile: block.settings.image_mobile,
                image_desktop: block.settings.image_desktop,
                title: block.settings.title,
                title_style: block.settings.title_style,
                richtext: block.settings.richtext,
                richtext_style: block.settings.richtext_style
            %}
          {% when 'product_desc_image' %}
            {% render 'product-desc-image'
                margin_top_mobile: block.settings.margin_top_mobile,
                margin_bottom_mobile: block.settings.margin_bottom_mobile,
                padding_top_mobile: block.settings.padding_top_mobile,
                padding_bottom_mobile: block.settings.padding_bottom_mobile,
                margin_top_desktop: block.settings.margin_top_desktop,
                margin_bottom_desktop: block.settings.margin_bottom_desktop,
                padding_top_desktop: block.settings.padding_top_desktop,
                padding_bottom_desktop: block.settings.padding_bottom_desktop,
                max_width_desktop: block.settings.max_width_desktop,
                title: block.settings.title,
                title_style: block.settings.title_style,
                product: block.settings.product,
                color: block.settings.color,
                btn_text: block.settings.btn_text,
                btn_style: block.settings.btn_style,
                image: block.settings.image,
                image_desktop: block.settings.image_desktop
            %}
        {% endcase %}
    {% endfor %}
</div>


