{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<div class="section__faq-videos {{ margins_paddings }} {{ section.settings.color }}">
  {% if section.settings.title != blank %}
    <h2 class="faq-videos__title {{ section.settings.title_style }} mb-md text-center px-md desktop:px-xl">{{ section.settings.title }}</h2>
  {% endif %}
  
  {%- capture carousel_options -%}
    {
      "loop": false,
      "autoHeight": false
    }
  {%- endcapture -%}
  <s-carousel data-options='{{ carousel_options }}' class="faq-videos__carousel grid">
    <div id="FaqVideos-{{ section.id }}" class="swiper w-full max-w-full" js-carousel>
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide faq-videos__slide w-[83%] desktop:w-[20%] box-content {% if forloop.first %}pl-md pr-xxs desktop:pl-xl desktop:pr-xs{%  elsif forloop.last %}pl-xxs pr-md desktop:pl-xs desktop:pr-xl{% else %}px-xxs desktop:px-xs{% endif %}" js-carousel-slide>
            {% if block.settings.youtube_id != blank %}
              <style>.embed-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; } .embed-container iframe, .embed-container object, .embed-container embed { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }</style>
              <div class='embed-container'><iframe src='https://www.youtube.com/embed/{{ block.settings.youtube_id }}' frameborder='0' allowfullscreen></iframe></div>
            {% elsif block.settings.video != blank %}
              <s-video data-playing="false" data-controls="true" class="faq-videos__video block relative">
                {{ block.settings.video | video_tag: class: 'block w-full', image_size: '1280x', autoplay: false, loop: true, muted: true, controls: false }}
                <button class="video__trigger video__trigger--white absolute bottom-xxs left-xxs w-[24px] h-[24px] pl-[2px] desktop:bottom-sm desktop:left-sm desktop:w-[40px] desktop:h-[40px] desktop:pl-xxxs flex justify-center items-center rounded-full bg-white" js-video-trigger>
                  <span class="video-trigger__play w-[10px] desktop:w-16 leading-[0px]">{% render 'icon-play' %}</span>
                </button>
              </s-video>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </s-carousel>
</div>

