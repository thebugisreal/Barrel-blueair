{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

{% if product.metafields.seed.pdp_tabs != blank %}
    <div class="product__app-tabs product__tabs {{ margins_paddings }} text-left px-lg {{ section.settings.color }} tabletl:px-xl">
        <s-tabs class="flex {{ section.settings.image_position_mobile }} gap-lg tabletl:gap-xxxl {{ section.settings.image_position_desktop }}">
            <div class="tab__triggers flex flex-col justify-center tabletl:flex-1 tabletl:max-w-[var(--max-w-desktop)] tabletl:mx-auto" role="tablist" aria-orientation="horizontal" js-tablist style="--max-w-desktop: {% if section.settings.max_width_desktop != blank %}{{ section.settings.max_width_desktop }}{% else %}unset{% endif %};">
              {% if product.metafields.seed.pdp_tabs_title != blank %}
                <h4 class="font-900 mb-md ">
                  {{ product.metafields.seed.pdp_tabs_title }}
                </h4>
              {% endif %}
              <ul class="flex flex-col gap-sm">
                {% for tab in product.metafields.seed.pdp_tabs.value %}
                    <li id="tab-{{ forloop.index }}" class="tab__trigger py-xxxs px-md border-l border-gray" aria-controls="product__tab-content-{{ forloop.index }}" role="tab" {% if forloop.first %} aria-selected="true" {% else %} aria-selected="false" {% endif %} js-tab>
                        <h3 class="s2 font-900 text-left">{{ tab.title }}</h3>
                        <div class="tab__text-content rte text-left">
                            {{ tab.richtext |  metafield_tag }}
                        </div>
                    </li>
                {% endfor %}
              </ul>
            </div>
            <div class="image-container relative tabletl:mt-0 tabletl:w-1/2">
                {% for tab in product.metafields.seed.pdp_tabs.value %}
                    <div id="product__tab-content-{{ forloop.index }}" class="product-tab__panel absolute top-0 bottom-0 right-0 left-0" role="tabpanel" aria-labelledby="tab-{{ forloop.index }}" {% if forloop.first %} aria-hidden="false" {% else %} aria-hidden="true" {% endif %}>
                        <div>
                            {% render 'lazy-image' image:tab.image %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </s-tabs>
    </div>
{% endif %}

