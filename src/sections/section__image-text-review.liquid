<section class="section__image-text-review mx-auto" style="--max-width-desktop: {{ section.settings.max_width_desktop }}; background-color: {{ section.settings.bg_color }}">
    {% render 'spacing-divider' mobile_height:section.settings.spacing_top_mobile, desktop_height:section.settings.spacing_top_desktop %}
    
    <div class="section__image-text-review-content px-30 flex flex-col tabletl:flex-row tabletl:px-0 tabletl:items-center tabletl:gap-48">
        {% if section.settings.image_mobile != blank %}
            <div class="spacing-divider h-[16px] tabletl:hidden"></div>
            <div class="section__image-content w-full tabletl:w-1/3">
                {%  render 'lazy-image' image:section.settings.image_mobile, image_desktop:section.settings.image_desktop %}
            </div>
        {% endif %}
        <div class="section__text-content tabletl:w-2/3">
            {% if section.settings.title != blank %}
                <h1 class="{{ section.settings.title_style }} font-900">{{ section.settings.title }}</h1>
                <div class="spacing-divider h-[16px] tabletl:h-[24px]"></div>
            {% endif %}
            {% if section.settings.richtext != blank %}
                <div class="rte"> {{ section.settings.richtext }} </div>
            {% endif %}
        </div>
    </div>

    {% render 'spacing-divider' mobile_height:section.settings.spacing_bottom_mobile, desktop_height:section.settings.spacing_bottom_desktop %}
</section>

{% schema %}
    {
      "name": "Image + Text - Review",
      "tag": "section",
      "settings": [
        {
            "type": "number",
            "id": "spacing_top_mobile",
            "label": "Spacing Top - Mobile",
            "default": 24
        },
        {
            "type": "number",
            "id": "spacing_bottom_mobile",
            "label": "Spacing Bottom - Mobile",
            "default": 24
        },
        {
            "type": "number",
            "id": "spacing_top_desktop",
            "label": "Spacing Top - Desktop",
            "default": 48
        },
        {
            "type": "number",
            "id": "spacing_bottom_desktop",
            "label": "Spacing Bottom - Desktop",
            "default": 48
        },
        {
            "type": "text",
            "id": "max_width_desktop",
            "label": "Max Width - Desktop",
            "info": "Make sure to include units",
            "default": "109ch"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "select",
          "id": "title_style",
          "label": "Title Style",
          "options": [
            { "value": "h1", "label": "h1" },
            { "value": "h2", "label": "h2" },
            { "value": "h3", "label": "h3" },
            { "value": "h4", "label": "h4" },
            { "value": "text-p1", "label": "text-p1" },
            { "value": "text-p2", "label": "text-p2" },
            { "value": "text-p3", "label": "text-p3" },
            { "value": "text-p4", "label": "text-p4" }
          ],
          "default": "h4"
        },
        {
            "type": "richtext",
            "id": "richtext",
            "label": "Richtext"
        },
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Image - Mobile" 
        },
        {
            "type": "image_picker",
            "id": "image_desktop",
            "label": "Image - Desktop" 
        }
      ],
      "presets": [
        {
          "name": "Image + Text - Review"
        }
      ]
    }
{% endschema %}