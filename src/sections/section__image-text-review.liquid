{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

<div class="section__image-text-review mx-auto p-24 {{ margins_paddings }} {{ section.settings.color }}" style="--max-width-desktop: {{ section.settings.max_width_desktop }}; ">
    {% if section.settings.section_title != blank %}
        <h1 class="{{ section.settings.section_title_style }} mb-12">{{ section.settings.section_title }}</h1>
    {% endif %}
    <div class="section__image-text-review-content px-30 flex flex-col tabletl:flex-row tabletl:px-0 tabletl:items-center tabletl:gap-48">
        {% if section.settings.image_mobile != blank %}
            <div class="section__image-content w-full mt-16 tabletl:mt-0 tabletl:w-1/3">
                {%  render 'lazy-image' image:section.settings.image_mobile, image_desktop:section.settings.image_desktop %}
            </div>
        {% endif %}
        <div class="section__text-content tabletl:w-2/3">
            {% if section.settings.title != blank %}
                <h1 class="{{ section.settings.title_style }} mb-16 font-900 tabletl:mb-24">{{ section.settings.title }}</h1>
            {% endif %}
            {% if section.settings.richtext != blank %}
                <div class="rte {{ section.settings.richtext_style }}"> {{ section.settings.richtext }} </div>
            {% endif %}
        </div>
    </div>
</div>

