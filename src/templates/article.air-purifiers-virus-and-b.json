            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "95ch",
            "richtext": "<h4><strong>Improved ventilation and clean air circulation can dilute airborne contaminants to make a meaningful impact on the indoor spread of airborne viruses and bacteria.⁵<\/strong><\/h4>",
            "richtext_style": "h4"
          }
        },
        "image_caption_DKAU6m": {
          "type": "image_caption",
          "settings": {
