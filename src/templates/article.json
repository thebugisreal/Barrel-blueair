            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/Blog_Image_8aa31d2b-248d-4b74-b4db-953ed0f4796b.png",
            "image_desktop": "shopify://shop_images/Blog_Image_8aa31d2b-248d-4b74-b4db-953ed0f4796b.png",
            "caption": "",
            "caption_style": "p6",
