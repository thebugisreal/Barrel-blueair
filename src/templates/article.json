            "padding_top_desktop": "desktop:pt-xxxl",
            "padding_bottom_desktop": "desktop:pb-xxl",
            "max_width_desktop": "95ch",
            "richtext": "<p>At Blueair, we’re proud to announce that our Classic Pro Air Purifier now holds the Asthma and Allergy Friendly™ Certification. This certification is a stamp of approval that proves our air purifier is scientifically tested to reduce airborne allergens and improve air quality in your home. It’s not just another claim—it’s a trusted standard.</p>",
            "richtext_alignment": "text-left",
            "richtext_style": "s3"
          }
        },
        "image_caption_QBGK76": {
          "type": "image_caption",
          "settings": {
            "margin_top_mobile": "mt-0",
            "margin_bottom_mobile": "mb-0",
