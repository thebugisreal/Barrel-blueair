            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image2_748041c2-194a-4161-8bbd-bdcb213388a7.jpg",
            "image_desktop": "shopify://shop_images/image2_748041c2-194a-4161-8bbd-bdcb213388a7.jpg",
            "caption": "",
            "caption_style": "p6",
