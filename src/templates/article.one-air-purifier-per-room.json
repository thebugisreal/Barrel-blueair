            "image": "shopify://shop_images/image2_3594f58c-fb8a-4bcb-96e7-237ea878ad60.jpg",
            "image_desktop": "shopify://shop_images/image2_3594f58c-fb8a-4bcb-96e7-237ea878ad60.jpg",
            "caption": "",
            "caption_style": "p6",
