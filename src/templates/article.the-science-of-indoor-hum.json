            "padding_bottom_desktop": "desktop:pb-xxl",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/Blog_Image_2_5c4eae1d-7454-40eb-96c2-fbf4148c2b08.png",
            "image_desktop": "shopify://shop_images/Blog_Image_2_5c4eae1d-7454-40eb-96c2-fbf4148c2b08.png",
            "caption": "",
            "caption_style": "p6",
            "product": "dreamwell-humidifier-1-gallon-coastal-beige",
            "product_image_override": "shopify://shop_images/dreamwell.jpg"
