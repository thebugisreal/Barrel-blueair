    "article_content_zMAJck": {
      "type": "article__content",
      "blocks": {
        "text_QNqwkC": {
          "type": "text",
          "settings": {
            "margin_top_mobile": "mt-xl",
            "margin_bottom_mobile": "mb-xl",
            "padding_top_mobile": "pt-0",
