            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image3_04602b57-fe88-4ac3-96c9-81fa087136de.jpg",
            "image_desktop": "shopify://shop_images/image3_04602b57-fe88-4ac3-96c9-81fa087136de.jpg",
