            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "80ch",
            "image": "shopify://shop_images/Blueair_-_Pre-Filter_Ionization_-_030122_-web_mob.webp",
            "image_desktop": "shopify://shop_images/Blueair_-_Pre-Filter_Ionization_-_030122_-web.webp",
            "caption": "",
            "caption_style": "s4",
