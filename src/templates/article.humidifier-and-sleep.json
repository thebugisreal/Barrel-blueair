            "product": ""
          }
        },
        "text_KgNxW6": {
          "type": "text",
          "settings": {
            "margin_top_mobile": "mt-md",
            "margin_bottom_mobile": "mb-md",
            "padding_top_mobile": "pt-0",
            "padding_bottom_mobile": "pb-0",
            "margin_top_desktop": "desktop:mt-lg",
            "margin_bottom_desktop": "desktop:mb-lg",
            "padding_top_desktop": "desktop:pt-0",
            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "95ch",
            "richtext": "<h4><strong>Winter<\/strong><\/h4><p>In winter, people typically stay indoors more, and heated homes often lead to drier indoor air. This dry air can contribute to the survival and spread of cold and influenza viruses. To combat this, increasing indoor humidity while the heating is on can help reduce the airborne transmission of these seasonal viruses. <\/p><p>Additionally, a humidifier can add moisture to the nasal and upper respiratory passages, making it easier to breathe if you’re dealing with a runny nose, chest congestion, cough, or sore throat.<\/p>",
            "richtext_style": "p2"
          }
        },
        "image_caption_cAUwpE": {
          "type": "image_caption",
          "settings": {
