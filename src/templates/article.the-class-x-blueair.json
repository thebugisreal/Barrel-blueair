            "margin_bottom_desktop": "desktop:mb-0",
            "padding_top_desktop": "desktop:pt-0",
            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify:\/\/shop_images\/BlueSig_9efa4c6e-15ae-4484-98f3-36e598758b51.png",
            "image_desktop": "shopify:\/\/shop_images\/BlueSig_9efa4c6e-15ae-4484-98f3-36e598758b51.png",
            "caption": "",
            "caption_style": "p6",
