            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image4_3d1820a0-eb7f-45c2-bc40-8235a80000d7.jpg",
            "image_desktop": "shopify://shop_images/image4_3d1820a0-eb7f-45c2-bc40-8235a80000d7.jpg",
            "caption": "",
            "caption_style": "p6",
