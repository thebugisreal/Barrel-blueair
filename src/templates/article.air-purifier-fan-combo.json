            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image3_4e3713b0-5073-432a-8e3d-ff7a992634e4.jpg",
            "image_desktop": "shopify://shop_images/image3_4e3713b0-5073-432a-8e3d-ff7a992634e4.jpg",
            "caption": "",
            "caption_style": "p6",
