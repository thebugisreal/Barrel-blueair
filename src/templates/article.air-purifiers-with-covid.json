            "padding_bottom_mobile": "pb-0",
            "margin_top_desktop": "desktop:mt-0",
            "margin_bottom_desktop": "desktop:mb-0",
            "padding_top_desktop": "desktop:pt-0",
            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image2_c5e69ee7-ecf9-423c-b853-ebf18fa59d3e.jpg",
            "image_desktop": "shopify://shop_images/image2_c5e69ee7-ecf9-423c-b853-ebf18fa59d3e.jpg",
            "caption": "",
            "caption_style": "p6",
