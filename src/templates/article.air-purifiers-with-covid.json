            "margin_top_desktop": "desktop:mt-0",
            "margin_bottom_desktop": "desktop:mb-0",
            "padding_top_desktop": "desktop:pt-0",
            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image4_d8a5d5a3-0ed7-40c1-b1c4-85a97a5d30be.jpg",
            "image_desktop": "shopify://shop_images/image4_d8a5d5a3-0ed7-40c1-b1c4-85a97a5d30be.jpg",
            "caption": "",
            "caption_style": "p6",
