            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify:\/\/shop_images\/Wildfire2023-HeaderM.png",
            "image_desktop": "shopify:\/\/shop_images\/Wildfire2023-HeaderD_1_cfce584f-7507-4bb8-92fe-ca081671ede5.png",
            "caption": "",
            "caption_style": "p6",
