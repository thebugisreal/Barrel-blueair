<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {% if settings.favicon != blank %}
      <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
    {% endif %}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {%- comment -%} Redirect Cart Page {%- endcomment -%}
    {% if template.name == 'cart' %}
      <script> location.href = '{{ routes.root_url }}?viewcart=true' </script>
    {% endif %}

    {%- comment -%} Redirect Account Addresses Page {%- endcomment -%}
    {% if template.name == 'addresses' %}
      <script> location.href = '{{ routes.account_url }}' </script>
    {% endif %}
  

    {{ content_for_header }}
  
    {{ 'vendor.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      window.currency = {
        symbol: "{{ cart.currency.symbol }}",
        name: "{{ cart.currency.name }}",
        code: "{{ cart.currency.iso_code }}"
      };
    </script>

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>
  
  {%- capture body_classes -%}
    template-{{template.name}} {% if template.suffix %}template--{{template.suffix}}{% endif %}
  {%- endcapture -%}
  <body {% if template.name == 'login' %}id="recover"{% endif %} class="{{body_classes | strip}}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ "accessibility.skip_to_text" | t }}
    </a>

    {% section 'header' %}

    {% render 'drawer--cart' %}

    <main id="MainContent" class="main drawer-background modal-background grid {% if template.name == 'index' %}min-h-screen{% else %}min-h-header mt-[var(--header-height)]{% endif %}" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>

    <script>
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };
      window.PUB_SUB_EVENTS = {
        cartUpdate: 'cart-update',
        quantityUpdate: 'quantity-update',
        variantChange: 'variant-change',
        cartError: 'cart-error',
      };
    </script>

    <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
