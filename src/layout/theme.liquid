<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {% if shop.permanent_domain == 'uk-blueair.myshopify.com' %}
      <!-- Google Tag Manager -->
      <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-58FXRQCH');</script>
      <!-- End Google Tag Manager -->
    {% endif %}
    {% if settings.favicon != blank %}
      <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
    {% endif %}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {%- comment -%} Redirect Account Addresses Page {%- endcomment -%}
    {% if template.name == 'addresses' %}
      <script> location.href = '{{ routes.account_url }}' </script>
    {% endif %}
    {% render 'onetrust' %}
    {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' %}
      <script type="text/javascript" lang="javascript" src="https://cdns.gigya.com/js/gigya.js?apikey=3_ySPsrsHSXFGBAm5bIySMyifZ29wt6LFIsiaU4QLEVlaz5MOEhi5cEJrKaWn_Glcv"></script>
      <!-- Affirm -->
      <script>
        _affirm_config = {
          public_api_key:  "0JDSO1NZ3ZHRQF0R",
          script:          "https://cdn1.affirm.com/js/v2/affirm.js"
        };
        (function(l,g,m,e,a,f,b){var d,c=l[m]||{},h=document.createElement(f),n=document.getElementsByTagName(f)[0],k=function(a,b,c){return function(){a[b]._.push([c,arguments])}};c[e]=k(c,e,"set");d=c[e];c[a]={};c[a]._=[];d._=[];c[a][b]=k(c,a,b);a=0;for(b="set add save post open empty reset on off trigger ready setProduct".split(" ");a<b.length;a++)d[b[a]]=k(c,e,b[a]);a=0;for(b=["get","token","url","items"];a<b.length;a++)d[b[a]]=function(){};h.async=!0;h.src=g[f];n.parentNode.insertBefore(h,n);delete g[f];d(g);l[m]=c})(window,_affirm_config,"affirm","checkout","ui","script","ready");
        // Use your live public API Key and https://cdn1.affirm.com/js/v2/affirm.js script to point to Affirm production environment.
      </script>
      <!-- End Affirm -->
      <!-- Amazon Adversting Script -->
      <script>
        !function(w,d,s,t,a){if(w.amzn)return;w.amzn=a=function(){w.amzn.q.push([arguments,(new Date).getTime()])};a.q=[];a.version="0.0";s=d.createElement("script");s.src="https://c.amazon-adsystem.com/aat/amzn.js";s.id="amzn-pixel";s.async=true;t=d.getElementsByTagName("script")[0];t.parentNode.insertBefore(s,t)}(window,document);
        amzn("setRegion", "NA");
        amzn("addTag", "7bfb4402-e53c-4bc2-9fe6-97c3c32b6a93");

        {% if template.name == 'index' %}
          amzn("trackEvent", "Homepage");
        {% endif %}
      </script>
       <!-- End Amazon Adversting Script -->
    {% endif %}
    {{ content_for_header }}
  
    {{ 'vendor.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      window.currency = {
        symbol: "{{ cart.currency.symbol }}",
        name: "{{ cart.currency.name }}",
        code: "{{ cart.currency.iso_code }}"
      };
    </script>

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {% if settings.use_purpledot and shop.permanent_domain == '5ef43d-4a.myshopify.com' %} 
      {% render 'purple-dot' %}
    {% endif %}
  </head>
  
  {%- capture body_classes -%}
    template-{{template.name}} {% if template.suffix %}template--{{template.suffix}}{% endif %}
  {%- endcapture -%}
  <body {% if template.name == 'login' %}id="recover"{% endif %} class="{{body_classes | strip}}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ "accessibility.skip_to_text" | t }}
    </a>
    {% if shop.permanent_domain == 'uk-blueair.myshopify.com' %}
      <!-- Google Tag Manager (noscript) -->
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-58FXRQCH"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
      <!-- End Google Tag Manager (noscript) -->
    {% endif %}

    {% sections 'header-group' %}
  
    {% render 'drawer--cart' %}
    {% render 'drawer--mobile-filter' %}
    {% render 'drawer--desktop-search' %}
    {% render 'modal--country-selector' %}

    {% include 'region-check' %}
    {% if template.name == 'product' %}
      {% render 'modal--klaviyo-bis' %}
      {% if is_transactional %}
        {% render 'product-sticky-bar' %}
      {% endif %}
    {% endif %}

    <main id="MainContent" class="main drawer-background modal-background grid {% if template.name == 'index' %}min-h-screen mt-[var(--header-height)]{% elsif template.name == 'login' %}min-h-auto{% else %}min-h-header mt-[var(--header-height)]{% endif %}">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>

    <script>
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };
      window.PUB_SUB_EVENTS = {
        cartUpdate: 'cart-update',
        quantityUpdate: 'quantity-update',
        variantChange: 'variant-change',
        cartError: 'cart-error',
      };
      window.klaviyo = {
        apiKeyUS: '{{ settings.klaviyo_api_key_us }}',
        apiKeyUK: '{{ settings.klaviyo_api_key_uk }}',
        apiKeyEU: '{{ settings.klaviyo_api_key_eu }}'
      };
      window.pathURL = `{{ canonical_url | replace: 'https://', '' | replace: shop.domain, '' }}`
      window.domain = `https://{{shop.domain}}`
    </script>

    <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {% if request.design_mode == false %}
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const country = Shopify.country;
          const currentUrl = window.location.hostname.replace('www.', '');

          let showModal = false;

          if ((country === 'US' || country === 'CA') && currentUrl !== 'blueair.com') {
            if (sessionStorage.getItem('isInitialVisit')) {
              return; // Don't show modal for returning visitors
            }
            showModal = true;
            sessionStorage.setItem('isInitialVisit', 'true');
          } else if (country === 'GB' && currentUrl !== 'blueair.co.uk') {
            showModal = true;
          } else if (!['US', 'CA', 'GB'].includes(country) && currentUrl !== 'blueair.co') {
            if (sessionStorage.getItem('isInitialVisit')) {
              return; // Don't show modal for returning visitors
            }
            showModal = true;
            sessionStorage.setItem('isInitialVisit', 'true');
          } else if (currentUrl === 'blueair.co') {
            if (sessionStorage.getItem('isInitialVisit')) {
              return;
            }

            sessionStorage.setItem('isInitialVisit', 'true');

            if (country !== 'DE') {
              showModal = true;
            }
          }

          if (showModal) {
            const welcomeModal = document.querySelector('#CountryMarketSelectModal');
            const countrySelector = welcomeModal?.querySelector('country-select-modal [js-country-select]');

            if (welcomeModal && countrySelector) {
              countrySelector.value = country;
              countrySelector.dispatchEvent(new Event('change'));
              welcomeModal.open();
            }
          }
        });
      </script>
    {% endif %}

    {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' or shop.permanent_domain == 'blueeudev.myshopify.com' %}
      {% if is_transactional %}
        {% render 'sprinklr-chat' %}
      {% endif %}
    {% endif %}
    {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' %}
      <script type="text/javascript">
        setTimeout(function() {
          var script = document.createElement('script');
          script.src = 'https://static.ordergroove.com/3488d6a745bd4989b67ebc6b0ad38ad6/msi.js';
          document.head.appendChild(script);
        }, 1000);
      </script>
    {% endif %}
    {% if shop.permanent_domain == 'blueeudev.myshopify.com' %}
      <script type="text/javascript">
        function OptanonWrapper() {
          // Check consent state from OneTrust
          var analyticsConsent = OnetrustActiveGroups.indexOf('C0002') > -1; // Example: Analytics category
          var marketingConsent = OnetrustActiveGroups.indexOf('C0003') > -1; // Example: Marketing category
          // Sync with Shopify customerPrivacy API
          if (window.Shopify && window.Shopify.customerPrivacy) {
             window.Shopify.customerPrivacy.setTrackingConsent({
              analytics: analyticsConsent,
              marketing: marketingConsent,
            });
          }
        }

        // Wait for OnetrustActiveGroups to be available before calling OptanonWrapper
        function waitForOneTrust() {
          if (typeof OnetrustActiveGroups !== 'undefined' && OnetrustActiveGroups) {
            OptanonWrapper();
          } else {
            setTimeout(waitForOneTrust, 100);
          }
        }

        waitForOneTrust();
      </script>
    {% endif %}
  </body>
</html>
