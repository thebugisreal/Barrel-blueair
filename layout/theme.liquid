    {% endif %}
    {% if settings.favicon != blank %}
      <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
    {% endif %}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {% render 'hreflang' %}

    {%- comment -%} Redirect Account Addresses Page {%- endcomment -%}
    {% if template.name == 'addresses' %}
      <script>
        location.href = '{{ routes.account_url }}';
      </script>
    {% endif %}
    {% render 'onetrust' %}
    {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' %}
      <script
        type="text/javascript"
        lang="javascript"
        src="https://cdns.gigya.com/js/gigya.js?apikey=3_ySPsrsHSXFGBAm5bIySMyifZ29wt6LFIsiaU4QLEVlaz5MOEhi5cEJrKaWn_Glcv"
      ></script>
      <!-- Affirm -->
      <script>
