    {{ content_for_header }}

    {%- render 'web-fonts' -%}
    {%- render 'asset' with 'vendor.css' -%}
    {%- render 'asset' with 'theme.css' -%}

    <script>
      window.currency = {
        symbol: '{{ cart.currency.symbol }}',
        name: '{{ cart.currency.name }}',
        code: '{{ cart.currency.iso_code }}',
      };
      window.permanent_domain = `{{shop.permanent_domain}}`;
    </script>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    {% if settings.use_purpledot and shop.permanent_domain == '5ef43d-4a.myshopify.com' and product.tags contains 'pre-order' %}
      {% render 'purple-dot' %}
    {% endif %}

    {% if settings.spark_id != blank %}
      {% render 'spark-layer' %}
    {% endif %}

    <script src="https://t.contentsquare.net/uxa/85f1f678b1cc2.js"></script>

{%- if customer.metafields.sparklayer.authentication -%}

  <script>
    window.sparkOptions = {
      siteId: "blueaircs",
      platform: "shopify",
      rootUrl: {{ routes.root_url | json }},
      language: {{ request.locale.iso_code | json }},
      accountRedirect: {
        urlRegex: /\/account/g,
        goTo: "/index", // page to redirect logged in users to
      },
      auth: {
        user: {{ customer.email | json }},
        token: {{ customer.metafields.sparklayer.authentication | json }},
      },
    };
  </script>
  <script async src="https://sparkcdn.io/sparkjs/blueaircs/live"></script>


<!-- SparkLayer brand variables — Block 1: inside auth conditional -->
<style type="text/css">
:root {
  /* Brand */
  --b2b-brand-color: #002955;
  --b2b-brand-color-hover: #002248;
  --b2b-brand-font: Roboto, sans-serif;
  --b2b-brand-font-heading: Roboto, sans-serif;

  /* Colours */
  --spark-default-body-color: #555555;
  --spark-primary-color: #000000;
  --spark-secondary-color: var(--b2b-brand-color);
  --spark-link-color: var(--b2b-brand-color);

  /* Typefaces */
  --spark-font-default: var(--b2b-brand-font);
  --spark-font-highlight: var(--b2b-brand-font-heading);
  --spark-font-weight-default: 400;
  --spark-font-weight-medium: 500;
  --spark-font-weight-heavy: 600;

  /* General */
  --spark-border-radius-default: 0; /* 4px if theme has rounded buttons, otherwise 0 */
  --spark-drawer-max-width: 700px;
  --spark-drawer-max-width-wide: 1000px;

  /* Font sizes */
  --spark-font-default-size: 14px;
  --spark-font-default-size-small: 14px;
  --spark-header-font: var(--b2b-brand-font-heading);
  --spark-header-font-weight: 500;
  --spark-h1-fontsize: 24px;
  --spark-h2-fontsize: 22px;
  --spark-h3-fontsize: 20px;
  --spark-h4-fontsize: 16px;
  --spark-h5-fontsize: 15px;
  --spark-h6-fontsize: 14px;
  --spark-pricing-fontsize: 20px;
  --spark-pricing-font-weight: 500;
  --spark-pricing-fontsize-small: 14px;
  --spark-product-code-fontsize: 16px;
  --spark-product-code-font-weight: 500;
  --spark-product-code-fontsize-small: 14px;
  --spark-product-stockstatus-align: flex-start;

  /* Buttons */
  --spark-button-font-family: var(--b2b-brand-font-heading);
  --spark-button-color: var(--b2b-brand-color);
  --spark-button-color-highlight: var(--b2b-brand-color-hover);
  --spark-button-large-color: var(--b2b-brand-color);
  --spark-button-large-color-highlight: var(--b2b-brand-color-hover);
  --spark-border-radius-button: 0;
  --spark-button-font-weight: 600;
  --spark-button-text-transform: none;
  --spark-button-text-letter-spacing: 0;
  --spark-button-padding: 1em 2.75em;
  --spark-button-small-font-size: 16px;

  /* Tables */
  --spark-table-border-color: #CCCCCC;
  --spark-table-header-background-color: #F1F1F1;
  --spark-table-header-text-color: #222222;
  --spark-table-header-font-weight: 500;

  /* Product Card */
  --spark-product-card-button-radius: 0;
  --spark-product-card-button-padding: 0.75em 1em;
  --spark-product-card-pricing-font-size: 15px;
  --spark-product-card-pricing-font-size-small: 14px;
  --spark-product-card-select-min-height: 0;
}
</style>

<!-- SparkLayer — disable automatic theme install (core script loaded via app embed) -->
<script>
window.sparkShopify = {
  options: {
    disableAutoInstall: true
  }
};
</script>

<style>
  /* SparkLayer — B2C element hides */
  .cart-count-bubble,
  .card__badge,
  .announcement-bar,
  .announcement-bar-section,
  cart-drawer,
  .product__quantity-option,
  .product__quantity-variant,
  .product-swatch__price--compare,
  .product-subscription__price-wrapper,
  .product__price--compare,
  .product__price--current,
  .product__price-wrapper,
  .product__atc,
  .product__intl-pricing,
  .product__upsells,
  .product-card__atc,
  .product-card__price-wrapper,
  .affirm-as-low-as,
  shopify-payment-terms,
  .product__filter-pack,
  .product__filter-options,
  #cart-count,
  .section__announcement-bar,
  .product__subscription-container,
  .product-card__tags {
    display: none !important;
  }

  /* SparkLayer — price wildcard (excludes containers with spark-product-card or spark-pdp) */
  [class*="price"]:not(:has(spark-product-card)):not(:has(spark-pdp)) {
    display: none !important;
  }

  /* SparkLayer — card layout */
  spark-product-card {
    display: block;
    width: 100%;
    position: relative;
    z-index: 2;
    pointer-events: auto;
  }

  /* SparkLayer — prevent :empty hiding before JS hydration */
  spark-pdp:empty,
  spark-product-card:empty {
    display: block !important;
  }

</style>
{%- endif -%}

<!-- SparkLayer redirect — always outside conditional -->
<script async src="https://cdn.sparklayer.io/spark-redirect.js"></script>
</head>

  {%- capture body_classes -%}
    template-{{template.name}} {% if template.suffix %}template--{{template.suffix}}{% endif %}
  {%- endcapture -%}
  <body
    {% if template.name == 'login' %}
      id="recover"
    {% endif %}
    class="{{body_classes | strip}}"
  >
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>
    {% if shop.permanent_domain == 'uk-blueair.myshopify.com' %}
      <!-- Google Tag Manager (noscript) -->
      <noscript
        ><iframe
          src="https://www.googletagmanager.com/ns.html?id=GTM-58FXRQCH"
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe
      ></noscript>
      <!-- End Google Tag Manager (noscript) -->
    {% endif %}

    {% sections 'header-group' %}

    {% render 'drawer--cart' %}
    {% render 'drawer--mobile-filter' %}
    {% render 'drawer--desktop-search' %}
    {% if settings.enable_quick_view %}
      {% render 'drawer--quick-view' %}
    {% endif %}
    {% if request.design_mode == false %}
      {% render 'modal--country-selector' %}
    {% endif %}

    {% include 'region-check' %}
    {% if template.name == 'product' %}
      {% render 'modal--klaviyo-bis' %}
      {% if is_transactional and template.suffix != 'coming-soon' %}
        {% render 'product-sticky-bar' %}
      {% endif %}
    {% endif %}

    <main
      id="MainContent"
      class="main drawer-background modal-background buystack-modal-background grid {% if template.name == 'index' %}min-h-screen mt-[var(--header-height)]{% elsif template.name == 'login' %}min-h-auto{% else %}min-h-header mt-[var(--header-height)]{% endif %}"
    >
      {% if request.path contains 'apps/returns' %}
        <h1 class="sr-only">{{ page.title | default: shop.name }}</h1>
      {% endif %}
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>

    <script>
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };
      window.PUB_SUB_EVENTS = {
        cartUpdate: 'cart-update',
        quantityUpdate: 'quantity-update',
        variantChange: 'variant-change',
        cartError: 'cart-error',
      };
      window.klaviyo = {
        apiKeyUS: '{{ settings.klaviyo_api_key_us }}',
        apiKeyUK: '{{ settings.klaviyo_api_key_uk }}',
        apiKeyEU: '{{ settings.klaviyo_api_key_eu }}',
      };
      window.pathURL = `{{ canonical_url | replace: 'https://', '' | replace: shop.domain, '' }}`;
      window.domain = `https://{{shop.domain}}`;
    </script>

    {%- render 'asset' with 'vendor.js' -%}
    {%- render 'asset' with 'theme.js' -%}

    {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' or shop.permanent_domain == 'blueeudev.myshopify.com' %}
      {% if is_transactional %}
        {% comment %} {% render 'sprinklr-chat' %} {% endcomment %}
      {% endif %}
    {% endif %}
    {% if shop.permanent_domain == '5ef43d-4a.myshopify.com' %}
      <script type="text/javascript">
        setTimeout(function () {
          var script = document.createElement('script');
          script.src = 'https://static.ordergroove.com/3488d6a745bd4989b67ebc6b0ad38ad6/msi.js';
          document.head.appendChild(script);
        }, 1000);
      </script>
    {% endif %}
    {% if shop.permanent_domain == 'blueeudev.myshopify.com' %}
      <script type="text/javascript">
        function OptanonWrapper() {
          // Check consent state from OneTrust
          var analyticsConsent = OnetrustActiveGroups.indexOf('C0002') > -1; // Example: Analytics category
          var marketingConsent = OnetrustActiveGroups.indexOf('C0003') > -1; // Example: Marketing category
          // Sync with Shopify customerPrivacy API
          if (window.Shopify && window.Shopify.customerPrivacy) {
            window.Shopify.customerPrivacy.setTrackingConsent({
              analytics: analyticsConsent,
              marketing: marketingConsent,
            });
          }
        }

        // Wait for OnetrustActiveGroups to be available before calling OptanonWrapper
        function waitForOneTrust() {
          if (typeof OnetrustActiveGroups !== 'undefined' && OnetrustActiveGroups) {
            OptanonWrapper();
          } else {
            setTimeout(waitForOneTrust, 100);
          }
        }

        waitForOneTrust();
      </script>
    {% endif %}

    {% render 'zendesk-chat' %}
  </body>
</html>
