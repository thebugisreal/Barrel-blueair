            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image2_56abd404-3a61-4f2c-a45e-6c5cfc4bf140.jpg",
            "image_desktop": "shopify://shop_images/image2_56abd404-3a61-4f2c-a45e-6c5cfc4bf140.jpg",
