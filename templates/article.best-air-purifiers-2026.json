            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image4_b95191fa-5d7c-4618-b284-e8fb1aa8db9d.jpg",
            "image_desktop": "shopify://shop_images/image4_b95191fa-5d7c-4618-b284-e8fb1aa8db9d.jpg",
