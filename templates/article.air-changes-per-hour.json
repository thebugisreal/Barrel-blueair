            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image3_433d68e6-aa85-4a99-950e-45173fee9f45.jpg",
            "image_desktop": "shopify://shop_images/image3_433d68e6-aa85-4a99-950e-45173fee9f45.jpg",
