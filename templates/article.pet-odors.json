            "padding_top_desktop": "desktop:pt-0",
            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "135ch",
            "richtext": "<h4><strong>The Risks of Conventional Air Fresheners<\/strong><\/h4><p><\/p><p>Many store-bought air fresheners and sprays contain:<\/p><ol><li>Volatile Organic Compounds (VOCs)<\/li><li>Synthetic fragrances<\/li><li>Formaldehyde<\/li><li>Phthalates<\/li><\/ol><p><\/p><p>These ingredients can contribute to respiratory problems and allergies—not just for humans, but for animals too. Cats and dogs have more sensitive respiratory systems, so what seems safe to you might be harmful to them over time.<\/p>",
            "richtext_alignment": "text-left",
            "richtext_style": "p2"
          }
        },
        "image_text_MikMKz": {
          "type": "image_text",
          "disabled": true,
          "settings": {
            "margin_top_mobile": "mt-0",
            "margin_bottom_mobile": "mb-xl",
            "padding_top_mobile": "pt-md",
            "padding_bottom_mobile": "pb-0",
            "margin_top_desktop": "desktop:mt-0",
            "margin_bottom_desktop": "desktop:mb-0",
            "padding_top_desktop": "desktop:pt-xl",
            "padding_bottom_desktop": "desktop:pb-xl",
            "max_width_desktop": "80ch",
            "color": "text-blue",
            "title": "Get started",
            "title_style": "h4",
            "richtext": "<p>Find your device, select your filter, & customize your subscription<\/p><p>Your purchase directly supports 1 pound of plastic & trash pulled from the ocean, coastlines & rivers<\/p>",
            "cta_url": "shopify:\/\/pages\/subscribe",
            "cta_text": "Subscribe now",
            "cta_style": "btn btn--blue-rounded",
            "text_padding_left_desktop": "desktop:pl-0",
            "text_padding_right_desktop": "desktop:pr-0",
            "image_mobile": "shopify:\/\/shop_images\/Image_Ratio_Keeper_56602345-65b9-4a4a-84b2-80c9208dacf9.png",
            "image_placement_mobile": "flex-col",
