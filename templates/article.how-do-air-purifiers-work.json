            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image2_15ac0b07-702a-416a-a88f-29846be8e059.jpg",
            "image_desktop": "shopify://shop_images/image2_15ac0b07-702a-416a-a88f-29846be8e059.jpg",
