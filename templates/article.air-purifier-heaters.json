            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image2_29d27f39-3607-4944-bda9-6cafbb25fd1f.jpg",
            "image_desktop": "shopify://shop_images/image2_29d27f39-3607-4944-bda9-6cafbb25fd1f.jpg",
