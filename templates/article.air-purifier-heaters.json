            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image3_e51fd225-3a2a-4749-844c-ad3e12612025.jpg",
            "image_desktop": "shopify://shop_images/image3_e51fd225-3a2a-4749-844c-ad3e12612025.jpg",
            "caption": "",
