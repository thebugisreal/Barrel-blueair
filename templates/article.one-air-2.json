            "margin_bottom_desktop": "desktop:mb-0",
            "padding_top_desktop": "desktop:pt-0",
            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image2_caecbbd5-1034-40b8-8285-53b9757d402e.jpg",
            "image_desktop": "shopify://shop_images/image2_caecbbd5-1034-40b8-8285-53b9757d402e.jpg",
            "caption": "",
            "caption_style": "p6",
            "product": ""
