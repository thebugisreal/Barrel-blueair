            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image1_77dac2fc-4482-483b-ae61-a4f782a70972.jpg",
            "image_desktop": "shopify://shop_images/image1_77dac2fc-4482-483b-ae61-a4f782a70972.jpg",
            "caption": "",
            "caption_style": "p6",
            "product": ""
