            "margin_bottom_desktop": "desktop:mb-0",
            "padding_top_desktop": "desktop:pt-0",
            "padding_bottom_desktop": "desktop:pb-md",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/Blog_Image_4.png",
            "image_desktop": "shopify://shop_images/Blog_Image_4.png",
            "caption": "",
            "caption_style": "p6",
            "product": "blue-pure-511i-max-marie-kondo-bundle",
            "product_image_override": "shopify://shop_images/2_b74bcdbf-50cb-423e-bfe0-32661ea909df.png"
