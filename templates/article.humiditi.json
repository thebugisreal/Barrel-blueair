            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image2_1df8a9d8-87dc-4648-9d72-acc6a4f7693d.jpg",
            "image_desktop": "shopify://shop_images/image2_1df8a9d8-87dc-4648-9d72-acc6a4f7693d.jpg",
