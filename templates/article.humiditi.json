            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image1_a917caaa-eac4-40ec-9261-0e84e08d60b0.jpg",
            "image_desktop": "shopify://shop_images/image1_a917caaa-eac4-40ec-9261-0e84e08d60b0.jpg",
