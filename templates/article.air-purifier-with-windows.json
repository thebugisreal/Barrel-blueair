            "image": "shopify://shop_images/image1_121cbdb4-dfaa-4a84-aa99-867455a202b7.jpg",
            "image_desktop": "shopify://shop_images/image1_121cbdb4-dfaa-4a84-aa99-867455a202b7.jpg",
