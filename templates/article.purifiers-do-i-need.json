            "margin_top_desktop": "desktop:mt-0",
            "margin_bottom_desktop": "desktop:mb-0",
            "padding_top_desktop": "desktop:pt-0",
            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image2_4fddfa26-11d3-49ce-825e-6288849e4d01.jpg",
            "image_desktop": "shopify://shop_images/image2_4fddfa26-11d3-49ce-825e-6288849e4d01.jpg",
            "caption": "",
            "caption_style": "p6",
