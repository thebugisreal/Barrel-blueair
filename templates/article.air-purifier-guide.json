            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image2_df4171cf-f89a-45dd-89e8-502470ef1340.jpg",
            "image_desktop": "shopify://shop_images/image2_df4171cf-f89a-45dd-89e8-502470ef1340.jpg",
