            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image4_4615cbd7-396c-4d07-8f0b-9e29a64aea1a.jpg",
            "image_desktop": "shopify://shop_images/image4_4615cbd7-396c-4d07-8f0b-9e29a64aea1a.jpg",
            "caption": "",
            "caption_style": "p6",
