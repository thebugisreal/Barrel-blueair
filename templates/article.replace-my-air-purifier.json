            "padding_top_desktop": "desktop:pt-0",
            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image1_774a766d-b5b5-43bf-aa2e-6c5e0bd4630a.jpg",
            "image_desktop": "shopify://shop_images/image1_774a766d-b5b5-43bf-aa2e-6c5e0bd4630a.jpg",
            "caption": "",
            "caption_style": "p6",
