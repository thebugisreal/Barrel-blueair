            "padding_bottom_desktop": "desktop:pb-xxl",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/image1_db8d80c4-91d8-4a16-a7b9-3c04d695c0d4.jpg",
            "image_desktop": "shopify://shop_images/image1_db8d80c4-91d8-4a16-a7b9-3c04d695c0d4.jpg",
            "caption": "",
            "caption_style": "p6",
