            "padding_bottom_desktop": "desktop:pb-0",
            "max_width_desktop": "1096px",
            "image": "shopify://shop_images/Blog_Image-1_1_1.png",
            "image_desktop": "shopify://shop_images/Blog_Image-1_1_1.png",
