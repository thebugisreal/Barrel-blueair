{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<s-sound-comparison class="section__sound-comparison block w-full {{ margins_paddings }} {{ section.settings.color }} px-md desktop:px-xl">
  <div
    class="sound-comparison__inner mx-auto w-full max-w-[var(--max-width-mobile)] desktop:max-w-[var(--max-width-desktop)]"
    style="--max-width-mobile: {% if section.settings.max_width_mobile != blank %}{{ section.settings.max_width_mobile }}{% else %}unset{% endif %}; --max-width-desktop: {% if section.settings.max_width_desktop != blank %}{{ section.settings.max_width_desktop }}{% else %}unset{% endif %};"
  >
    <div class="sound-comparison__content">
      {% if section.settings.title != blank %}
        <h2 class="sound-comparison__title {{ section.settings.title_style }}">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="sound-comparison__description p2">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="sound-comparison__cards">
      {% render 'sound-comparison-card',
        variant: 'blueair',
        label: section.settings.blueair_label,
        image: section.settings.blueair_image,
        audio: section.settings.blueair_audio,
        caption: section.settings.blueair_caption,
        caption_style: section.settings.caption_typography
      %}

      <span class="sound-comparison__vs" aria-hidden="true">{{ 'sections.sound_comparison.vs' | t }}</span>

      {% render 'sound-comparison-card',
        variant: 'others',
        label: section.settings.others_label,
        image: section.settings.others_image,
        audio: section.settings.others_audio,
        caption: section.settings.others_caption,
        caption_style: section.settings.caption_typography
      %}
    </div>
  </div>
</s-sound-comparison>

