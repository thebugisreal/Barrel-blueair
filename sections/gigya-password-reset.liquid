<script type="text/javascript" lang="javascript" src="https://cdns.gigya.com/js/gigya.js?apikey={{ settings.gigya_api_key }}"></script>

<script>
  window.SHOPIFY_SETTINGS = {
    xecurify_id: {{ settings.xecurify_id | json }},
    gigya_api_key: {{ settings.gigya_api_key | json }}
  };
</script>

<gigya-password-reset class="min-h-screen flex items-center justify-center bg-gray-light py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <h1 class="h3 text-center mb-md">Reset Your Password</h1>

    <form id="passwordResetForm" class="mt-8" js-password-reset-submit>
      <div>
        <div class="mb-4">
          <label for="email" class="sr-only">Email</label>
          <input type="email" id="email" name="email" required placeholder="Email" 
            class="w-full mb-md border-b px-sm py-xxxs text-16 text-blue bg-transparent placeholder:text-blue" js-password-reset-email>
        </div>
      </div>

      <div>
        <button type="submit" class="btn btn--blue-rounded mb-lg mx-auto">
          <span class="btn__text">Send Reset Email</span>
          <span class="btn__arrow">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span>
        </button>
      </div>
    </form>
  </div>
</gigya-password-reset>

{% schema %}
{
  "name": "Gigya Password Reset",
  "settings": [],
  "presets": [
    {
      "name": "Gigya Password Reset",
      "category": "Authentication"
    }
  ]
}
{% endschema %}
