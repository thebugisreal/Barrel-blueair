{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

<div class="section__media {{ margins_paddings }} {{ section.settings.color }} {{ section.settings.gutter_mobile }} {{ section.settings.gutter_desktop }}">
  <div class="tabletl:mx-auto tabletl:max-w-[var(--section-max-width-desktop)]" style="--section-max-width-desktop: {{ section.settings.section_max_width_desktop}}">
    {% if section.settings.video != blank %}
    <div class="video__upload  block relative overflow-hidden">
        {{ section.settings.video | video_tag: class: 'block w-full h-full object-cover object-center', image_size: '1280x', autoplay: section.settings.enable_autoplay, loop: true, muted: true, controls: true }}
    </div>

    {% elsif section.settings.video_embed != blank %}
    <div class="video__embed">
        {{  section.settings.video_embed }}
    </div>
    {% elsif section.settings.image_mobile %}
        <div class="image-container">
        {% render 'lazy-image', image: section.settings.image_mobile, image_desktop: section.settings.image_desktop %}
        </div>
    {% endif %}
  </div>
</div>

