{% assign footer_linklist = linklists[section.settings.footer_nav] %}
{% assign subfooter_linklist = linklists[section.settings.subfooter_nav] %}

<footer class="site-footer bg-blue text-white px-md pt-xl pb-lg desktop:px-xl desktop:pt-xxl">
  <div class="site-footer__main desktop:flex desktop:justify-between desktop:gap-lg">
    <div class="site-footer__nav-conatiner desktop:flex-1 desktop:max-w-[420px]">
      {% if section.settings.footer_heading_text != blank %}
        <h1 class="site-footer__heading {{ section.settings.footer_heading_style }} leading-[1.3]">
          {{ section.settings.footer_heading_text }}
        </h1>
      {% endif %}
    
      <div class="site-footer__social-media-links flex gap-md pt-lg mt-xs desktop:mt-0">
        {% if settings.social_instagram != blank %}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{{ 'icon-social-ig.svg' | inline_asset_content }}</a>
        {% endif %}
        {% if settings.social_facebook != blank %}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{{ 'icon-social-fb.svg' | inline_asset_content }}</a>
        {% endif %}
        {% if settings.social_tiktok != blank %}
          <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{{ 'icon-social-tt.svg' | inline_asset_content }}</a>
        {% endif %}
        {% if settings.social_linkedin != blank %}
          <a href="{{ settings.social_linkedin }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-media-link w-24">{{ 'icon-social-in.svg' | inline_asset_content }}</a>
        {% endif %}
      </div>

      {% if settings.app_store_url_mobile != blank or settings.google_play_url_mobile != blank %}
        <div class="site-footer__divider py-lg desktop:hidden">
          <hr class="block my-xs text-blue-medium">
        </div>

        <div class="site-footer__app site-footer__app--mobile desktop:hidden">
          <h2 class="text-18">Get the Blueair app</h2>
          <div class="site-footer__app-links flex flex-col gap-sm mt-sm">
            {% if settings.app_store_url_mobile != blank %}
              <a href="{{ settings.app_store_url_mobile }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--mobile" aria-label="Apple App Store">
                <img src="{{ 'app-store--white.png' | asset_url }}" class="block w-auto h-[67px]" alt="Download on the App Store" />
              </a>
            {% endif %}
            {% if settings.google_play_url_mobile != blank %}
              <a href="{{ settings.google_play_url_mobile }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--mobile" aria-label="Google Play Store">
                <img src="{{ 'google-play--white.png' | asset_url }}" class="block w-auto h-[67px]" alt="Get it on Google Play" />
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if settings.bcorp_link_url != blank %}
        <div class="site-footer__divider py-lg">
          <hr class="block my-xs text-blue-medium desktop:my-sm">
        </div>

        <div class="site-footer__bcorp">
          <a href="{{ settings.bcorp_link_url }}" target="_blank" rel="noopener noreferrer" class="site-footer__bcorp-link block w-[270px] desktop:w-[200px]">
