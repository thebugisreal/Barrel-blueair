      <div class="site-footer__divider py-lg desktop:hidden">
        <hr class="block my-xs text-blue-medium">
      </div>

      <div class="site-footer__nav site-footer__nav--mobile desktop:hidden">
        <s-accordion data-manual-collapse="false" js-accordion>
          {% for link in footer_linklist.links %}
            <div class="accordion-item {% unless forloop.last %}mb-md{% endunless %}" js-accordion-item>
              <button class="accordion-header w-full flex justify-between items-center" aria-expanded="false" aria-controls="FooterNavLink{{ forloop.index }}" js-accordion-header>
                <span class="h4 text-20">{{ link.title }}</span>
                <span class="accordion-icon accordion-icon--caret-down w-24">{{ 'icon-active-down.svg' | inline_asset_content }}</span>
              </button>
              <div id="FooterNavLink{{ forloop.index }}" class="accordion-content" aria-hidden="true" js-accordion-content>
                <ul class="site-footer__links mt-md">
                  {% for child_link in link.links %}
                    <li class="site-footer__item {% unless forloop.last %}mb-xs{% endunless %}">
                      <a href="{{ child_link.url }}" class="site-footer__link text-18 font-300">{{ child_link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endfor %}
        </s-accordion>
      </div>
    </div>
    
    <div class="site-footer__nav-conatiner hidden desktop:block desktop:w-1/2">
      <div class="site-footer__nav site-footer__nav--desktop flex gap-md">
        {% for link in footer_linklist.links %}
          <div class="site-footer__links-wrapper flex-1">
            <div class="h4 text-20 mb-md">{{ link.title }}</div>
            <ul class="site-footer__links">
              {% for child_link in link.links %}
                <li class="site-footer__item mt-sm">
                  <a href="{{ child_link.url }}" class="site-footer__link text-18 font-300">{{ child_link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>

      {% if settings.app_store_url_desktop != blank or settings.google_play_url_desktop != blank %}
        <div class="site-footer__app site-footer__app--desktop pt-xs mt-lg">
          <h2 class="text-18">Get the Blueair app</h2>
          <div class="site-footer__app-links flex gap-md mt-sm">
            {% if settings.app_store_url_desktop != blank %}
              <a href="{{ settings.app_store_url_desktop }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--desktop" aria-label="Apple App Store">
                <img src="{{ 'app-store--white.png' | asset_url }}" class="block w-auto h-[57px]" alt="Download on the App Store" />
              </a>
            {% endif %}
            {% if settings.google_play_url_desktop != blank %}
              <a href="{{ settings.google_play_url_desktop }}" target="_blank" rel="noopener noreferrer" class="site-footer__app-link site-footer__app-link--desktop" aria-label="Google Play Store">
                <img src="{{ 'google-play--white.png' | asset_url }}" class="block w-auto h-[57px]" alt="Get it on Google Play" />
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="site-footer__divider pt-lg pb-sm desktop:pb-lg desktop:pt-xxl">
    <hr class="block mt-xs mb-sm text-blue-medium desktop:my-0">
  </div>
  
  <div class="site-footer__subfooter flex flex-col gap-lg desktop:flex-row-reverse desktop:justify-between desktop:items-center">
    {% if settings.enable_modal_popup %}
      <div class="site-footer__county-select border border-white rounded-[24px] overflow-hidden text-white max-w-max cursor-pointer" js-open-country-market-selector-modal aria-expanded="false">
        <div class="country-select__label flex gap-xxxs justify-start items-center py-xxs px-xs pr-md">
          <div class="icon-globe w-32">{{ 'icon-globe.svg' | inline_asset_content }}</div>
          <div class="country-name text-12 flex-1" js-country-input-label>{{ localization.country.name }}</div>
        </div>  
      </div>
    {% else %}
      <div class="site-footer__county-select border border-white rounded-[24px] overflow-hidden text-white max-w-max" aria-expanded="false">
        {% render 'country-select' scope: 'Footer' %}
      </div>
    {% endif %}
    <ul class="site-footer__links flex flex-wrap gap-x-md gap-y-xs font-300">
      {% for link in subfooter_linklist.links %}
        <li class="site-footer__item">
          <a href="{{ link.url }}" class="site-footer__link !no-underline">{{ link.title }}</a>
        </li>
      {% endfor %}
      {% if localization.country.iso_code == 'US' %}
        {% comment %} <li class="site-footer__item">
          <span class=evidon-notice-link></span>
        </li> {% endcomment %}
                <li id="adchoices-container" class="site-footer__item">
        <a href="#" class="adchoices-button" Cookie Preferences>
        <img id="adchoices-logo" alt="AdChoices Logo" src="https://youradchoices.com/DAA_style/YAC/icon.png">
        <span>Adchoices - Do not sell or Share</span>
        </a>
      </li>
        <style>
        #adchoices-container a{
        display:flex !important;
        align-items:center !important;}
        #adchoices-logo{width:1.3rem !important}
        </style>
        <script>
          (function() {
            let adContainer = document.getElementById('adchoices-container');
            let adLogo = document.getElementById('adchoices-logo');
            let adText = document.getElementById('adchoices-text');
         
            if (!adContainer) {
              console.warn("AdChoices container not found.");
              return;
            }
         
            adContainer.onclick = function() {
              if (window.OneTrust && typeof window.OneTrust.ToggleInfoDisplay === "function") {
                window.OneTrust.ToggleInfoDisplay();
              } else {
                console.warn("OneTrust is not loaded yet.");
              }
            };
         
            console.log("AdChoices badge initialized.");
          })();
         </script>
      {% endif %}
      {% if localization.country.iso_code == 'CA' or localization.country.iso_code == 'GB' or localization.country.iso_code == 'DE' %}
        <li class="site-footer__item">
          <button id="ot-sdk-btn" class="ot-sdk-show-settings site-footer__link !no-underline">Cookie Settings</button>
