{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
<s-hotspot {% if section.settings.open_first_hospot_mobile %}open-first-hotspot-mobile {% endif %}class="section__hotspot block {{ margins_paddings }} {{ section.settings.color }} px-md desktop:px-xl desktop:flex desktop:items-center desktop:gap-[136px]" {% if section.settings.enable_hover_display != blank %} data-display-control="{{ section.settings.enable_hover_display }}" {% endif %}>
  <div class="hotspot__text-content flex flex-col gap-sm desktop:flex-1 mb-xxl desktop:mb-0">
    {% if section.settings.title != blank %}
      <h2 class="hotspot__title {{ section.settings.title_style }}">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="hotspot__subtext {{ section.settings.subtext_style }}">{{ section.settings.subtext }}</p>
    {% endif %}
    {% if section.settings.cta_url != blank and section.settings.cta_text != blank%}
      <a href="{{ section.settings.cta_url }}" class="hotspot__cta {{ section.settings.cta_style }}">
        <span class="btn__text">{{ section.settings.cta_text }}</span>
        <span class="btn__arrow">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span>
      </a>
    {% endif %}
  </div>
  <div class="hotspot__main-image relative {{ section.settings.image_position }} desktop:w-[var(--desktop-width)]" style="--desktop-width: {{ section.settings.image_width }}%;">
    {% render 'lazy-image' image: section.settings.image %}

    {% for block in section.blocks %}
      <div class="hotspot__trigger absolute -translate-x-1/2 -translate-y-1/2" data-active="false" style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;">
        <button class="hotspot-trigger__btn flex justify-center items-center w-[37px] h-[37px] rounded-full desktop:w-[49px] desktop:h-[49px]" data-active="false" data-index="{{ forloop.index0 }}" js-hotspot-trigger-btn>
          <span class="plus w-[19px] desktop:w-[25px] leading-[0]">{{ 'icon-plus.svg' | inline_asset_content }}</span>
          <span class="minus w-[19px] desktop:w-[25px] leading-[0]">{{ 'icon-minus.svg' | inline_asset_content }}</span>
        </button>

        <div class="hotspot-trigger__content hotspot-trigger__content--desktop w-[330px] shadow-md absolute top-0 -translate-y-1/2 hidden" js-hotspot-trigger-content>
          {% if block.settings.image_desktop != blank %}
            <div class="hotspot-trigger-content__image relative">
              {% render 'lazy-image' image: block.settings.image_desktop %}
  
              {% if block.settings.tags != blank %}
                {% assign tags = block.settings.tags |  split: ',' %}
                <ul class="hotspot-trigger-content__tags flex flex-wrap gap-xxs absolute bottom-0 left-0 py-xs px-sm">
                  {% for tag in tags %}
                    <li class="hotspot-trigger-content__tag text-12 font-500 bg-white rounded-[60px] border border-gray px-xs py-xxs leading-[1]">
                      {{ tag | strip }}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endif %}
          <div class="hotspot-trigger-content__text-container p-sm bg-blue-light flex flex-col gap-xxs">
            {% if block.settings.image_desktop == blank and block.settings.tags != blank %}
              {% assign tags = block.settings.tags |  split: ',' %}
              <ul class="hotspot-trigger-content__tags flex flex-wrap gap-xxs">
                {% for tag in tags %}
                  <li class="hotspot-trigger-content__tag text-12 font-500 bg-white rounded-[60px] border border-gray px-xs py-xxs leading-[1]">
                    {{ tag | strip }}
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
            {% if block.settings.title != blank %}
              <div class="hotspot-trigger-content__title {{ block.settings.title_style }}">
                {{ block.settings.title }}
              </div>
            {% endif %}
            {% if block.settings.subtext != blank %}
              <div class="hotspot-trigger-content__subtext {{ block.settings.subtext_style }}">
                {{ block.settings.subtext }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="hotspot__trigger-contents hotspot__trigger-contents--mobile mt-lg desktop:hidden">
    {% for block in section.blocks %}
      <div class="hotspot-trigger__content hotspot-trigger__content--mobile hidden" data-active="false" data-index="{{ forloop.index0 }}" js-hotspot-trigger-content>
        {% if block.settings.image_mobile != blank %}
          <div class="hotspot-trigger-content__image relative">
            {% render 'lazy-image' image: block.settings.image_mobile %}

            {% if block.settings.tags != blank %}
              {% assign tags = block.settings.tags |  split: ',' %}
              <ul class="hotspot-trigger-content__tags flex flex-wrap gap-xxs absolute bottom-0 left-0 py-xs px-sm">
                {% for tag in tags %}
                  <li class="hotspot-trigger-content__tag text-12 font-500 bg-white rounded-[60px] border border-gray px-xs py-xxs leading-[1]">
                    {{ tag | strip }}
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
        <div class="hotspot-trigger-content__text-container p-sm bg-blue-light flex flex-col gap-xxs">
          {% if block.settings.image_mobile == blank and block.settings.tags != blank %}
            {% assign tags = block.settings.tags |  split: ',' %}
            <ul class="hotspot-trigger-content__tags flex flex-wrap gap-xxs">
              {% for tag in tags %}
                <li class="hotspot-trigger-content__tag text-12 font-500 bg-white rounded-[60px] border border-gray px-xs py-xxs leading-[1]">
                  {{ tag | strip }}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if block.settings.title != blank %}
            <div class="hotspot-trigger-content__title {{ block.settings.title_style }}">
              {{ block.settings.title }}
            </div>
          {% endif %}
          {% if block.settings.subtext != blank %}
            <div class="hotspot-trigger-content__subtext {{ block.settings.subtext_style }}">
              {{ block.settings.subtext }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</s-hotspot>

