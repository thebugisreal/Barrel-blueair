<subscription-quiz class="section__subscription-quiz block p-md desktop:px-xl desktop:pt-sm">
  <div class="subscription-quiz__nav subscription-quiz__nav--search flex justify-center items-center gap-xxxs desktop:justify-end mb-md desktop:mb-lg hidden" js-quiz-search-nav>
    <button class="subscription-quiz-nav__btn w-[32px] p-xxxs disabled:opacity-30" disabled data-type="prev" js-quiz-nav-btn>
      {{ 'icon-arrow-left.svg' | inline_asset_content }}
    </button>
    <div class="subscription-quiz__current-step p3 pt-[1px]">
      <span>Step 0</span><span js-quiz-current-step>1</span><span> / 03</span>
    </div>
    <button class="subscription-quiz-nav__btn w-[32px] p-xxxs disabled:opacity-30" disabled data-type="next" js-quiz-nav-btn>
      {{ 'icon-arrow-right.svg' | inline_asset_content }}
    </button>
  </div>
  <div class="subscription-quiz__nav subscription-quiz__nav--family flex justify-center items-center gap-xxxs desktop:justify-end mb-md desktop:mb-lg" js-quiz-family-nav>
    <button class="subscription-quiz-nav__btn w-[32px] p-xxxs disabled:opacity-30" disabled data-type="prev" js-quiz-nav-btn>
      {{ 'icon-arrow-left.svg' | inline_asset_content }}
    </button>
    <div class="subscription-quiz__current-step p3 pt-[1px]">
      <span>Step 0</span><span js-quiz-current-step>1</span><span> / 04</span>
    </div>
    <button class="subscription-quiz-nav__btn w-[32px] p-xxxs disabled:opacity-30" disabled data-type="next" js-quiz-nav-btn>
      {{ 'icon-arrow-right.svg' | inline_asset_content }}
    </button>
  </div>
  <div class="subscription-quiz__steps-container max-w-[900px] mx-auto">
    <div class="subscription-quiz__step" data-step="1" data-active="true" js-quiz-step>
      {% if section.settings.step_1_heading != blank %}
        <h1 class="subscription-quiz__heading h2 text-center">
          {{ section.settings.step_1_heading }}
        </h1>
      {% endif %}
      <s-tabs class="subscription-quiz__tabs block mt-md desktop:mt-lg">
        <div class="tab__triggers flex justify-center items-center rounded-[100px] bg-blue-light p-xxs max-w-max mx-auto" role="tablist" aria-orientation="horizontal" js-tablist>
          <button id="subscription-quiz-tab1-tab" class="tab__trigger subscription-quiz__tab-trigger text-16 rounded-[30px] py-xs px-md" aria-controls="subscription-quiz-tab1-content-panel" role="tab" aria-selected="false" data-mode="search" js-tab>
            By Model Number
          </button>
          <button id="subscription-quiz-tab2-tab" class="tab__trigger subscription-quiz__tab-trigger text-16 rounded-[30px] py-xs px-md" aria-controls="subscription-quiz-tab2-content-panel" role="tab" aria-selected="true" data-mode="family" js-tab>
            By Family
          </button>
        </div>
        <div id="subscription-quiz-tab1-content-panel" class="tab__panel py-md desktop:py-lg" role="tabpanel" aria-labelledby="subscription-quiz-tab1-tab" aria-hidden="true">
          <form class="subscription-quiz__search-form" js-quiz-search-form>
            <label for="SubscriptionQuizSearch" class="block p1 text-center mb-sm">Enter your model number and we'll find compatible replacement filters</label>
            <div class="flex items-center gap-sm">
              <div class="flex items-center gap-sm rounded-[24px] border border-gray bg-blue-light overflow-hidden pl-xs pr-lg relative flex-1">
                <span class="w-[36px]">{{ 'icon-search.svg' | inline_asset_content }}</span>
                <input type="text" name="modelNumber" id="SubscriptionQuizSearch" class="flex-1 py-xs bg-transparent" required autocomplete="off" />
                <button type="button" class="w-[20px] absolute right-[12px] top-1/2 -translate-y-1/2 hidden" js-quiz-search-clear>{{ 'icon-close.svg' | inline_asset_content }}</button>
              </div>
              <button type="submit" class="subscription-quiz__search-submit w-[32px] rounded-full overflow-hidden border border-blue">
                {{ 'icon-arrow-right.svg' | inline_asset_content }}
              </button>
            </div>
          </form>
          <div class="subscription-quiz__search-no-results text-center mt-md" js-quiz-search-no-results></div>
        </div>
        <div id="subscription-quiz-tab2-content-panel" class="tab__panel py-md desktop:py-lg" role="tabpanel" aria-labelledby="subscription-quiz-tab2-tab" aria-hidden="false">
          <div class="subscription-quiz__selection-group subscription-quiz__selection-group--family grid grid-cols-3 gap-xs desktop:grid-cols-4 desktop:gap-md">
            {% for block in section.blocks %}
              <button class="subscription-quiz__selection subscription-quiz__selection--family border border-gray flex flex-col" data-selected="false" data-group-target="{{ block.settings.title | handleize }}" js-quiz-selection>
                {% if block.settings.image != blank %}
                  <div class="subscription-quiz-selection__image w-full">
                    {% render 'lazy-image' image: block.settings.image loading: 'easy' %}
                  </div>
                {% endif %}
                {% if block.settings.title != blank %}
                  <div class="subscription-quiz-selection__title w-full font-500 leading-[18px] desktop:text-16 text-center p-xs desktop:pb-md flex-1">
                    {{ block.settings.title }}
                  </div>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        </div>
      </s-tabs>
    </div>
    <div class="subscription-quiz__step" data-step="2" data-active="false" js-quiz-step>
      {% if section.settings.step_2_heading != blank %}
        <div class="subscription-quiz__heading h2 text-center">
          {{ section.settings.step_2_heading }}
        </div>
      {% endif %}
      {% for block in section.blocks %}
        {% if block.settings.series != blank %}
          <div class="subscription-quiz__selection-group subscription-quiz__selection-group--series py-48 desktop:py-xxl grid grid-cols-3 gap-xs desktop:grid-cols-4 desktop:gap-md" data-active="false" data-group-id="{{ block.settings.title | handleize }}" js-quiz-selection-group>
            {% for series in block.settings.series %}
              <button class="subscription-quiz__selection subscription-quiz__selection--series border border-gray flex flex-col" data-selected="false" data-group-target="{{ series.system.id }}" js-quiz-selection>
                <div class="subscription-quiz-selection__image w-full">
                  {% render 'lazy-image' image: series.image loading: 'easy' %}
                </div>
                <div class="subscription-quiz-selection__title w-full font-500 leading-[18px] desktop:text-16 text-center p-xs desktop:pb-md flex-1">
                  {{ series.name }}
                </div>
              </button>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="subscription-quiz__step" data-step="3" data-active="false" js-quiz-step>
      {% if section.settings.step_3_heading != blank %}
        <div class="subscription-quiz__heading h2 text-center">
          {{ section.settings.step_3_heading }}
        </div>
      {% endif %}
      {% for block in section.blocks %}
        {% for series in block.settings.series %}
          {% if series.filters != blank %}
            <div class="subscription-quiz__selection-group subscription-quiz__selection-group--filter py-48 desktop:py-xxl grid grid-cols-1 gap-xs desktop:grid-cols-3 desktop:gap-md" data-active="false" data-group-id="{{ series.system.id }}" js-quiz-selection-group>
              {% for filter_object in series.filters.value %}
                {% if filter_object.product != blank %}
                  {% assign filter_product = filter_object.product.value %}
                  {% assign filter_product_variant = filter_product.variants[0] %}
                  {% assign fitler_quantity = filter_object.quantity | default: 1 | plus: 0 %}
                  {% if filter_product_variant.selling_plan_allocations.size > 0 %}
                    {% assign model_numbers = '' %}
                    {% for number in filter_product.metafields.seed.product_model_number.value %}
                      {% assign model_numbers = model_numbers | append: number %}
                      {% unless forloop.last %}
                        {% assign model_numbers = model_numbers | append: ',' %}
                      {% endunless %}
                    {% endfor %}
                    <button class="subscription-quiz__selection subscription-quiz__selection--filter flex flex-col border border-gray" 
                      data-selected="false" 
                      data-group-target="{{ filter_object.system.id }}" 
                      data-model-numbers="{{ model_numbers }}"
                      js-quiz-selection 
                      js-quiz-filter-selection>
                      <div class="subscription-quiz-filter__image w-full">
                        {% assign filter_image = filter_object.image | default: filter_product.featured_image %}
                        {% render 'lazy-image' image: filter_image loading: 'easy' %}
                      </div>
                      <div class="subscription-quiz-filter__info w-full flex-1 text-left p-sm desktop:p-md">
                        <div class="subscription-quiz-filter__badge flex gap-xs">
                          <span class="product-card__tag product-card__tag--dark-blue text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]">Save 15%</span>
                        </div>
                        <div class="subscription-quiz-filter__title s3 leading-[22px] mt-md">{{ filter_object.name }}</div>
                        <div class="subscription-quiz-filter__price p1 mt-md">
                          {% if filter_product_variant.selling_plan_allocations[0].compare_at_price > filter_product_variant.selling_plan_allocations[0].price %}
                            <s class="font-400 mr-xs">{{ filter_product_variant.selling_plan_allocations[0].compare_at_price | times: fitler_quantity | money }}</s>
                          {% endif %}
                          <span>{{ filter_product_variant.selling_plan_allocations[0].price | times: fitler_quantity | money }}</span>
                        </div>
                      </div>
                    </button>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
      <div class="subscription-quiz__search-results py-48 desktop:py-xxl grid grid-cols-1 gap-xs desktop:grid-cols-3 desktop:gap-md" js-quiz-search-results></div>
    </div>
    <div class="subscription-quiz__step" data-step="4" data-active="false" js-quiz-step>
      {% if section.settings.step_4_heading != blank %}
        <div class="subscription-quiz__heading h2 text-center">
          {{ section.settings.step_4_heading }}
        </div>
      {% endif %}
      {% for block in section.blocks %}
        {% for series in block.settings.series %}
          {% for filter_object in series.filters.value %}
            {% if filter_object.product != blank %}
              {% assign filter_product = filter_object.product.value %}
              {% assign filter_product_variant = filter_product.variants[0] %}
              {% if filter_product_variant.selling_plan_allocations.size > 0 %}
                <div class="subscription-quiz__selection-group subscription-quiz__selection-group--frequency pt-48 desktop:pt-xxl grid grid-cols-1 gap-xs desktop:grid-cols-3 desktop:gap-md" data-variant-available="{{ filter_product_variant.available }}" data-active="false" data-group-id="{{ filter_object.system.id }}" js-quiz-selection-group>
                  {% assign recommended_frequency_option = '' %}
                  {% if filter_object.recommended_frequency != blank %}
                    {% assign recommended_frequency_option = filter_object.recommended_frequency %}
                  {% endif %}
                  {% if filter_product.metafields.seed.subscription_frequency_options != blank %}
                    {% for frequency_option in filter_product.metafields.seed.subscription_frequency_options.value %}
                      {% assign frequency_option_name = forloop.index | prepend: 'Option ' %}
                      {% for selling_plan_allocation in filter_product_variant.selling_plan_allocations %}
                        {% if frequency_option == selling_plan_allocation.selling_plan.options[0].value %}
                          <button
                            data-selected="false" 
                            data-selling-plan-id="{{ selling_plan_allocation.selling_plan.id }}" 
                            data-variant="{{ filter_product_variant.id }}" 
                            data-quantity="{% if filter_object.quantity != blank %}{{ filter_object.quantity }}{% else %}1{% endif %}"
                            data-frequency="{{ selling_plan_allocation.selling_plan.options[0].value | downcase }}"
                            {% if filter_product_variant.available == false %}disabled{% endif %} 
                            class="subscription-quiz__selection subscription-quiz__selection--frequency flex flex-col border border-blue-darkSky relative {% if frequency_option_name == recommended_frequency_option %}recommended{% endif %} disabled:opacity-50 disabled:cursor-not-allowed" 
                            js-quiz-subscription-frequency>
                            <div class="subscription-quiz-frequency__heading w-full p-md flex justify-center items-center gap-xxs border-b border-blue-darkSky">
                              <span class="subscription-quiz-frequency__checkbox w-[18px] min-w-[18px] h-[18px] border border-blue rounded-full relative"></span>
                              <span class="subscription-quiz-frequency__title p1">
                                Every {{ selling_plan_allocation.selling_plan.options[0].value }}
                              </span>
                            </div>
                            <div class="subscription-quiz-frequency__description w-full p-md text-left flex-1">
                              {% assign description_handle = forloop.parentloop.index | prepend: 'frequency_option_' | append: '_description' %}
                              {% if filter_object[description_handle] != blank %}
                                {% assign description_list = filter_object[description_handle] %}
                                <div class="p3">This option is great for:</div>
                                <ul class="subscription-quiz-frequency__description-list">
                                  {% for description_line in description_list.value %}
                                    {% assign description = description_line %}
                                    <li class="mt-sm flex justify-start items-center gap-xxxs">
                                      {% if description_line contains '|' %}
                                        {% assign description = description_line | split: '|' | last | strip %}
                                        {% assign description_icon_file = description_line | split: '|' | first | strip %}
                                        {% assign description_icon_file_object = images[description_icon_file] %}
                                        {% if description_icon_file_object != blank %}
                                          <div class="w-[24px]">{% render 'lazy-image' image: description_icon_file_object loading: 'easy' %}</div>
                                        {% endif %}
                                      {% endif %}
                                      <div class="flex-1">{{ description }}</div>
                                    </li>
                                  {% endfor %}
                                </ul>
                              {% endif %}
                            </div>
                          </button>
                        {% endif %}
                      {% endfor %}
                    {% endfor %}
                  {% else %}{% comment %}remove once subscription frequency options metafield entries are complete{% endcomment %}
                    {% for selling_plan_allocation in filter_product_variant.selling_plan_allocations %}
                      {% assign frequency_option_name = forloop.index | prepend: 'Option ' %}
                      <button
                        data-selected="false" 
                        data-selling-plan-id="{{ selling_plan_allocation.selling_plan.id }}" 
                        data-variant="{{ filter_product_variant.id }}" 
                        data-quantity="{% if filter_object.quantity != blank %}{{ filter_object.quantity }}{% else %}1{% endif %}"
                        data-frequency="{{ selling_plan_allocation.selling_plan.options[0].value | downcase }}"
                        {% if filter_product_variant.available == false %}disabled{% endif %} 
                        class="subscription-quiz__selection subscription-quiz__selection--frequency flex flex-col border border-blue-darkSky relative {% if frequency_option_name == recommended_frequency_option %}recommended{% endif %} disabled:opacity-50 disabled:cursor-not-allowed" 
                        js-quiz-subscription-frequency>
                        <div class="subscription-quiz-frequency__heading w-full p-md flex justify-center items-center gap-xxs border-b border-blue-darkSky">
                          <span class="subscription-quiz-frequency__checkbox w-[18px] min-w-[18px] h-[18px] border border-blue rounded-full relative"></span>
                          <span class="subscription-quiz-frequency__title p1">
                            Every {{ selling_plan_allocation.selling_plan.options[0].value }}
                          </span>
                        </div>
                        <div class="subscription-quiz-frequency__description w-full p-md text-left flex-1">
                          {% assign description_handle = forloop.index | prepend: 'frequency_option_' | append: '_description' %}
                          {% if filter_object[description_handle] != blank %}
                            {% assign description_list = filter_object[description_handle] %}
                            <div class="p3">This option is great for:</div>
                            <ul class="subscription-quiz-frequency__description-list">
                              {% for description_line in description_list.value %}
                                {% assign description = description_line %}
                                <li class="mt-sm flex justify-start items-center gap-xxxs">
                                  {% if description_line contains '|' %}
                                    {% assign description = description_line | split: '|' | last | strip %}
                                    {% assign description_icon_file = description_line | split: '|' | first | strip %}
                                    {% assign description_icon_file_object = images[description_icon_file] %}
                                    {% if description_icon_file_object != blank %}
                                      <div class="w-[24px]">{% render 'lazy-image' image: description_icon_file_object loading: 'easy' %}</div>
                                    {% endif %}
                                  {% endif %}
                                  <div class="flex-1">{{ description }}</div>
                                </li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </div>
                      </button>
                    {% endfor %}{% comment %}remove once subscription frequency options metafield entries are complete{% endcomment %}
                  {% endif %}
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% endfor %}

      <form action="{{ routes.cart_url }}" class="subscription-quiz__checkout-form flex flex-col items-center gap-lg pb-xxl pt-lg desktop:pt-xl" js-quiz-subscription-frequncy-form>
        <div class="flex justify-center items-center gap-xs">
          <input type="checkbox" id="SubscriptionQuizCheckoutCheckkbox" autocomplete="off" required />
          <label for="SubscriptionQuizCheckoutCheckkbox">I agree to Blueair's <a href="{{ section.settings.policy_link }}">Filter Subscription Terms of Use*</a></label>
        </div>
        <button type="submit" class="btn btn--blue-rounded disabled:opacity-30" js-quiz-subscription-frequncy-form-submit-btn>
          <span class="btn__text">Go to Checkout</span>
          <span class="btn__arrow">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span>
        </button>
        <p class="tag-small -mt-md hidden text-center" js-quiz-subscription-submit-error></p>
      </form>
    </div>
  </div>
</subscription-quiz>

{% schema %}
{
  "name": "Subscription Quiz",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Step 1"
    },
    {
      "type": "text",
      "id": "step_1_heading",
      "label": "Heading",
      "default": "How to choose the right replacement filter"
    },
    {
      "type": "header",
      "content": "Step 2"
    },
    {
      "type": "text",
      "id": "step_2_heading",
      "label": "Heading",
      "default": "Select Your Air Purifier"
    },
    {
      "type": "header",
      "content": "Step 3"
    },
    {
      "type": "text",
      "id": "step_3_heading",
      "label": "Heading",
      "default": "Select a Filter"
    },
    {
      "type": "header",
      "content": "Step 4"
    },
    {
      "type": "text",
      "id": "step_4_heading",
      "label": "Heading",
      "default": "Select a Shipment Frequency"
    },
    {
      "type": "header",
      "content": "Filter Subscription Policy Link"
    },
    {
      "type": "url",
      "id": "policy_link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "name": "Family",
      "type": "family",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "metaobject_list",
          "metaobject_type": "subscription_quiz_series",
          "id": "series",
          "label": "Series"
        }
      ]
    }
  ]
}
{% endschema %} 