{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

{% if section.settings.enable_clickable_url and section.settings.cta_url != blank %}
  <a href="{{ section.settings.cta_url }}" class="section__promo-banner {{ margins_paddings }} flex justify-center items-center mx-auto" style="background-color: {{ section.settings.background_color }}; max-width: {{ section.settings.section_max_width }};">
{% else %}
  <div
    class="section__promo-banner {{ margins_paddings }} flex justify-center items-center mx-auto"
    style="
      {% if section.settings.background_color != blank %}
        background-color: {{ section.settings.background_color }};
      {% endif %}
      {% if section.settings.background_test_color != blank %}
        background-color: {{ section.settings.background_test_color }};
      {% endif %}
      max-width: {{ section.settings.section_max_width }};"
  >
{% endif %}
  
  {% if section.settings.image_mobile != blank or section.settings.image_desktop != blank %}
    <div class="promo-banner__image" style="{% if section.settings.image_mobile_max_width != blank %} --mobile-max-width: {{ section.settings.image_mobile_max_width }}; {% endif %}{% if section.settings.image_desktop_max_width != blank %} --desktop-max-width: {{ section.settings.image_desktop_max_width }};{% endif %}">
      {% if section.settings.image_mobile != blank and section.settings.image_desktop != blank %}
        {% render 'lazy-image', image: section.settings.image_mobile, image_desktop: section.settings.image_desktop, img_classes:'object-cover h-auto' %}
      {% elsif section.settings.image_mobile != blank %}
        {% render 'lazy-image', image: section.settings.image_mobile, img_classes:'object-cover h-auto' %}
      {% elsif section.settings.image_desktop != blank %}
        {% render 'lazy-image', image: section.settings.image_desktop, img_classes:'object-cover h-auto' %}
      {% endif %}
    </div>
  {% endif %}

{% if section.settings.enable_clickable_url and section.settings.cta_url != blank %}
  </a>
{% else %}
  </div>
{% endif %}


