{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

<div class="hero_2 {{ margins_paddings }} relative px-md overflow-hidden {{ section.settings.color }} tabletl:px-xl">
    <div class="flex mx-auto gap-xxxxl justify-between items-center tabletl:max-w-[var(--max-width-desktop)]" style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
        <div class="hero_content-container z-[1] flex-1 tabletl:max-w-[var(--max-width-content-desktop)]"  style="--max-width-content-desktop: {{ section.settings.max_width_content_desktop }};">
            {% if section.settings.title != blank %}
                <h1 class="hero__title {{ section.settings.title_style }} mb-lg text-center tabletl:text-left">{{ section.settings.title }}</h1>
            {% endif %}
            {% if section.blocks.size > 0 %}
                <div class="text-container">
                    {% for block in section.blocks %}
                        <div class="text-container flex flex-col gap-md text-center justify-center items-center tabletl:text-left tabletl:flex-row tabletl:justify-start tabletl:gap-md">
                            {% if block.settings.icon != blank %}
                                <div class="icon w-[64px]">
                                    {% render 'lazy-image' image:block.settings.icon %}
                                </div>
                            {% endif %}
                            {% if block.settings.text != blank %}
                                <p class="font-900 {{ block.settings.text_style }}">{{ block.settings.text }}</p>
                            {% endif %}
                        </div>
        
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        {% if section.settings.image_desktop != blank %}
            <div class="image-container__desktop z-[1] w-[312px] hidden tabletl:block">
                {% render 'lazy-image' image:section.settings.image_desktop %}
            </div>
        {% endif %}
    </div>


    {% if section.settings.background_image_desktop != blank %}
        <div class="background-image-container__desktop absolute right-[-80px] top-xl hidden tabletl:block">
            {% render 'lazy-image' image:section.settings.background_image_desktop %}
        </div>
    {% endif %}
</div>

