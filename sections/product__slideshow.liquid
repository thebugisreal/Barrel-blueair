{% capture margins_paddings %}
    {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}

{%- capture carousel_options -%}
{
    "cssMode": true,
    "loop": false,
    "autoHeight": false,
    "scrollbar": {
        "el": "[js-scrollbar-{{section.id}}]",
        "hide": false,
        "draggable": true
    },
    "navigation": {
        "enabled": true,
        "nextEl": ".swiper-button-next--{{section.id}}",
        "prevEl": ".swiper-button-prev--{{section.id}}"
    }
}
{%- endcapture -%}

{% if product.metafields.seed.pdp_slideshow_slides != blank %}
    <div class="product__slideshow {{ margins_paddings }} px-[30px] {{ section.settings.color }}">
        <div class="mx-auto grid grid-cols-1 tabletl:max-w-[var(--max-width-desktop)]"  style="--max-width-desktop: {{ section.settings.max_width_desktop }};">
            <s-carousel class="block" data-options='{{carousel_options}}'>
                <div id="Slideshow-{{ section.id }}" class="swiper w-full max-w-full" js-carousel>
                    <div class="swiper-wrapper">
                        {% for slide in product.metafields.seed.pdp_slideshow_slides.value %}
                            <div class="swiper-slide" js-carousel-slide>
                                {% if slide.image != blank %}
                                    <div class="image-container max-w-[120px] mx-auto mb-[48px] tabletl:mb-[40px]">
                                        {% render 'lazy-image' image:slide.image, image_desktop:slide.image_desktop %}
                                    </div>
                                {% endif %}
                                <div class="text-content text-center">
                                    {% if slide.quote != blank %}
                                        <h3 class="mb-lg tabletl:mb-[40px]">{{ slide.quote }}</h3>
                                    {% endif %}
                                    {% if slide.text != blank %}
                                        <p class="s2 font-900">{{ slide.text }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="swiper-nav-container py-8 flex gap-24 items-center mt-[40px] tabletl:mt-xxl">
                        <div class="swiper-button-prev--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--prev">{{ 'icon-arrow-left.svg' | inline_asset_content }}</span></div>
                        <div class="swiper-scrollbar !relative !left-0 !bottom-0" js-scrollbar-{{section.id}}></div>
                        <div class="swiper-button-next--{{ section.id }} w-[40px] btn"><span class="swiper-button-icon btn__arrow border-0 swiper-button-icon--next">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span></div>
                    </div>
                </div>
            </s-carousel>
        </div>
    </div>
{% endif %}

