{% capture margins_paddings %}
  {{ section.settings.margin_top_mobile }} {{ section.settings.margin_bottom_mobile }} {{ section.settings.padding_top_mobile }} {{ section.settings.padding_bottom_mobile }} {{ section.settings.margin_top_desktop }} {{ section.settings.margin_bottom_desktop }} {{ section.settings.padding_top_desktop }} {{ section.settings.padding_bottom_desktop }}
{% endcapture %}
{% liquid
  assign quote_card_count = 0

  for block in section.blocks
    if block.settings.quote != blank or block.settings.name != blank or block.settings.title != blank or block.settings.image != blank or block.settings.icon != blank
      assign quote_card_count = quote_card_count | plus: 1
    endif
  endfor
%}

{% if quote_card_count > 0 %}
  {%- capture carousel_options -%}
    {
      "slidesPerView": "auto",
      "spaceBetween": 16,
      "loop": false,
      "grabCursor": true,
      "slidesOffsetBefore": 24,
      "slidesOffsetAfter": 24,
      {% if section.settings.show_scrollbar %}
      "scrollbar": {
        "el": "[js-scrollbar-{{ section.id }}]",
        "hide": false,
        "draggable": true
      },
      {% endif %}
      "keyboard": {
        "enabled": true,
        "onlyInViewport": true
      },
      "breakpoints": {
        "1025": {
          "spaceBetween": 57,
          "slidesOffsetBefore": 64,
          "slidesOffsetAfter": 64
        }
      }
    }
  {%- endcapture -%}

  <div class="section__quote-carousel block w-full {{ margins_paddings }} {{ section.settings.color }}">
    <div class="quote-carousel__inner">
      {% if section.settings.eyebrow != blank or section.settings.title != blank %}
        <header class="quote-carousel__header">
          {% if section.settings.eyebrow != blank %}
            <p class="quote-carousel__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.title != blank %}
            {% liquid
              assign quote_carousel_heading_id = 'QuoteCarouselHeading-' | append: section.id
              assign title_tag = 'h2'
              assign title_options = 'h1,h2,h3,h4,h5,h6'

              if title_options contains section.settings.title_style
                assign title_tag = section.settings.title_style
              endif
            %}
            <{{ title_tag }}
              id="{{ quote_carousel_heading_id }}"
              class="quote-carousel__title {{ section.settings.title_style }}"
            >
              {{ section.settings.title | escape }}
            </{{ title_tag }}>
          {% endif %}
        </header>
      {% endif %}
    </div>

    <div class="quote-carousel__content">
      <s-carousel
        class="block"
        role="region"
        aria-roledescription="{{ 'sections.quote_carousel.roledescription' | t }}"
        {% if section.settings.title != blank %}
        aria-labelledby="{{ quote_carousel_heading_id }}"
        {% else %}
        aria-label="{{ 'sections.quote_carousel.region' | t }}"
        {% endif %}
        data-options='{{ carousel_options }}'
      >
        <div
          id="QuoteCarousel-{{ section.id }}"
          class="swiper w-full max-w-full"
          js-carousel
        >
          <div class="swiper-wrapper">
            {% assign quote_slide_index = 0 %}
            {% for block in section.blocks %}
              {% liquid
                assign block_has_content = false

                if block.settings.quote != blank or block.settings.name != blank or block.settings.title != blank or block.settings.image != blank or block.settings.icon != blank
                  assign block_has_content = true
                endif
              %}

              {% if block_has_content %}
                {% assign quote_slide_index = quote_slide_index | plus: 1 %}
                <div
                  class="swiper-slide h-auto"
                  js-carousel-slide
                  role="group"
                  aria-roledescription="{{ 'sections.quote_carousel.slide_roledescription' | t }}"
                  aria-label="{{ 'sections.quote_carousel.slide' | t: index: quote_slide_index, count: quote_card_count }}"
                >
                  {% render 'quote-card',
                    block: block,
                    quote_typography: section.settings.quote_typography,
                    name_typography: section.settings.name_typography,
                    role_typography: section.settings.role_typography
                  %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </s-carousel>
    </div>

    {% if section.settings.show_scrollbar %}
      <div class="quote-carousel__inner">
        <div class="quote-carousel__nav">
          <div
            class="quote-carousel__scrollbar swiper-scrollbar"
            js-scrollbar-{{ section.id }}
            aria-hidden="true">
          </div>
        </div>
      </div>
    {% endif %}
  </div>
{% endif %}

