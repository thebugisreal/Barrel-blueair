<div class="room-icon relative bg-blue-light" style="min-width: {{ width }}; width: {{ width }}; height: {{ width }};">
  {% case size %}
    {% when 'small' %}
      <div class="absolute bottom-0 right-0 w-[38%] h-[38%] bg-blue"></div>
    {% when 'medium' %}
      <div class="absolute bottom-0 right-0 w-[60%] h-[60%] bg-blue"></div>
    {% when 'large' %}
      <div class="absolute bottom-0 right-0 w-3/4 h-3/4 bg-blue"></div>
    {% when 'extralarge' %}
      <div class="absolute bottom-0 right-0 w-full h-full bg-blue"></div>
  {% endcase %}
</div>