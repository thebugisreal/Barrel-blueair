{%- assign current_template = template | split: '.' | first -%}
{%- assign class = class | default: 'fs-body-75' -%}

<nav class="breadcrumbs flex ff-body {{ class }}" role="navigation" aria-label="{{ 'general.navigation.breadcrumbs' | t }}">
  {%- if show_breadcrumbs -%}
    <ol class="breadcrumbs__list list-none">
      {%- unless current_template == 'product' and collection.url -%}
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a>
          <div class="breadcrumbs__icon">/</div>
        </li>
      {%- endunless -%}
      {%- case current_template -%}
        {%- when 'product' -%}
          {%- if collection.url -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ collection.url }}">{{ collection.title }}</a>
              <div class="breadcrumbs__icon">/</div>
            </li>
          {%- endif -%}
          <li class="breadcrumbs__item">
            <span class="breadcrumbs__current" aria-current="page">{{ product.title }}</span>
          </li>
        {%- when 'collection' -%}
          {%- if collection.handle -%}
            {%- if current_tags -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ collection.url }}">{{ collection.title }}</a>
                <div class="breadcrumbs__icon">/</div>
              </li>
              <li class="breadcrumbs__item">
                <span class="breadcrumbs__current" aria-current="page">{{- current_tags | join: ' + ' -}}</span>
              </li>
            {%- else -%}
              <li class="breadcrumbs__item">
                <span class="breadcrumbs__current" aria-current="page">{{ collection.title }}</span>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- when 'blog' -%}
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ blog.url }}">{{ blog.title }}</a>
            {% if current_tags %}
              <div class="breadcrumbs__icon">/</div>
            {% endif %}
          </li>
          {% if current_tags %}
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__current" aria-current="page">{{ current_tags }}</span>
            </li>
          {% endif %}
        {%- when 'article' -%}
          {%- if blog.url -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ blog.url }}">{{- blog.title -}}</a>
              <div class="breadcrumbs__icon">/</div>
            </li>
          {%- endif -%}
          <li class="breadcrumbs__item">
            <span class="breadcrumbs__current" aria-current="page">{{ article.title | truncate: 40 }}</span>
          </li>
      {%- endcase -%}
    </ol>
  {%- endif -%}

  {%- if show_navigation_buttons -%}
    <ol class="navigation-buttons__list">
      {%- if collection.previous_product -%}
        <li class="navigation-buttons__item">
          {{ 'general.navigation.previous' | t | link_to: collection.previous_product }}
        </li>
      {%- endif -%}
      {%- if collection.next_product -%}
        <li class="navigation-buttons__item">
          {{ 'general.navigation.next' | t | link_to: collection.next_product }}
        </li>
      {%- endif -%}
    </ol>
  {%- endif -%}
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement":
    [
      {
        "@type": "ListItem",
        "position": 1,
        "item":
        {
          "@id": {{ routes.root_url | prepend: shop.url | json }},
          "name": {{ 'general.navigation.home' | t | json }}
        }
      },
      {%- case current_template -%}
        {%- when 'product' -%}
          {%- if collection.url -%}
            {
              "@type": "ListItem",
              "position": 2,
              "item":
              {
                "@id": {{ collection.url | prepend: shop.url | json }},
                "name": {{ collection.title | json }}
              }
            },
          {%- endif -%}
          {
            "@type": "ListItem",
            "position": {%- if collection.url -%}3{%- else -%}2{%- endif -%},
            "item":
            {
              "@id": {{ product.url | prepend: shop.url | json }},
              "name": {{ product.title | json }}
            }
          }
        {%- when 'collection' -%}
          {%- if collection.handle -%}
            {%- if current_tags -%}
              {
                "@type": "ListItem",
                "position": 2,
                "item":
                {
                  "@id": {{ collection.url | prepend: shop.url | json }},
                  "name": {{ collection.title | json }}
                }
              },
              {
                "@type": "ListItem",
                "position": 3,
                "item":
                {
                  "@id": {{ collection.url | prepend: shop.url | json }},
                  "name": {{ current_tags | join: ' + ' | json }}
                }
              }
            {%- else -%}
              {
                "@type": "ListItem",
                "position": 2,
                "item":
                {
                  "@id": {{ collection.url | prepend: shop.url | json }},
                  "name": {{ collection.title | json }}
                }
              }
            {%- endif -%}
          {%- endif -%}
        {%- when 'article' -%}
          {
            "@type": "ListItem",
            "position": 2,
            "item":
              {
                "@id": {{ blog.url | prepend: shop.url | json }},
                "name": {{ blog.title | json }}
              }
          },
          {
            "@type": "ListItem",
            "position": 3,
            "item":
              {
                "@id": {{ article.url | prepend: shop.url | json }},
                "name": {{ article.title | json }}
              }
          }
      {%- endcase -%}
    ]
  }
</script>
