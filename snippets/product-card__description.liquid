{% liquid
  assign current_variant = product.selected_or_first_available_variant

  if shop.permanent_domain == '5ef43d-4a.myshopify.com'  
      assign transactional_countries = 'US,CA' | split: ',' 
      assign is_transactional = false 
      assign current_country = localization.country.iso_code | upcase 
      for country in transactional_countries 
          if country == current_country 
            assign is_transactional = true 
            break 
          endif 
        endfor 
  elsif shop.permanent_domain == 'blueeudev.myshopify.com' 
      assign transactional_countries = 'DE' | split: ',' 
      assign is_transactional = false 
      assign current_country = localization.country.iso_code | upcase 
      for country in transactional_countries 
          if country == current_country 
            assign is_transactional = true 
            break 
          endif 
        endfor 
  endif  
  %}

<div class="product-card__description p-md bg-white">
    <div class="product-card__tags min-h-[28px] mb-xxs flex justify-center gap-x-xs gap-y-xxs flex-wrap">
      <span class="product-card__tag product-card__tag--gray bg-gray {% if current_variant.available %}hidden{% endif %} text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]" >Out of Stock</span>
      {% if is_transactional %}
        {% if localization.country.iso_code == 'CA' %}
          {% if product.metafields.seed.product_tags_canada != blank %}
              {% for tag in product.metafields.seed.product_tags_canada.value %}
                  <span class="product-card__tag {% if product.metafields.seed.product_card_tag_style_canada == 'White fill' %}product-card__tag--white{% else %}product-card__tag--blue{% endif %} text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]">{{ tag }}</span>
              {% endfor %}
          {% endif %}
        {% else %}
          {% for tag in product.metafields.seed.product_tags.value %}
            <span class="product-card__tag {% if product.metafields.seed.product_card_tag_style == 'White fill' %}product-card__tag--white{% else %}product-card__tag--blue{% endif %} text-12 leading-[12px] font-500 py-xxs px-xs rounded-[60px]">{{ tag }}</span>
          {% endfor %}
        {% endif %}
      {% endif %}
    </div>

    <a href="{{ product.url }}" class="product-card__title s1 block text-center !no-underline mb-md">
      {% render 'product-title-intl', product: product %}
    </a>

    <div class="product-card__image mb-lg">
        {% render 'lazy-image' image: product.featured_image %}
    </div>
    {% if product.metafields.seed.pdp_additional_descriptions != blank %}
        <ul class="product__additional-descriptions flex flex-col gap-md">
            {% for description in product.metafields.seed.pdp_additional_descriptions.value %}
                <li class="product__additional-description text-center">
                    {%  liquid 
                        assign title = description | split: ':' | first
                        assign desc = description | split: ':' | last
                    %}
                    <p class="s2 font-900">{{ title }}</p>
                    <p class="p2 font-400">{{ desc }}</p>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>