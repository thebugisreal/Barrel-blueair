{% assign filter_subscriptions = filter_subscription.filter_subscriptions.value %}
{% assign subscription_selected = true %}
{% assign airpurifier_type_two_pack = false %}
{% if filter_subscription.pdp_type == 'Filter' %}
  {% assign pdp_type = 'filter' %}
{% elsif filter_subscription.pdp_type == 'Air Purifier + Filter' %}
  {% assign pdp_type = 'airpurifier_and_filter' %}
  {% if filter_subscription.two_pack_quantity_override.value == false or filter_subscription.two_pack_quantity_override.value == true %}
    {% if filter_subscription.two_pack_quantity_override.value == true %}
      {% assign airpurifier_type_two_pack = true %}
    {% endif %}
  {% else %}
    {% for filter_product in filter_subscriptions %}
      {% if filter_product.variants[1].selling_plan_allocations.size > 0 and filter_product.metafields.seed.quantity_option.value contains '2 Pack | 2' %}
        {% assign airpurifier_type_two_pack = true %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% else %}
  {% assign pdp_type = '2in1_purify_humidify' %}
  {% assign scent_subscriptions = filter_subscription.scent_subscriptions.value %}
{% endif %}
{% assign subscription_discount_amount = shop.metafields.custom.subscription_discount_amount | times: 100 %}

<div class="product__subscription-container flex flex-col {% if is_quick_view %}gap-[6px] mt-sm mb-sm{% else %}gap-[12px]{% endif %} {% if product.variants.size > 1 or is_additional %}mt-md{% elsif is_additional %}mt-sm{% endif %}">
  <div class="product__subscription group {% if is_additional %}product__subscription--additional {% endif %}border border-gray rounded-[16px] relative data-[selected=true]:border-primary {% if is_quick_view %}mt-[11px]{% else %}mt-[9px]{% endif %}" data-type="{{ pdp_type }}" data-selected="{% if subscription_selected %}true{% else %}false{% endif %}" js-subscription {% if is_additional %}js-additional-subscription {% endif %}{% if airpurifier_type_two_pack %}is-airpurifier-type-two-pack {% endif %}>
    <button type="button" class="product-subscription__toggle {% if is_quick_view %}px-[10px] py-[16px] gap-[7px]{% else %}px-[24px] py-[16px] gap-[12px]{% endif %} group-data-[selected=true]:pb-[12px] flex items-center w-full disabled:opacity-30 disabled:cursor-not-allowed" js-subscription-toggle {% if is_additional %}js-additional-subscription-toggle{% endif %}>
      <div class="checkbox bg-white w-[16px] min-w-[16px] h-[16px] border border-primary rounded-full p-[3px] flex justify-center items-center [&_svg]:!fill-transparent">
        {{ 'icon-check.svg' | inline_asset_content }}
      </div>
      <div class="{% if is_quick_view %}p3{% else %}text-[13px] leading-[21px]{% endif %} font-[600] text-left text-primary flex flex-col gap-[4px]">
        {% if filter_subscription.subscription_button_label_override != blank %}
          {{ filter_subscription.subscription_button_label_override }}
        {% else %}
          {% if pdp_type == 'filter' %}
            Subscribe + Save
          {% elsif pdp_type == 'airpurifier_and_filter' %}
            {% if filter_subscription.name contains 'Humidifier' %}
              Humidifier + Filter Subscription
            {% else %}
              Air Purifier + Filter Subscription
            {% endif %}
          {% else %}
            2-in-1 Purify + Humidify + Filter Subscription
          {% endif %}
        {% endif %}
        {% if filter_subscription.subscription_options.value.size %}
          <ul class="flex flex-wrap gap-[4px] w-full">
            {% for option in filter_subscription.subscription_options.value %}
              {% if option.icon != blank or option.text != blank %}
                <li class="flex items-center gap-[4px] px-[10px] py-[6px] bg-blue-darkSky rounded-full">
                  {% if option.icon != blank %}
                    <div class="w-[12px] h-[12px] flex items-center justify-center shrink-0">
                      {{ option.icon | image_url: width: 24 | image_tag: width: option.icon.width, height: option.icon.height, loading: 'lazy' }}
                    </div>
                  {% endif %}
                  {% if option.text != blank %}
                    <span class="p6 leading-none capitalize {% unless is_quick_view %}desktop:font-[600]{% endunless %}">{{ option.text }}</span>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
      <div class="product-subscription__price-wrapper {% if is_quick_view %}p3{% else %}text-[13px] leading-[21px]{% endif %} text-primary flex-1 flex flex-wrap flex-col justify-end items-end gap-x-xxxs gap-y-0 py-[4px]" {% if pdp_type == 'filter' %}js-subscription-price {% endif %}>
        {% if pdp_type != 'filter' %}
          {% if product.metafields.seed.filter_subscription_discount != blank and filter_subscription_discounted_price != blank %}
            <s class="product__price product__price--compare font-400 order-1 text-primary {% if is_quick_view %}p4{% else %}text-[13px] leading-[21px]{% endif %}">{{ current_variant.price | money }}</s>
            <span class="product__price product__price--current font-[600] {% if is_quick_view %}p3{% else %}text-[13px] leading-[21px]{% endif %}" js-discount-subscription-price>{{ filter_subscription_discounted_price | money }}</span>
          {% elsif current_variant.compare_at_price > current_variant.price %}
            <s class="product__price product__price--compare font-400 order-1 text-primary {% if is_quick_view %}p4{% else %}text-[13px] leading-[21px]{% endif %}">{{ current_variant.compare_at_price | money }}</s>
            <span class="product__price product__price--current font-[600] {% if is_quick_view %}p3{% else %}text-[13px] leading-[21px]{% endif %}" js-discount-subscription-price>{{ current_variant.price | money }}</span>
          {% else %}
            <span class="product__price product__price--current font-[600] {% if is_quick_view %}p3{% else %}text-[13px] leading-[21px]{% endif %}" js-discount-subscription-price>{{ current_variant.price | money }}</span>
          {% endif %}
        {% endif %}
      </div>
    </button>
    <div class="product-subscription__content {% if is_quick_view %}px-[10px]{% else %}px-xs desktop:px-md{% endif %} transition-[max-height] duration-500">
      {% if filter_subscription.description_1_bullets != blank or filter_subscription.description_2_bullets != blank %}
        <div class="product-subscription__description-container border-t border-gray pt-[16px] flex gap-[12px]">
          {%- for i in (1..2) -%}
            {%- assign description_title_handle = 'description_' | append: i | append: '_title' -%}
            {%- assign description_bullets_handle = 'description_' | append: i | append: '_bullets' -%}
            {%- if filter_subscription[description_bullets_handle] != blank -%}
              <div class="product-subscription__description flex-1">
                {% assign show_selling_plan = false %}
                {% for filter_product in filter_subscriptions %}
                  {% assign filter_variant = filter_product.variants[0] %}
                  {% if pdp_type == 'airpurifier_and_filter' %}
                    {% if filter_product.variants[1].title contains 'subscription' or filter_product.variants[1].title contains 'Subscription' %}
                      {% assign filter_variant = filter_product.variants[1] %}
                    {% endif %}
                  {% endif %}
                  {% if filter_variant.selling_plan_allocations.size > 0 %}
                    {% assign show_selling_plan = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                {% if show_selling_plan and i == 2 %}
                  <div class="product-subscription-description__title text-primary text-[11px] font-[600] leading-[16px] capitalize" js-selling-plan-copy></div>
                {% elsif filter_subscription[description_title_handle] != blank %}
                  <div class="product-subscription-description__title text-primary text-[11px] font-[600] leading-[16px] capitalize">
                    {{ filter_subscription[description_title_handle] }}
                  </div>
                {% endif %}
                <ul class="product-subscription-description__bullets mt-[4px]"{% if is_quick_view %} style="display: block!important;"{% endif %}>
                  {% if product.metafields.seed.pdp_filter_quantity != blank %}
                    <li class="product-subscription-description__bullet flex items-center text-primary text-[11px] leading-[16px]">
                      <div>
                        <span js-filter-subscription-quantity-label>1 Replacement Filter</span> every <span js-filter-subscription-quantity-duration> 6 months</span>
                      </div>
                    </li>
                  {% endif %}
                  {% for bullet in filter_subscription[description_bullets_handle].value %}
                    <li class="product-subscription-description__bullet flex items-center text-primary text-[11px] leading-[16px]">{{ bullet }}</li>
                  {% endfor %}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {% endif %}
      <div class="product-subscription__filter-subscriptions py-[12px] border-t border-gray {% if pdp_type == '2in1_purify_humidify' %}hidden{% endif %}">
        {% if pdp_type == 'filter' %}
          <input type="hidden" disabled name="id" value="" js-filter-subscription-selected-variant-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="selling_plan" value="" js-filter-subscription-selected-variant-selling-plan-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="properties[_Frequency]" value="" js-filter-subscription-frequency-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="properties[_frequency_integer]" value="" js-filter-subscription-frequency-integer-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="properties[First Order Date]" value="" js-filter-subscription-first-order-date-input js-filter-subscription-form-input>
        {% elsif pdp_type == 'airpurifier_and_filter' %}
          <input type="hidden" disabled name="properties[_unitSubscriptionTempId]" value="" js-filter-subscription-temp-id-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="items[1][id]" value="" js-filter-subscription-selected-variant-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="items[1][selling_plan]" value="" js-filter-subscription-selected-variant-selling-plan-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="items[1][properties[_Frequency]]" value="" js-filter-subscription-frequency-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="items[1][properties[_frequency_integer]]" value="" js-filter-subscription-frequency-integer-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="items[1][properties[First Order Date]]" value="" js-filter-subscription-first-order-date-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="items[1][properties[_unitSubscriptionTempId]]" value="" js-filter-subscription-temp-id-input js-filter-subscription-form-input>
          <input type="hidden" disabled name="items[1][properties[_og_first_order_place_date]]" value="" js-filter-subscription-og-date-input js-filter-subscription-form-input>
          {% if airpurifier_type_two_pack %}
            <input type="hidden" disabled name="items[1][quantity]" value="2" js-filter-subscription-two-pack-quantity-input js-filter-subscription-form-input>
            <input type="hidden" disabled name="items[1][properties[_two_pack]]" value="true" js-filter-subscription-two-pack-boolean-input js-filter-subscription-form-input>
          {% endif %}
        {% else %}
          <input type="hidden" disabled name="properties[_unitSubscriptionTempId]" value="" js-filter-subscription-temp-id-input js-filter-subscription-form-input>
          {% assign counter = 0 %}
          {% for filter_product in filter_subscriptions %}
            {% assign counter = counter | plus: 1 %}
            <input type="hidden" disabled name="items[{{ counter }}][id]" value="" data-index="{{ counter }}" js-filter-subscription-selected-variant-input js-filter-subscription-form-input js-2-in-1-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][selling_plan]" value="" js-filter-subscription-selected-variant-selling-plan-input js-filter-subscription-form-input js-2-in-1-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[_Frequency]]" value="" js-filter-subscription-frequency-input js-filter-subscription-form-input js-2-in-1-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[_frequency_integer]]" value="" js-filter-subscription-frequency-integer-input js-filter-subscription-form-input js-2-in-1-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[First Order Date]]" value="" js-filter-subscription-first-order-date-input js-filter-subscription-form-input js-2-in-1-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[_unitSubscriptionTempId]]" value="" js-filter-subscription-temp-id-input js-filter-subscription-form-input js-2-in-1-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[_og_first_order_place_date]]" value="" js-filter-subscription-og-date-input js-filter-subscription-form-input js-2-in-1-subscription-form-input>
          {% endfor %}
          {% if scent_subscriptions != blank and scent_subscriptions.count != 0 %}
            {% assign counter = counter | plus: 1 %}
            {% assign scent_index = counter %}
            <input type="hidden" disabled name="items[{{ counter }}][id]" value="" data-index="{{ counter }}" js-filter-subscription-selected-variant-input js-filter-subscription-form-input js-scent-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][selling_plan]" value="" js-filter-subscription-selected-variant-selling-plan-input js-filter-subscription-form-input js-scent-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[_Frequency]]" value="" js-filter-subscription-frequency-input js-filter-subscription-form-input js-scent-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[_frequency_integer]]" value="" js-filter-subscription-frequency-integer-input js-filter-subscription-form-input js-scent-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[First Order Date]]" value="" js-filter-subscription-first-order-date-input js-filter-subscription-form-input js-scent-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[_unitSubscriptionTempId]]" value="" js-filter-subscription-temp-id-input js-filter-subscription-form-input js-scent-subscription-form-input>
            <input type="hidden" disabled name="items[{{ counter }}][properties[_og_first_order_place_date]]" value="" js-filter-subscription-og-date-input js-filter-subscription-form-input js-scent-subscription-form-input>
          {% endif %}
        {% endif %}
        <div class="filter-subscriptions">
          {% if pdp_type == '2in1_purify_humidify' %}
            {% if scent_subscriptions != blank and scent_subscriptions.count != 0 %}
              <div class="{% if is_quick_view %}p3 my-xxxs{% else %}p6 font-700 mb-xxxs mt-sm{% endif %}">Select Scent</div>
              <div class="filter-subscriptions__filters flex flex-col gap-xxxs desktop:flex-row desktop:flex-wrap desktop:gap-xxs">
                {% assign scent_count = 0 %}
                {% for scent_product in scent_subscriptions %}
                  {% assign scent_variant = scent_product.variants[0] %}
                  {% if scent_product.variants[1].title contains 'subscription' or scent_product.variants[1].title contains 'Subscription' %}
                    {% assign scent_variant = scent_product.variants[1] %}
                  {% endif %}

                  {% if scent_variant.selling_plan_allocations.size > 0 %}
                    {% assign scent_count = scent_count | plus: 1 %}
                    {% if scent_count == 1 %}
                      {% assign scent_current_on_load = true %}
                    {% else %}
                      {% assign scent_current_on_load = false %}
                    {% endif %}

                    {% comment %} Build selling plan ID data attributes for this scent variant {% endcomment %}
                    {% assign selling_plan_data_attrs = '' %}
                    {% for selling_plan_allocation in scent_variant.selling_plan_allocations %}
                      {% assign plan_frequency_text = selling_plan_allocation.selling_plan.options[0].value | downcase | strip %}
                      {% assign plan_frequency = plan_frequency_text | replace: 'months', '' | strip | plus: 0 %}
                      {% assign selling_plan_data_attrs = selling_plan_data_attrs | append: ' data-selling-plan-' | append: plan_frequency | append: '="' | append: selling_plan_allocation.selling_plan.id | append: '"' %}
                    {% endfor %}

                    <button type="button" class="filter-subscription__variant {% if is_quick_view %}py-[10px] pl-[16px] pr-[12px]{% else %}p-xxs{% endif %} border border-gray rounded-[2px] flex justify-between items-center gap-sm desktop:block desktop:flex-1" {% if scent_current_on_load %}current-on-load {% endif %} data-index="{{ scent_index }}" data-selected="false" data-variant="{{ scent_variant.id }}" data-available="{{ scent_variant.available }}"{{ selling_plan_data_attrs }} js-filter-subscription-variant js-scent-subscription-variant>
                      <div class="{% if is_quick_view %}p3{% else %}p4 font-500{% endif %}">
                        {% if scent_product.metafields.seed.filter_subscription_label != blank %}
                          {{ scent_product.metafields.seed.filter_subscription_label }}
                        {% else %}
                          {{ scent_product.variants[0].title }}
                        {% endif %}
                      </div>
                      <div class="flex justify-center gap-xxs {% if is_quick_view %}p3{% else %}p6{% endif %}" js-price-copy data-label-price="{{ scent_product.variants[0].selling_plan_allocations[0].price }}" data-label-price-compare-at="{{ scent_product.variants[0].selling_plan_allocations[0].compare_at_price }}" data-price="{{ scent_variant.selling_plan_allocations[0].price }}" data-price-compare-at="{{ scent_variant.selling_plan_allocations[0].compare_at_price }}">
                        {% assign label_quantity = 1 %}
                        {% if scent_product.variants[0].selling_plan_allocations[0].compare_at_price > scent_product.variants[0].selling_plan_allocations[0].price %}
                          <s>{{ scent_product.variants[0].selling_plan_allocations[0].compare_at_price | times: label_quantity | money }}</s>
                        {% endif %}
                        <span class="font-700">{{ scent_product.variants[0].selling_plan_allocations[0].price | times: label_quantity | money }}</span>
                      </div>
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            <div class="{% if is_quick_view %}p3 mt-[22px] mb-xxxs{% else %}p6 font-700 mb-xxxs mt-sm{% endif %}">Choose Shipping Frequency</div>
            <div class="filter-subscriptions__master-frequency-selector">
              {% comment %} Use the exact same frequency options logic as individual selectors {% endcomment %}
              {% for filter_product in filter_subscriptions limit: 1 %}
                {% assign first_filter_product = filter_product %}
                {% assign first_filter_variant = filter_product.variants[0] %}
                {% if filter_product.variants[1].title contains 'subscription' or filter_product.variants[1].title contains 'Subscription' %}
                  {% assign first_filter_variant = filter_product.variants[1] %}
                {% endif %}
              {% endfor %}
              <div class="filter-subscriptions__master-frequency-buttons flex flex-wrap gap-xxs">
                {% if filter_subscription.frequency_options_override != blank or first_filter_product.metafields.seed.subscription_frequency_options != blank %}
                  {% if filter_subscription.frequency_options_override != blank %}
                    {% assign frequency_options = filter_subscription.frequency_options_override.value %}
                  {% else %}
                    {% assign frequency_options = first_filter_product.metafields.seed.subscription_frequency_options.value %}
                  {% endif %}
                  {% for frequency_option in frequency_options %}
                    <button type="button" data-selected="false" data-frequency="{{ frequency_option }}" class="filter-subscription__master-frequency flex-1 rounded-[2px] border border-gray {% if is_quick_view %}p3 p-[10px]{% else %}p-xxs p-3 font-500{% endif %} text-blue" js-filter-subscription-master-frequency data-selling-plan-name="Delivered every {{ frequency_option }}">
                      {{ frequency_option }}
                    </button>
                  {% endfor %}
                {% else %}
                  {% for selling_plan_allocation in first_filter_variant.selling_plan_allocations %}
                    <button type="button" data-selected="false" data-frequency="{{ selling_plan_allocation.selling_plan.options[0].value }}" class="filter-subscription__master-frequency flex-1 rounded-[2px] border border-gray {% if is_quick_view %}p3 p-[10px]{% else %}p-xxs p-3 font-500{% endif %} text-blue" js-filter-subscription-master-frequency data-selling-plan-name="{{ selling_plan_allocation.selling_plan.name }}">
                      {{ selling_plan_allocation.selling_plan.options[0].value }}
                    </button>
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          {% else %}
            <div class="p3 mb-xxxs {% if filter_subscriptions.count == 1 and pdp_type == 'filter' %}hidden{% endif %}">Select Filter Type</div>
            <div class="relative">
              <div class="filter-subscription__variant py-[11px] pl-[15px] pr-[33px] text-left border border-blue bg-white rounded-[2px] flex justify-between items-center gap-[6px] desktop:pr-[37px] relative cursor-pointer after:content-[''] after:absolute after:w-[8px] after:right-[12px] after:top-[calc(50%-6px)] after:h-[8px] after:rotate-45 after:border-r after:border-b [&.is-active]:hidden {% if filter_subscriptions.count == 1 and pdp_type == 'filter' %}hidden{% endif %}" data-selected="true" js-filter-subscription-select-current></div>
              <div class="filter-subscriptions__filters py-[7px] pl-[15px] pr-[33px] desktop:pr-[37px] flex-col gap-[4px] border border-blue bg-white rounded-[2px] hidden [&.is-active]:flex" js-filter-subscription-select-wrapper>
                {% assign filter_count = 0 %}
                {% for filter_product in filter_subscriptions %}
                  {% assign filter_variant = filter_product.variants[0] %}
                  {% if pdp_type == 'airpurifier_and_filter' %}
                    {% if filter_product.variants[1].title contains 'subscription' or filter_product.variants[1].title contains 'Subscription' %}
                      {% assign filter_variant = filter_product.variants[1] %}
                    {% endif %}
                  {% endif %}
                  {% if filter_variant.selling_plan_allocations.size > 0 %}
                    {% assign filter_count = filter_count | plus: 1 %}
                    {% if pdp_type == 'filter' %}
                      {% if filter_product == product %}
                        {% assign current_on_load = true %}
                      {% else %}
                        {% assign current_on_load = false %}
                      {% endif %}
                    {% else %}
                      {% if filter_count == 1 %}
                        {% assign current_on_load = true %}
                      {% else %}
                        {% assign current_on_load = false %}
                      {% endif %}
                    {% endif %}
                    <button type="button" class="filter-subscription__variant relative w-full py-[4px] text-left flex justify-between items-center gap-sm group/variant first:after:content-[''] first:after:absolute first:after:w-[8px] first:after:-right-[21px] first:after:top-[calc(50%-1px)] first:after:h-[8px] first:after:-rotate-[135deg] first:after:border-r first:after:border-b" {% if current_on_load %}current-on-load {% endif %} data-selected="false" data-variant="{{ filter_variant.id }}" data-available="{{ filter_variant.available }}" js-filter-subscription-variant js-filter-subscription-select-option {% if current_on_load == false and pdp_type == 'filter' %}is-variant-link="{{ filter_product.url }}" {% endif %}>
                      <div class="p3 group-hover/variant:underline underline-offset-[4px]">
                        {% if filter_product.metafields.seed.filter_subscription_label != blank %}
                          {{ filter_product.metafields.seed.filter_subscription_label }}
                        {% else %}
                          {{ filter_product.variants[0].title }}
                        {% endif %}
                      </div>

                      {%- liquid
                        assign filter_price = filter_product.variants[0].selling_plan_allocations[0].price | plus: 0
                        assign filter_compare_at_price = filter_product.variants[0].selling_plan_allocations[0].compare_at_price | plus: 0

                        if filter_compare_at_price < filter_price
                          assign subscription_discount_percentage = settings.initial_subscription_discount_percentage | plus: 0
                          assign filter_compare_at_price = filter_price
                          assign filter_discount_amount = filter_price | times: subscription_discount_percentage | divided_by: 100
                          assign filter_price = filter_price | minus: filter_discount_amount
                        endif
                      -%}

                      <div class="p3 shrink-0" js-price-copy data-label-price="{{ filter_price }}" data-label-price-compare-at="{{ filter_compare_at_price }}" data-price="{{ filter_price }}" data-price-compare-at="{{ filter_compare_at_price }}">
                        {% assign label_quantity = 1 %}
                        {% if airpurifier_type_two_pack %}
                          {% assign label_quantity = 2 %}
                        {% endif %}
                        {% if filter_compare_at_price > filter_price %}
                          <s class="font-400 mr-[6px]">{{ filter_compare_at_price | times: label_quantity | money }}</s>
                        {% endif %}
                        {{ filter_price | times: label_quantity | money }}
                        <span class="font-400"> /filter{% if filter_compare_at_price > filter_price %} <span class="hidden">({{ filter_compare_at_price | times: label_quantity | money }} value)</span>{% endif %}</span>
                      </div>
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
          {% for filter_products in filter_subscriptions %}
            {% if forloop.first %}
              {% assign filter_product = filter_products %}
            {% endif %}
          {% endfor%}
          {% assign filter_variant = filter_product.variants[0] %}
          {% if pdp_type != 'filter' %}
            {% if filter_product.variants[1].title contains 'subscription' or filter_product.variants[1].title contains 'Subscription' %}
              {% assign filter_variant = filter_product.variants[1] %}
            {% endif %}
          {% endif %}
          {% if filter_variant.selling_plan_allocations.size > 0 %}
            <div class="filter-subscription__selling-plans-group {% if pdp_type == '2in1_purify_humidify' %}hidden{% endif %}" data-variant="{{ filter_variant.id }}" js-filter-subscription-selling-plans-group>
              {% if filter_product.metafields.seed.filter_subscription_description != blank and pdp_type != '2in1_purify_humidify' %}
                <div class="filter-subscription__description p4 mt-xxxs hidden">
                  {{ filter_product.metafields.seed.filter_subscription_description }}
                </div>
              {% endif %}
              <div class="hidden">
                {% if filter_subscription.frequency_options_override != blank or filter_product.metafields.seed.subscription_frequency_options != blank %}
                  {% if filter_subscription.frequency_options_override != blank %}
                    {% assign frequency_options = filter_subscription.frequency_options_override.value %}
                  {% else %}
                    {% assign frequency_options = filter_product.metafields.seed.subscription_frequency_options.value %}
                  {% endif %}
                  {% for frequency_option in frequency_options %}
                    {% for selling_plan_allocation in filter_variant.selling_plan_allocations %}
                      {% if frequency_option == selling_plan_allocation.selling_plan.options[0].value %}
                        <button type="button" data-selected="false" data-selling-plan-id="{{ selling_plan_allocation.selling_plan.id }}" data-variant="{{ filter_variant.id }}" {% if filter_variant.available == false %}disabled{% endif %} {% if pdp_type == '2in1_purify_humidify' %}data-index="{{ forloop.parentloop.parentloop.index }}"{% endif %} class="filter-subscription__selling-plan flex-1 rounded-[2px] border border-gray {% if is_quick_view %}p3 p-[10px]{% else %}p-xxs p-3 font-500{% endif %} text-blue" js-filter-subscription-selling-plan data-selling-plan-name="{{ selling_plan_allocation.selling_plan.name }}">
                          {{ selling_plan_allocation.selling_plan.options[0].value }}
                        </button>
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                {% else %}
                  {% for selling_plan_allocation in filter_variant.selling_plan_allocations %}
                    <button type="button" data-selected="false" data-selling-plan-id="{{ selling_plan_allocation.selling_plan.id }}" data-variant="{{ filter_variant.id }}" {% if filter_variant.available == false %}disabled{% endif %} {% if pdp_type == '2in1_purify_humidify' %}data-index="{{ forloop.parentloop.index }}"{% endif %} class="filter-subscription__selling-plan flex-1 rounded-[2px] border border-gray {% if is_quick_view %}p3 p-[10px]{% else %}p-xxs p-3 font-500{% endif %} text-blue" js-filter-subscription-selling-plan data-selling-plan-name="{{ selling_plan_allocation.selling_plan.name }}">
                      {{ selling_plan_allocation.selling_plan.options[0].value }}
                    </button>
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          {% endif %}
          {% for filter_product in filter_subscriptions offset: 1 %}
            {% assign filter_variant = filter_product.variants[0] %}
            {% if pdp_type != 'filter' %}
              {% if filter_product.variants[1].title contains 'subscription' or filter_product.variants[1].title contains 'Subscription' %}
                {% assign filter_variant = filter_product.variants[1] %}
              {% endif %}
            {% endif %}
            {% if filter_variant.selling_plan_allocations.size > 0 %}
              <div class="filter-subscription__selling-plans-group hidden" data-variant="{{ filter_variant.id }}" js-filter-subscription-selling-plans-group>
                {% if filter_product.metafields.seed.filter_subscription_description != blank and pdp_type != '2in1_purify_humidify' %}
                  <div class="filter-subscription__description p4 mt-xxxs">
                    {{ filter_product.metafields.seed.filter_subscription_description }}
                  </div>
                {% endif %}
                <div class="hidden">
                  {% if filter_subscription.frequency_options_override != blank or filter_product.metafields.seed.subscription_frequency_options != blank %}
                    {% if filter_subscription.frequency_options_override != blank %}
                      {% assign frequency_options = filter_subscription.frequency_options_override.value %}
                    {% else %}
                      {% assign frequency_options = filter_product.metafields.seed.subscription_frequency_options.value %}
                    {% endif %}
                    {% for frequency_option in frequency_options %}
                      {% for selling_plan_allocation in filter_variant.selling_plan_allocations %}
                        {% if frequency_option == selling_plan_allocation.selling_plan.options[0].value %}
                          <button type="button" data-selected="false" data-selling-plan-id="{{ selling_plan_allocation.selling_plan.id }}" data-variant="{{ filter_variant.id }}" {% if filter_variant.available == false %}disabled{% endif %} {% if pdp_type == '2in1_purify_humidify' %}data-index="{{ forloop.parentloop.parentloop.index }}"{% endif %} class="filter-subscription__selling-plan flex-1 rounded-[2px] border border-gray {% if is_quick_view %}p3 p-[10px]{% else %}p-xxs p-3 font-500{% endif %} text-blue" js-filter-subscription-selling-plan data-selling-plan-name="{{ selling_plan_allocation.selling_plan.name }}">
                            {{ selling_plan_allocation.selling_plan.options[0].value }}
                          </button>
                        {% endif %}
                      {% endfor %}
                    {% endfor %}
                  {% else %}
                    {% for selling_plan_allocation in filter_variant.selling_plan_allocations %}
                      <button type="button" data-selected="false" data-selling-plan-id="{{ selling_plan_allocation.selling_plan.id }}" data-variant="{{ filter_variant.id }}" {% if filter_variant.available == false %}disabled{% endif %} {% if pdp_type == '2in1_purify_humidify' %}data-index="{{ forloop.parentloop.index }}"{% endif %} class="filter-subscription__selling-plan flex-1 rounded-[2px] border border-gray {% if is_quick_view %}p3 p-[10px]{% else %}p-xxs p-3 font-500{% endif %} text-blue" js-filter-subscription-selling-plan data-selling-plan-name="{{ selling_plan_allocation.selling_plan.name }}">
                        {{ selling_plan_allocation.selling_plan.options[0].value }}
                      </button>
                    {% endfor %}
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="{% if is_quick_view %}h-[4px]{% else %}h-[16px]{% endif %}"></div>
    </div>
    {% if filter_subscription.tags != blank %}
      <ul class="product-subscription__tags flex gap-xxs absolute {% if is_quick_view %}left-[13px]{% else %}left-md{% endif %} top-0 -translate-y-1/2">
        {% for tag in filter_subscription.tags.value %}
          {% capture tag_cycle %}{% cycle 'odd', 'even' %}{% endcapture %}
          {%- capture tag_class -%}
            {%- if is_additional -%}
              {%- if tag_cycle == 'odd' -%}bg-blue-darkSky{%- else -%}bg-blue text-white{%- endif -%}
            {%- else -%}
              {%- if tag_cycle == 'odd' -%}bg-primary text-white{%- else -%}bg-blue-darkSky{%- endif -%}
            {%- endif -%}
          {%- endcapture -%}
          <li class="product-subscription__tag rounded-[60px] font-[600] text-[11px] leading-[12px] px-[10px] py-[2px] h-[18px] flex items-center justify-center {{ tag_class }}">{{ tag }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  {% unless is_additional %}
    <button type="button" class="product__non-subscription border border-gray rounded-[16px] {% if is_quick_view %}px-[10px] py-[16px] gap-[7px]{% else %}p-[16px] desktop:px-md gap-[12px]{% endif %} flex items-center w-full {% if subscription_selected == false %}order-first{% endif %} data-[selected=true]:border-primary" data-selected="{% if subscription_selected %}false{% else %}true{% endif %}" data-available="{{ current_variant.available }}" js-non-subscription-toggle>
      <div class="checkbox bg-white w-[16px] h-[16px] border border-gray rounded-full p-[3px] flex justify-center items-center [&_svg]:!fill-transparent">
        {{ 'icon-check.svg' | inline_asset_content }}
      </div>
      <div class="{% if is_quick_view %}p3{% else %}text-[13px] leading-[21px]{% endif %} font-[600] text-primary flex-1 text-left">
        {% if filter_subscription.non_subscription_button_label_override != blank %}
          {{ filter_subscription.non_subscription_button_label_override }}
        {% else %}
          {% if pdp_type == 'filter' %}
            One-Time Purchase
          {% elsif pdp_type == 'airpurifier_and_filter' %}
            {% if filter_subscription.name contains 'Humidifier' %}
              Humidifier Only
            {% else %}
              Air Purifier Only
            {% endif %}
          {% else %}
            2-in-1 Purify + Humidify Only
          {% endif %}
        {% endif %}
      </div>
      <div class="product__price-wrapper {% if is_quick_view %}p3{% else %}text-[13px] leading-[21px]{% endif %} flex flex-col justify-end items-end gap-xxxs" {% if pdp_type == 'filter' %}js-price js-full-price {% endif %} js-price-copy data-price="{{ current_variant.price }}">
        {% if current_variant.compare_at_price > current_variant.price %}
          <s class="product__price product__price--compare font-400 order-1 text-primary text-[13px] leading-[21px]">{{ current_variant.compare_at_price | money }}</s>
          <span class="product__price product__price--current text-primary font-[600] text-[13px] leading-[21px]">{{ current_variant.price | money }}</span>
        {% else %}
          <span class="product__price product__price--current text-primary font-[600] text-[13px] leading-[21px]">{{ current_variant.price | money }}</span>
        {% endif %}
      </div>
    </button>
  {% endunless %}
</div>
