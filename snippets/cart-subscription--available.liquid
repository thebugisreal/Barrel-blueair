{% assign preselected_subscription_quantity = 1 %}
{% if pdp_type == 'Filter' %}
  {% if preselected_subscription.product.metafields.seed.quantity_option.value contains '2 Pack | 2' %}
    {% assign preselected_subscription_quantity = 2 %}
  {% else %}
    {% assign preselected_subscription_quantity = item.quantity %}
  {% endif %}
{% elsif pdp_type == 'Air Purifier + Filter' %}
  {% if two_pack_override == false or two_pack_override == true %}
    {% if two_pack_override == true %}
      {% assign preselected_subscription_quantity = 2 %}
    {% endif %}
  {% elsif preselected_subscription.product.metafields.seed.quantity_option.value contains '2 Pack | 2' %}
    {% assign preselected_subscription_quantity = 2 %}
  {% endif %}
{% endif %}
{% liquid
  assign filter_price = preselected_subscription.product.variants[0].selling_plan_allocations[0].price | plus: 0
  assign filter_compare_at_price = preselected_subscription.product.variants[0].selling_plan_allocations[0].compare_at_price | plus: 0

  if pdp_type == 'Filter'
    assign filter_price = preselected_subscription_selling_plan_allocation.price | plus: 0
    assign filter_compare_at_price = preselected_subscription_selling_plan_allocation.compare_at_price | plus: 0
  endif

  if filter_compare_at_price < filter_price
    assign subscription_discount_percentage = settings.recurring_subscription_discount_percentage | plus: 0
    assign filter_compare_at_price = filter_price
    assign filter_discount_amount = filter_price | times: subscription_discount_percentage | divided_by: 100
    assign filter_price = filter_price | minus: filter_discount_amount
  endif
%}
<cart-subscription data-scope="{{ scope }}" data-index="{{ index }}" class="cart-item__subscription block border border-gray p-sm mt-sm relative">
  <div class="flex justify-start items-center gap-xs">
    <button type="button" class="cart-item-subscription__checkbox" data-checked="false" js-cart-subscription-checkbox></button>
    <p class="p3">
      {% if preselected_subscription.title contains 'Wick' and is_two_in_one_subscription %}
        Add a Wick Subscription 2026
      {% elsif preselected_subscription.title contains 'Aroma' and is_two_in_one_subscription %}
        Add an Aroma Subscription
      {% elsif preselected_subscription.title contains 'Collection' and is_two_in_one_subscription %}
        Add an Aroma Subscription
      {% else %}
        Add a Subscription 999999999
      {% endif %}
    </p>
    <button type="button" class="cart-item-subscription__tooltip cart-item-subscription__tooltip--add w-[19px] h-[19px] rounded-full"></button>
  </div>
  <div class="border-t border-t-gray mt-sm pt-sm flex items-center gap-xxs">
    <button type="button" class="cart-item-subscription__tooltip cart-item-subscription__tooltip--pay w-[19px] h-[19px] rounded-full"></button>
    <div class="flex-1">Pay when it's sent</div>
    <div>
      {% comment %} {% if filter_compare_at_price > filter_price %}
        <s>{{ filter_compare_at_price | times: preselected_subscription_quantity | money }}</s>
      {% endif %} {% endcomment %}
      <span class="font-700">{{ filter_price | times: preselected_subscription_quantity | money }}</span>
    </div>
    {% if settings.initial_subscription_discount_percentage > 0 %}
      <div class="py-xxs px-xs rounded-[24px] bg-blue text-white text-12 font-700">
        Save {{ settings.initial_subscription_discount_percentage }}%
      </div>
    {% endif %}
  </div>
  <p class="text-12 mt-xxxs hidden" js-cart-subscription-error></p>
  <script type="application/json" js-subscription-data-json>
    {
      "{% if pdp_type == 'Filter' %}filter{% else %}airPurifier{% endif %}": {
        "itemKey": "{{ item.key }}",
        "itemQuantity": "{{ item.quantity }}",
        "variantId": "{{ item.variant_id }}",
        "properties": {
        {% for property in item.properties %}
          "{{ property.first }}": "{{ property.last }}"{% unless forloop.last %},{% endunless %}
        {% endfor %}
        }
      },
      "preSelectedFilter": {
        "id": "{{ preselected_subscription.id }}",
        "sellingPlanId": "{{ preselected_subscription_selling_plan_allocation.selling_plan.id }}",
        "frequency": "{{ preselected_subscription_selling_plan_allocation.selling_plan.options[0].value | downcase | remove: 'months' | strip }}",
        "quantity": "{{ preselected_subscription_quantity }}"
      },
      "isTwoInOneSubscription": {{ is_two_in_one_subscription }},
      "index": "{{ index }}"
    }
  </script>
</cart-subscription>