<s-drawer id="DesktopSearchDrawer" position='top' open="[js-open-desktop-search]" close="[js-close-desktop-search]">
  <predictive-search class="desktop-search block" data-scope="desktop" data-market="{{ localization.language.iso_code | downcase }}-{{ localization.country.iso_code |  downcase}}">
    <div class="desktop-search__heading px-xl flex justify-between items-center gap-md py-sm">
      <a href="{{ routes.root_url }}" class="desktop-search__logo w-[140px]">{{ 'icon-blueair-logo.svg' | inline_asset_content }}</a>
      <form action="{{ routes.search_url }}" method="get" role="search" class="flex items-center gap-sm w-[650px]">
        <div class="relative flex-1">
          <label for="DesktopSearch" class="visually-hidden">Search</label>
          <input
            id="DesktopSearch"
            class="desktop-search__input p2 leading-[22px] block w-full py-xs pl-[52px] pr-lg rounded-[24px] bg-blue-light placeholder:p2 placeholder:text-gray"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            {%- if settings.predictive_search_enabled -%}
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results-list"
              aria-controls="predictive-search-results-list"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            {%- endif -%}
            placeholder="Search"
          >
          <input name="options[prefix]" type="hidden" value="last">
          <div class="block absolute left-8 w-[36px] top-1/2 -translate-y-1/2">{{ 'icon-search.svg' | inline_asset_content }}</div>
          <button type="button" class="block absolute right-12 w-[20px] top-1/2 -translate-y-1/2 leading-[0] hidden" js-clear>{{ 'icon-close.svg' | inline_asset_content }}</button>
        </div>
        <button type="submit" class="desktop-search__submit btn" js-search-submit>
          <span class="btn__text p2">Search</span>
          <span class="btn__arrow">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span>
        </button>
      </form>
      <button class="desktop-search__close w-[42px] ml-[100px]" js-close-desktop-search>{{ 'icon-nav-close.svg' | inline_asset_content }}</button>
    </div>
    <div class="desktop-search__results-container w-[650px] mx-auto">
      {% if settings.popular_searches != blank %}
        <div class="desktop-search__popular-searches pt-md pb-lg max-h-[calc(100vh-78px)] overflow-y-auto" js-popular-searches>
          {% render 'predictive-search--popular-searches' popular_searches_linklist: linklists[settings.popular_searches] %}
        </div>
      {% endif %}
      <div class="desktop-search__results hidden pt-md" js-predictive-search-results></div>
    </div>
  </predictive-search>
</s-drawer>