<!-- Zendesk Authentication -->
<!-- Start of blueairsupport Zendesk Widget script -->
<script
  id="ze-snippet"
  src="https://static.zdassets.com/ekr/snippet.js?key=ac937830-13ea-4d4f-9caf-4459b668d107"
></script>
<!-- End of blueairsupport Zendesk Widget script -->

{% if customer %}
  <script>
    (function () {
      // Shopify customer data
      const customerData = {
        customerId: '{{ customer.id }}',
        email: '{{ customer.email }}',
        name: '{{ customer.first_name | append: " " | append: customer.last_name }}'.trim(),
      };

      // Function to fetch JWT from Gadget backend
      async function fetchZendeskJWT() {
        try {
          const response = await fetch('https://blueair--development.gadget.app/zendesk-auth', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(customerData),
          });

          if (!response.ok) {
            throw new Error('Failed to fetch JWT: ' + response.status);
          }

          const data = await response.json();
          console.log('Zendesk JWT:', data.token);
          return data.token;
        } catch (error) {
          console.error('Zendesk JWT fetch error:', error);
          throw error;
        }
      }

      // Wait for Zendesk widget to be ready
      function initZendeskAuth() {
        if (typeof zE === 'undefined') {
          setTimeout(initZendeskAuth, 100);
          return;
        }

        // Authenticate user with Zendesk
        zE(
          'messenger',
          'loginUser',
          function (callback) {
            fetchZendeskJWT()
              .then((token) => {
                callback(token);
              })
              .catch((error) => {
                console.error('Failed to authenticate with Zendesk:', error);
              });
          },
          function (error) {
            if (error) {
              console.error('Zendesk login error:', error.type, error.reason, error.message);
            } else {
              console.log('Zendesk authentication successful');
            }
          }
        );
      }

      // Initialize authentication when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initZendeskAuth);
      } else {
        initZendeskAuth();
      }
    })();
  </script>
{% endif %}
<!-- End Zendesk Authentication -->
