{% liquid
    if shop.permanent_domain == '5ef43d-4a.myshopify.com'  
        assign transactional_countries = 'US,CA' | split: ',' 
        assign is_transactional = false 
        assign current_country = localization.country.iso_code | upcase 
        for country in transactional_countries 
            if country == current_country 
              assign is_transactional = true 
              break 
            endif 
          endfor 
    elsif shop.permanent_domain == 'blueeudev.myshopify.com' 
        assign transactional_countries = 'DE' | split: ',' 
        assign is_transactional = false 
        assign current_country = localization.country.iso_code | upcase 
        for country in transactional_countries 
            if country == current_country 
              assign is_transactional = true 
              break 
            endif 
          endfor 
    endif  
    %}
<ul class="product__spec-container">
    {% if product.metafields.seed.blair_filterSpecification_filterType != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">{{ 'products.technical_specifications.filter_type' | t }}</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_filterSpecification_filterType}}</p>
        </li>
    {% endif %}
    {% if is_transactional %}
      {% if product.metafields.seed.blair_dimensions != blank %}
          <li class="flex gap-md">
              <p class="p3 w-1/2">{{ 'products.technical_specifications.dimensions' | t }}</p>
              <p class="p4 w-1/2">{{ product.metafields.seed.blair_dimensions}}</p>
          </li>
      {% endif %}
    {% else %}
      {% if product.metafields.seed.dimensions_hxwxd_international != blank %}
          <li class="flex gap-md">
              <p class="p3 w-1/2">{{ 'products.technical_specifications.dimensions' | t }}</p>
              <p class="p4 w-1/2">{{ product.metafields.seed.dimensions_hxwxd_international}}</p>
          </li>
      {% else %}
        {% if product.metafields.seed.blair_dimensions != blank %}
            <li class="flex gap-md">
                <p class="p3 w-1/2">{{ 'products.technical_specifications.dimensions' | t }}</p>
                <p class="p4 w-1/2">{{ product.metafields.seed.blair_dimensions}}</p>
            </li>
        {% endif %}
      {% endif %}
    {% endif %}
    {% if is_transactional %}
      {% if product.metafields.seed.blair_productSpecification_weight != blank %}
          <li class="flex gap-md">
              <p class="p3 w-1/2">{{ 'products.technical_specifications.product_weight' | t }}</p>
              <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_weight}} {{ product.metafields.seed.blair_productSpecification_weight_measurement}}</p>
          </li>
      {% endif %}
    {% else %}
      {% if product.metafields.seed.blair_productSpecification_weight_internaional  != blank %}
          <li class="flex gap-md">
              <p class="p3 w-1/2">{{ 'products.technical_specifications.product_weight' | t }}</p>
              <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_weight_internaional }} {{ product.metafields.seed.blair_productSpecification_weight_measurement_international}}</p>
          </li>
      {% else %}
        {% if product.metafields.seed.blair_productSpecification_weight != blank %}
            <li class="flex gap-md">
                <p class="p3 w-1/2">{{ 'products.technical_specifications.product_weight' | t }}</p>
                <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_weight}} {{ product.metafields.seed.blair_productSpecification_weight_measurement}}</p>
            </li>
        {% endif %}
      {% endif %}
    {% endif %}   
    {% if product.metafields.seed.blair_productSpecification_tankcapacity != blank %}
        <li class="flex gap-md">
            <p class="p3 w-1/2">{{ 'products.technical_specifications.tank_capacity' | t }}</p>
            <p class="p4 w-1/2">{{ product.metafields.seed.blair_productSpecification_tankcapacity}}</p>
