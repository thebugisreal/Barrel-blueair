<s-modal id="CountryMarketSelectModal" class="country-market-selector-modal py-md bg-gray-athans w-[300px] tabletl:min-w-[500px]" open="[js-open-country-market-selector-modal]" close="[js-close-country-market-selector-modal]" js-country-select-modal>
    <div class="site__logo w-[138px] mx-auto self-center mb-md">{{ 'icon-blueair-logo.svg' | inline_asset_content }}</div>
    
    <div class="modal__content px-lg tabletl:px-xl">
        <div class="s1 mb-md">
            <country-select-modal class="block w-full h-full" data-domain="{{shop.permanent_domain}}">
                {% capture form_id %}ModalLocalizationForm{% endcapture %}
                {% capture input_id %}ModalCountryCode{% endcapture %}
                {%- form 'localization', id: form_id, js-country-form: '', class: 'block w-full h-full relative' -%}  
                <p class="s2">Select Market</p>
                <div class="modal__country-select relative bg-white border p-sm border-gray rounded-[4px]">
                    <div class="country-name text-[22px] flex-1"
                    js-country-input-label>
                    {% if localization.country.market.handle == "europe" %}
                        Europe
                    {% elsif localization.country.name == 'Hong Kong SAR' %}
                        Hong Kong/Macau
                    {% else %}
                        {{ localization.country.name }}
                    {% endif %}
                    </div>
                    <select name="country_code" id="{{ input_id }}" class="country-select__selector block absolute inset-0 z-[1] opacity-0 cursor-pointer" js-country-select>
                        <option value="AU" {% if localization.country.iso_code == "AU"%}selected{% endif %} data-country-name="Australia">Australia</option>
                        <option value="BD" {% if localization.country.iso_code == "BD"%}selected{% endif %} data-country-name="Bangladesh">Bangladesh</option>
                        <option value="EU" {% if localization.country.market.handle == "europe" %}selected{% endif %} data-country-name="Europe">Europe</option>
                        <option value="CA" {% if localization.country.iso_code == "CA"%}selected{% endif %} data-country-name="Canada">Canada</option>
                        <option value="HK" {% if localization.country.iso_code == "HK"%}selected{% endif %} data-country-name="Hong Kong/Macau">Hong Kong/Macau</option>
                        <option value="TW" {% if localization.country.iso_code == "TW"%}selected{% endif %} data-country-name="Taiwan">Taiwan</option>
                        <option value="FR" {% if localization.country.iso_code == "FR"%}selected{% endif %} data-country-name="France">France</option>
                        <option value="DE" {% if localization.country.iso_code == "DE"%}selected{% endif %} data-country-name="Germany">Germany</option>
                        <option value="ID" {% if localization.country.iso_code == "ID"%}selected{% endif %} data-country-name="Indonesia">Indonesia</option>
                        <option value="JP" {% if localization.country.iso_code == "JP"%}selected{% endif %} data-country-name="Japan">Japan</option>
                        <option value="KR" {% if localization.country.iso_code == "KR"%}selected{% endif %} data-country-name="Korea">Korea</option>
                        <option value="CN" {% if localization.country.iso_code == "CN"%}selected{% endif %} data-country-name="Mainland China">Mainland China</option>
                        <option value="MY" {% if localization.country.iso_code == "MY"%}selected{% endif %} data-country-name="Malaysia">Malaysia</option>
                        <option value="AE" {% if localization.country.iso_code == "AE"%}selected{% endif %} data-country-name="Middle East">Middle East</option>
                        <option value="NP" {% if localization.country.iso_code == "NP"%}selected{% endif %} data-country-name="Nepal">Nepal</option>
                        <option value="NZ" {% if localization.country.iso_code == "NZ"%}selected{% endif %} data-country-name="New Zealand">New Zealand</option>
                        <option value="PK" {% if localization.country.iso_code == "PK"%}selected{% endif %} data-country-name="Pakistan">Pakistan</option>
                        <option value="PH" {% if localization.country.iso_code == "PH"%}selected{% endif %} data-country-name="Philippines">Philippines</option>
                        <option value="SG" {% if localization.country.iso_code == "SG"%}selected{% endif %} data-country-name="Singapore">Singapore</option>
                        <option value="ES" {% if localization.country.iso_code == "ES"%}selected{% endif %} data-country-name="Spain">Spain</option>
                        <option value="TH" {% if localization.country.iso_code == "TH"%}selected{% endif %} data-country-name="Thailand">Thailand</option>
                        <option value="US" {% if localization.country.iso_code == "US"%}selected{% endif %} data-country-name="United States">United States</option>
                        <option value="GB" {% if localization.country.iso_code == "GB"%}selected{% endif %} data-country-name="UK">UK</option>
                        <option value="VN" {% if localization.country.iso_code == "VN"%}selected{% endif %} data-country-name="Vietnam">Vietnam</option>
                    </select>
                    <div class="absolute w-[32px] top-1/4 right-xxs">
                        {{ 'icon-active-down.svg' | inline_asset_content }}
                    </div>
                </div>
                <p class="s2 mt-md">Select Language</p>
                <div class="modal__country-select relative bg-white border p-sm border-gray rounded-[4px]" js-language>
                    <div class="language-name text-[22px] flex-1" js-language-input-label> {{ localization.language.endonym_name | capitalize }} </div>
                    <select id="LanguageList" role="list" class="language-select__selector block absolute inset-0 z-[1] opacity-0 cursor-pointer" js-language-select>
                        {% for language in localization.available_languages %}
                            <option {% if language.iso_code == localization.language.iso_code | downcase%} selected {% endif %} value="{{ language.iso_code }}"  data-value="{{ language.iso_code }}" data-endonym-name="{{ language.endonym_name }}">
                                {{ language.endonym_name | capitalize }}
                            </option>
                        {% endfor %}
                    </select>
                    <input class="hidden" name="language_code" value="{{ localization.language.iso_code }}" js-language-input>
                    <div class="absolute w-[32px] top-1/4 right-xxs">
                        {{ 'icon-active-down.svg' | inline_asset_content }}
                    </div>
                </div>
                {%- endform -%} 
                <button class="modal__submit-btn btn btn--blue-rounded mt-md w-fit mx-auto" js-close-country-market-selector-modal js-localization-submit>
                    <span class="btn__text">Visit Site</span>
                    <span class="btn__arrow">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span>
                </button>
            </country-select-modal>
        </div>
    </div>
    <p class="modal__disclaimer p1 p-lg text-center font-400">This website uses cookies to improve your experience. By continuing to use our website you are consenting to our cookie policy.</p>
</s-modal>