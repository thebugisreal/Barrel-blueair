<s-drawer id="QuickViewDrawer" body-open-class="quick-view-drawer-open" position='center' open="[js-quick-view]" close="[js-close-quick-view]">
  <button class="absolute top-[14px] right-[11px] tabletp:right-[15px] tabletp:top-[17px] w-[18px] h-[18px] z-20" js-close-quick-view>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none"><path stroke="currentColor" d="M9 .5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Z"/><path fill="currentColor" d="m5.435 4.787-.648.648 7.778 7.778.649-.648z"/><path fill="currentColor" d="m13.213 5.435-.648-.648-7.778 7.778.648.648z"/></svg>
  </button>
  <quick-view class="block w-full h-[780px] max-h-[100vh] tabletp:max-w-[880px] tabletp:h-[560px]">
    <div class="w-full h-full flex justify-center items-center" js-loading-indicator>
      <div class="w-full max-w-[100px] h-[2px] overflow-hidden">
        <div class="animate-loader w-full h-[2px] bg-gray"></div>
      </div>
    </div>
    <div class="h-full" js-quick-view-content></div>
  </quick-view>
</s-drawer>