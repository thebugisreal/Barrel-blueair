<s-drawer id="CartDrawer" body-open-class="cart-drawer-open" class="pt-md" position='right' open="[js-open-cart]" close="[js-close-cart]">
  <button class="absolute right-sm top-md w-[40px] h-[40px]" js-close-cart>
    {{ 'icon-close-no-border.svg' | inline_asset_content }}
  </button>
  {% render 'cart' %}
</s-drawer>