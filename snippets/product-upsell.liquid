{% comment %}
  @param upsell_product - the product object
  @param upsell_heading - the heading of the upsell
  @param upsell_short_desc - the short description of the upsell
  @param upsell_image - the image to display for the upsell
{% endcomment %}

{% if upsell_product != blank %}
  {%- liquid
    assign upsell_current_variant = upsell_product.variants.first
    for variant in upsell_product.variants
      assign variant_title = variant.title | downcase
      unless variant_title contains 'subscription'
        assign upsell_current_variant = variant
        break
      endunless
    endfor

    assign color_option = false
    assign related_tag_scent = blank

    if upsell_product.options_by_name['color'] != blank
      assign color_option = upsell_product.options_by_name['color'].position | minus: 1
    endif

    for tag in upsell_product.tags
      if tag contains 'product-family-scent:'
        assign related_tag_scent = tag
      endif
    endfor

    assign has_option_display = false
    if color_option != false
      assign has_option_display = true
    elsif related_tag_scent != blank
      assign has_option_display = true
    endif

    assign option_label = ''
    assign color_pattern = upsell_product.metafields.shopify.color-pattern
    if color_option != false
      assign option_label = upsell_current_variant.options[color_option]
    elsif color_pattern != blank and related_tag_scent != blank
      assign option_label = color_pattern.value[0].label
    endif
  -%}
{% endif %}

<product-upsell class="product-upsell__item flex flex-col">
  <div class="product-upsell__buybox flex-1 flex flex-col justify-between tabletl:gap-md">
    {% if upsell_product != blank %}
      {%- if upsell_heading != blank -%}
        {%- capture upsell_title_content -%}
          <span class="title-base">{{ upsell_heading | strip }}</span>
          {%- if has_option_display -%}
            <span class="title-base price-span">|</span>
            <span class="title-base italic color-name">{{ option_label }}</span>
          {%- endif -%}
        {%- endcapture -%}
      {%- endif -%}

      <div class="product-upsell__row flex gap-sm justify-between items-center">
        <div class="product-upsell__details flex flex-1 min-w-0 items-center">
          {%- if upsell_image != blank -%}
            <div class="product-upsell__variant-image w-[80px] min-w-[80px] h-[80px] flex flex-col">
              <a href="{{ upsell_product.url }}?variant={{ upsell_current_variant.id }}" class="upsell-image-link">
                {%- if upsell_current_variant.image != blank -%}
                  {% render 'lazy-image' image: upsell_current_variant.image, img_classes: 'bg-blue-light' %}
                {%- else -%}
                  {% render 'lazy-image' image: upsell_image, img_classes: 'bg-blue-light' %}
                {%- endif -%}
              </a>
            </div>
          {%- endif -%}

          <div class="product-upsell__content flex flex-col justify-center min-w-0 ml-sm">
            {%- if upsell_heading != blank -%}
              <div class="product-upsell__title p3 flex gap-xxs" js-upsell-title data-base-title="{{ upsell_heading | strip }}">
                <a href="{{ upsell_product.url }}?variant={{ upsell_current_variant.id }}" class="upsell-link flex items-center gap-xxs tabletl:gap-xs">
                  {{ upsell_title_content }}
                </a>
              </div>
              <div class="product-upsell__price p4 price-display" js-product-upsell-price>{{ upsell_current_variant.price | money }}</div>
            {%- endif -%}

            {%- if upsell_short_desc != blank -%}
              <div class="product-upsell__description p4 mb-xxxs">{{ upsell_short_desc }}</div>
            {%- endif -%}

            {%- if color_option != false -%}
              <div class="product-upsell__variants-container flex mt-4">
                <div class="product-upsell__variants flex justify-start flex-wrap gap-[2px]">
                  {%- assign swatch_objects = upsell_product.metafields.seed.swatches.value -%}
                  {%- for upsell_variant in upsell_product.variants -%}
                    {%- assign uv_title = upsell_variant.title | downcase -%}
                    {%- unless uv_title contains 'subscription' -%}
                      {%- assign swatch = swatch_objects | where: 'name', upsell_variant.options[color_option] | first -%}
                      <div class="flex">
                        <button type="button"
                          class="product-upsell__variant product-upsell__variant--color w-[24px] h-[24px] p-[3px] rounded-full"
                          data-variant-id="{{ upsell_variant.id }}"
                          data-available="{{ upsell_variant.available }}"
                          data-price="{{ upsell_variant.price | money }}"
                          data-selected="{% if upsell_variant.options[color_option] == upsell_current_variant.options[color_option] %}true{% else %}false{% endif %}"
                          title="{{ upsell_variant.options[color_option] }}"
                          data-variant-image="{{ upsell_variant.image | image_url: width: 300 }}"
                          js-product-upsell-variant>
                          <div class="block w-full h-full rounded-full overflow-hidden" style="background-color: {{ swatch.color }};">
                            {%- if swatch.image != blank -%}
                              <img src="{{ swatch.image.value | image_url: width: 24 }}" alt="{{ upsell_variant.options[color_option] }}" width="24" height="24" class="block h-full w-full">
                            {%- endif -%}
                          </div>
                        </button>
                      </div>
                    {%- endunless -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

            {%- if color_pattern != blank and related_tag_scent != blank -%}
              <div class="product__related-colors-container mt-sm mb-sm">
                {%- for color in color_pattern.value -%}
                  <div class="product__related-color">
                    <div class="product__related-colors flex flex-wrap gap-xs"
                      data-handle="{{ upsell_product.handle }}"
                      data-collection="{{ related_tag_scent }}"
                      data-option="scent"
                      js-product-option-swatches-container>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="product-upsell__atc-container flex shrink-0 justify-end items-center flex-nowrap gap-xxs">
          <button type="button" class="product-upsell__atc {% unless upsell_current_variant.available %}product-upsell__atc--hidden{% endunless %}" {% unless upsell_current_variant.available %}disabled{% endunless %} data-variant-id="{{ upsell_current_variant.id }}" js-product-upsell-atc>
            <span class="btn__text visually-hidden">
              {%- if upsell_current_variant.available -%}
                Add to Cart
              {%- else -%}
                Out of Stock
              {%- endif -%}
            </span>
            <svg class="pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true"><path stroke="currentColor" d="m22.995 10.436-3.457 11.129H4.693L.955 10.435z" clip-rule="evenodd"/><path stroke="currentColor" d="M16.955 7.436a5 5 0 0 0-10 0"/></svg>
          </button>
          <button type="button" class="product-upsell__added-btn btn btn--white-outline hidden" data-variant-id="{{ upsell_current_variant.id }}" js-product-upsell-added>
            <span class="btn__text">Added</span>
          </button>
          <button type="button" class="product-upsell__bis-btn btn btn--blue-rounded px-sm {% if upsell_current_variant.available %}hidden{% endif %}" data-variant-id="{{ upsell_current_variant.id }}" data-variant-title="{{ upsell_current_variant.title }}" js-klaviyo-bis-modal-trigger>
            <span class="btn__text">Notify Me</span>
          </button>
        </div>
      </div>
      <p class="p6 hidden text-right w-full leading-[1.1]" js-product-upsell-error></p>
    {% endif %}
  </div>
</product-upsell>
