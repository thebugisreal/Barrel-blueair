{%- liquid
  assign filter_price = subscription_item.product.variants[0].selling_plan_allocations[0].price | plus: 0
  assign filter_compare_at_price = subscription_item.product.variants[0].selling_plan_allocations[0].compare_at_price | plus: 0

  if filter_compare_at_price < filter_price
    assign subscription_discount_percentage = settings.recurring_subscription_discount_percentage | plus: 0
    assign filter_compare_at_price = filter_price
    assign filter_discount_amount = filter_price | times: subscription_discount_percentage | divided_by: 100
    assign filter_price = filter_price | minus: filter_discount_amount
  endif
-%}

<cart-subscription data-scope="{{ scope }}" data-index="{{ index }}" class="cart-item__subscription block border border-gray p-sm mt-sm">
  <div class="flex justify-start items-start gap-xs">
    <button type="button" class="cart-item-subscription__checkbox mt-xxxs" data-checked="true" js-cart-subscription-checkbox></button>
    <div class="p3 flex-1">{{ subscription_item.product.title }} Subscription</div>
  </div>
  <div class="mt-xxxs relative">
    <p>First order will process on <span class="font-700">{{ subscription_item.properties['First Order Date'] }}</span></p>
    <p>Delivered every <span class="font-700">{{ subscription_item.properties['_Frequency'] }}</span></p>
    <p class="mr-lg">
      Recurring payment: 
      {% if filter_compare_at_price > filter_price %}
        <s>{{ filter_compare_at_price | times: subscription_item.quantity | money }}</s>
      {% endif %}
      <span class="font-700">{{ filter_price | times: subscription_item.quantity | money }}</span></p>
    <a href="{{ item.url }}" class="link link--underline underline-offset-2 absolute right-0 bottom-0" js-cart-subscription-edit>Edit</a>
  </div>
  <p class="text-12 mt-xxxs hidden" js-cart-subscription-error></p>
  <script type="application/json" js-subscription-data-json>
    {
      "filter": {
        "itemKey": "{{ subscription_item.key }}",
        "itemQuantity": "{{ subscription_item.quantity }}",
        "variantId": "{{ subscription_item.variant_id }}",
        "properties": {
        {% for property in subscription_item.properties %}
          "{{ property.first }}": "{{ property.last }}"{% unless forloop.last %},{% endunless %}
        {% endfor %}
        }
      }{% if unit_subscription_service_product != blank %},
      "airPurifier": {
        "itemKey": "{{ item.key }}",
        "itemQuantity": "{{ item.quantity }}",
        "variantId": "{{ item.variant_id }}",
        "properties": {
        {% for property in item.properties %}
          "{{ property.first }}": "{{ property.last }}"{% unless forloop.last %},{% endunless %}
        {% endfor %}
        }
      }{% endif %},
      "isTwoInOneSubscription": {{ is_two_in_one_subscription }},
      {% if subscribed_scent_product != blank %}
      "subscribedScent": "{{ subscribed_scent_product }}",
      {% endif %}
      "index": "{{ index }}"
    }
  </script>
</cart-subscription>